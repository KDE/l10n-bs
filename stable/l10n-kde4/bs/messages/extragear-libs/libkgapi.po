#: libkgapi/accessmanager_p.cpp:82
msgid "No valid reply received"
msgstr "Nije primljen ispravan odgovor"

#: libkgapi/accessmanager_p.cpp:112
msgid "Bad request."
msgstr "Loš zahtjev"

#: libkgapi/accessmanager_p.cpp:170 libkgapi/accessmanager_p.cpp:171
#, kde-format
msgid ""
"Requested resource is forbidden.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Zahtijevani resurs je zabranjen.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:179 libkgapi/accessmanager_p.cpp:180
#, kde-format
msgid ""
"Requested resource does not exist.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Zahtijevani resurs ne postoji.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:188 libkgapi/accessmanager_p.cpp:189
#, kde-format
msgid ""
"Conflict. Remote resource is newer than local.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Konflikt. Udaljeni resurs je noviji od lokalnog.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:197 libkgapi/accessmanager_p.cpp:198
#, kde-format
msgid ""
"Requested resource does not exist anymore.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Zahtijevani resurs više ne postoji.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:206 libkgapi/accessmanager_p.cpp:207
#, kde-format
msgid ""
"Internal server error. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Interna greška servera. Probajte kasnije ponovo.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:215 libkgapi/accessmanager_p.cpp:216
#, kde-format
msgid ""
"User quota exceeded. Try again later.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Korisnička kvota prekoračena. Probajte kasnije ponovo.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:224
#, kde-format
msgid ""
"Unknown error.\n"
"\n"
"Google replied '%1'"
msgstr ""
"Nepoznata greška.\n"
"\n"
"Google odgovorio '%1'"

#: libkgapi/accessmanager_p.cpp:255 libkgapi/accessmanager_p.cpp:256
msgid "Unknown reply content type."
msgstr "Nepoznat tip sadržaja odgovora."

#: libkgapi/accessmanager_p.cpp:331
#, kde-format
msgid "Invalid request, service %1 is not registered."
msgstr "Nepoznat zahtjev, servis %1 nije registrovan"

#: libkgapi/auth_p.cpp:180
msgid "Authentication cancelled"
msgstr "Autentifikacija otkazana"

#: libkgapi/auth_p.cpp:232
msgid "Failed to parse newly fetched tokens"
msgstr "Neuspjelo parsiranje novo dobavljenih tokena"

#: libkgapi/common.h:100
msgid "An unknown error has occurred."
msgstr "Nepoznata greška se desila."

#: libkgapi/common.h:126
#, kde-format
msgid "Unknown account '%1'"
msgstr "Nepoznat nalog '%1'"

#: libkgapi/common.h:139
#, kde-format
