#: plugin_search.cpp:185
msgid ""
"Comma separated list of file types to search in. example: \"*.cpp,*.h\"\n"
"NOTE: Put a minus sign ('-') in front of the list to make it into an exclude "
"list. example: \"-*.o,*.obj\""
msgstr ""
"Zarezima razdvojena lista tipova datoteka za pretragu u primjeru: \"*.cpp,*.h"
"\"\n"
"NOTE: Ubaci minus znak ('-') da napraviš listom isključenja, na primjer: \"-"
"*.o,*.obj\""

