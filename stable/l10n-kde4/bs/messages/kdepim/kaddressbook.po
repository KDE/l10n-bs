#: xxport/vcard/vcard_xxport.cpp:611
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's other fields to the vCard "
"output file."
msgstr ""
"Čekirajte ovaj kvadratić ako želite da izvezete druga polja kontakta u vCard "
"izlaznu datoteku."

#: xxport/vcard/vcard_xxport.cpp:615
msgctxt "@option:check"
msgid "Encryption keys"
msgstr "Kriptografski ključevi"

#: xxport/vcard/vcard_xxport.cpp:617
msgctxt "@info:tooltip"
msgid "Export encryption keys"
msgstr "Eksporiraj izlazne ključeve"

#: xxport/vcard/vcard_xxport.cpp:620
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's encryption keys to the "
"vCard output file."
msgstr ""
"Čekirajte ovaj kvadratić ako želite uvesti šifrirane ključeve kontakta u "
"vCard izlaznu datoteku."

#: xxport/vcard/vcard_xxport.cpp:624
msgctxt "@option:check"
msgid "Pictures"
msgstr "Slike"

#: xxport/vcard/vcard_xxport.cpp:626
msgctxt "@info:tooltip"
msgid "Export pictures"
msgstr "Eksportiraj slike"

#: xxport/vcard/vcard_xxport.cpp:629
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's picture to the vCard "
"output file."
msgstr ""
"Čekirajte ovaj kvadratić ako želite da uvezet sliku kontakta u vCard izlaznu "
"datoteku."

#: xxport/vcard/vcard_xxport.cpp:634
msgctxt "@title:group"
msgid "Export options"
msgstr "Eksportiraj opcije"

#: xxport/vcard/vcard_xxport.cpp:638
msgctxt "@option:check"
msgid "Display name as full name"
msgstr "Prikaži ime kao puno ime"

#: xxport/vcard/vcard_xxport.cpp:640
msgctxt "@info:tooltip"
msgid "Export display name as full name"
msgstr "Eksportiraj naziv ekrana kao puni naziv"

#: xxport/vcard/vcard_xxport.cpp:643
msgctxt "@info:whatsthis"
msgid ""
"Check this box if you want to export the contact's display name in the "
"vCard's full name field.  This may be required to get the name shown "
"correctly in GMail or Android."
msgstr ""
"Označite ovu kućicu ako želite izvesti prikaza imena kontakta u vCar-ovom "
"punom imenu polju. To može biti potrebno da biste dobili ime prikazano "
"ispravno u GMail ili Android."

