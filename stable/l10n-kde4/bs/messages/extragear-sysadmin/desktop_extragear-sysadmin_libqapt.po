msgid "To install or remove software you need to authenticate."
msgstr "Za instalaciju ili uklanjanje softvera treba se autentificirati."

#: src/worker/qaptworker.actions:211
msgctxt "Name"
msgid "Change software configuration"
msgstr "Promjena softverske konfiguracije"

#: src/worker/qaptworker.actions:251
msgctxt "Description"
msgid "To change software settings you need to authenticate."
msgstr "Za promjenu postavku softvera treba se autentificirati."

#: src/worker/qaptworker.actions:294
msgctxt "Name"
msgid "Cancel the task of another user"
msgstr "Otkaži zadatak drugog korisnika"

#: src/worker/qaptworker.actions:334
msgctxt "Description"
msgid "To cancel someone else's software changes you need to authenticate."
msgstr "Za otkazivanje tuđih promjena softvera treba se autentificirati."

