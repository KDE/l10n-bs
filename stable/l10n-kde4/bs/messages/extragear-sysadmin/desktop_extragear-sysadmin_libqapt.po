msgid "Update package information"
msgstr "Ažuriraj paketske informacije"

#: src/worker/qaptworker.actions:85
msgctxt "Description"
msgid "To update the software catalog you need to authenticate."
msgstr "Za ažuriranje softverskog kataloga potrebna je autentifikacija."

#: src/worker/qaptworker.actions:128
msgctxt "Name"
msgid "Install or remove packages"
msgstr "Instalacija i pregled softverskih paketa"

#: src/worker/qaptworker.actions:168
