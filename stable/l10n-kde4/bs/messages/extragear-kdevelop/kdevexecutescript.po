msgstr "Projektno odredište:"

#. i18n: ectx: property (text), widget (QLabel, label_7)
#: scriptappconfig.ui:88
msgid "Interpreter:"
msgstr "Interpretator:"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: scriptappconfig.ui:104
msgid "Execute on Host"
msgstr "Izvrši na računaru"

#. i18n: ectx: property (text), widget (QRadioButton, localHostRadio)
#: scriptappconfig.ui:110
msgid "Local Host"
msgstr "Lokalni računar"

#. i18n: ectx: property (text), widget (QRadioButton, remoteHostRadio)
#: scriptappconfig.ui:120
msgid "Remote Host (ssh):"
msgstr "Udaljeni računar (ssh):"

#. i18n: ectx: property (clickMessage), widget (KLineEdit, remoteHost)
#: scriptappconfig.ui:130
msgid "Enter a remote host (user@example.com)"
msgstr "Unesi udaljeni računar (user@example.com)"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: scriptappconfig.ui:140
msgid "Behavior"
msgstr "Ponašanje"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: scriptappconfig.ui:146
msgid "Arguments:"
msgstr "Argumenti:"

#. i18n: ectx: property (toolTip), widget (KLineEdit, arguments)
#. i18n: ectx: property (clickMessage), widget (KLineEdit, arguments)
#: scriptappconfig.ui:156 scriptappconfig.ui:159
msgid "Enter arguments to give to the executable"
msgstr "Unesi argumente koji se prosljeđuju izvršnom programu"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#: scriptappconfig.ui:166
msgid "Working Directory:"
msgstr "Radni direktorij:"

#. i18n: ectx: property (toolTip), widget (KUrlRequester, workingDirectory)
#. i18n: ectx: property (clickMessage), widget (KUrlRequester, workingDirectory)
#: scriptappconfig.ui:176 scriptappconfig.ui:179
msgid "Select a working directory for the executable"
msgstr "Odaberi radni direktorij za izvršni program"

#. i18n: ectx: property (text), widget (QLabel, label_5)
#: scriptappconfig.ui:186
msgid "Environment:"
msgstr "Okruženje:"

#. i18n: ectx: property (toolTip), widget (KDevelop::EnvironmentSelectionWidget, environment)
#: scriptappconfig.ui:196
msgid "Select an environment to be used"
msgstr "Odaberite okruženje koje će se koristiti"

#: scriptappjob.cpp:88
#, kde-format
msgid ""
"No environment group specified, looks like a broken configuration, please "
"check run configuration '%1'. Using default environment group."
msgstr ""
"Nema grupe okruženja, izgleda kao slomljena konfiguracija, molimo provjerite "
"aktivnu konfiguraciju \"%1\". Koristi se podrazumijevana grupa okruženja."

#: scriptappjob.cpp:155
#, kde-format
msgid "Starting: %1"
msgstr "Pokrećem: %1"

#: scriptappjob.cpp:169
msgid "*** Killed Application ***"
msgstr "*** Ubijen program ***"

#: scriptappjob.cpp:179
msgid "*** Exited normally ***"
msgstr "*** Normalan izlaz ***"

#: scriptappjob.cpp:182
#, kde-format
msgid "*** Exited with return code: %1 ***"
msgstr "*** Izlaz s povratnim kodom: %1 ***"

#: scriptappjob.cpp:185
msgid "*** Process aborted ***"
msgstr "*** Proces prekinut ***"

#: scriptappjob.cpp:187
#, kde-format
msgid "*** Crashed with return code: %1 ***"
msgstr "*** Krah s izlaznim kodom: %1 ***"

#: scriptappjob.cpp:200
#, kde-format
msgid ""
"Could not start program '%1'. Make sure that the path is specified correctly."
msgstr ""
"Ne mogu pokrenuti program '%1'. Provjerite da li je staza pravilno navedena."

#: scriptappjob.cpp:202
msgid "Could not start application"
msgstr "Ne mogu pokrenuti program"
