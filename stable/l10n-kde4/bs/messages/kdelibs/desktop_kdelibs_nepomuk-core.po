#: server/nepomukserver.desktop:8
msgctxt "Name"
msgid "Nepomuk Server"
msgstr "Server Nepomuka"

#: server/nepomukserver.desktop:51
msgctxt "Comment"
msgid "The Nepomuk Server providing Storage services and strigi controlling"
msgstr "Server Nepomuka pruža servis za skladištenje i kontrolu Strigija"

#: server/nepomukservice.desktop:4
msgctxt "Comment"
msgid "Nepomuk Service"
msgstr "Servis Nepomuka"

#: services/backupsync/gui/nepomukbackup.desktop:2
msgctxt "Name"
msgid "Nepomuk Backup"
msgstr "Rezerva Nepomuka"

#: services/backupsync/service/nepomukbackupsync.desktop:8
msgctxt "Name"
msgid "Nepomuk Backup and Sync"
msgstr "Rezerva i sinhronizacija Nepomuka"

#: services/backupsync/service/nepomukbackupsync.desktop:51
msgctxt "Comment"
msgid "Nepomuk Service which handles backup and sync."
msgstr "Servis Nepomuka za pravljenje rezervi i sinhronizaciju."

#: services/fileindexer/nepomukfileindexer.desktop:7
msgctxt "Name"
msgid "File Indexer Service"
msgstr "Usluga za indeksiranje datoteka"

#: services/fileindexer/nepomukfileindexer.desktop:50
msgctxt "Comment"
msgid "Nepomuk Service which indexes files on the desktop"
msgstr "Nepomuk usluga koja indeksira datoteke na radnoj površini"

#: services/fileindexer/nepomukfileindexer.notifyrc:3
msgctxt "Comment"
msgid "Desktop Search"
msgstr "Pretraga površi"

#: services/fileindexer/nepomukfileindexer.notifyrc:48
msgctxt "Name"
msgid "Initial Indexing started"
msgstr "Započeto početno indeksiranje"

#: services/fileindexer/nepomukfileindexer.notifyrc:91
msgctxt "Comment"
msgid "Indexing of local files for fast searches has started."
msgstr "Započeto je indeksiranje lokalnih datoteka radi brze pretrage."

#: services/fileindexer/nepomukfileindexer.notifyrc:137
msgctxt "Name"
msgid "Initial Indexing finished"
msgstr "Završeno početno indeksiranje"

#: services/fileindexer/nepomukfileindexer.notifyrc:180
msgctxt "Comment"
msgid ""
"The initial indexing of local files for fast desktop searches has completed."
msgstr ""
"Završeno je početno indeksiranje lokalnih datoteka radi brze pretrage površi."

#: services/fileindexer/nepomukfileindexer.notifyrc:226
msgctxt "Name"
msgid "Indexing suspended"
msgstr "Indeksiranje suspendovano"

#: services/fileindexer/nepomukfileindexer.notifyrc:269
msgctxt "Comment"
msgid "File indexing has been suspended by the search service."
msgstr "Servis pretrage je suspendovao indeksiranje datoteka."

#: services/fileindexer/nepomukfileindexer.notifyrc:315
msgctxt "Name"
msgid "Indexing resumed"
msgstr "Indeksiranje nastavljeno"

#: services/fileindexer/nepomukfileindexer.notifyrc:358
msgctxt "Comment"
msgid "File indexing has been resumed by the search service."
msgstr "Servis pretrage je nastavio indeksiranje datoteka."

#: services/filewatch/nepomukfilewatch.desktop:7
msgctxt "Name"
msgid "NepomukFileWatch"
msgstr "Nepomukov nadzor datoteka"

#: services/filewatch/nepomukfilewatch.desktop:50
msgctxt "Comment"
msgid "The Nepomuk file watch service for monitoring file changes"
msgstr "Nepomukov servis za nadgledanje izmjena nad datotekema"

#: services/filewatch/nepomukfilewatch.notifyrc:3
msgctxt "Comment"
msgid "Nepomuk file watch service"
msgstr "Servis Nepomuka"

#: services/filewatch/nepomukfilewatch.notifyrc:48
msgctxt "Name"
msgid "New Removable Device"
msgstr "Uklonjivi uređaji"

#: services/filewatch/nepomukfilewatch.notifyrc:91
msgctxt "Comment"
msgid "A new unknown removable device has been mounted"
msgstr "Novi nepoznati uklonjivi uređaj je montiran"

#: services/queryservice/nepomukqueryservice.desktop:7
msgctxt "Name"
msgid "NepomukQueryService"
msgstr "Servis Nepomukovih upita"

#: services/queryservice/nepomukqueryservice.desktop:50
msgctxt "Comment"
msgid ""
"The Nepomuk Query Service provides an interface for persistent query folders"
msgstr "Servis Nepomukovih upita pruža sučelje za trajne upitne fascikle"

#: services/storage/nepomukstorage.desktop:7
msgctxt "Name"
msgid "Nepomuk Data Storage"
msgstr "Nepomukovo skladište"

#: services/storage/nepomukstorage.desktop:50
msgctxt "Comment"
msgid "The Core Nepomuk data storage service"
msgstr "Osnovni servis Nepomuka za skladištenje podataka"

#: services/storage/nepomukstorage.notifyrc:3
msgctxt "Name"
msgid "Semantic Data Storage"
msgstr "Semantičko skladištenje podataka"

#: services/storage/nepomukstorage.notifyrc:46
msgctxt "Comment"
msgid "Semantic Desktop"
msgstr "Semantička radna površina"

#: services/storage/nepomukstorage.notifyrc:91
msgctxt "Name"
msgid "Failed to start Nepomuk"
msgstr "Neuspelo pokretanje Nepomuka"

#: services/storage/nepomukstorage.notifyrc:134
msgctxt "Comment"
msgid "The Nepomuk Semantic Desktop system could not be started"
msgstr "Sistem semantičke površi Nepomuk ne može da se pokrene"

#: services/storage/nepomukstorage.notifyrc:180
msgctxt "Name"
msgid "Converting Nepomuk data"
msgstr "Pretvaram Nepomukove podatke"

#: services/storage/nepomukstorage.notifyrc:223
msgctxt "Comment"
msgid "All Nepomuk data is converted to a new storage backend"
msgstr "Svi Nepomukovi podaci su pretvoreni za novu skladišnu pozadinu"

#: services/storage/nepomukstorage.notifyrc:269
msgctxt "Name"
msgid "Converting Nepomuk data failed"
msgstr "Propalo pretvaranje Nepomukovih podataka"

#: services/storage/nepomukstorage.notifyrc:312
msgctxt "Comment"
msgid "Converting Nepomuk data to a new backend failed"
msgstr "Pretvaranje Nepomukovih podataka za novu pozadinu nije uspelo"

#: services/storage/nepomukstorage.notifyrc:358
msgctxt "Name"
msgid "Converting Nepomuk data done"
msgstr "Gotovo pretvaranje Nepomukovih podataka"

#: services/storage/nepomukstorage.notifyrc:401
msgctxt "Comment"
msgid "Successfully converted Nepomuk data to new backend"
msgstr "Nepomukovi podaci su uspješno pretvoreni za novu pozadinu"
