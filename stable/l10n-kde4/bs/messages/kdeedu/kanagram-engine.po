#. i18n: ectx: label, entry (currentCategory), group (kanagram)
#: kanagram.kcfg:9
msgid "This settings stores the currently selected Category"
msgstr "Ove postavke smiještaju trenutno odabranu kategoriju"

#. i18n: ectx: label, entry (hintHideTime), group (kanagram)
#: kanagram.kcfg:13
msgid ""
"This setting allows you to set in seconds how long Kanagram's hint bubble is "
"shown."
msgstr ""
"Ova postavka navodi koliko sekundi će KHangMan savjet u balončiću biti "
"prikazan"

#. i18n: ectx: label, entry (resolveTime), group (kanagram)
#: kanagram.kcfg:17
msgid ""
"This setting allows you to set in seconds how much time is available for "
"resolving the anagram."
msgstr ""
"Ova postavka omogućava postavljanje broja sekundi za razrješenje anagrama."

#. i18n: ectx: label, entry (useSounds), group (kanagram)
#: kanagram.kcfg:21
msgid "Turns sounds on/off."
msgstr "Uključuje i isključuje zvukove."

#. i18n: ectx: label, entry (defaultVocabulary), group (kanagram)
#: kanagram.kcfg:25
msgid "Set the default vocabulary"
msgstr "Postaviti uobičajeni rječnik?"

#. i18n: ectx: label, entry (dataLanguage), group (kanagram)
#: kanagram.kcfg:29
msgid "Set the default translation"
msgstr "Postaviti uobičajeni prijevod?"

#: kanagramgame.cpp:214
msgid "No hint"
msgstr "Nema savjeta"

#: kanagramgame.cpp:301
msgctxt "@item:inlistbox no language for that locale"
msgid "None"
msgstr "Ništa"
