#: data/ktelepathy.notifyrc:3
msgctxt "Name"
msgid "Instant messaging"
msgstr "Instant poruke"

#: data/ktelepathy.notifyrc:46
msgctxt "Comment"
msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:91
msgctxt "Name"
msgid "Group"
msgstr "Grupa"

#: data/ktelepathy.notifyrc:135
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Grupa u kojoj kontakt prebivaju"

#: data/ktelepathy.notifyrc:180
msgctxt "Name"
msgid "Contact"
msgstr "Kontakt"

#: data/ktelepathy.notifyrc:224
msgctxt "Comment"
msgid "The specified contact"
msgstr "Određeni kontakt"

#: data/ktelepathy.notifyrc:269
msgctxt "Name"
msgid "Class"
msgstr "Klasa"

#: data/ktelepathy.notifyrc:313
msgctxt "Comment"
msgid "The message class"
msgstr "Klasa poruke"

#: data/ktelepathy.notifyrc:361
msgctxt "Name"
msgid "Instant messaging error"
msgstr "Greška u instant porukama"

#: data/ktelepathy.notifyrc:403
msgctxt "Comment"
msgid "An error occurred within instant messaging"
msgstr "Greška unutar instant porukaa"

#: data/ktelepathy.notifyrc:450
msgctxt "Name"
msgid "Instant messaging info message"
msgstr "Informativna poruka kod instant poruka"

#: data/ktelepathy.notifyrc:492
msgctxt "Comment"
msgid "A general info message from instant messaging"
msgstr "Opšta informativna poruka kod instant poruka"

#: data/ktelepathy.notifyrc:541
msgctxt "Name"
msgid "Incoming Message"
msgstr "Dolazeća Poruka"

#: data/ktelepathy.notifyrc:585
msgctxt "Comment"
msgid "An incoming message has been received"
msgstr "Dolazeća poruka je primljena"

#: data/ktelepathy.notifyrc:635
msgctxt "Name"
msgid "Incoming Message in Active Chat"
msgstr "Dolazeća poruka u aktivnom ćaskanju"

#: data/ktelepathy.notifyrc:678
msgctxt "Comment"
msgid "An incoming message in the active chat window has been received"
msgstr "Dolazeća poruka u aktivnom časkanju je primljena"

#: data/ktelepathy.notifyrc:727
msgctxt "Name"
msgid "Incoming Message in Group Chat"
msgstr "Dolazeća poruka u grupnom ćaskanju"

#: data/ktelepathy.notifyrc:762
msgctxt "Comment"
msgid "An incoming message has been received in a group chat"
msgstr "Dolazeća poruka je primljena u grupnom ćaskanju"

#: data/ktelepathy.notifyrc:804
msgctxt "Name"
msgid "Incoming Message in Active Group Chat"
msgstr "Dolazeća poruka u aktivnom grupnom ćaskanju"

#: data/ktelepathy.notifyrc:839
msgctxt "Comment"
msgid "An incoming message in the active group chat window has been received"
msgstr "Dolazeća poruka u prozoru aktivnog grupnog ćaskanja je primljena"

#: data/ktelepathy.notifyrc:881
msgctxt "Name"
msgid "Outgoing Message"
msgstr "Odlazna poruka"

#: data/ktelepathy.notifyrc:924
msgctxt "Comment"
msgid "An outgoing message has been sent"
msgstr "Odlazna poruka je poslana"

#: data/ktelepathy.notifyrc:973
msgctxt "Name"
msgid "Highlight in Group Chat"
msgstr "Označi u grupnom ćaskanju"

#: data/ktelepathy.notifyrc:1008
msgctxt "Comment"
msgid "A highlighted message has been received in a group chat"
msgstr "Primljena je označena poruka u grupnom ćaskanju"

#: data/ktelepathy.notifyrc:1049
msgctxt "Name"
msgid "Highlight in Active Group Chat"
msgstr "Označi u aktivnom grupnom ćaslamki"

#: data/ktelepathy.notifyrc:1084
msgctxt "Comment"
msgid "A highlighted message has been received in the active group chat window"
msgstr "Primljena je označena poruka u prozoru grupnog ćaslanja"

#: data/ktelepathy.notifyrc:1125
msgctxt "Name"
msgid "Message Dropped"
msgstr "Poruka je ispuštena"

#: data/ktelepathy.notifyrc:1168
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "Poruka je filtrirana pomoću priključka za privatnost"

#: data/ktelepathy.notifyrc:1215
msgctxt "Name"
msgid "Service Message"
msgstr "Servisna poruka"

#: data/ktelepathy.notifyrc:1258
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr "Servisna poruka je primljena (npr. zahtijev za ovlaštenje)"

#: data/ktelepathy.notifyrc:1308
msgctxt "Name"
msgid "New incoming chat"
msgstr "Novo dolazno ćaskanje"

#: data/ktelepathy.notifyrc:1350
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "Nova instantna poruka je primljena"

#: data/ktelepathy.notifyrc:1397
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "Dolazni transfer datoteke"

#: data/ktelepathy.notifyrc:1439
msgctxt "Comment"
msgid "An incoming file transfer request has been received"
msgstr "Primljen je zahtjev za dolaznu datoteku"

#: data/ktelepathy.notifyrc:1487
msgctxt "Name"
msgid "Incoming call"
msgstr "Dolazni poziv"

#: data/ktelepathy.notifyrc:1529
msgctxt "Comment"
msgid "An incoming audio/video call request has been received"
msgstr "Dolazni audio/video poziv je primljen"

#: data/ktelepathy.notifyrc:1579
msgctxt "Name"
msgid "Chatstyle Install Request"
msgstr "Zahtjev za instalaciju stila ćaskanja"

#: data/ktelepathy.notifyrc:1626
msgctxt "Name"
msgid "Chatstyle Installed Successfully"
msgstr "Stil ćaskanja uspješno instaliran"

#: data/ktelepathy.notifyrc:1673
msgctxt "Name"
msgid "Chatstyle Installation Failed"
msgstr "Neuspješna instalacija stila ćaskanja"

#: data/ktelepathy.notifyrc:1720
msgctxt "Name"
msgid "Emoticonset Install Request"
msgstr "Zahtjev za instalaciju skupa emotikona"

#: data/ktelepathy.notifyrc:1767
msgctxt "Name"
msgid "Emoticonset Installed Successfully"
msgstr "Uspješna instalacija skupa emotikona"

#: data/ktelepathy.notifyrc:1815
msgctxt "Name"
msgid "Emoticonset Installation failed"
msgstr "Neuspješna instalacija skupa emotikona"

#: data/ktelepathy.notifyrc:1861
msgctxt "Name"
msgid "Contact status changed"
msgstr "Status kontakta promijenjen"

#: data/ktelepathy.notifyrc:1902
msgctxt "Comment"
msgid "A contact has changed their status"
msgstr "Kontaknta osoba promijenila je status"

#: data/ktelepathy.notifyrc:1947
msgctxt "Name"
msgid "File renamed for sending with Google Talk"
msgstr "Datoteka preimenovana za slanje s Google Talk"

#: data/ktelepathy.notifyrc:1981
msgctxt "Comment"
msgid "An outgoing file with forbidden extension .exe or .ini has been renamed"
msgstr "Izlazna datoteka s zabranjenom ekstenzijom .exe ili .ini je preimenovana"

