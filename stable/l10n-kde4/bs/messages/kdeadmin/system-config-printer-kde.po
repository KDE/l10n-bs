#. i18n: file: new-printer.ui:595
#. i18n: ectx: property (text), widget (QLabel, label_27)
#: ui.py:123
msgid ""
"The foomatic printer database contains various manufacturer provided "
"PostScript Printer Description (PPD) files and also can generate PPD files "
"for a large number of (non PostScript) printers. But in general manufacturer "
"provided PPD files provide better access to the specific features of the "
"printer."
msgstr ""
"Foomatic baza podataka štampača obuhvaća razne PPD datoteke proizvođača "
"(PostScript opis štampača) i može generirati PPD datoteke za veliki broj "
"štampača koji nisu u PostScript standardu. Općenito, PPD datoteke izrađene "
"od strane proizvođača pružaju bolji pristup određenim osobinama štampača."

