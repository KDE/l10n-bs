#: src/MainWindow.cpp:777
msgid "Imports another library appending the symbols it contains to the current library."
msgstr "Uvoz druge biblioteke uz simbole koje sadrži u trenutnu biblioteku."

#: src/MainWindow.cpp:782
msgid "Save Symbol"
msgstr "Snimi simbol"

#: src/MainWindow.cpp:783
msgid "Save the symbol to the library. If this is a new symbol, subsequent saves will create additional symbols in the library. If the symbol was selected from the library to edit then saving will update that symbol in the library."
msgstr "Snimi simbol u biblioteku. Ako je ovo novi simbol, naknadno snimanje će kreirati dodatne simbole u biblioteku. Ako je simbol za uređivanje odabran iz biblioteke onda će snimanje ažurirati taj simbol u biblioteku."

#: src/MainWindow.cpp:789
msgid "Save Symbol as New"
msgstr "Snimi simbol kao novi"

#: src/MainWindow.cpp:790
msgid "Save the current symbol as a new one in the library. Subsequent saves will update the new symbol."
msgstr "Snimi trenutni simbol kao novi u biblioteku. Naknadna snimanja će ažurirati novi simbol."

#: src/MainWindow.cpp:803
msgid "Fill Path"
msgstr "Popuni put"

#: src/MainWindow.cpp:804
msgid "Enable path filling. The path defines the closed boundary of the shape and the path is filled with the selected fill method."
msgstr "Dozvoli popunjavanje puta. Put definiše zatvorene granice oblika i put je popunjen sa odabranom metodom za popunjavanje."

#: src/MainWindow.cpp:814
msgid "Odd Even Fill"
msgstr "Odd Even Fill"

#: src/MainWindow.cpp:815
msgid "The Odd Even fill method will fill alternate areas of the symbol."
msgstr "The Odd Even metod popunjavanja će popuniti alternativne oblasti simbola."

#: src/MainWindow.cpp:823
msgid "Winding Fill"
msgstr "Vijugavo punjenje"

#: src/MainWindow.cpp:824
msgid "The Winding fill method will fill the complete interior of the path."
msgstr "Vijugava metoda punjenja će popuniti čitavu unutrašnjost puta."

#: src/MainWindow.cpp:837
msgid "Flat Cap"
msgstr "Ravni završetak"

#: src/MainWindow.cpp:838
msgid ""
"The Flat Cap end type provides a square end that stops at the end point of the line.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Ravni završetak kao tip kraja obezbjeđuje krajnji kvadrat koji se zaustavlja na krajnjoj tački linije.\n"
"\n"
"Ovo je primjenjivo samo za nepopunjene putanje."

#: src/MainWindow.cpp:846
msgid "Square Cap"
msgstr "Četvrtasti završetak"

#: src/MainWindow.cpp:847
msgid ""
"The Square Cap end type provides a square end that projects beyond the end point of the line by half the line width.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Četvrtasti tip kraja obezbjeđuje kvadratni završetak koji se projicira iza krajnje tačke linije za polovinu debljine linije.\n"
"\n"
"Ovo je primjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:855
msgid "Round Cap"
msgstr "Okrugli završetak"

#: src/MainWindow.cpp:856
msgid ""
"The Round Cap end type provides a round end that projects beyond the end point of the line with a radius of half the line width.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Okrugli završetak tip kraja obezbjeđuje okrugli kraj koji stvara iznad krajnje tačke linije sa poluprečnikom od polovine debljine linije.\n"
"\n"
"Ovo je primjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:869
msgid "Bevel Join"
msgstr "Kosi spoj"

#: src/MainWindow.cpp:870
msgid ""
"The Bevel Join provides a beveled corner between two lines.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Kosi spoj obezbjeđuje kosi ugao između dvije linije.\n"
"\n"
"Ovo je primjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:878
msgid "Miter Join"
msgstr "Pravougli spoj"

#: src/MainWindow.cpp:879
msgid ""
"The Miter Join provides a mitered corner between two lines.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Pravougli spoj obezbjeđuje pravi ugao između dvije linije.\n"
"\n"
"Ovo je primjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:887
msgid "Round Join"
msgstr "Kružni spoj"

#: src/MainWindow.cpp:888
msgid ""
"The Round Join provides a rounded corner between two lines using a radius of half the line width.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Kružni spoj obezbjeđuje zaobljeni ugao između dvije linije koristeći poluprečnik od polovine debljine linije.\n"
"\n"
"Ovo je primjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:899
msgid ""
"Increases the line width.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Povećava debljinu linije.\n"
"\n"
"Ovo je pimjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:906
msgid ""
"Decreases the line width.\n"
"\n"
"This is only applicable to non-filled paths."
msgstr ""
"Smanjuje debljinu linije.\n"
"\n"
"Ovo je pimjenjivo samo na neispunjene puteve."

#: src/MainWindow.cpp:917
msgid "Move the current point to a new position. This implicitly closes any existing sub path, starting a new one."
msgstr "Pomjeri trenutnu tačku na novu poziciju. Ovo implicitno zatvara sve postojeće podstaze, uz započinjanje nove."

#: src/MainWindow.cpp:926
msgid "Add a straight line from the current position to a defined end point. The end point becomes the new current position."
msgstr "Dodaj pravu liniju iz trenutne pozicije u definisanu krajnju tačku. Krajnja tačka postaje nova trenutna pozicija."

#: src/MainWindow.cpp:935
msgid "Add a cubic bezier curve from the current position using two control points and an end point. The end point becomes the new current position."
msgstr "Dodaj kubičnu Bezierovu krivu iz trenutne pozicije koristeći dvije kontrolne tačke i krajnju tačku. Krajnja tačka postaje nova trenutna pozicija."

#: src/MainWindow.cpp:943
msgid "Rectangle"
msgstr "Pravougaonik"

#: src/MainWindow.cpp:944
msgid "Add a rectangle as a separate sub path defined by two points representing the opposite corners."
msgstr "Dodaj pravougaonik kao razdvojeni podput definisan sa dvije tačke koje predstavljaju suprotne uglove."

#: src/MainWindow.cpp:952
msgid "Ellipse"
msgstr "Elipsa"

#: src/MainWindow.cpp:953
msgid "Add an ellipse as a separate sub path defined by a bounding rectangle represented by two opposite corners."
msgstr "Dodaj elipsu kao razdvojeni podput definisan sa graničnim pravougaonikom predstavljenim sa dva suprotna ugla."

#: src/MainWindow.cpp:961
msgid "Insert Character"
msgstr "Ubaci Znak"

#: src/MainWindow.cpp:962
msgid "Allows selection of a character from any font to be inserted as a closed sub path. The inserted character will overwrite any existing path, but additional sub paths may be added to the character."
msgstr "Dozvoli izbor karaktera iz bilo kojeg fonta za ubacivanje kao zatvorenog podputa. Ubačeni karakter će zamijeniti bilo koji postojeći put, ali dodatno podputevi mogu biti dodani karakteru."

#: src/MainWindow.cpp:973
msgid "Rotate all the points of a path counter-clockwise 90 degrees around the center of the editor."
msgstr "Zarotiraj svetačke puta za 90 stepeni suprotno od smjera kazaljke na satu oko sredine uređivača."

#: src/MainWindow.cpp:980
msgid "Rotate all the points of a path clockwise 90 degrees around the center point of the editor."
msgstr "Zarotiraj sve tačke puta za 90 stepeni u smjeru kazaljke na satu oko središne tačke uređivača."

#: src/MainWindow.cpp:987
msgid "Flip all the points of the path horizontally about the vertical center of the editor."
msgstr "Okreni sve tačke puta vodoravno oko vertikalne sredine uređivača."

#: src/MainWindow.cpp:994
msgid "Flip all the points of the path vertically about the horizontal center of the editor."
msgstr "Okreni sve tačke puta uspravno oko vodoravne sredine uređivača."

#: src/MainWindow.cpp:1001
msgid "Scale the current symbol so that it fits within the preferred size of a symbol."
msgstr "Promijeni trenutni simbol tako da odgovara željenoj veličini simbola."

#: src/MainWindow.cpp:1007
msgid "Enable Snap"
msgstr "Dozvoli naglu promjenu"

#: src/MainWindow.cpp:1008
msgid "Enable snapping of points to guide intersections or to the grid."
msgstr "Dozvoli naglu promjenu tačaka da bi vodile do presjecanja ili rešetke."

#: src/MainWindow.cpp:1015
msgid "Enable Guides"
msgstr "Dozvoli vodiče"

#: src/MainWindow.cpp:1016
msgid "Enable the generation of quide intersections."
msgstr "Dozvoli generisanje križanja vodiča."

