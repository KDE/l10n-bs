#: guitest/main.cpp:37 main.cpp:40
msgid "NepomukBackup"
msgstr "NepomukBackup"

#: guitest/main.cpp:39 main.cpp:42
msgid "Nepomuk Backup Tool"
msgstr "Nepomuk alat za rezervne kopije"

#: guitest/main.cpp:41 main.cpp:44
msgid "(c) 2010, Nepomuk-KDE Team"
msgstr "(c) 2010, Nepomuk-KDE Team"

#: guitest/main.cpp:44 main.cpp:47
msgid "Vishesh Handa"
msgstr "Vishesh Handa"

#: guitest/main.cpp:44 main.cpp:47
msgid "Maintainer"
msgstr "Održava"

#: guitest/main.cpp:45 main.cpp:48
msgid "Sebastian Trüg"
msgstr "Sebastian Trüg"

#: guitest/main.cpp:45 main.cpp:48
msgid "Developer"
msgstr "Glavni programer"

#: guitest/main.cpp:50 main.cpp:53
msgid "Start the application in backup mode"
msgstr "Pokreni program u režimu kopiranja"

#: guitest/main.cpp:51 main.cpp:54
msgid "Start the application in restore mode"
msgstr "Pokreni program u režimu obnove"

#: main.cpp:72
msgctxt "@info"
msgid ""
"The Nepomuk backup service does not seem to be running. Backups cannot be "
"handled without it."
msgstr ""
"Servis za Nepomuk rezervne kopije ne izgleda aktivan. Rezervne kopije se ne "
"mogu odrediti bez njega."

#: mergeconflictdelegate.cpp:60
msgctxt "@action:button Resolve the conflict in this row"
msgid "Resolve..."
msgstr "Razriješi..."

#: mergeconflictdelegate.cpp:62
msgctxt "@action:button Discard the item in this row"
msgid "Discard"
msgstr "Odbaci"

#: mergeconflictdelegate.cpp:195
#, kde-format
msgctxt ""
"@item:inlistbox Refers to a set of metadata that has been identified as "
"beloging to file file at %1. %1 is a URL or part of it."
msgid "Identified as: %1"
msgstr "Identifikovano kao: %1"

#: mergeconflictdelegate.cpp:203
msgctxt ""
"@item:inlistbox The item in this row has been discarded, ie. should be "
"ignored in the following steps"
msgid "Discarded"
msgstr "Odbačeno"

#: mergeconflictdelegate.cpp:207
msgctxt ""
"@item:inlistbox The item in this row has not been identified yet, ie. the "
"file corresponding to it has not been chosen yet."
msgid "Not identified"
msgstr "Nije identifikovano"

#: backupwizardpages.cpp:43 backupwizardpages.cpp:66 backupwizardpages.cpp:249
msgid "Nepomuk Backup"
msgstr "Nepomuk Backup"

#: backupwizardpages.cpp:44
msgid "Please choose one of the following options"
msgstr "Odaberite jednu od sljedećih opcija"

#: backupwizardpages.cpp:67
msgid "Performing backup"
msgstr "Obavljam kopiranje"

#: backupwizardpages.cpp:81
#, kde-format
msgctxt "@info"
msgid "Writing Nepomuk database backup to <filename>%1</filename>..."
msgstr "Pišem kopiju Nepomuk baze u <filename>%1</filename>..."

#: backupwizardpages.cpp:99
#, kde-format
msgctxt "@info"
msgid ""
"Backup of the Nepomuk database successfully written to <filename>%1</"
"filename>."
msgstr "Kopija Nepomuk baze uspješno upisana u <filename>%1</filename>."

#: backupwizardpages.cpp:101
msgid "Backup completed successfully"
msgstr "Kopiranje uspješno obavljeno"

#: backupwizardpages.cpp:127
msgctxt "@info"
msgid "No system backups found. Please select a custom backup path."
msgstr ""
"Nijedn sistemska rezervna kopija nije pronađena. Molimo Vas da izaberete "
"prilagođenu putanju rezervne kopije."

#: backupwizardpages.cpp:181
msgid "Restoring Backup"
msgstr "Obnova rezervne kopije"

#: backupwizardpages.cpp:182
msgid "The backup is being restored..."
msgstr "Rezervna kopija je obnovljena"

#: backupwizardpages.cpp:210
msgid "Invalid backup file"
msgstr "Pogrešna datoteka rezervne kopije"

#: backupwizardpages.cpp:250
msgid "Please configure the Nepomuk backup"
msgstr "Molim konfigurišite Nepomuk program za kopiranje"

#: backupwizardpages.cpp:290
msgctxt "@info"
msgid "Merging the backup into the local Nepomuk database..."
msgstr "Spajanje rezervne kopije u lokalnu Nepomuk bazu podataka..."

#: backupwizardpages.cpp:307
msgctxt "@info"
msgid "Backup restored successfully"
msgstr "Rezervna kopija uspješno vraćena"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Samir Ribić"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "megaribi@epn.ba"

#. i18n: file: errorpage.ui:14
#. i18n: ectx: property (windowTitle), widget (QWizardPage, ErrorPage)
#: rc.cpp:5
msgid "WizardPage"
msgstr "WizardPage"

#. i18n: file: mergeconflictwidget.ui:20
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:8
msgid ""
"Not all files in the backup could be identified. Please resolve the "
"conflicts by choosing the corresponding file or discarding the data."
msgstr ""
"Ne mogu sve datoteke u rezervnoj kopiji biti identifikovane. Molim "
"razriješite konflikte izborom odgovarajuće datoteke ili odbacivanjem "
"podataka."

#. i18n: file: mergeconflictwidget.ui:62
#. i18n: ectx: property (text), widget (KPushButton, m_buttonDiscardAll)
#: rc.cpp:11
msgid "Discard All"
msgstr "Odbaci sve"

#. i18n: file: restorefinal.ui:6
#. i18n: ectx: property (title), widget (QWizardPage, RestoreFinal)
#: rc.cpp:14
msgid "Restoring the Backup"
msgstr "Vraćanje rezervne kopije"

#. i18n: file: restorefinal.ui:9
#. i18n: ectx: property (subTitle), widget (QWizardPage, RestoreFinal)
#: rc.cpp:17
msgid "Please wait while the backup is being restored"
msgstr "Molim sačekajte dok se rezervna kopija vrati"

#. i18n: file: backupsettingspage.ui:20
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:20
msgid "Backup Path"
msgstr "Putanja za rezervne kopije"

#. i18n: file: backupsettingspage.ui:26
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:23
msgctxt "@info"
msgid ""
"Please choose a file for the backup. Make sure that enough hard disk space "
"is available."
msgstr ""
"Molimo vas odaberite datoteku za pravljenje rezervnih kopija. Provjerite da "
"li dovoljno prostora na čvrstom disku na raspolaganju."

#. i18n: file: intropage.ui:44
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:26
msgctxt "@info"
msgid ""
"Create a backup of the current Nepomuk database including all manually "
"created data. This backup can later be restored by choosing the "
"<interface>Restore</interface> option below."
msgstr ""
"Kreira rezervnu kopiju trenutne Nepomuk baze podataka uključujući sve ručno "
"kreirane podatke. Ova rezervna kopija se kasnije može obnoviti izborom "
"opcije <interface>Obnovi</interface> navedene dolje."

#. i18n: file: intropage.ui:120
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:29
msgctxt "@info"
msgid ""
"Restore an automated Nepomuk system backup or a manual backup created with "
"the <interface>Backup</interface> tool above."
msgstr ""
"Obnovi automatizirani Nepomuk sistemsku kopiju ili ručnu kopiju kreiranu s "
"gore navedenim alatom za rezervne kopije."

#. i18n: file: restoreselection.ui:6
#. i18n: ectx: property (title), widget (QWizardPage, RestoreSelection)
#: rc.cpp:32
msgid "Restore Nepomuk Database"
msgstr "Obnovi Nepomuk bazu"

#. i18n: file: restoreselection.ui:9
#. i18n: ectx: property (subTitle), widget (QWizardPage, RestoreSelection)
#: rc.cpp:35
msgid ""
"Please choose a backup from a list of known backups below. Or choose a "
"custom backup path."
msgstr ""
"Odaberite rezervnu kopiju iz liste poznatih rezervnih kopija. Ili odaberite "
"vlastitu stazu za rezervnu kopiju."

#. i18n: file: restoreselection.ui:18
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:38
msgctxt "@info"
msgid ""
"Please select one of the system backups generated by the Nepomuk backup "
"service or choose a custom backup file which has been created by this tool."
msgstr ""
"Molimo Vas da izaberete jednu od rezervnih kopija sistema koje generiše "
"Nepomuk servis ili izaberite prilagođenu backup datoteku koja je kreirana od "
"strane ove alatke."

#. i18n: file: restoreselection.ui:53
#. i18n: ectx: property (text), widget (KPushButton, m_customBackupButton)
#: rc.cpp:41
msgid "Open Backup..."
msgstr "Otvori rezervnu kopiju..."
