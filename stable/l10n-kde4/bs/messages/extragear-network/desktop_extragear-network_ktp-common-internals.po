msgctxt "Comment"
msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:85
msgctxt "Name"
msgid "Group"
msgstr "Grupa"

#: data/ktelepathy.notifyrc:126
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Grupa u kojoj kontakt prebivaju"

#: data/ktelepathy.notifyrc:168
msgctxt "Name"
msgid "Contact"
msgstr "Kontakt"

#: data/ktelepathy.notifyrc:209
msgctxt "Comment"
msgid "The specified contact"
msgstr "Određeni kontakt"

#: data/ktelepathy.notifyrc:251
msgctxt "Name"
msgid "Class"
msgstr "Klasa"

#: data/ktelepathy.notifyrc:292
msgctxt "Comment"
msgid "The message class"
