#: src/applet/tabletapplet.cpp:127
msgid "Error - Tablet service not available."
msgstr "Greška - Tablet usluga nije dostupna."

#: src/applet/tabletapplet.cpp:128
msgid ""
"Please start the KDE wacom tablet service.\n"
"The service is required for tablet detection and profile support."
msgstr ""
"Molimo započnite KDE wacom tablet uslugu.\n"
"Usluga je potrebna za detekciju tableta i podršku profila."

#: src/applet/tabletapplet.cpp:368
msgid "Select Profile:"
msgstr "Izaberite profil:"

#: src/applet/tabletapplet.cpp:386
msgctxt "Groupbox Settings for the applet to change some values on the fly"
msgid "Settings"
msgstr "Postavke"

#: src/applet/tabletapplet.cpp:400
msgctxt "Toggle between touch on/off"
msgid "Touch:"
msgstr "Dodir:"

#: src/applet/tabletapplet.cpp:405
msgctxt "Touch tool enabled"
msgid "On"
msgstr "Uključeno"

#: src/applet/tabletapplet.cpp:413
msgctxt "Touch tool disabled"
msgid "Off"
msgstr "Isključeno"

#: src/applet/tabletapplet.cpp:430
msgctxt "Rotation of the tablet pad"
msgid "Rotation:"
msgstr "Rotacija:"

#: src/applet/tabletapplet.cpp:475
msgctxt "Toggle between absolute/relative penmode"
msgid "Mode:"
msgstr "Režim:"

#: src/applet/tabletapplet.cpp:480
msgctxt "absolute pen movement (pen mode)"
msgid "Absolute"
msgstr "Apsolutno"

#: src/applet/tabletapplet.cpp:488
msgctxt "relative pen movement (mouse mode)"
msgid "Relative"
msgstr "Relativni"

#: src/applet/tabletapplet.cpp:558
msgid "Graphic Tablet - Device not detected."
msgstr "Grafički tablet - Uređaj nije pronađen."

#: src/applet/tabletapplet.cpp:559
msgid ""
"This widget is inactive because your tablet device is not connected or "
"currently not supported."
msgstr ""
"Ova kontrola nije aktivna zbog toga što vaš tablet uređaj nije konektovan "
"ili trenutno nije podržan."

#~ msgid "Select Tablet:"
#~ msgstr "Izaberite tablet:"
