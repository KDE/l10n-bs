#: openvpn.cpp:501
#, kde-format
msgid "Invalid number of arguments (expected 2) in option: %1"
msgstr "Pogrešan broj argumenata (očekivano 2) u opciji: %1"

#: openvpn.cpp:523
#, kde-format
msgid "Invalid argument in option: %1"
msgstr "Pogrešan argument opciji: %1"

