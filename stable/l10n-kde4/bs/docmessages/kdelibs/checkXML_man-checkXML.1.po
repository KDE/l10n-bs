#. Tag: refpurpose
#: man-checkXML.1.docbook:20
#, no-c-format
msgid "An &XML; lint tool for &kde; DocBook &XML; documents."
msgstr "Alat za uređivanje &XML;  &kde; DocBook &XML; dokumenata."

#. Tag: cmdsynopsis
#: man-checkXML.1.docbook:24
#, no-c-format
msgid ""
"<command>checkXML</command> <arg><replaceable>filename</replaceable></arg>"
msgstr ""
"<command>provjera XMLa</command> <arg><replaceable>Ime datoteke</"
"replaceable></arg>"

#. Tag: title
#: man-checkXML.1.docbook:30
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-checkXML.1.docbook:32
#, no-c-format
msgid ""
"<command>checkXML</command> is a tool to check for syntax errors in &kde; "
"DocBook &XML; files. It can also be used for other DocBook based &XML; "
"files, but you should use the less specific xmllint(1) tool if you are not "
"writing or otherwise working on &kde; documentation."
msgstr ""
"<command>provjera XMLa</command> je alat za provjeru pravopisnih grešaka u "
"&kde; DocBook &XML; datotekama. Može se koristiti i za druge datoteke koje "
"su bazirane na osnovu DocBook &XML; datoteka, ali bi trebali koristiti manje "
"sprecifičan xmllint(1) alat ako ne pišete ili na bilo koji drugi način "
"radite sa &kde; dokumentacijom."

#. Tag: title
