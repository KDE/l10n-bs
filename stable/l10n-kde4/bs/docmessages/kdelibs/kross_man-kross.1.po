#. Tag: title
#: man-kross.1.docbook:9
#, no-c-format
msgid "&kde; User's Manual"
msgstr "&kde; Priručnik za korisnike"

#. Tag: author
#: man-kross.1.docbook:10
#, no-c-format
msgid "<firstname>Sebastian</firstname> <surname>Sauer</surname>"
msgstr "<firstname>Sebastian</firstname> <surname>Sauer</surname>"

#. Tag: email
#: man-kross.1.docbook:14
#, no-c-format
msgid "mail@dipe.org"
msgstr "mail@dipe.org"

#. Tag: date
#: man-kross.1.docbook:18
#, no-c-format
msgid "2008-10-22"
msgstr "2008-10-22"

#. Tag: releaseinfo
#: man-kross.1.docbook:19
#, no-c-format
msgid "0.01.01"
msgstr "0.01.01"

#. Tag: manvolnum
#: man-kross.1.docbook:25
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refpurpose
#: man-kross.1.docbook:30
#, no-c-format
msgid "&kde; application to run kross scripts."
msgstr "&kde; prijava za pokretanje kross skripte."

#. Tag: title
#: man-kross.1.docbook:34
#, no-c-format
msgid "Synopsis"
msgstr "Siže"

#. Tag: cmdsynopsis
#: man-kross.1.docbook:36
#, no-c-format
msgid ""
"<command>kross</command> <arg choice=\"opt\">--help</arg> <arg choice=\"opt"
"\">Generic-options</arg> <arg choice=\"opt\">Qt-options</arg> <arg choice="
"\"opt\">KDE-options</arg> <arg choice=\"opt\">file ...</arg>"
msgstr ""
"<command>kross</command> <arg choice=\"opt\">--help</arg> <arg choice=\"opt"
"\">Generic-options</arg> <arg choice=\"opt\">Qt-options</arg> <arg choice="
"\"opt\">KDE-opcije</arg> <arg choice=\"opt\">file ...</arg>"

#. Tag: title
#: man-kross.1.docbook:48
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kross.1.docbook:50
#, no-c-format
msgid ""
"<command>kross</command> executes kross scripts written in &kde; Javascript, "
"Python, Ruby, Java and Falcon."
msgstr ""
"<command>kross</command> izvršava kross skripte pisane u &kde; Javascript, "
"Python, Ruby, Java i Falcon."

#. Tag: title
#: man-kross.1.docbook:55
#, no-c-format
msgid "Generic Options"
msgstr "Opće opcije"

#. Tag: option
#: man-kross.1.docbook:60
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kross.1.docbook:62
#, no-c-format
msgid "Show author information."
msgstr "Prikaži informacije o autoru."

#. Tag: option
#: man-kross.1.docbook:67
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kross.1.docbook:69
#, no-c-format
msgid "Show help about options."
msgstr "Prikaži pomoć o opcijama."

#. Tag: option
#: man-kross.1.docbook:74
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kross.1.docbook:76
#, no-c-format
msgid "Show all options."
msgstr "Prikaži sve opcije."

#. Tag: option
#: man-kross.1.docbook:81
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kross.1.docbook:83
#, no-c-format
msgid "Show KDE specific options."
msgstr "Prikaži KDE specifične opcije."

#. Tag: option
#: man-kross.1.docbook:90
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kross.1.docbook:92
#, no-c-format
msgid "Show Qt specific options."
msgstr "Prikaži Qt specifične opcije."

#. Tag: option
#: man-kross.1.docbook:97
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kross.1.docbook:99
#, no-c-format
msgid "Show license information."
msgstr "Prikaz informacija o licenci."

#. Tag: term
#: man-kross.1.docbook:104
#, no-c-format
msgid "<option>-v</option><option>--version</option>"
msgstr "<option>-v</option><option>--version</option>"

#. Tag: para
#: man-kross.1.docbook:106
#, no-c-format
msgid "Show version information"
msgstr "Pokaži verziju"

#. Tag: title
#: man-kross.1.docbook:115
#, no-c-format
msgid "Application Options"
msgstr "Opcije programa"

#. Tag: term
#: man-kross.1.docbook:119
#, no-c-format
msgid "<option>file</option>..."
msgstr "<option>datoteka</option>..."

#. Tag: para
#: man-kross.1.docbook:121
#, no-c-format
msgid "The files with the scripts to run."
msgstr "Datoteke sa skripte za pokretanje."

#. Tag: title
#: man-kross.1.docbook:131
#, no-c-format
msgid "Usage"
msgstr "Upotreba"

#. Tag: para
#: man-kross.1.docbook:132
#, no-c-format
msgid ""
"<command>kross</command> <parameter>file</parameter> runs the script in "
"<parameter>file</parameter> after loading the interpreter plugin for the "
"script language (detected by filename suffix)."
msgstr ""
"<command>kross</command> <parameter>datoteka</parameter> pokreće skripte iz "
"<parameter>datoteke</parameter> nakon učitavanja interpretera za skriptni "
"jezik (detektovan po sufiksu imena datoteke)."

#. Tag: para
#: man-kross.1.docbook:136
#, no-c-format
msgid ""
"To interpret other languages than &kde; Javascript, "
"<replaceable>kdebindings</replaceable> must be installed."
msgstr ""
"Za interpreter ostalih jezika osim &kde; Javascript, "
"<replaceable>kdebindings</replaceable> mora biti instaliran."

#. Tag: title
#: man-kross.1.docbook:145
#, no-c-format
msgid "See Also"
msgstr "Vidite i"

#. Tag: para
#: man-kross.1.docbook:146
#, no-c-format
msgid ""
"<replaceable>kdeoptions</replaceable>(7), <replaceable>qtoptions</"
"replaceable>(7), <replaceable>python</replaceable>(1), <replaceable>ruby</"
"replaceable>(1), <replaceable>kjs</replaceable>(1), <replaceable>java</"
"replaceable>(1), <replaceable>falcon</replaceable>(1)"
msgstr ""
"<replaceable>kdeoptions</replaceable>(7), <replaceable>qtoptions</"
"replaceable>(7), <replaceable>python</replaceable>(1), <replaceable>ruby</"
"replaceable>(1), <replaceable>kjs</replaceable>(1), <replaceable>java</"
"replaceable>(1), <replaceable>falcon</replaceable>(1)"

#. Tag: para
#: man-kross.1.docbook:150
#, no-c-format
msgid ""
"Look at <replaceable>http://kross.dipe.org/solution.html</replaceable> for "
"more information and tutorials."
msgstr ""
"Pogledajte <replaceable>http://kross.dipe.org/solution.html</replaceable> za "
"više informacija i uputa."

#. Tag: title
#: man-kross.1.docbook:156
#, no-c-format
msgid "Bugs"
msgstr "Bagovi"

#. Tag: para
#: man-kross.1.docbook:157
#, no-c-format
msgid ""
"There are probably tons of bugs. Use <ulink url=\"http://bugs.kde.org\">bugs."
"kde.org</ulink> to report them."
msgstr ""
"Moguće je da ima mnogo grešaka. Korisite<ulink url=\"http://bugs.kde.org"
"\">bugs.kde.org</ulink> da ih prijavite."
