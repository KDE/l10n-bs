#. Tag: title
#: man-kcookiejar4.8.docbook:42
#, no-c-format
msgid "Synopsis"
msgstr "Sinopsis"

#. Tag: cmdsynopsis
#: man-kcookiejar4.8.docbook:44
#, no-c-format
msgid ""
"<command>kcookiejar4</command> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">Generic-options</arg> <arg choice=\"opt\">Qt-options</arg> <arg "
"choice=\"opt\">KDE-options</arg> <arg choice=\"opt\">--shutdown</arg> <arg "
"choice=\"opt\">--remove<replaceable> domain</replaceable></arg> <arg choice="
"\"opt\">--remove-all</arg> <arg choice=\"opt\">--reload-config</arg>"
msgstr ""
"<command>kcookiejar4</command> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">Generičke-opcije</arg> <arg choice=\"opt\">Qt-options</arg> <arg "
"choice=\"opt\">KDE-opcije</arg> <arg choice=\"opt\">--shutdown</arg> <arg "
"choice=\"opt\">--remove<replaceable> domain</replaceable></arg> <arg choice="
"\"opt\">--remove-all</arg> <arg choice=\"opt\">--reload-config</arg>"

#. Tag: title
#: man-kcookiejar4.8.docbook:59
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kcookiejar4.8.docbook:61
#, no-c-format
msgid ""
"<command>kcookiejar4</command> handles the HTTP cookies providing a D-BUS "
"service to store/retrieve/clean cookies."
msgstr ""
"<command>kcookiejar4</command> obrađuje HTTP kolačiće pruzajući D_BUS usluge "
"za skladištenje,pronalazak i brisanje kolačića."

#. Tag: title
#: man-kcookiejar4.8.docbook:67
#, no-c-format
msgid "Generic Options"
msgstr "Generičke opcije"

#. Tag: option
#: man-kcookiejar4.8.docbook:72
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kcookiejar4.8.docbook:74
#, no-c-format
msgid "Show author information."
msgstr "Prikazi podatke o autoru."

#. Tag: option
#: man-kcookiejar4.8.docbook:79
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kcookiejar4.8.docbook:81
#, no-c-format
msgid "Show help about options."
msgstr "Prikaži pomoć o opcijama."

#. Tag: option
#: man-kcookiejar4.8.docbook:86
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kcookiejar4.8.docbook:88
#, no-c-format
msgid "Show all options."
msgstr "Prikaži sve opcije."

#. Tag: option
#: man-kcookiejar4.8.docbook:93
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kcookiejar4.8.docbook:95
#, no-c-format
msgid "Show KDE specific options."
msgstr "Prikaži KDE specifične opcije"

#. Tag: option
#: man-kcookiejar4.8.docbook:102
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kcookiejar4.8.docbook:104
#, no-c-format
msgid "Show Qt specific options."
msgstr "Prikazi Qt specificne opcije."

#. Tag: option
#: man-kcookiejar4.8.docbook:109
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kcookiejar4.8.docbook:111
#, no-c-format
msgid "Show license information."
msgstr "Prikazi informacije o licenci."

#. Tag: term
#: man-kcookiejar4.8.docbook:116
#, no-c-format
msgid "<option>-v</option><option>--version</option>"
msgstr "<option>-v</option><option>--version</option>"

#. Tag: para
#: man-kcookiejar4.8.docbook:118
#, no-c-format
msgid "Show version information"
msgstr "Prikazi informacije o verziji."

#. Tag: title
#: man-kcookiejar4.8.docbook:127
#, no-c-format
msgid "Application Options"
msgstr "Aplikacijske opcije."

#. Tag: option
#: man-kcookiejar4.8.docbook:131
#, no-c-format
msgid "--shutdown"
msgstr "--shutdown"

#. Tag: para
#: man-kcookiejar4.8.docbook:133
#, no-c-format
msgid "Shut down cookie jar and the D-BUS service."
msgstr "Iskljucite teglu kolačića i D_BUS uslugu."

#. Tag: term
#: man-kcookiejar4.8.docbook:139
#, no-c-format
msgid "<option>--remove</option> <parameter>domain</parameter>"
msgstr "<option>--remove</option> <parameter>domain</parameter>"

#. Tag: para
#: man-kcookiejar4.8.docbook:141
#, no-c-format
msgid "Removes cookies for <parameter>domain</parameter> from the cookie jar."
msgstr ""
"Uklanja kolačiće za  <parameter>domain</parameter> iz tegle za kolačiće."

#. Tag: option
#: man-kcookiejar4.8.docbook:149
#, no-c-format
msgid "--remove-all"
msgstr "--remove-all"

#. Tag: para
#: man-kcookiejar4.8.docbook:151
#, no-c-format
msgid "Removes all the cookies from the cookie jar."
msgstr "Uklanja sve kolačiće iz tegle za kolačiće."

#. Tag: option
#: man-kcookiejar4.8.docbook:156
#, no-c-format
msgid "--reaload-config"
msgstr "--reaload-config"

#. Tag: para
#: man-kcookiejar4.8.docbook:158
#, no-c-format
msgid "Reloads the configuration file."
msgstr "Ponovo učitava konfiguracijsku datoteku."

#. Tag: title
#: man-kcookiejar4.8.docbook:169
#, no-c-format
msgid "Usage"
msgstr "Upotreba"

#. Tag: para
#: man-kcookiejar4.8.docbook:170
#, no-c-format
msgid ""
"KDE web browser <command>konqueror</command> uses <command>kcookiejar4</"
"command> for storing and managing cookies using the D-Bus service "
"<command>kcookiejar4</command> provides."
msgstr ""
"KDE web pretraživač  <command>konqueror</command> koristi "
"<command>kcookiejar4</command> za  čuvanje i upravljanje kolačića koristeći "
"D_BUS pruza  uslugu <command>kcookiejar4</command> ."

#. Tag: para
#: man-kcookiejar4.8.docbook:175
#, no-c-format
msgid ""
"When <command>kcookiejar4</command> is started without parameters, it "
"provides a D-BUS service to handle HTTP cookies."
msgstr ""
"Kada <command>kcookiejar4</command> zapocne bez parametara, D-BUS pruza "
"uslugu za rukovanje HTTP kolačićima."

#. Tag: para
#: man-kcookiejar4.8.docbook:179
#, no-c-format
msgid ""
"When <command>kcookiejar4</command> is started with some parameters, it does "
"additional tasks to the cookies jar it provides, like removing the cookies "
"from one <parameter>domain</parameter>."
msgstr ""
"Kada <command>kcookiejar4</command> zapocne s parametrima, tegla kolacica "
"vrlo pruza dodatne opcije kao sto si uklanjanje kolačića  iz  "
"<parameter>domain</parameter>."

