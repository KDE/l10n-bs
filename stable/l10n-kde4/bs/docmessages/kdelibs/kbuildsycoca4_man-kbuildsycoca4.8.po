#, no-c-format
msgid "Synopsis"
msgstr "Sinopsis"

#. Tag: cmdsynopsis
#: man-kbuildsycoca4.8.docbook:36
#, no-c-format
msgid ""
"<command>kbuildsycoca4</command> <group> <arg choice=\"opt\">--nosignal</"
"arg> <arg choice=\"opt\">--noincremental</arg> <arg choice=\"opt\">--"
"checkstamps</arg> <arg choice=\"opt\">--nocheckfiles</arg> <arg choice=\"opt"
"\">--global</arg> <arg choice=\"opt\">--menutest</arg> <arg choice=\"opt\">--"
"track <replaceable>menu-id</replaceable></arg> <arg choice=\"opt\">--help</"
"arg> <arg choice=\"opt\">--help-qt</arg> <arg choice=\"opt\">--help-kde</"
"arg> <arg choice=\"opt\">--help-all</arg> <arg choice=\"opt\">--author</arg> "
"<arg choice=\"opt\">-v, --version</arg> <arg choice=\"opt\">--license</arg> "
"</group>"
msgstr ""
"<command>kbuildsycoca4</command> <group> <arg choice=\"opt\">--nosignal</"
"arg> <arg choice=\"opt\">--noincremental</arg> <arg choice=\"opt\">--"
"checkstamps</arg> <arg choice=\"opt\">--nocheckfiles</arg> <arg choice=\"opt"
"\">--global</arg> <arg choice=\"opt\">--menutest</arg> <arg choice=\"opt\">--"
"track <replaceable>menu-id</replaceable></arg> <arg choice=\"opt\">--help</"
"arg> <arg choice=\"opt\">--help-qt</arg> <arg choice=\"opt\">--help-kde</"
"arg> <arg choice=\"opt\">--help-all</arg> <arg choice=\"opt\">--author</arg> "
"<arg choice=\"opt\">-v, --version</arg> <arg choice=\"opt\">--license</arg> "
"</group>"

#. Tag: title
#: man-kbuildsycoca4.8.docbook:60
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:62
#, no-c-format
msgid ""
"<command>kbuildsycoca4</command>, as part of the &kde; command line tools "
"ensures the proper operation of &kde; by reading in all the <literal role="
"\"extension\">.desktop</literal>, <literal role=\"extension\">.xml</"
"literal>, and <literal role=\"extension\">.protocol</literal> files to "
"construct a binary database."
msgstr ""
"<command> kbuildsycoca4 </command>, kao dio &kde; alat komandne linije "
"osigurava pravilan rad &kde; čitajući u svim <literal role=\"extension\">."
"desktop</literal>, <literal role=\"extension\">.xml</literal>, i <literal "
"role=\"extension\">.protocol</literal> datotekama za izgradnju binarnih baza "
"podataka."

#. Tag: para
#: man-kbuildsycoca4.8.docbook:71
#, no-c-format
msgid ""
"&kde; itself accesses this database during operation to provide "
"configuration information a program needs to run."
msgstr ""
"&kde; sam pristupa ovoj bazi podataka tokom rada da pruži informacije o "
"konfiguraciji koje program treba da se ponovo pokrene."

#. Tag: para
#: man-kbuildsycoca4.8.docbook:76
#, no-c-format
msgid ""
"This tool is part of ksycoca4, which stands for &kde; System Configuration "
"Cache"
msgstr ""
"Ovaj alat je dio ksycoca4, što je skraćenica za &kde; konfiguraciju keš "
"memorije sistema"

#. Tag: title
#: man-kbuildsycoca4.8.docbook:84
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:88
#, no-c-format
msgid "--nosignal"
msgstr "--nosignal"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:90
#, no-c-format
msgid "Do not signal applications to update"
msgstr "Ne šalji programima signal za ažuriranje"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:95
#, no-c-format
msgid "--noincremental"
msgstr "--noincremental"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:97
#, no-c-format
msgid "Disable incremental update, re-read everything"
msgstr "Isključi postepeno ažuriranje, isčitaj sve ponovo"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:102
#, no-c-format
msgid "--checkstamps"
msgstr "--checkstamps"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:104
#, no-c-format
msgid "Check file timestamps"
msgstr "Provjeri vremenske pečate datoteka"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:109
#, no-c-format
msgid "--nocheckfiles"
msgstr "--nocheckfiles"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:111
#, no-c-format
msgid "Disable checking files (dangerous)"
msgstr "Isključi provjeru datoteka (opasno)"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:116
#, no-c-format
msgid "--global"
msgstr "--global"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:118
#, no-c-format
msgid "Create global database"
msgstr "Napravi globalnu bazu"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:123
#, no-c-format
msgid "--menutest"
msgstr "--menutest"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:125
#, no-c-format
msgid "Perform menu generation test run only"
msgstr "Izvrši samo probni postupak stvaranja menija"

#. Tag: option
#: man-kbuildsycoca4.8.docbook:130
#, no-c-format
msgid "--track <replaceable>menu-id</replaceable>"
msgstr "--track <replaceable>menu-id</replaceable>"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:132
#, no-c-format
msgid "Track menu id for debug purposes"
msgstr "Prati id. menija radi ispravljanja"

