msgstr "Upotreba"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:207
#, no-c-format
msgid ""
"A standard way to run this program is by simply specifying the following "
"command at the prompt <userinput><command>kbuildsycoca4</command></userinput>"
msgstr ""
"Standardni način za pokretanje ovog programa je jednostavno navodeći "
"sljedeće naredbe na upitu <userinput> <command> kbuildsycoca4 </command> </"
"userinput>"

