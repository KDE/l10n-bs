#. Tag: title
#: man-qtoptions.7.docbook:8
#, no-c-format
msgid "KDE User's Manual"
msgstr "KDE Korisnički priručnik"

#. Tag: author
#: man-qtoptions.7.docbook:9
#, no-c-format
msgid "&Lauri.Watts; &Lauri.Watts.mail;"
msgstr "&Lauri.Watts; &Lauri.Watts.mail;"

#. Tag: date
#: man-qtoptions.7.docbook:10
#, no-c-format
msgid "2004-02-02"
msgstr "02.02.2004"

#. Tag: productname
#: man-qtoptions.7.docbook:11
#, no-c-format
msgid "K Desktop Environment"
msgstr "K Desktop okruženje"

#. Tag: refentrytitle
#: man-qtoptions.7.docbook:15
#, no-c-format
msgid "<refentrytitle>qtoptions</refentrytitle>"
msgstr "<refentrytitle>qtopcije</refentrytitle>"

#. Tag: manvolnum
#: man-qtoptions.7.docbook:16
#, no-c-format
msgid "<manvolnum>7</manvolnum>"
msgstr "<manvolnum>7</manvolnum>"

#. Tag: refname
#: man-qtoptions.7.docbook:20
#, no-c-format
msgid "<refname>qtoptions</refname>"
msgstr "<refname>qtopcije</refname>"

#. Tag: refpurpose
#: man-qtoptions.7.docbook:21
#, no-c-format
msgid "Common commandline options for all applications based on the Qt toolkit"
msgstr ""
"Zajedničke opcije komandne linije za sve aplikacije zasnovane na Qt alatima"

#. Tag: cmdsynopsis
#: man-qtoptions.7.docbook:25
#, no-c-format
msgid ""
"<command><replaceable>Qt application</replaceable></command> <arg choice="
"\"opt\">Qt Generic Options</arg>"
msgstr ""
"<command><replaceable>Qt aplikacija</replaceable></command> <arg choice=\"opt"
"\">Qt Generičke Opcije</arg>"

#. Tag: title
#: man-qtoptions.7.docbook:33
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: para
#: man-qtoptions.7.docbook:35
#, no-c-format
msgid "The following options apply to all &Qt; applications:"
msgstr "Sljedeće opcije se primjenjuju za sve &Qt; aplikacije:"

#. Tag: term
#: man-qtoptions.7.docbook:39
#, no-c-format
msgid "<option>--display</option> <parameter>displayname</parameter>"
msgstr "<option>--prikaži</option> <parameter>prikažiime</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:43
#, no-c-format
msgid "Use the X-server display <parameter>displayname</parameter>."
msgstr "Koristite X-poslužitelj prikaz <parameter>prikažiime</parameter>."

#. Tag: term
#: man-qtoptions.7.docbook:49
#, no-c-format
msgid "<option>--session</option> <parameter>sessionId</parameter>"
msgstr "<option>--session</option> <parameter>sessionId</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:53
#, no-c-format
msgid "Restore the application for the given <parameter>sessionId</parameter>."
msgstr "Vrati aplikaciju za zadati <parameter>sessionId</parameter>."

#. Tag: option
#: man-qtoptions.7.docbook:60
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-qtoptions.7.docbook:63
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display."
msgstr "Uzrokuje da aplikacija instalira privatnu mapu boja na 8-bitni ekran."

#. Tag: term
#: man-qtoptions.7.docbook:69
#, no-c-format
msgid "<option>--ncols</option> <parameter>count</parameter>"
msgstr "<option>--ncols</option> <parameter>count</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:73
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the <methodname>QApplication::ManyColor</"
"methodname> color specification."
msgstr ""
"Ograničava broj alociranih boja u kocki sa bojama na 8-bitnom ekranu,ako "
"aplikacija koristi <methodname>QAplikacija::Punoboja</methodname> "
"specifikaciju."

#. Tag: option
#: man-qtoptions.7.docbook:82
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-qtoptions.7.docbook:85
#, no-c-format
msgid "Tells &Qt; to never grab the mouse or the keyboard."
msgstr "Zabranjuje &Qt; korištenje  miša ili tastature."

#. Tag: option
#: man-qtoptions.7.docbook:91
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-qtoptions.7.docbook:94
#, no-c-format
msgid ""
"Running under a debugger can cause an implicit <option>--nograb</option>, "
"use <option>--dograb</option> to override."
msgstr ""
"Pokretanje unutar debagera može uzrokovati implicitno <option>--nograb</"
"option>, use <option>--dograb</option> pregaranje."

#. Tag: option
#: man-qtoptions.7.docbook:102
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-qtoptions.7.docbook:105
#, no-c-format
msgid "Switches to synchronous mode for debugging."
msgstr "Prebacuje na sinhroni mod za debagiranje."

#. Tag: term
#: man-qtoptions.7.docbook:110
#, no-c-format
msgid ""
"<option>--fn</option>,<option>--font</option> <parameter>fontname</parameter>"
msgstr ""
"<option>--fn</option>,<option>--font</option> <parameter>nazivfonta</"
"parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:115
#, no-c-format
msgid "Defines the application font."
msgstr "Definira font korišten u aplikaciji."

#. Tag: term
#: man-qtoptions.7.docbook:120
#, no-c-format
msgid ""
"<option>--bg</option>,<option>--background</option> <parameter>color</"
"parameter>"
msgstr ""
"<option>--bg</option>,<option>--pozadina</option> <parameter>boja</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:125
#, no-c-format
msgid ""
"Sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"Postavlja osnovnu boju pozadine i paletu aplikacije (svijetle i tamne sjene "
"su uključene)."

#. Tag: term
#: man-qtoptions.7.docbook:131
#, no-c-format
msgid ""
"<option>--fg</option>,<option>--foreground</option> <parameter>color</"
"parameter>"
msgstr ""
"<option>--fg</option>,<option>--prednji</option> <parameter>boja</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:136
#, no-c-format
msgid "Sets the default foreground color"
msgstr "Postavlja osnovnu  boju prednje strane."

#. Tag: term
#: man-qtoptions.7.docbook:141
#, no-c-format
msgid ""
"<option>--btn</option>,<option>--button</option> <parameter>color</parameter>"
msgstr ""
"<option>--btn</option>,<option>--tipka</option> <parameter>boja</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:146
#, no-c-format
msgid "Sets the default button color."
msgstr "Postavlja osnovnu boju tipke."

#. Tag: term
#: man-qtoptions.7.docbook:152
#, no-c-format
msgid "<option>--name</option> <parameter>name</parameter>"
msgstr "<option>--ime</option> <parameter>ime</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:156
#, no-c-format
msgid "Sets the application name."
msgstr "Postavlja ime aplikacije."

#. Tag: term
#: man-qtoptions.7.docbook:161
#, no-c-format
msgid "<option>--title</option> <parameter>title</parameter>"
msgstr "<option>--naslov</option> <parameter>naslov</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:165
#, no-c-format
msgid "Sets the application title (caption)."
msgstr "Postavlja naslov aplikacije (zaglavlje)."

#. Tag: term
#: man-qtoptions.7.docbook:170
#, no-c-format
msgid "<option>--visual</option> <parameter>TrueColor</parameter>"
msgstr "<option>--vizualizacija</option> <parameter>PravaBoja</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:174
#, no-c-format
msgid ""
"Forces the application to use a <parameter>TrueColor</parameter> visual on "
"an 8-bit display."
msgstr ""
"Zahtijeva od aplikacije korištenje <parameter>PravaBoja</parameter> "
"vizualizacije na  8-bitnom ekranu."

#. Tag: term
#: man-qtoptions.7.docbook:181
#, no-c-format
msgid "<option>--inputstyle</option> <parameter>inputstyle</parameter>"
msgstr "<option>--načinunosa</option> <parameter>načinunosa</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:185
#, no-c-format
msgid ""
"Sets XIM (X Input Method) input style. Possible values are "
"<parameter>onthespot</parameter>, <parameter>overthespot</parameter>, "
"<parameter>offthespot</parameter> and <parameter>root</parameter>."
msgstr ""
"Postavlja XIM (X način unosa) način unosa.Moguće vrijednosti su "
"<parameter>ufokusu</parameter>, <parameter>iznadfokusa</parameter>, "
"<parameter>vanfokusa</parameter> i <parameter>korijen</parameter>."

#. Tag: term
#: man-qtoptions.7.docbook:193
#, no-c-format
msgid "<option>--im</option> <parameter>XIM server</parameter>"
msgstr "<option>--im</option> <parameter>XIM server</parameter>"

#. Tag: para
#: man-qtoptions.7.docbook:197
#, no-c-format
msgid "Set XIM server."
msgstr "Postavi XIM server."

#. Tag: option
#: man-qtoptions.7.docbook:203
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-qtoptions.7.docbook:206
#, no-c-format
msgid "Disable XIM"
msgstr "Isključi XIM"

#. Tag: option
#: man-qtoptions.7.docbook:212
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-qtoptions.7.docbook:215
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr "kopira cijeli izgled grafičkih elemenata"

#. Tag: term
#: man-qtoptions.7.docbook:220
#, no-c-format
msgid "<option>--stylesheet</option> <replaceable>file.qss</replaceable>"
msgstr "<option>--stilovi</option> <replaceable>dokument.qss</replaceable>"

#. Tag: para
#: man-qtoptions.7.docbook:224
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets"
msgstr "primjenjuje Qt‑ov opis stila na programske grafičke kontrole"

#. Tag: title
#: man-qtoptions.7.docbook:234
#, no-c-format
msgid "See Also"
msgstr "Također pogledati"

#. Tag: para
#: man-qtoptions.7.docbook:235
#, no-c-format
msgid "<replaceable>kdeoptions</replaceable>(7)"
msgstr "<replaceable>kdeopcije</replaceable>(7)"

#. Tag: title
#: man-qtoptions.7.docbook:240
#, no-c-format
msgid "Authors"
msgstr "Autori"

#. Tag: para
