#: man-meinproc4.8.docbook:184
#, no-c-format
msgid "--htdig"
msgstr "--htdig"

#. Tag: para
#: man-meinproc4.8.docbook:186
#, no-c-format
msgid "Create a ht://dig compatible index"
msgstr "Napravi indeks saglasan sa ht://dig"

