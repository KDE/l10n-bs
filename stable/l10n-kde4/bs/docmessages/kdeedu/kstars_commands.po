msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Alat</guimenu> <guimenuitem>Kalkulator...</guimenuitem>"

#. Tag: para
#: commands.docbook:432
#, no-c-format
msgid ""
"Opens the <link linkend=\"tool-calculator\">AstroCalculator</link> Tool, "
"which provides full access to many of the mathematical functions used by "
"&kstars;."
msgstr ""
"Otvori <link linkend=\"tool-calculator\">Astro Kalkulator</link>Alat, koji "
"omoucuje puni pristup mnogim matematickim funkcijema koriscenim od &kstars;."

#. Tag: menuchoice
#: commands.docbook:441
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Devices</guisubmenu> "
"<guimenuitem>Telescope Wizard...</guimenuitem>"
msgstr ""
"<guimenu>Alat</guimenu> <guisubmenu>Uređaji</guisubmenu> "
"<guimenuitem>Teleskop Čarobnjak...</guimenuitem>"

#. Tag: para
#: commands.docbook:446
#, no-c-format
msgid ""
"Opens the <guilabel>Telescope Wizard</guilabel>, which provides a step-by-"
"step guide to help you connect to your telescope and control it with "
"&kstars;."
msgstr ""
"Otvori <guilabel>Teleskop Čarobnjak</guilabel>, koji omogucuje korak po "
"korak da pomogne konektovati teleskop i koristiti ga sa  &kstars;."

#. Tag: menuchoice
#: commands.docbook:452
#, no-c-format
