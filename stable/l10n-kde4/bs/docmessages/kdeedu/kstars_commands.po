msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu></guimenu> <guimenuitem>Planer posmatranja</guimenuitem>"

#. Tag: para
#: commands.docbook:692
#, no-c-format
msgid ""
"Open the <link linkend=\"tool-obsplanner\">Observation Planner</link> tool"
msgstr ""
"Otvori  <link linkend=\"tool-obsplanner\">Planer posmatranja</link> tool"

#. Tag: menuchoice
#: commands.docbook:696
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>Observation</guimenu> <guimenuitem>Execute the session "
"Plan</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>Opažanje</guimenu> <guimenuitem>Izvrsi plan sesije </"
"guimenuitem>"

#. Tag: para
#: commands.docbook:703
#, no-c-format
msgid ""
"Opens <link linkend=\"tool-obsplanner\">session plan wizard</link> or "
"execute the planned session."
msgstr ""
"Otvori <link linkend=\"tool-obsplanner\">carobnjaka plana sesije </link> ili "
"izvrsi laniranu sesiju ."

