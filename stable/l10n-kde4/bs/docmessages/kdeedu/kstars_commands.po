#. Tag: title
#: commands.docbook:9
#, no-c-format
msgid "File Menu"
msgstr "Datoteka Meni"

#. Tag: menuchoice
#: commands.docbook:13
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open FITS...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>Fajl</guimenu> <guimenuitem>Otvori FITS...</guimenuitem>"

#. Tag: para
#: commands.docbook:20
#, no-c-format
msgid "Open a FITS image in the FITS Viewer tool"
msgstr "Otvori FITS sliku u FITS alatu za pregledanje"

#. Tag: menuchoice
#: commands.docbook:25
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save Sky Image...</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Spasi Sky Sliku...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:32
#, no-c-format
msgid "Create image on disk from current display"
msgstr "Izrada slike na disku sa trenutnom zaslonu"

#. Tag: menuchoice
#: commands.docbook:37
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Run Script...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Fajl</guimenu> <guimenuitem>Run Script...</guimenuitem>"

#. Tag: para
#: commands.docbook:44
#, no-c-format
msgid "Run the specified &kstars; script"
msgstr "Pokreni specificiranu &kstars; skrpitu"

#. Tag: menuchoice
#: commands.docbook:75
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Printing Wizard</guimenuitem>"
msgstr "<guimenu>Fajl</guimenu> <guimenuitem>Čarobnjak za ispis</guimenuitem>"

#. Tag: para
#: commands.docbook:79
#, no-c-format
msgid ""
"Starts a wizard to configure capturing sky objects images using telescope "
"and printing the results as a good looking printout for further use or "
"catalogization."
msgstr ""
"Pokreće čarobnjak za konfiguriranje snimanje slika nebeskih tijela  pomoću "
"teleskopa i printanje rezultata kao lijep ispis za dalju upotrebu i "
"katalogalizaciju."

#. Tag: menuchoice
#: commands.docbook:84
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Fajl</guimenu> <guimenuitem>Printaj...</guimenuitem>"

#. Tag: para
#: commands.docbook:91
#, no-c-format
msgid "Send the current sky map to the printer (or to a PostScript/PDF file)"
msgstr "Posalji trenutnu Skay Map-u do printera (ili na PostScript/PDF Fajl)"

#. Tag: menuchoice
#: commands.docbook:97
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Fajl</guimenu> <guimenuitem>Izlaz</guimenuitem>"

#. Tag: para
#: commands.docbook:104 commands.docbook:1154
#, no-c-format
msgid "Quit &kstars;"
msgstr "Izlaz &kstars;"

#. Tag: title
#: commands.docbook:112
#, no-c-format
msgid "Time Menu"
msgstr "Meni Vremena"

#. Tag: menuchoice
#: commands.docbook:116
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> </"
"shortcut> <guimenu>Time</guimenu> <guimenuitem>Set Time to Now</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> </"
"shortcut> <guimenu>Vrijeme</guimenu> <guimenuitem>Postavi vrijeme na</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:123
#, no-c-format
msgid "Sync time to system clock"
msgstr "Sinhroniziraj vrijeme na sistemski sat"

#. Tag: menuchoice
#: commands.docbook:127
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Time</guimenu> <guimenuitem>Set Time...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Vrijeme</guimenu> <guimenuitem>Postavi Vrijeme...</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:134
#, no-c-format
msgid "Set time and date"
msgstr "Postavite vrijeme i datum"

#. Tag: menuchoice
#: commands.docbook:137
#, no-c-format
msgid ""
"<shortcut> <keycap>&lt;</keycap> </shortcut> <guimenu>Time</guimenu> "
"<guimenuitem>Advance one step backward in time</guimenuitem>"
msgstr ""
"<shortcut> <keycap>&lt;</keycap> </shortcut> <guimenu>Vrijeme</guimenu> "
"<guimenuitem>Napravi jedan korak unazad u vremenu</guimenuitem>"

#. Tag: para
#: commands.docbook:144
#, no-c-format
msgid ""
"Advance one step backward in time in the &kstars; simulation of the sky "
"chart. The duration of the time step can be configured after pressing the "
"little <guilabel>&gt;</guilabel> button on the &kstars; toolbar."
msgstr ""
"Napravi jedan korak unazad u vremenu u &kstars; simulacij nebeskog grafa . "
"Vrijeme trajanja koraka se moze podesiti nakon pritiska malog <guilabel>&gt;"
"</guilabel>dugmeta na &kstars; alatnoj traci ."

#. Tag: menuchoice
#: commands.docbook:148
#, no-c-format
msgid "<guimenu>Time</guimenu> <guimenuitem>Stop Clock</guimenuitem>"
msgstr "<guimenu>Vrijeme</guimenu> <guimenuitem>Zustavi sat</guimenuitem>"

#. Tag: para
#: commands.docbook:152
#, no-c-format
msgid "Toggle whether time passes"
msgstr "Prebaci ako vrijeme prođe"

#. Tag: menuchoice
#: commands.docbook:155
#, no-c-format
msgid ""
"<shortcut> <keycap>&gt;</keycap> </shortcut> <guimenu>Time</guimenu> "
"<guimenuitem>Advance one step forward in time</guimenuitem>"
msgstr ""
"<shortcut> <keycap>&gt;</keycap> </shortcut> <guimenu>Vrijeme</guimenu> "
"<guimenuitem>Naravi jedan korak naprijed u vremenu </guimenuitem>"

#. Tag: para
#: commands.docbook:162
#, no-c-format
msgid ""
"Advance one step forward in time in the &kstars; simulation of the sky "
"chart. The duration of the time step can be configured after pressing the "
"little <guilabel>&gt;</guilabel> button on the &kstars; toolbar."
msgstr ""
"Napravi jedan korak unazad u vremenu u &kstars; simulacij nebeskog grafa . "
"Vrijeme trajanja koraka se moze podesiti nakon pritiska malog <guilabel>&gt;"
"</guilabel>dugmeta na &kstars; alatnoj traci ."

#. Tag: title
#: commands.docbook:170
#, no-c-format
msgid "Pointing Menu"
msgstr "Ukazujuci Meni"

#. Tag: menuchoice
#: commands.docbook:174
#, no-c-format
msgid ""
"<shortcut> <keycap>Z</keycap> </shortcut> <guimenu>Pointing</guimenu> "
"<guimenuitem>Zenith</guimenuitem>"
msgstr ""
"<shortcut> <keycap>Z</keycap> </shortcut> <guimenu>Ukazujuci </guimenu> "
"<guimenuitem>Zenit</guimenuitem>"

#. Tag: para
#: commands.docbook:181
#, no-c-format
msgid ""
"Center the display at the <link linkend=\"ai-zenith\">Zenith</link> point "
"(straight up)"
msgstr ""
"Postavi displej na  <link linkend=\"ai-zenith\">Zenit</link> tacku (uspravno)"

#. Tag: menuchoice
#: commands.docbook:187
#, no-c-format
msgid ""
"<shortcut> <keycap>N</keycap> </shortcut> <guimenu>Pointing</guimenu> "
"<guimenuitem>North</guimenuitem>"
msgstr ""
"<shortcut> <keycap>N</keycap> </shortcut> <guimenu>Ukazujuci</guimenu> "
"<guimenuitem>Sjever</guimenuitem>"

#. Tag: para
#: commands.docbook:194 commands.docbook:1065
#, no-c-format
msgid "Center the display above the North point on the horizon"
msgstr "Postavi displej iznad Sjeverne tacke na horizontu"

#. Tag: menuchoice
#: commands.docbook:199
#, no-c-format
msgid ""
"<shortcut> <keycap>E</keycap> </shortcut> <guimenu>Pointing</guimenu> "
"<guimenuitem>East</guimenuitem>"
msgstr ""
"<shortcut> <keycap>E</keycap> </shortcut> <guimenu>Ukazujući</guimenu> "
"<guimenuitem>Istok</guimenuitem>"

#. Tag: para
#: commands.docbook:206 commands.docbook:1070
#, no-c-format
msgid "Center the display above the East point on the horizon"
msgstr "Postavi displej iznad Istocne tacke na horizontu"

#. Tag: menuchoice
#: commands.docbook:211
#, no-c-format
msgid ""
"<shortcut> <keycap>S</keycap> </shortcut> <guimenu>Pointing</guimenu> "
"<guimenuitem>South</guimenuitem>"
msgstr ""
"<shortcut> <keycap>S</keycap> </shortcut> <guimenu>Ukazujući</guimenu> "
"<guimenuitem>Jug</guimenuitem>"

#. Tag: para
#: commands.docbook:218 commands.docbook:1075
#, no-c-format
msgid "Center the display above the South point on the horizon"
msgstr "Postavi displej iznad Juzne tacke na horizontu"

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid ""
"<shortcut> <keycap>W</keycap> </shortcut> <guimenu>Pointing</guimenu> "
"<guimenuitem>West</guimenuitem>"
msgstr ""
"<shortcut> <keycap>W</keycap> </shortcut> <guimenu>Ukazujući</guimenu> "
"<guimenuitem>Zapad</guimenuitem>"

#. Tag: para
#: commands.docbook:230 commands.docbook:1081
#, no-c-format
msgid "Center the display above the West point on the horizon"
msgstr "Postavi displej iznad Zapadne tacke na horizontu"

#. Tag: menuchoice
#: commands.docbook:235
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>M</keycap></keycombo> </"
"shortcut> <guimenu>Pointing</guimenu> <guimenuitem>Set Coordinates "
"Manually...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>M</keycap></keycombo> </"
"shortcut> <guimenu>Ukazujući</guimenu> <guimenuitem>Postavi Koordinate "
"manuelno...</guimenuitem>"

#. Tag: para
#: commands.docbook:242
#, no-c-format
msgid ""
"Center the display on specific <link linkend=\"ai-skycoords\">sky "
"coordinates</link>"
msgstr ""
"Postavi displej na specificne  <link linkend=\"ai-skycoords\">koordinate na "
"nebu</link>"

#. Tag: menuchoice
#: commands.docbook:248
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Pointing</guimenu> <guimenuitem>Find Object</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Ukazujući</guimenu> <guimenuitem>Nađi objekt</guimenuitem>"

#. Tag: para
#: commands.docbook:255
#, no-c-format
msgid ""
"Locate an object by name using the <link linkend=\"findobjects\">Find Object "
"Window</link>"
msgstr ""
"Lociraj objekt po imenu koristeci <link linkend=\"findobjects\">Nađi prozor "
"objekta</link>"

#. Tag: menuchoice
#: commands.docbook:260
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo> </"
"shortcut> <guimenu>Pointing</guimenu> <guimenuitem>Stop Tracking</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo> </"
"shortcut> <guimenu>Ukazujući</guimenu> <guimenuitem>Prestani pratiti</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:267
#, no-c-format
msgid ""
"Toggle tracking on/off. While tracking, the display will remain centered on "
"the current position or object."
msgstr ""
"Prebaci pracenje on/off.Praćenjem, displej ce ostati pozicioniran na "
"trenutnom polozaju ili objektu."

#. Tag: title
#: commands.docbook:276
#, no-c-format
msgid "View Menu"
msgstr "Prikaz Meni"

#. Tag: menuchoice
#: commands.docbook:280
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>+</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom in</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>+</keycap></keycombo></"
"shortcut> <guimenu>Pogled</guimenu> <guimenuitem>Zumiraj</guimenuitem>"

#. Tag: para
#: commands.docbook:285
#, no-c-format
msgid "Zooms view in"
msgstr "Zumira pogled"

#. Tag: menuchoice
#: commands.docbook:289
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>-</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom out</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>-</keycap></keycombo></"
"shortcut> <guimenu>Pogled</guimenu> <guimenuitem>Smanjivanje</guimenuitem>"

#. Tag: para
#: commands.docbook:294
#, no-c-format
msgid "Zooms view out"
msgstr "Smanji pogled"

#. Tag: menuchoice
#: commands.docbook:298
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Default Zoom</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Postavljeno zumiranje</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:305 commands.docbook:1031
#, no-c-format
msgid "Restore the default Zoom setting"
msgstr "Vrati na potavljene postavke zumiranja"

#. Tag: menuchoice
#: commands.docbook:309
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom to Angular "
"Size...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>View</guimenu> <guimenuitem>Zumiraj na ugaonu "
"velicinu...</guimenuitem>"

#. Tag: para
#: commands.docbook:316 commands.docbook:1036
#, no-c-format
msgid "Zoom to specified field-of-view angle"
msgstr "Zumiraj na specificirano polje gledišta."

#. Tag: menuchoice
#: commands.docbook:320
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>View</guimenu> <guimenuitem>Full Screen Mode</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>View</guimenu> <guimenuitem>Rezim prikaza "
"citavog ekrana </guimenuitem>"

#. Tag: para
#: commands.docbook:327 commands.docbook:1169
#, no-c-format
msgid "Toggle full-screen mode"
msgstr "Prebaci na režim čitavog ekrana"

#. Tag: menuchoice
#: commands.docbook:331
#, no-c-format
msgid ""
"<shortcut> <keycap>Space</keycap> </shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Switch to star globe view / Switch to horizontal view</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycap>Space</keycap> </shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Promjeni na zvijezdani globalni pogled / SPromjeni na "
"horizontalni pogled </guimenuitem>"

#. Tag: para
#: commands.docbook:338 commands.docbook:1183
#, no-c-format
msgid ""
"Toggle between the <link linkend=\"horizontal\">Horizontal</link> and <link "
"linkend=\"equatorial\">Equatorial</link> <link linkend=\"ai-skycoords"
"\">Coordinate Systems</link>"
msgstr ""
"Prebaci između <link linkend=\"horizontal\">Horizontale </link> and <link "
"linkend=\"equatorial\">Vertikale</link> <link linkend=\"ai-skycoords"
"\">Coordinate Systems</link>"

#. Tag: menuchoice
#: commands.docbook:345
#, no-c-format
msgid ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Lambert Azimuthal Equal-"
"area</guimenuitem>"
msgstr ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projekcija</guisubmenu> <guimenuitem>Lambert Azimuthal Equal-"
"područje</guimenuitem>"

#. Tag: para
#: commands.docbook:353 commands.docbook:1196
#, no-c-format
msgid ""
"Switch sky chart view to the <ulink url=\"https://en.wikipedia.org/wiki/"
"Lambert_azimuthal_equal-area_projection\">Lambert azimuthal equal-area</"
"ulink> projection."
msgstr ""
"Promjeni nebeski grafik na  <ulink url=\"https://en.wikipedia.org/wiki/"
"Lambert_azimuthal_equal-area_projection\">Lambert azimuthal equal-area</"
"ulink> projekciju."

#. Tag: menuchoice
#: commands.docbook:357
#, no-c-format
msgid ""
"<shortcut> <keycap>F6</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Azimuthal Equidistant</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycap>F6</keycap> </shortcut> <guimenu>Pogled</guimenu> "
"<guisubmenu>Projekcija</guisubmenu> <guimenuitem>Azimuthal Equidistant</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:365 commands.docbook:1201
#, no-c-format
msgid ""
"Switch sky chart view to the <ulink url=\"https://en.wikipedia.org/wiki/"
"Azimuthal_equidistant_projection\">azimuthal equidistant</ulink> projection."
msgstr ""
"Promijeni pogled na nebeski grafik na  <ulink url=\"https://en.wikipedia.org/"
"wiki/Azimuthal_equidistant_projection\">asimutalnu ujednacenu </ulink> "
"projekciju."

#. Tag: menuchoice
#: commands.docbook:369
#, no-c-format
msgid ""
"<shortcut> <keycap>F7</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Orthographic</guimenuitem>"
msgstr ""
"<shortcut> <keycap>F7</keycap> </shortcut> <guimenu>Pogled</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Ortogonalni</guimenuitem>"

#. Tag: para
#: commands.docbook:377 commands.docbook:1206
#, no-c-format
msgid ""
"Switch sky chart view to the <ulink url=\"https://en.wikipedia.org/wiki/"
"Orthographic_projection_(cartography)\">orthographic</ulink> projection."
msgstr ""
"Promijeni pogled na nebeski grafik na <ulink url=\"https://en.wikipedia.org/"
"wiki/Orthographic_projection_(cartography)\">ortogonalnu </ulink> projekciju."

#. Tag: menuchoice
#: commands.docbook:381
#, no-c-format
msgid ""
"<shortcut> <keycap>F8</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Equirectangular</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycap>F8</keycap> </shortcut> <guimenu>Pogled</guimenu> "
"<guisubmenu>Projekcija</guisubmenu> <guimenuitem>Equirectangular</"
"guimenuitem>"

#. Tag: para
#: commands.docbook:389 commands.docbook:1211
#, no-c-format
msgid ""
"Switch sky chart view to the <ulink url=\"https://en.wikipedia.org/wiki/"
"Equirectangular_projection\">equirectangular</ulink> projection."
msgstr ""
"Promijeni pogled na nebeski grafik na <ulink url=\"https://en.wikipedia.org/"
"wiki/Equirectangular_projection\">ujednacena cilincricna</ulink> projekciju."

#. Tag: menuchoice
#: commands.docbook:393
#, no-c-format
msgid ""
"<shortcut> <keycap>F9</keycap> </shortcut> <guimenu>View</guimenu> "
"<guisubmenu>Projection</guisubmenu> <guimenuitem>Stereographic</guimenuitem>"
msgstr ""
"<shortcut> <keycap>F9</keycap> </shortcut> <guimenu>Pogled</guimenu> "
"<guisubmenu>Projekcija</guisubmenu> <guimenuitem>Stereografska</guimenuitem>"

#. Tag: para
