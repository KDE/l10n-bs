"shortcut> <guimenu>Data</guimenu> <guimenuitem>Download New Data...</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
