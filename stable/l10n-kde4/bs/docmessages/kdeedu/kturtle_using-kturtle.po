msgstr "<guimenu>Platno</guimenu> <guimenuitem>Štapaj Platno...</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:351
#, no-c-format
msgid ""
"Prints the current content of the <link linkend=\"the-canvas\">Canvas</link>."
msgstr "Štampa trenutni sadržaj <link linkend=\"the-canvas\">Platna</link>."

#. Tag: title
#: using-kturtle.docbook:357
#, no-c-format
msgid "The <guimenu>Run</guimenu> Menu"
msgstr "<guimenu>Pokreni</guimenu> Izbornik"

#. Tag: menuchoice
#: using-kturtle.docbook:361
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F5</keysym></keycombo> </shortcut> "
"<guimenu>Run</guimenu> <guimenuitem>Run</guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keysym>F5</keysym></keycombo> </shortcut> "
"<guimenu>Pokreni</guimenu> <guimenuitem>Pokreni</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:368
#, no-c-format
msgid "Starts the execution of the commands in the editor."
msgstr "Počinje izvršenje komandi u uređivaču."

#. Tag: menuchoice
#: using-kturtle.docbook:374
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F6</keysym></keycombo> </shortcut> "
"<guimenu>Run</guimenu> <guimenuitem>Pause</guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keysym>F6</keysym></keycombo> </shortcut> "
"<guimenu>Pokreni</guimenu> <guimenuitem>Zaustavi</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:381
#, no-c-format
msgid ""
"Pauses the execution. This action is only enabled when the commands are "
"actually executing."
msgstr ""
"Zaustavlja izvršenje. Ova akcija je  omogućena samo kada se komande stvarno "
"izvršavaju."

#. Tag: menuchoice
#: using-kturtle.docbook:387
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F7</keysym></keycombo> </shortcut> "
"<guimenu>Run</guimenu> <guimenuitem>Abort</guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keysym>F7</keysym></keycombo> </shortcut> "
"<guimenu>pokreni</guimenu> <guimenuitem>Prekini</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:394
#, no-c-format
msgid ""
"Stops the execution. This action is only enabled when the commands are "
"actually executing."
msgstr ""
"Zaustavlja izvršenje. Ova akcija je omogućena samo kad se komande stvarno "
"izvršavaju."

#. Tag: menuchoice
#: using-kturtle.docbook:400
#, no-c-format
msgid "<guimenu>Run</guimenu> <guisubmenu>Run Speed</guisubmenu>"
msgstr "<guimenu>Pokreni</guimenu> <guisubmenu>Brzina Pokretanja</guisubmenu>"

#. Tag: para
#: using-kturtle.docbook:404
#, no-c-format
msgid ""
"Present a list of possible execution speeds, consisting of: "
"<guimenuitem>Full Speed (no highlighting and inspector)</guimenuitem>, "
"<guimenuitem>Full Speed</guimenuitem>, <guimenuitem>Slow</guimenuitem>, "
"<guimenuitem>Slower</guimenuitem>, <guimenuitem>Slowest</guimenuitem> and "
"<guimenuitem>Step-by-Step</guimenuitem>. When the execution speed is set to "
"<guimenuitem>Full Speed</guimenuitem> (default) we can barely keep up with "
"what is happening. Sometimes this behavior is wanted, but sometimes we want "
"to keep track of the execution. In the latter case you want to set the "
"execution speed to <guimenuitem>Slow</guimenuitem>, <guimenuitem>Slower</"
"guimenuitem> or <guimenuitem>Slowest</guimenuitem>. When one of the slow "
"modes is selected the current position of the executor will be shown in the "
"editor. <guimenuitem>Step-by-Step</guimenuitem> will execute one command at "
"a time."
msgstr ""
"Predstavlja listu mogućih brzina izvršenja, koje se sastoje od: "
"<guimenuitem>Pune Brzine (bez naglašavanja i inspektora)</guimenuitem>, "
"<guimenuitem>Puna Brzina</guimenuitem>, <guimenuitem>Sporo</guimenuitem>, "
"<guimenuitem>Sporije</guimenuitem>, <guimenuitem>Najsporije</guimenuitem> i "
"<guimenuitem>Korak-po-Korak</guimenuitem>. Kada se brzina izvršenja namjesti "
"na <guimenuitem>Punu Brzinu</guimenuitem> (osnovno) mi jedva možemo držati "
"korak sa onimšto se dešava. Ponekad je ovakvo ponašanje poželjno, ali nekad "
"želimo da pratimo izvršenje. U drugom slučaju vi želite da namjestite brzinu "
"izvršenja na <guimenuitem>Sporo</guimenuitem>, <guimenuitem>Sporije</"
"guimenuitem> ili <guimenuitem>Najsporije</guimenuitem>. Kada se odabere "
"jedan od sporih modova trenutna pozicija izvršitelja bit će pokazana u "
"uređivaču. <guimenuitem>Korak-po-Korak</guimenuitem> će izvršavati jednu po "
"jednu komandu."

#. Tag: title
#: using-kturtle.docbook:412
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr "<guimenu>Alatke</guimenu> Izbornik"

#. Tag: menuchoice
#: using-kturtle.docbook:416
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Direction Chooser...</guimenuitem>"
msgstr "<guimenu>Alatke</guimenu> <guimenuitem>Birač Smjera...</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:420
#, no-c-format
msgid "This action opens the direction chooser dialog."
msgstr "Ova akcija otvara dijalog birača smjera."

#. Tag: menuchoice
#: using-kturtle.docbook:426
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Color Picker...</guimenuitem>"
msgstr "<guimenu>Alatke</guimenu> <guimenuitem>Birač Boja...</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:430
#, no-c-format
msgid "This action opens the color picker dialog."
msgstr "Ova akcija otvara dijalog birača boja."

#. Tag: title
#: using-kturtle.docbook:436
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr "<guimenu>Postavke</guimenu> Izbornik"

#. Tag: menuchoice
#: using-kturtle.docbook:440
#, no-c-format
msgid "<guimenu>Settings</guimenu><guisubmenu>Script Language</guisubmenu>"
msgstr "<guimenu>Postavke</guimenu><guisubmenu>Jezik Pisanja</guisubmenu>"

#. Tag: para
#: using-kturtle.docbook:441
#, no-c-format
msgid "<action>Choose</action> the language for the code."
msgstr "<action>Odaberi</action> jezik za kod."

#. Tag: menuchoice
#: using-kturtle.docbook:447
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>E</keycap></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Show Editor</guimenuitem>"
msgstr ""
"<shortcut> <keycombo>&Ctrl;<keycap>E</keycap></keycombo> </shortcut> "
"<guimenu>Postavke</guimenu> <guimenuitem>Pokaži Uređivač</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:454
#, no-c-format
msgid "Show or hide the <link linkend=\"the-editor\">Editor</link>."
msgstr "Pokaži ili sakrij <link linkend=\"the-editor\">Uređivač</link>."

#. Tag: menuchoice
#: using-kturtle.docbook:460
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Show Inspector</guimenuitem>"
msgstr ""
"<shortcut> <keycombo>&Ctrl;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Postavke</guimenu> <guimenuitem>Pokaži Inspektora</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:467
#, no-c-format
msgid "Show or hide <link linkend=\"the-inspector\">the inspector</link>."
msgstr "Pokaži ili sakrij <link linkend=\"the-inspector\">inspektora</link>."

#. Tag: menuchoice
#: using-kturtle.docbook:473
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Errors</guimenuitem>"
msgstr "<guimenu>Postavke</guimenu> <guimenuitem>Poaži Greške</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:477
#, no-c-format
msgid ""
"Show or hide the <guilabel>Error</guilabel> tab with a list of errors "
"resulting from running the code. If this option is enabled, click on "
"<guilabel>Canvas</guilabel> to see the turtle again."
msgstr ""
"Pokaži ili sakrij <guilabel>Greška</guilabel>prozor sa listom grešaka koje "
"rezultiraju iz pokretanja koda. Ukoliko je ova opcija omogućena, kliknite na "
"<guilabel>Platno</guilabel> da ponovo vidite kornjaču."

#. Tag: menuchoice
#: using-kturtle.docbook:483
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F11</keysym></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Show Line Numbers</guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keysym>F11</keysym></keycombo> </shortcut> "
"<guimenu>Postavke</guimenu> <guimenuitem>Pokaži Brojeve Linija</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:490
#, no-c-format
msgid ""
"With this action you can show the line numbers in <link linkend=\"the-editor"
"\">the editor</link>. This can be handy for finding errors."
msgstr ""
"Ovom akcijom vi možete pokazati brojeve redova u <link linkend=\"the-editor"
"\">uređivač</link>. Ovo može dobro doći kod pronalaženja grešaka."

#. Tag: menuchoice
#: using-kturtle.docbook:496
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu><guimenuitem>Pokaži Alatnu Traku</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:497
#, no-c-format
msgid "<action>Toggle</action> the Main Toolbar"
msgstr "<action>Prebaci</action> Glavna Traka Izbornika"

#. Tag: menuchoice
#: using-kturtle.docbook:503
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu><guimenuitem>Pokaži Statusnu traku</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:504
#, no-c-format
msgid "<action>Toggle</action> the Statusbar"
msgstr "<action>Prebaci</action> Statusna traka"

#. Tag: menuchoice
#: using-kturtle.docbook:510
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Podesi Kratice...</guimenuitem>"

#. Tag: para
#: using-kturtle.docbook:514
#, no-c-format
