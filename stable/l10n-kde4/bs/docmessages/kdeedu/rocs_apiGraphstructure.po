"<parameter><replaceable>type</replaceable></parameter></paramdef>"

#. Tag: term
#: apiGraphstructure.docbook:90
#, no-c-format
msgid "createNode(type)"
msgstr "createNode(type)"

#. Tag: para
#: apiGraphstructure.docbook:92
#, no-c-format
msgid ""
"Create a new node of the specified type and return the created node. If the "
"type is not registered, no node is created."
msgstr ""
"Kreira novi čvor navedenog tipa i vraća kreirani čvor. Ako čvor nije "
"registrovannijedan čvor se ne kreira."

#. Tag: funcprototype
#: apiGraphstructure.docbook:93
#, no-c-format
msgid ""
"<funcdef>GraphNode <function>createNode</function></funcdef> <paramdef>int "
"<parameter><replaceable>type</replaceable></parameter></paramdef>"
msgstr ""
"<funcdef>GraphNode <function>createNode</function></funcdef> <paramdef>int "
"<parameter><replaceable>type</replaceable></parameter></paramdef>"

#. Tag: term
#: apiGraphstructure.docbook:102
#, no-c-format
msgid "createNode()"
msgstr "createNode()"

#. Tag: para
#: apiGraphstructure.docbook:104
#, no-c-format
msgid "Create a new node of default type and return the created node."
msgstr "Kreira novi čvor podrazumijevanog tipa i vraća kreirani čvor."

#. Tag: funcprototype
#: apiGraphstructure.docbook:105
#, no-c-format
msgid ""
"<funcdef>GraphNode <function>createNode</function></funcdef> <paramdef></"
"paramdef>"
msgstr ""
"<funcdef>GraphNode <function>createNode</function></funcdef> <paramdef></"
"paramdef>"

#. Tag: term
#: apiGraphstructure.docbook:114
#, no-c-format
msgid "createEdge(from, to, type)"
msgstr "createEdge(from, to, type)"

#. Tag: para
#: apiGraphstructure.docbook:116
#, no-c-format
msgid ""
"Create an edge from node \"from\" to node \"to\" of the specified type and "
"return the created edge. If the type is not registered, no edge is created."
msgstr ""
"Kreira ivicu od čvora \"from\" do čvora \"to\" navedenog tipa i vraća "
"kreiranu ivicu. Ako tip nije registrovan, ivica se ne kreira."

#. Tag: funcprototype
#: apiGraphstructure.docbook:117
#, no-c-format
msgid ""
"<funcdef>GraphEdge <function>createEdge</function></funcdef> "
"<paramdef>GraphNode <parameter><replaceable>from</replaceable></parameter></"
"paramdef> <paramdef>GraphNode <parameter><replaceable>to</replaceable></"
"parameter></paramdef> <paramdef>int <parameter><replaceable>type</"
"replaceable></parameter></paramdef>"
msgstr ""
"<funcdef>GraphEdge <function>createEdge</function></funcdef> "
"<paramdef>GraphNode <parameter><replaceable>from</replaceable></parameter></"
"paramdef> <paramdef>GraphNode <parameter><replaceable>to</replaceable></"
"parameter></paramdef> <paramdef>int <parameter><replaceable>type</"
"replaceable></parameter></paramdef>"

#. Tag: term
#: apiGraphstructure.docbook:128
#, no-c-format
msgid "createEdge(from, to)"
msgstr "createEdge(from, to)"

#. Tag: para
#: apiGraphstructure.docbook:130
#, no-c-format
msgid ""
"Create an edge from node \"from\" to node \"to\" of default type and return "
"the created edge."
msgstr "Kreira ivicu od čvora \"from\" do čvora \"to\" podrazumijevanog tipa."

#. Tag: funcprototype
#: apiGraphstructure.docbook:131
#, no-c-format
msgid ""
"<funcdef>GraphEdge <function>createEdge</function></funcdef> "
"<paramdef>GraphNode <parameter><replaceable>from</replaceable></parameter></"
"paramdef> <paramdef>GraphNode <parameter><replaceable>to</replaceable></"
"parameter></paramdef>"
msgstr ""
"<funcdef>GraphEdge <function>createEdge</function></funcdef> "
"<paramdef>GraphNode <parameter><replaceable>from</replaceable></parameter></"
"paramdef> <paramdef>GraphNode <parameter><replaceable>to</replaceable></"
"parameter></paramdef>"

#. Tag: term
#: apiGraphstructure.docbook:141
#, no-c-format
msgid "distances(from)"
msgstr "distances(from)"

#. Tag: para
#: apiGraphstructure.docbook:143
#, no-c-format
msgid ""
"Returns an array of shortest path lengths from this node to every other node "
"in the graph."
msgstr ""
"Vraća niz najkraćih dužina staza od ovog čvora ka svakom drugom čvoru u "
"grafu."

#. Tag: funcprototype
#: apiGraphstructure.docbook:144
#, no-c-format
msgid ""
"<funcdef>Array <function>distances</function></funcdef> <paramdef>GraphNode "
"<parameter><replaceable>from</replaceable></parameter></paramdef>"
msgstr ""
"<funcdef>Array <function>distances</function></funcdef> <paramdef>GraphNode "
"<parameter><replaceable>from</replaceable></parameter></paramdef>"

