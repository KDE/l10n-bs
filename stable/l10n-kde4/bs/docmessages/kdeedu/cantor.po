msgstr "Dozvoljava čuvanje trenutnog radnog lista kao tekst dokumenta."

#. Tag: menuchoice
#: index.docbook:417
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export to LaTeX</guimenuitem>"
msgstr "<guimenu>Fajl</guimenu> <guimenuitem>Uvezi u LaTeX</guimenuitem>"

