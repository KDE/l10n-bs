#. Tag: menuchoice
#: index.docbook:410
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save Plain Text</guimenuitem>"
msgstr "<guimenu>Fajl</guimenu> <guimenuitem>Sačuvaj Tekst</guimenuitem>"

