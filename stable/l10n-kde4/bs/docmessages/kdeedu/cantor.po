msgstr "Dozvoljava čuvanje trenutnog radnog lista kao&latex;  dokumenta."

#. Tag: menuchoice
#: index.docbook:424
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Publish Worksheet</guimenuitem>"
msgstr "<guimenu>Fajl</guimenu> <guimenuitem>Obavi Radni list</guimenuitem>"

#. Tag: action
#: index.docbook:428
#, no-c-format
msgid ""
"Opens the dialog to publish your current worksheet and make it available to "
"other &cantor; users through <ulink url=\"http://userbase.kde.org/Special:"
"MyLanguage/Glossary#Get_Hot_New_Stuff\">GetHotNewStuff</ulink>."
msgstr ""
"Otvara dijalog za objavljivanje vašeg trenutnog radnog lista da bude "
"dostupan drugima &cantor; korisnicima kroz <ulink url=\"http://userbase.kde."
"org/Special:MyLanguage/Glossary#Get_Hot_New_Stuff\">GetHotNewStuff</ulink>."

