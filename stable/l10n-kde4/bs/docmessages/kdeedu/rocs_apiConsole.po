#. Tag: title
#: apiConsole.docbook:2
#, no-c-format
msgid "Scripting Interfaces"
msgstr "Osnove skripte"

#. Tag: title
#: apiConsole.docbook:4
#, no-c-format
msgid "Console Object"
msgstr "Objekat konzole"

#. Tag: para
#: apiConsole.docbook:5
#, no-c-format
msgid ""
"The Console object allows you to print messages of different importance to a "
"log."
msgstr "Konzola objekta omogućava ispis poruka različitog značaja za zapisnik."

#. Tag: para
#: apiConsole.docbook:8
#, no-c-format
msgid ""
"Console is not a constructor. All properties and methods of Console can be "
"called by using Console as an object, without creating it."
msgstr ""
"Konzola nije konstruktor. Sva svojstva i metode konzole mogu biti pozvane "
"korištenjem konzole kao objekta, bez njenog kreiranja."

#. Tag: title
#: apiConsole.docbook:13
#, no-c-format
msgid "Syntax"
msgstr "Sintaksa"

#. Tag: programlisting
#: apiConsole.docbook:14
#, no-c-format
msgid ""
"Console.log(\"This is a program message.\"); // print a program message\n"
"Console.debug(\"A debug message.\"); // print a debug message"
msgstr ""
"Console.log(\"Ovo je poruka programa.\"); // print a program message\n"
"Console.debug(\"Poruka za ispravljanje greške.\"); // print a debug message"

#. Tag: title
#: apiConsole.docbook:17
#, no-c-format
msgid "Console Object Methods"
msgstr "Metode objekta konzole"

#. Tag: title
#: apiConsole.docbook:19
#, no-c-format
msgid "log()"
msgstr "log()"

#. Tag: para
#: apiConsole.docbook:20
#, no-c-format
msgid "Print the given message of normal severity."
msgstr "Ispiši datu poruku prosječne ozbiljnosti."

#. Tag: funcprototype
#: apiConsole.docbook:24
#, no-c-format
msgid ""
"<funcdef>void <function>log</function></funcdef> <paramdef>string "
"<parameter>message</parameter></paramdef>"
msgstr ""
"<funcdef>void <function>log</function></funcdef> <paramdef>string "
"<parameter>poruka</parameter></paramdef>"

#. Tag: title
#: apiConsole.docbook:31
#, no-c-format
msgid "debug()"
msgstr "debug()"

#. Tag: para
#: apiConsole.docbook:32
#, no-c-format
msgid "Print the given debug message."
msgstr "Ispiši datu poruku za ispravljanje greške."

#. Tag: funcprototype
#: apiConsole.docbook:36
#, no-c-format
msgid ""
"<funcdef>void <function>debug</function></funcdef> <paramdef>string "
"<parameter>message</parameter></paramdef>"
msgstr ""
"<funcdef>void <function>debug</function></funcdef> <paramdef>string "
"<parameter>poruka</parameter></paramdef>"

#. Tag: title
#: apiConsole.docbook:43
#, no-c-format
msgid "error()"
msgstr "error()"

#. Tag: para
#: apiConsole.docbook:44
#, no-c-format
msgid "Print the given error message of high severity."
msgstr "Ispiši datu poruku o greški visokog stepena ozbiljnosti."

#. Tag: funcprototype
#: apiConsole.docbook:48
#, no-c-format
msgid ""
"<funcdef>void <function>error</function></funcdef> <paramdef>string "
"<parameter>message</parameter></paramdef>"
msgstr ""
"<funcdef>void <function>error</function></funcdef> <paramdef>string "
"<parameter>poruka</parameter></paramdef>"
