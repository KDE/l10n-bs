#. Tag: para
#: index.docbook:235
#, no-c-format
msgid ""
"Provinces or Territories by Capital: you are asked to find the name of a "
"province among a choice of 4 given its capital:"
msgstr ""
"Provincije ili teritorije po glavnom gradu: od vas se traži da pronađete ime "
"provincije među izborom od 4 sa zadanim glavnim gradom:"

#. Tag: screeninfo
#: index.docbook:238
#, no-c-format
msgid "<screeninfo>Guess a division from its capital</screeninfo>"
msgstr "<screeninfo>Pogodite diviziju pomoću njenog glavnog grada</screeninfo>"

#. Tag: phrase
#: index.docbook:244
#, no-c-format
msgid "<phrase>Guess a division from its capital</phrase>"
