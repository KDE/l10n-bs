msgstr "remove()"

#. Tag: para
#: apiDatastructure.docbook:126
#, no-c-format
msgid "Remove this connection."
msgstr "Ukloni ovu vezu."

#. Tag: funcprototype
#: apiDatastructure.docbook:127
#, no-c-format
msgid ""
"<funcdef>void <function>remove</function></funcdef> <paramdef></paramdef>"
msgstr ""
"<funcdef>void <function>remove</function></funcdef> <paramdef></paramdef>"

#. Tag: term
#: apiDatastructure.docbook:136
#, no-c-format
msgid "add_property(name, value)"
msgstr "add_property(name, value)"

#. Tag: para
#: apiDatastructure.docbook:138
#, no-c-format
msgid "Add a new property to the connection."
msgstr "Dodaj novo svojstvo vezi."

