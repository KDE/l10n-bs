msgid "ROLES_OF_TRANSLATORS"
msgstr "ULOGE_PREVODITELJA"

#. Tag: date
#: index.docbook:18
#, no-c-format
msgid "2013-12-05"
msgstr "2013-12-05"

#. Tag: releaseinfo
