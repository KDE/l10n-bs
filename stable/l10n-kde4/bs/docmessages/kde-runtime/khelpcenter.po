msgid "Originally developed by &Matthias.Elter; &Matthias.Elter.mail;"
msgstr "Razvio &Matthias.Elter; &Matthias.Elter.mail;"

#. Tag: para
#: index.docbook:882
#, no-c-format
msgid ""
"The current maintainer is &Cornelius.Schumacher; &Cornelius.Schumacher.mail;"
msgstr "Trenutno održava  &Cornelius.Schumacher; &Cornelius.Schumacher.mail;"

