#. Tag: title
#: man-plasmapkg.1.docbook:8
#, no-c-format
msgid "KDE User's Manual"
msgstr "KDE Korisnički priručnik"

#. Tag: date
#: man-plasmapkg.1.docbook:9
#, no-c-format
msgid "2012-12-05"
msgstr "2012-12-05"

#. Tag: productname
#: man-plasmapkg.1.docbook:10
#, no-c-format
msgid "K Desktop Environment"
msgstr "K Desktop okruženje"

#. Tag: manvolnum
#: man-plasmapkg.1.docbook:15
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refpurpose
#: man-plasmapkg.1.docbook:20
#, no-c-format
msgid "Install, list, remove Plasma packages"
msgstr "Instalirajte, izlistajte, uklonite Plasma pakete"

#. Tag: cmdsynopsis
#: man-plasmapkg.1.docbook:24
#, no-c-format
msgid ""
"<command>plasmapkg</command> <group choice=\"opt\"><option>-h, --hash</"
"option> <replaceable> path</replaceable></group> <group choice=\"opt"
"\"><option>-g, --global</option></group> <group choice=\"opt\"><option>-t, --"
"type</option> <replaceable> type</replaceable></group> <group choice=\"opt"
"\"><option>-i, --install</option> <replaceable> path</replaceable></group> "
"<group choice=\"opt\"><option>-u, --upgrade</option> <replaceable> path</"
"replaceable></group> <group choice=\"opt\"><option>-l, --list</option></"
"group> <group choice=\"opt\"><option>--list-types</option></group> <group "
"choice=\"opt\"><option>-r, --remove</option> <replaceable> name</"
"replaceable></group> <group choice=\"opt\"><option>-p, --packageroot</"
"option> <replaceable> path</replaceable></group> <arg choice=\"opt\">KDE "
"Generic Options</arg> <arg choice=\"opt\">Qt Generic Options</arg>"
msgstr ""
"<command>plasmapkg</command> <group choice=\"opt\"><option>-h, --hash</"
"option> <replaceable> put</replaceable></group> <group choice=\"opt"
"\"><option>-g, --global</option></group> <group choice=\"opt\"><option>-t, --"
"type</option> <replaceable> tip</replaceable></group> <group choice=\"opt"
"\"><option>-i, --install</option> <replaceable> put</replaceable></group> "
"<group choice=\"opt\"><option>-u, --upgrade</option> <replaceable> put</"
"replaceable></group> <group choice=\"opt\"><option>-l, --list</option></"
"group> <group choice=\"opt\"><option>--list-types</option></group> <group "
"choice=\"opt\"><option>-r, --remove</option> <replaceable>name</"
"replaceable></group> <group choice=\"opt\"><option>-p, --packageroot</"
"option> <replaceable> put</replaceable></group> <arg choice=\"opt\">KDE opće "
"opcije</arg> <arg choice=\"opt\">Qt opće opcije</arg>"

#. Tag: title
#: man-plasmapkg.1.docbook:42
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-plasmapkg.1.docbook:43
#, no-c-format
msgid ""
"<command>plasmapkg</command> is a command line tool to install, list, remove "
"Plasma packages."
msgstr ""
"<command>plasmapkg</command> je komandna linija alata za instaliranje, "
"izlistanje, uklonjanje Plasma paketa."

#. Tag: title
#: man-plasmapkg.1.docbook:49
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: term
#: man-plasmapkg.1.docbook:53
#, no-c-format
msgid "<option>-h, --hash</option> <replaceable> path</replaceable>"
msgstr "<option>-h, --hash</option> <replaceable> put</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:54
#, no-c-format
msgid "Generate a SHA1 hash for the package at <quote>path</quote>."
msgstr "Generirajte SHA1 hash za paket na <quote>path</quote>."

#. Tag: option
#: man-plasmapkg.1.docbook:57
#, no-c-format
msgid "-g, --global"
msgstr "-g, --global"

#. Tag: para
#: man-plasmapkg.1.docbook:58
#, no-c-format
msgid "For install or remove, operates on packages installed for all users."
msgstr ""
"Za instaliranje ili uklanjanje, radi nad paketima instaliranim za sve "
"korisnike."

#. Tag: term
#: man-plasmapkg.1.docbook:61
#, no-c-format
msgid "<option>-t, --type</option> <replaceable> type</replaceable>"
msgstr "<option>-t, --type</option> <replaceable> tip</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:62
#, no-c-format
msgid ""
"The type of package, &eg; theme, wallpaper, plasmoid, dataengine, runner, "
"layout-template, &etc; [plasmoid]."
msgstr ""
"Tim paketa , &eg; tema, pozadina, plasmoid, dataengine, runner, raspored "
"šablona, &etc; [plasmoid]."

#. Tag: term
#: man-plasmapkg.1.docbook:65
#, no-c-format
msgid "<option>-i, --install</option> <replaceable> path</replaceable>"
msgstr "<option>-i, --install</option> <replaceable> put</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:66
#, no-c-format
msgid "Install the package at <quote>path</quote>."
msgstr "Instaliraj paket na <quote>put</quote>."

#. Tag: term
#: man-plasmapkg.1.docbook:69
#, no-c-format
msgid "<option>-u, --upgrade</option> <replaceable> path</replaceable>"
msgstr "<option>-u, --upgrade</option> <replaceable> put</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:70
#, no-c-format
msgid "Upgrade the package at <quote>path</quote>."
msgstr "Unaprijedi paket na <quote>path</quote>."

#. Tag: option
#: man-plasmapkg.1.docbook:73
#, no-c-format
msgid "-l, --list"
msgstr "-l, --list"

#. Tag: para
#: man-plasmapkg.1.docbook:74
#, no-c-format
msgid "List installed packages."
msgstr "Lista instaliranih paketa."

#. Tag: term
#: man-plasmapkg.1.docbook:77
#, no-c-format
msgid "<option>-r, --remove</option> <replaceable> name</replaceable>"
msgstr "<option>-r, --remove</option> <replaceable> ime</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:78
#, no-c-format
msgid "Remove the package named <quote>name</quote>."
msgstr "Ukloni paket nazvan <quote>ime</quote>."

#. Tag: term
#: man-plasmapkg.1.docbook:81
#, no-c-format
msgid "<option>-p, --packageroot</option> <replaceable> path</replaceable>"
msgstr "<option>-p, --packageroot</option> <replaceable> put</replaceable>"

#. Tag: para
#: man-plasmapkg.1.docbook:82
#, no-c-format
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this &kde; session will be searched instead."
msgstr ""
"Apsolutna putanja do korijena paketa. Ako nije isporučen, onda će se "
"standardni podaci direktorije za &kde;  za ovu sesiju tražiti."

#. Tag: title
#: man-plasmapkg.1.docbook:91
#, no-c-format
msgid "See Also"
msgstr "Pogledajte i"

#. Tag: para
#: man-plasmapkg.1.docbook:93
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/plasma-"
"desktop\">help:/plasma-desktop</ulink> (either enter this <acronym>URL</"
"acronym> into &konqueror;, or run <userinput><command>khelpcenter</command> "
"<parameter>help:/plasma-desktop</parameter></userinput>)."
msgstr ""
"Detaljnija korisnička dokumentacija je dostupna na <ulink url=\"help:/plasma-"
"desktop\">help:/plasma-desktop</ulink> (ili unesite ovo <acronym>URL</"
"acronym> into &konqueror;, ili pokrenite <userinput><command>khelpcenter</"
"command> <parameter>help:/plasma-desktop</parameter></userinput>)."

#. Tag: title
#: man-plasmapkg.1.docbook:102
#, no-c-format
msgid "Authors"
msgstr "Autori"

#. Tag: para
#: man-plasmapkg.1.docbook:103
#, no-c-format
msgid ""
"<command>plasmapkg</command> was written by <personname><firstname>Aaron</"
"firstname><surname>Seigo</surname></personname> <email>aseigo@kde.org</"
"email>."
msgstr ""
"<command>plasmapkg</command> je napisana od strane "
"<personname><firstname>Aaron</firstname><surname>Seigo</surname></"
"personname> <email>aseigo@kde.org</email>."
