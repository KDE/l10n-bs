#. Tag: title
#: man-nepomukserver.8.docbook:34
#, no-c-format
msgid "Synopsis"
msgstr "Sinopsis"

#. Tag: cmdsynopsis
#: man-nepomukserver.8.docbook:36
#, no-c-format
msgid ""
"<command>nepomukserver</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Generic options</arg> <arg choice=\"opt\">&Qt;-options</arg> "
"<arg choice=\"opt\">&kde;-options</arg>"
msgstr ""
"<command>nepomukserver</command> <arg choice=\"opt\">--help</arg> <arg "
"choice=\"opt\">Opće opcije</arg> <arg choice=\"opt\">&Qt;-options</arg> <arg "
"choice=\"opt\">&kde;-opcije</arg>"

#. Tag: title
#: man-nepomukserver.8.docbook:47
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-nepomukserver.8.docbook:49
#, no-c-format
msgid ""
"<command>nepomukserver</command> starts the Nepomuk server which manages all "
"Nepomuk services and provides a DBus API."
msgstr ""
"<command>nepomukserver</command> počinje Nepomuk server koji upravlja svim "
"Nepomuk uslugama i pruža DBus API."

#. Tag: para
#: man-nepomukserver.8.docbook:53
#, no-c-format
msgid ""
"It uses <command>nepomukservicestub</command> to run all configured Nepomuk "
"services."
msgstr ""
"Koristi <command>nepomukservicestub</command> da pokrene sve konfiguracije "
"Nepomuk usluga."

