msgid "ROLES_OF_TRANSLATORS"
msgstr "ULOGE_PREVODITELJA"

#. Tag: date
#: index.docbook:17
#, no-c-format
msgid "2013-12-05"
msgstr "2013-12-05"

#. Tag: releaseinfo
#: index.docbook:18
#, no-c-format
msgid "&kde; 4.12"
msgstr "&kde; 4.12"

#. Tag: keyword
#: index.docbook:21
#, no-c-format
