msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref=\"mail-tagged."
"png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>Pogled oznaka</"
"phrase> </textobject> </inlinemediaobject> </guiicon> Oznake: Specijalni "
"računi koji nude dodatni način Kategorijama za grupisanje povezanih "
"transakcija."

#. Tag: para
#: firsttime.docbook:214
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref=\"payees_view."
"png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>Payees View</"
"phrase> </textobject> </inlinemediaobject> </guiicon> Payees: All Payees "
"used by &kappname;."
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref=\"payees_view."
"png\" format=\"PNG\"/> </imageobject> <textobject> <phrase>Pogled primaoca</"
"phrase> </textobject> </inlinemediaobject> </guiicon> Primatelji uplata: Svi "
"primatelji uplata korišteni od strane &kappname;."

#. Tag: para
#: firsttime.docbook:230
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"ledgers_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Ledgers View</phrase> </textobject> </inlinemediaobject> </guiicon> "
"Ledgers: Your account transactions."
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"ledgers_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Pogled knjiga</phrase> </textobject> </inlinemediaobject> </guiicon> "
"Finansijske knjige: Vaše transakcije."

#. Tag: para
#: firsttime.docbook:246
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"investments_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Investments View</phrase> </textobject> </inlinemediaobject> </"
"guiicon> Investments: Your portfolio summary."
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"investments_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Pogled investicija</phrase> </textobject> </inlinemediaobject> </"
"guiicon> Ulaganja: Sažetak vašeg portfolia."

#. Tag: para
#: firsttime.docbook:262
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"reports_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Reports View</phrase> </textobject> </inlinemediaobject> </guiicon> "
"Reports: A collection of useful reports, providing alternate views of your "
"financial data."
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"reports_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Pogled izvještaja</phrase> </textobject> </inlinemediaobject> </"
"guiicon> Izvještaji: Skup korisnih izvještaja, pruža drugačije prikaze vaših "
"finansijskih podataka."

#. Tag: para
#: firsttime.docbook:279
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"budgets_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Budgets View</phrase> </textobject> </inlinemediaobject> </guiicon> "
"Budgets: Your budgets"
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"budgets_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Pogled budžeta</phrase> </textobject> </inlinemediaobject> </"
"guiicon> Budžeti: Vaši budžeti"

#. Tag: para
#: firsttime.docbook:295
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"forecast_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Forecast View</phrase> </textobject> </inlinemediaobject> </guiicon> "
"Forecast: This view provides a forecast of your accounts and categories"
msgstr ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref="
"\"forecast_view.png\" format=\"PNG\"/> </imageobject> <textobject> "
"<phrase>Pogled prognoze</phrase> </textobject> </inlinemediaobject> </"
"guiicon> Prognoza: Ovaj prikaz pruža prognozu vaših računa i kategorija"

#. Tag: para
#: firsttime.docbook:311
#, no-c-format
msgid ""
"<guiicon> <inlinemediaobject> <imageobject> <imagedata fileref=\"outbox_view."
