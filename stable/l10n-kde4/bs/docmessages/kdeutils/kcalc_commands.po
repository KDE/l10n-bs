#. Tag: title
#: commands.docbook:3
#, no-c-format
msgid "Command Reference"
msgstr "Reference za naredbe"

#. Tag: title
#: commands.docbook:6
#, no-c-format
msgid "Menu Items"
msgstr "Opcije menija"

#. Tag: para
#: commands.docbook:8
#, no-c-format
msgid "A brief overview of some special menu items in &kcalc;:"
msgstr "Kratak pregled nekih posebnih opcija izbornika u &kcalc;:"

#. Tag: menuchoice
#: commands.docbook:12
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Mathematics</guimenuitem>"
msgstr "<guimenu>Konstante</guimenu> <guimenuitem>Matematika</guimenuitem>"

#. Tag: action
#: commands.docbook:16
#, no-c-format
msgid "Display Pi, Euler Number or Golden Ratio."
msgstr "Prikaz broja Pi, Eulerov broj ili Zlatni Rez."

#. Tag: menuchoice
#: commands.docbook:21
#, no-c-format
msgid ""
"<guimenu>Constants</guimenu> <guimenuitem>Electromagnetism</guimenuitem>"
msgstr ""
"<guimenu> Konstante </guimenu> <guimenuitem> Elektromagnetizam </guimenuitem>"

#. Tag: action
#: commands.docbook:25
#, no-c-format
msgid ""
"Display Light Speed, Elementary Charge, Impedance of Vacuum, Permeability of "
"Vacuum or Permittivity of Vacuum."
msgstr ""
"Prikaz brzine svjetlosti, elementarnog naboja, impedanse vakuuma, "
"permeabilnosti vakuuma, ili dielektrične konstante vakuuma."

#. Tag: menuchoice
#: commands.docbook:31
#, no-c-format
msgid ""
"<guimenu>Constants</guimenu> <guimenuitem>Atomic &amp; Nuclear</guimenuitem>"
msgstr ""
"<guimenu> Konstante </guimenu> <guimenuitem>Atomska &amp; Nuklearna </"
"guimenuitem>"

#. Tag: action
#: commands.docbook:35
#, no-c-format
msgid ""
"Display Planck's Constant, Elementary Charge or Fine-Structure Constant."
msgstr ""
"Prikaz Plankove konstante, elementarnog naboja ili konstante fine strukture."

#. Tag: menuchoice
#: commands.docbook:41
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Thermodynamics</guimenuitem>"
msgstr ""
"<guimenu> Konstante </guimenu> <guimenuitem> Termodinamika </guimenuitem>"

#. Tag: action
#: commands.docbook:45
#, no-c-format
msgid ""
"Display Boltzmann Constant, Atomic Mass Unit, Molar Gas Constant, Stefan-"
"Boltzmann Constant or Avogadro's Number."
msgstr ""
"Prikaz Boltzmanove konstante, jedinice atomske mase, molarne mase konstante, "
"Stefan-Boltzmannove konstante ili Avogadrovog broja."

#. Tag: menuchoice
#: commands.docbook:51
#, no-c-format
msgid "<guimenu>Constants</guimenu> <guimenuitem>Gravitation</guimenuitem>"
msgstr "<guimenu>Konstante</guimenu> <guimenuitem>Gravitacija</guimenuitem>"

#. Tag: para
#: commands.docbook:55
#, no-c-format
msgid "Display Constant of Gravitation or Earth Acceleration."
msgstr "Prikaz gravitacione konstante ili Zemljinog ubrzanja."

#. Tag: menuchoice
#: commands.docbook:60
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Simple Mode</guimenuitem>"
msgstr "<guimenu>Postavke</guimenu> <guimenuitem>Simple Mode</guimenuitem>"

#. Tag: action
#: commands.docbook:64
#, no-c-format
msgid "Displays the simple math buttons."
msgstr "Prikaz jednostavnih matematičkih tipki."

#. Tag: menuchoice
#: commands.docbook:69
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Science Mode</guimenuitem>"
msgstr "<guimenu>Postavke</guimenu> <guimenuitem>Naučni režim</guimenuitem>"

#. Tag: action
#: commands.docbook:73
#, no-c-format
msgid "Displays trigonometric and science buttons."
msgstr "Prikaz trigonometrijskih i naučnih tipki."

#. Tag: menuchoice
#: commands.docbook:78
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Statistic Mode</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Statistički režim</guimenuitem>"

#. Tag: action
#: commands.docbook:82
#, no-c-format
msgid "Displays <link linkend=\"statistical-mode\">statistic buttons.</link>"
msgstr ""
"Prikazuje <link linkend=\"statistical-mode\">statistička dugmad.</link>"

#. Tag: menuchoice
#: commands.docbook:88
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Numeral System Mode</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Režim brojnih sistema</guimenuitem>"

#. Tag: action
#: commands.docbook:92
#, no-c-format
msgid ""
"Displays <link linkend=\"and-or-xor\">logic buttons</link> and allows "
"changing the numeral system."
msgstr ""
"Prikazuje <link linkend=\"and-or-xor\">logičku dugmad</link> i omogućava "
"mijenjanje cifri."

#. Tag: menuchoice
#: commands.docbook:98
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Constants Buttons</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Konstantne tipke</guimenuitem>"

#. Tag: action
#: commands.docbook:102
#, no-c-format
msgid ""
"Display constants buttons. They are available in <link linkend=\"science-mode"
"\">science mode</link> and <link linkend=\"statistical-mode\">statistic "
"mode</link>."
msgstr ""
"Prikazuje dugmad konstanti. Oni su dostupni u <link linkend=\"science-mode"
"\"> naučnom režimu </link> i <link linkend = \"statistical-mode"
"\">statističkom režimu </link>."

#. Tag: menuchoice
#: commands.docbook:108
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Bit Edit</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Prikaži editovanje bita</"
"guimenuitem>"

#. Tag: action
#: commands.docbook:112
#, no-c-format
msgid ""
"Displays a bit edit field. Click on a bit to toggle it. Only available in "
"<link linkend=\"numeral-system-mode\">numeral system mode</link>."
msgstr ""
"Prikaz polja za izmjenu bita.  Kliknite na bit da ga prebacite. Dostupno "
"samo u <link linkend = \"numeral-system-mode\">režimu brojnih sistema </"
"link>."

#. Tag: para
#: commands.docbook:119
#, no-c-format
msgid ""
"Additionally &kcalc; has the common &kde; <guimenu>File</guimenu>, "
"<guimenu>Edit</guimenu>, <guimenu>Settings</guimenu> and <guimenu>Help</"
"guimenu> menu items, for more information read the sections about the <ulink "
"url=\"help:/fundamentals/ui.html#menus\">Menus</ulink> in the &kde; "
"Fundamentals."
msgstr ""
"Pored toga &kcalc; ima zajednički &kde; <guimenu> Datoteka </guimenu>, "
"<guimenu> Izmijeni </guimenu>, <guimenu> Postavke </guimenu> i <guimenu> "
"Pomoć </guimenu> opcije izbornika, za više informacija pročitajte odlomak o "
"<ulink url=\"help:/fundamentals/ui.html#menus\"> Izbornici </ulink> u &kde; "
"osnovama."
