#. Tag: para
#: index.docbook:36
#, no-c-format
msgid ""
"&ktimer; is an application for the &kde; environment that lets you start an "
"application after a certain amount of time has passed."
msgstr ""
"&ktimer; je aplikacija za  &kde; okruđženje koja omogućuje pokretanje "
"aplikacija nakon sto je neko vrijeme proslo."

#. Tag: keyword
#: index.docbook:43
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:44
#, no-c-format
