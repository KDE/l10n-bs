#. Tag: entry
#: hayes.docbook:103 hayes.docbook:344 hayes.docbook:584
#, no-c-format
msgid "Command"
msgstr "Komanda"

#. Tag: entry
#: hayes.docbook:104 hayes.docbook:345 hayes.docbook:585
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: entry
#: hayes.docbook:105 hayes.docbook:346 hayes.docbook:586
#, no-c-format
msgid "Comments"
msgstr "Komentari"

#. Tag: entry
#: hayes.docbook:110
#, no-c-format
msgid "<command>A0</command> or <command>A</command>"
msgstr "<command>A0</command> ili <command>A</command>"

#. Tag: entry
#: hayes.docbook:111
#, no-c-format
msgid "Answer incoming call"
msgstr "Odgovori na dolazni poziv"

#. Tag: entry
#: hayes.docbook:116
#, no-c-format
msgid "Repeat last command"
msgstr "Ponovi posljednju naredbu"

#. Tag: entry
#: hayes.docbook:117
#, no-c-format
msgid "Don't preface with <command>AT</command>. Enter usually aborts."
msgstr "Ne započinji sa <command>AT</command>. Unesi uobičajeni prekid."

#. Tag: entry
#: hayes.docbook:121
#, no-c-format
msgid "<command>B0</command> or <command>B</command>"
msgstr "<command>B0</command> ili <command>B</command>"

#. Tag: entry
#: hayes.docbook:122 hayes.docbook:127 hayes.docbook:132
#, no-c-format
msgid "Call negotiation"
msgstr "Pozovi pregovaranje"

#. Tag: entry
#: hayes.docbook:123
#, no-c-format
msgid "V32 Mode/CCITT Answer Seq."
msgstr "V32 Mode/CCITT Answer Seq."

#. Tag: entry
#: hayes.docbook:128
#, no-c-format
msgid "Bell 212A Answer Seq."
msgstr "Bell 212A Answer Seq."

#. Tag: entry
#: hayes.docbook:133
#, no-c-format
msgid "Verbose/Quiet On Answer"
msgstr "Verbalni/Tihi Odgovor"

#. Tag: entry
#: hayes.docbook:137
#, no-c-format
msgid "Dial"
msgstr "Zovi"

#. Tag: para
#: hayes.docbook:138
#, no-c-format
msgid "Dial the following number and then handshake in originate mode."
msgstr "Zovi sljedeći broj i rukuj se u izvornom modu."

#. Tag: para
#: hayes.docbook:142
#, no-c-format
msgid "Pulse Dial"
msgstr "Polsno pozivanje"

#. Tag: para
#: hayes.docbook:146
#, no-c-format
msgid "Touch Tone Dial"
msgstr "Dodirni Ton Pozivanja"

#. Tag: para
#: hayes.docbook:150
#, no-c-format
msgid "Wait for the second dial tone"
msgstr "Sačekaj drugi ton pozivanja"

#. Tag: para
#: hayes.docbook:154
#, no-c-format
msgid ""
"Pause for the time specified in register <varname>S8</varname> (usually 2 "
"seconds)"
msgstr ""
"Pauziraj onoliko vremena koliko je specificirano u registru <varname>S8</"
"varname> (obično 2 sekunde)"

#. Tag: para
#: hayes.docbook:159
#, no-c-format
msgid "Remain in command mode after dialing."
msgstr "Ostani u komandnom modu nakon pozivanja."

#. Tag: para
#: hayes.docbook:163
#, no-c-format
msgid ""
"Flash switch-hook (Hang up for a half second, as in transferring a call.)"
msgstr ""

#. Tag: para
#: hayes.docbook:168
#, no-c-format
msgid "Dial last number"
msgstr "Pozovi posljednji broj"

#. Tag: entry
#: hayes.docbook:173
#, no-c-format
msgid "<command>E0</command> or <command>E</command>"
msgstr "<command>E0</command> ili <command>E</command>"

#. Tag: entry
#: hayes.docbook:174
#, no-c-format
msgid "No Echo"
msgstr "Bez odziva"

#. Tag: entry
#: hayes.docbook:175
#, no-c-format
msgid "Will not echo commands to the computer"
msgstr "Nemoj se odazivati na komande kompjuteru"

#. Tag: entry
#: hayes.docbook:179
#, no-c-format
msgid "Echo"
msgstr "Odziv"

#. Tag: entry
#: hayes.docbook:180
#, no-c-format
msgid "Will echo commands to the computer (so one can see what one types)"
msgstr ""
"Odazivaj se na komande kompjuteru (tako da se može vidjeti ono što se piše)"

#. Tag: entry
#: hayes.docbook:185
#, no-c-format
msgid "Hook Status"
msgstr "Hook Status"

#. Tag: entry
#: hayes.docbook:186
#, no-c-format
msgid "On hook - Hang up"
msgstr ""

#. Tag: entry
#: hayes.docbook:190
#, no-c-format
msgid "Hook status"
msgstr "Hook status"

#. Tag: entry
#: hayes.docbook:191
#, no-c-format
msgid "Off hook - phone picked up"
msgstr ""

#. Tag: entry
#: hayes.docbook:194
#, no-c-format
msgid "<command>I0</command> or <command>I</command>"
msgstr "<command>I0</command> ili <command>I</command>"

#. Tag: entry
#: hayes.docbook:195
#, no-c-format
msgid "Inquiry, Information, or Interrogation"
msgstr "Upit, informacije, ili ispitivanje"

#. Tag: entry
#: hayes.docbook:196
#, no-c-format
msgid ""
"This command is very model specific. <command>I0</command> usually returns a "
"number or code, while higher numbers often provide much more useful "
"information."
msgstr ""
"Ova komanda je veoma specifična za model <command>I0</command> obično vraća "
"broj ili kod, dok veći brojevi obično nude mnogo korisnije informacije."

#. Tag: entry
#: hayes.docbook:201
#, no-c-format
msgid "<command>L0</command> or <command>L</command>"
msgstr "<command>L0</command> ili <command>L</command>"

#. Tag: entry
#: hayes.docbook:202
#, no-c-format
msgid ""
"Speaker Loudness. Modems with volume control knobs will not have these "
"options."
msgstr ""
"Glasnoća zvučnika. Modemi sa ručicama za kontrolu glasnoće neće imati ovu "
"opciju."

#. Tag: entry
#: hayes.docbook:204
#, no-c-format
msgid "Off or low volume"
msgstr "Ugasi ili smanji glasnoću"

#. Tag: entry
#: hayes.docbook:209
#, no-c-format
msgid "Low Volume"
msgstr "Smanjena glasnoća"

#. Tag: entry
#: hayes.docbook:214
#, no-c-format
msgid "Medium Volume"
msgstr "Srednje glasno"

#. Tag: entry
#: hayes.docbook:219
#, no-c-format
msgid "Loud or High Volume"
msgstr "Glasno ili jako glasno"

#. Tag: entry
#: hayes.docbook:222
#, no-c-format
msgid "<command>M0</command> or <command>M</command>"
msgstr "<command>M0</command> ili <command>M</command>"

#. Tag: entry
#: hayes.docbook:223
#, no-c-format
msgid "Speaker off"
msgstr "Isključi zvučnike"

#. Tag: entry
#: hayes.docbook:224
#, no-c-format
msgid "<command>M3</command> is also common, but different on many brands"
msgstr ""
"<command>M3</command> je također uobičajena komanda, ali se razlikuje na "
"različitim brendovima"

#. Tag: entry
#: hayes.docbook:230
#, no-c-format
msgid ""
"Speaker on until remote carrier detected (&ie; until the other modem is "
"heard)"
msgstr ""
"Uključi zvučnike dok ne detektuješ udaljeni nosač (&ie; dok ne čuješ drugi "
"modem)"

#. Tag: entry
#: hayes.docbook:236
#, no-c-format
msgid "Speaker is always on (data sounds are heard after CONNECT)"
msgstr ""
"Zvučnici su uvijek uključeni (čuju se zvuci podataka nakon KONEKTOVANO)"

#. Tag: entry
#: hayes.docbook:239
#, no-c-format
msgid "<command>N0</command> or <command>N</command>"
msgstr "<command>N0</command> ili <command>N</command>"

#. Tag: entry
#: hayes.docbook:240
#, no-c-format
msgid "Handshake Speed"
msgstr "Brzina rukovanja"

#. Tag: entry
#: hayes.docbook:241
#, no-c-format
msgid ""
"Handshake only at speed in <link linkend=\"hayes-s37\"><varname>S37</"
"varname></link>"
msgstr ""
"Rukuj se samo na brzini u <link linkend=\"hayes-s37\"><varname>S37</"
"varname></link>"

#. Tag: entry
#: hayes.docbook:246
#, no-c-format
msgid ""
"Handshake at highest speed larger than <link linkend=\"hayes-"
"s37\"><varname>S37</varname></link>"
msgstr ""
"Rukuj se na najvećim brzinama većim od <link linkend=\"hayes-"
"s37\"><varname>S37</varname></link>"

#. Tag: entry
#: hayes.docbook:249
#, no-c-format
msgid "<command>O0</command> or <command>O</command>"
msgstr "<command>O0</command> ili <command>O</command>"

#. Tag: entry
#: hayes.docbook:250
#, no-c-format
msgid "Return Online"
msgstr "Vrati se na mrežu"

#. Tag: entry
#: hayes.docbook:251
#, no-c-format
msgid ""
"See also <link linkend=\"hayes-basic-x1\"><command>X1</command></link> as "
"dial tone detection may be active."
msgstr ""
"Pogledajte također <link linkend=\"hayes-basic-x1\"><command>X1</command></"
"link> obzirom da bi ton pozivanja mogao biti aktivan."

#. Tag: entry
#: hayes.docbook:257
#, no-c-format
msgid "Return Online after an equalizer retrain sequence"
msgstr "Vrati se na mrežu nakon što ekvalajzer eternira sekvenu"

#. Tag: entry
#: hayes.docbook:260
#, no-c-format
msgid "<command>Q0</command> or <command>Q1</command>"
msgstr "<command>Q0</command> ili <command>Q1</command>"

#. Tag: entry
#: hayes.docbook:261 hayes.docbook:267
#, no-c-format
msgid "Quiet Mode"
msgstr "Tihi mod"

#. Tag: entry
#: hayes.docbook:262
#, no-c-format
msgid ""
"Off - Displays result codes, user sees command responses (&eg; "
"<computeroutput>OK</computeroutput>)"
msgstr ""
"Isključi - Prikazuje rezltujuće kodove, korisnik vidi odgovore na komande "
"(&eg; <computeroutput>OK</computeroutput>)"

#. Tag: entry
#: hayes.docbook:268
#, no-c-format
msgid "On - Result codes are suppressed, user does not see responses."
msgstr "Uključi - Rezultati kodova su potisnuti, korisnik ne vidi odgovore."

#. Tag: entry
#: hayes.docbook:274
#, no-c-format
msgid "Query the contents of S-register <replaceable>n</replaceable>"
msgstr "Upit na sadržaj S-registra <replaceable>n</replaceable>"

#. Tag: entry
#: hayes.docbook:279
#, no-c-format
msgid "Store"
msgstr "Spasi"

#. Tag: entry
#: hayes.docbook:280
#, no-c-format
msgid ""
"Store the value of <replaceable>r</replaceable> in S-register "
"<replaceable>n</replaceable>"
msgstr ""
"Spasi vrijednost <replaceable>r</replaceable> u S-registar <replaceable>n</"
"replaceable>"

#. Tag: entry
#: hayes.docbook:284
#, no-c-format
msgid "<command>V0</command> or <command>V</command>"
msgstr "<command>V0</command> ili <command>V</command>"

#. Tag: entry
#: hayes.docbook:285
#, no-c-format
msgid "Verbose"
msgstr "Detaljno"

#. Tag: entry
#: hayes.docbook:286
#, no-c-format
msgid "Numeric result codes"
msgstr "Brojčani kod rezultata"

#. Tag: entry
#: hayes.docbook:291
#, no-c-format
msgid ""
"English result codes (&eg; <computeroutput>CONNECT</computeroutput>, "
"<computeroutput>BUSY</computeroutput>, <computeroutput>NO CARRIER</"
"computeroutput> &etc;)"
msgstr ""
"Engleski kod rezultata (&eg; <computeroutput>POVEŽI</computeroutput>, "
"<computeroutput>ZAUZETO</computeroutput>, <computeroutput>BEZ NOSAČA</"
"computeroutput> &etc;)"

#. Tag: entry
#: hayes.docbook:297
#, no-c-format
msgid "<command>X0</command> or <command>X</command>"
msgstr "<command>X0</command> ili <command>X</command>"

#. Tag: entry
#: hayes.docbook:298
#, no-c-format
msgid "Smartmodem"
msgstr "Smartmodem"

#. Tag: entry
#: hayes.docbook:299
#, no-c-format
msgid "Hayes Smartmodem 300 compatible result codes"
msgstr "Hayes Smartmodem 300 kompatibilnih kodova rezultata"

#. Tag: entry
#: hayes.docbook:304
#, no-c-format
msgid ""
"Usually adds connection speed to basic result codes (&eg; "
"<computeroutput>CONNECT 1200</computeroutput>)"
msgstr ""
"Obično dodaje brzinu konekcije u bazni kod rezultata (&eg; "
"<computeroutput>POVEŽI 1200</computeroutput>)"

#. Tag: entry
#: hayes.docbook:310
#, no-c-format
msgid ""
"Usually adds dial tone detection (preventing blind dial, and sometimes "
"preventing <command>AT0</command>)"
msgstr ""
"Obično dodaje detekciju tona pozivanja (sprječavajući slijepi poziv, i "
"katkad sprječavajući <command>AT0</command>)"

#. Tag: entry
#: hayes.docbook:316
#, no-c-format
msgid "Usually adds busy signal detection"
msgstr "Obično dodaje detekciju signala zauzeća"

#. Tag: entry
#: hayes.docbook:321
#, no-c-format
msgid "Usually adds both busy signal and dial tone detection"
msgstr "Obično dodaje i detekciju signala zauzeća i tona pozivanja"

#. Tag: entry
#: hayes.docbook:324
#, no-c-format
msgid "<command>Z0</command> or <command>Z</command>"
msgstr "<command>Z0</command> ili <command>Z</command>"

#. Tag: entry
#: hayes.docbook:325
#, no-c-format
msgid "Reset"
msgstr "Ponovno postavljanje"

#. Tag: entry
#: hayes.docbook:326
#, no-c-format
msgid ""
"Reset modem to stored configuration. Use <command>Z0</command>, <command>Z1</"
"command> &etc; for multiple profiles. This is the same as <command>&amp;F</"
"command> for factory default on modems without <acronym>NVRAM</acronym> (non-"
"volatile memory)"
msgstr ""
