#. Tag: title
#: editor.docbook:5 editor.docbook:20
#, no-c-format
msgid "The Editor"
msgstr "Uređivač"

#. Tag: author
#: editor.docbook:7
#, no-c-format
msgid "<firstname>Tamara</firstname> <surname>King</surname>"
msgstr "<firstname>Tamara</firstname> <surname>King</surname>"

#. Tag: email
#: editor.docbook:11
#, no-c-format
msgid "tik@acm.org"
msgstr "tik@acm.org"

#. Tag: trans_comment
#: editor.docbook:15
#, no-c-format
msgid "ROLES_OF_TRANSLATORS"
msgstr "ULOGE PREVODIOCA"

#. Tag: para
#: editor.docbook:22
#, no-c-format
msgid ""
"The editor is based on &designer;, a tool for designing and implementing "
"user interfaces created by <ulink url=\"http://www.trolltech.com"
"\">Trolltech</ulink>. We have modified &designer; in the following ways:"
msgstr ""
"Editor je baziran na &designer;-u, alatu za dizajniranje i implementaciju "
"korisničkih interfejsa kreiranih od strane <ulink url=\"http://www.trolltech."
"com\">Trolltech-a</ulink>. Modificirali smo &designer; na sljedeće načine:"

#. Tag: para
#: editor.docbook:26
#, no-c-format
msgid "Its interface is much simpler"
msgstr "Njegov interfejs je mnogo jednostavniji"

#. Tag: para
#: editor.docbook:27
#, no-c-format
msgid "Built in our own widgets"
msgstr "Ugrađeno u naše dodatke"

#. Tag: para
#: editor.docbook:28
#, no-c-format
msgid "Added the ability to setup &kommander; Text"
msgstr "Dodana mogućnost da se postavi &kommander; tekst"

#. Tag: para
#: editor.docbook:29
#, no-c-format
msgid "Various other superficial changes"
msgstr "Razne druge površne izmjene"

#. Tag: para
#: editor.docbook:31
#, no-c-format
msgid ""
"For those of you already familiar with using &designer;, using the &kmdr-"
"editor; will be trivial."
msgstr ""
"Za vas koji ste već upoznati sa korištenjem &designer;-a, korištenje &kmdr-"
"editor;-a će biti trivijalno."

#. Tag: title
#: editor.docbook:36
#, no-c-format
msgid "Main Window"
msgstr "Glavni prozor"

#. Tag: para
#: editor.docbook:45
#, no-c-format
msgid ""
"Toolbars contain a number of buttons to provide quick access to number of "
"functions."
msgstr ""
"Trake alata koje sadrže veliki broj dugmadi koja omogućavaju brz pristup "
"brojnim funkcijama."

#. Tag: para
#: editor.docbook:46
#, no-c-format
msgid ""
"The File Overview displays all of the files. Use the search field to rapidly "
"switch between files."
msgstr ""
"File Overview prikazuje sve fajlove. Koristite search polje da brzo "
"prelazite sa jednog na drugi fajl."

#. Tag: para
#: editor.docbook:47
#, no-c-format
msgid ""
"The Object Explorer provides an overview of the relationships between the "
"widgets in a form. It is useful for selecting widgets in a form with a "
"complex layout."
msgstr ""
"Object Explorer omogućava pregled veza između dodataka u formi. Korisno je "
"za selektovanje dodataka na formi sa kompleksnim rasporedom."

#. Tag: para
#: editor.docbook:48
#, no-c-format
msgid ""
"The Property Editor is where the behavior and apperance of a widget is "
"changed."
msgstr "U Property Editoru se mijenja ponašanje i izgled dodatka."

#. Tag: para
#: editor.docbook:49
#, no-c-format
msgid "The Dialog Editor is where dialogs are created and edited."
msgstr "U Dialog Editoru se kreiraju i mijenjaju dijalozi."

#. Tag: title
#: editor.docbook:54
#, no-c-format
msgid "The File Menu"
msgstr "File Meni"

#. Tag: menuchoice
#: editor.docbook:58
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Datoteka</guimenu> <guimenuitem>Novo</guimenuitem>"

#. Tag: action
#: editor.docbook:65
#, no-c-format
msgid "Creates a new dialog"
msgstr "Pravi novi dijalog"

#. Tag: menuchoice
#: editor.docbook:68
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>Datoteka</guimenu> <guimenuitem>Otvori</guimenuitem>"

#. Tag: action
#: editor.docbook:75
#, no-c-format
msgid "Search the file system to open an existing dialog"
msgstr "Pretraži sistem fajlova da otvoriš postojeći dijalog"

#. Tag: menuchoice
#: editor.docbook:78
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr "<guimenu>File</guimenu> <guimenuitem>Zatvori</guimenuitem>"

#. Tag: action
#: editor.docbook:82
#, no-c-format
msgid "Closes the active dialog"
msgstr "Zatvara aktivni dijalog"

#. Tag: menuchoice
#: editor.docbook:85
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Snimi</guimenuitem>"

#. Tag: action
#: editor.docbook:92
#, no-c-format
msgid "Saves the active dialog"
msgstr "Snima aktivni dijalog"

#. Tag: menuchoice
#: editor.docbook:95
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As</guimenuitem>"
msgstr "<guimenu>File</guimenu> <guimenuitem>Snimi kao</guimenuitem>"

#. Tag: action
#: editor.docbook:99
#, no-c-format
msgid "Saves the active dialog with another name"
msgstr "Snima aktivni dijalog pod drugim imenom"

#. Tag: menuchoice
#: editor.docbook:102
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr "<guimenu>File</guimenu> <guimenuitem>Snimi sve</guimenuitem>"

#. Tag: action
#: editor.docbook:106
#, no-c-format
msgid "Saves all open dialogs"
msgstr "Snima sve otvorene dijaloge"

#. Tag: menuchoice
#: editor.docbook:109
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Recently Opened Files</guimenuitem>"
msgstr ""
"<guimenu>File</guimenu> <guimenuitem>Skoro otvarane datoteke</guimenuitem>"

#. Tag: action
#: editor.docbook:113
#, no-c-format
msgid ""
"Quick list of the last several files you've opened. This list will change "
"each time you open a file that is not on it with the oldest being bumped off "
"first."
msgstr ""
"Brza lista zadnjih nekoliko datoteka koje ste otvarali. Ova lista će se "
"mijenjati svaki put kad otvorite datoteku koja nije u njoj, a najstarija "
"otvarana će biti uklonjena s liste."

#. Tag: menuchoice
#: editor.docbook:116
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Exit</guimenuitem>"
msgstr "<guimenu>File</guimenu> <guimenuitem>Izađi</guimenuitem>"

#. Tag: para
#: editor.docbook:120
#, no-c-format
msgid "<action>Quits</action> &kommander;"
msgstr "<action>Zatvara</action> &kommander;"

#. Tag: title
#: editor.docbook:128
#, no-c-format
msgid "The Edit Menu"
msgstr "Uredi Meni"

#. Tag: menuchoice
#: editor.docbook:132
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Poništi</guimenuitem>"

#. Tag: action
#: editor.docbook:139
#, no-c-format
msgid "Undo the last action performed."
msgstr "Poništi posljednju izvršenu radnju."

#. Tag: menuchoice
#: editor.docbook:142
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Y</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Y</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Vrati poništeno</guimenuitem>"

#. Tag: action
#: editor.docbook:149
#, no-c-format
msgid "Redo the last action undone."
msgstr "Vrati posljednju poništenu akciju."

#. Tag: menuchoice
#: editor.docbook:152
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Izreži</guimenuitem>"

#. Tag: action
#: editor.docbook:159
#, no-c-format
msgid "Cut the current item and place it content on the clipboard."
msgstr "Izreži trenutni objekat i stavi u međuspremnik."

#. Tag: menuchoice
#: editor.docbook:162
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Kopiraj</guimenuitem>"

#. Tag: action
#: editor.docbook:169
#, no-c-format
msgid "Copy the current item to the clipbard."
msgstr "Kopiraj trenutni objekat u međuspremnik."

#. Tag: menuchoice
#: editor.docbook:172
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Zalijepi</guimenuitem>"

#. Tag: action
#: editor.docbook:179
#, no-c-format
msgid "Paste the contents of the clipboard at the current cursor position."
msgstr "Stavlja sadržaj iz međuspremnika na trenutnu poziciju kursora."

#. Tag: menuchoice
#: editor.docbook:182
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Delete</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Obriši</guimenuitem>"

#. Tag: action
#: editor.docbook:189
#, no-c-format
msgid "Delete the current item."
msgstr "Briše trenutni element."

#. Tag: menuchoice
#: editor.docbook:192
#, no-c-format
msgid ""
"<shortcut> <keycap>Del</keycap> </shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Select All</guimenuitem>"
msgstr ""
"<shortcut> <keycap>Del</keycap> </shortcut> <guimenu>Uredi</guimenu> "
"<guimenuitem>Označi sve</guimenuitem>"

#. Tag: action
#: editor.docbook:199
#, no-c-format
msgid "Select all of the items in the current dialog."
msgstr "Označava sve objekte u trenutnom dijalogu."

#. Tag: menuchoice
#: editor.docbook:202
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Check Accelerators</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Provjeri ubrzavače</"
"guimenuitem>"

#. Tag: action
#: editor.docbook:209
#, no-c-format
msgid "Verifies that all the accelerators are used only once."
msgstr "Verifikuje da su svi ubrzavači korišteni samo jednom."

#. Tag: menuchoice
#: editor.docbook:212
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Script Objects</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Skriptovni objekti</"
"guimenuitem>"

#. Tag: menuchoice
#: editor.docbook:222
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Slots</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Slotovi</guimenuitem>"

#. Tag: action
#: editor.docbook:226
#, no-c-format
msgid "Displays window to edit and create slots and functions."
msgstr "Prikazuje prozor da se urede i kreiraju slotovi i funkcije."

#. Tag: menuchoice
#: editor.docbook:229
#, no-c-format
