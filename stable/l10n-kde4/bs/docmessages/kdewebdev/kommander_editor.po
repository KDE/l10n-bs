msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Konektori</guimenuitem>"

#. Tag: action
#: editor.docbook:233
#, no-c-format
msgid "Displays the view and edit connections dialog."
msgstr "Prikazuje dijalog za preglede i uređivanje veza."

#. Tag: menuchoice
#: editor.docbook:236
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Form Setting</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem> Postavka forme </guimenuitem>"

#. Tag: action
#: editor.docbook:240
#, no-c-format
msgid "Displays the form setting dialog."
msgstr "Prikazuje dijalog za postavke forme."

#. Tag: menuchoice
#: editor.docbook:243
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Preferences</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Preference</guimenuitem>"

#. Tag: action
#: editor.docbook:247
#, no-c-format
msgid "Displays the preferences dialog."
msgstr "Prikazuje dijalog za preference"

