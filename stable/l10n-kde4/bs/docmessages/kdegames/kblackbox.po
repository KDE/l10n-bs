"                                2                         3"

#. Tag: para
#: index.docbook:153
#, no-c-format
msgid ""
"As mentioned above, a reflection occurs when a beam emerges from the same "
"point it was sent in. This can happen in several ways:"
msgstr ""
"Kao što je spomenuto iznad, reflekcija se javlja kada se zrak pojavi na "
"istom mjestu sa kojeg je poslan. Ovo se može desiti na više načina:"

#. Tag: screen
#: index.docbook:158
#, no-c-format
msgid ""
"- - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - O - - -         - - O - O - - -          - - - - - - - -\n"
"R * * * * - - - -         - - - * - - - -          O - - - - - - -\n"
"  - - - - O - - -         - - - * - - - -        R - - - - - - - -\n"
"  - - - - - - - -         - - - * - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - * - - - -          - - - - - - - -\n"
"  - - - - - - - -       R * * * * - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - O - - -          - - - - - - - -"
msgstr ""
"- - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - O - - -         - - O - O - - -          - - - - - - - -\n"
"R * * * * - - - -         - - - * - - - -          O - - - - - - -\n"
