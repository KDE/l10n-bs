#, no-c-format
msgid ""
"- - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - O - - -\n"
"  - - - - - - - -         - - - - O - - -        H * * * * - - - -\n"
"  - - - - - - - -       H * * * * O - - -          - - - * - - - -\n"
"  - - - - - - - -         - - - - O - - -          - - - O - - - -\n"
"H * * * O - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - - - - -"
msgstr ""
"- - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - O - - -\n"
"  - - - - - - - -         - - - - O - - -        H * * * * - - - -\n"
"  - - - - - - - -       H * * * * O - - -          - - - * - - - -\n"
"  - - - - - - - -         - - - - O - - -          - - - O - - - -\n"
"H * * * O - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - - - - -         - - - - - - - -          - - - - - - - -"

#. Tag: para
#: index.docbook:171
#, no-c-format
msgid ""
"Be sure to compare the second example of a hit with the first example of a "
"reflection."
msgstr ""
"Obavezno uporedite drugi primjer pogotka sa prvim primjerom refleksije."

#. Tag: title
#: index.docbook:177
#, no-c-format
msgid "Interface Overview"
msgstr "Pregled Sučelja"

#. Tag: title
#: index.docbook:180
#, no-c-format
msgid "Game Board Description"
msgstr "Opis igračke ploče"

#. Tag: screeninfo
#: index.docbook:183
#, no-c-format
msgid "<screeninfo>&kblackbox; Game Board</screeninfo>"
msgstr "<screeninfo>&kblackbox; Igračka ploča</screeninfo>"

#. Tag: phrase
#: index.docbook:189
#, no-c-format
msgid "<phrase>&kblackbox; Game Board</phrase>"
msgstr "<phrase>&kblackbox; Igračka ploča</phrase>"

#. Tag: para
#: index.docbook:194
#, no-c-format
msgid "The following types of field are found on the game board:"
msgstr "Sljedeći tipovi polja su nađeni na igračkoj ploči:"

#. Tag: interface
#: index.docbook:198
#, no-c-format
msgid "The big black box in the middle"
msgstr "Velika crna kutija u sredini"

#. Tag: para
#: index.docbook:199
#, no-c-format
msgid "Here you must mark the positions you think a ball is in."
msgstr "Ovdje morate označiti poziciju za koju mislite da je u njoj loptica."

#. Tag: interface
#: index.docbook:204
#, no-c-format
msgid "Lasers around the box"
msgstr "Laseri oko kutije"

#. Tag: para
#: index.docbook:205
#, no-c-format
msgid ""
"The lasers are shooting beams of light when switched on. Then, they "
"disappear and are replaced by an information about the interactions of the "
"laser beam with the balls in the black box."
msgstr ""
"Laseri ispaljuju zrake svjetla kada su uključeni. Onda, oni nestaju i "
"zamijenjeni su informacijom o interakciji laserske zrake i loptica u crnoj "
"kutiji."

#. Tag: interface
#: index.docbook:210
#, no-c-format
msgid "Balls"
msgstr "Loptice"

#. Tag: para
#: index.docbook:211
#, no-c-format
msgid ""
"<quote>There must be one there!</quote> you think. These mark where you "
"suspect a ball is placed in the black box."
msgstr ""
"<quote>Tamo mora biti jedna!</quote> mislite vi. Ta oznaka gdje sumnjate da "
"je loptica smještena u crnoj kutiji."

#. Tag: para
#: index.docbook:213
#, no-c-format
msgid ""
"At the end of the game, the right and wrong positions of the balls are also "
"marked with \"balls\"."
msgstr ""
"Na kraju igre, prave i pogrešne pozicije loptica su također označene sa "
"\"lopticama\"."

#. Tag: interface
#: index.docbook:218
#, no-c-format
msgid "Markers for \"free position\""
msgstr "Oznake za \"slobodna pozicija\""

#. Tag: para
#: index.docbook:219
#, no-c-format
msgid ""
"You can use them to mark some positions where you are sure there is no ball."
msgstr ""
"Možete ih koristiti za oznaku nekih pozicija gdje mislite da nema loptice."

#. Tag: title
#: index.docbook:226
#, no-c-format
msgid "Menu Items"
msgstr "Stavke menija"

#. Tag: menuchoice
#: index.docbook:230
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Igra</guimenu> <guimenuitem>Nova</guimenuitem>"

#. Tag: para
#: index.docbook:236
#, no-c-format
msgid "Starts a new game (and abandons the current, if any.)"
msgstr "Pokreće novu igru (i napušta trenutnu, ako postoji)"

#. Tag: menuchoice
#: index.docbook:241
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Game</guimenu> "
"<guimenuitem>Pause</guimenuitem>"
msgstr ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Igra</guimenu> "
"<guimenuitem>Pauza</guimenuitem>"

#. Tag: para
#: index.docbook:245
#, no-c-format
msgid "Pause or continue the current game."
msgstr "Pauziraj ili nastavi trenutnu igru."

#. Tag: para
#: index.docbook:245
#, no-c-format
msgid "Note that the interaction results are hidden in a paused game."
msgstr "Primijetite da su interakcioni rezultati skriveni u pauziranoj igri."

#. Tag: menuchoice
#: index.docbook:249
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>Show High Scores</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> </"
"shortcut> <guimenu>Igra</guimenu> <guimenuitem>Prikaži rekorde</guimenuitem>"

#. Tag: para
#: index.docbook:255
#, no-c-format
msgid "Show the high score tables."
msgstr "Prikaži tabele rekorda."

#. Tag: menuchoice
#: index.docbook:259
#, no-c-format
msgid "<guimenu>Game</guimenu> <guimenuitem>Start Tutorial</guimenuitem>"
msgstr "<guimenu>Igra</guimenu> <guimenuitem>Pokreni vježbu</guimenuitem>"

#. Tag: para
#: index.docbook:262
#, no-c-format
msgid ""
"Start the tutorial of the game. This is a user friendly way to learn the "
"game rules."
msgstr ""
"Pokreni vježbu igre. Ovo je način prilagođen korisniku za učenje pravila "
"igre."

#. Tag: menuchoice
#: index.docbook:266
#, no-c-format
msgid "<guimenu>Game</guimenu> <guimenuitem>New Sandbox Game</guimenuitem>"
msgstr ""
"<guimenu>Igra</guimenu> <guimenuitem>Nova igra ograničene pouzdanosti</"
"guimenuitem>"

#. Tag: para
#: index.docbook:269
#, no-c-format
msgid ""
"In this mode, the solution is displayed at the start of the game. This is "
"useful to understand the game principles."
msgstr ""
"U ovom modu, rješenje je prikazano na početku igre. Ovo je korisno za "
"shvatanje principa igre."

#. Tag: menuchoice
#: index.docbook:274
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Igra</guimenu> <guimenuitem>Izlaz</guimenuitem>"

#. Tag: para
#: index.docbook:283
#, no-c-format
msgid "This closes the window and quits &kblackbox;."
msgstr "Ovo zatvara prozor i napušta &kblackbox;."

#. Tag: menuchoice
#: index.docbook:289
#, no-c-format
msgid "<guimenu>Move</guimenu> <guimenuitem>Solve</guimenuitem>"
msgstr "<guimenu>Pomjeri</guimenu> <guimenuitem>Riješi</guimenuitem>"

#. Tag: para
#: index.docbook:295
#, no-c-format
msgid ""
"Use it to give up a game. It shows you the solution: the right positions of "
"the balls."
msgstr ""
"Iskoristite za odustajanje od igre. Pokaže vam rješenje: pravu poziciju "
"loptica."

#. Tag: menuchoice
#: index.docbook:300
#, no-c-format
msgid "<guimenu>Move</guimenu> <guimenuitem>Done!</guimenuitem>"
msgstr "<guimenu>Pomjeri</guimenu> <guimenuitem>Završeno!</guimenuitem>"

#. Tag: para
#: index.docbook:302
#, no-c-format
msgid ""
"When you placed all the balls, choose \"Done!\" to terminate the current "
"game, to compute the final score and to display the real positions of the "
"balls."
msgstr ""
"Kada ste postavili sve loptice, izaberite \"Završeno!\" za završavanje "
"trenutne igre, za proračunavanje krajnjeg rezultata i za prikaz prave "
"pozicije loptica."

#. Tag: menuchoice
#: index.docbook:308
#, no-c-format
msgid "<guimenu>Settings</guimenu><guisubmenu>Difficulty</guisubmenu>"
msgstr "<guimenu>Podešavanja</guimenu><guisubmenu>Težina</guisubmenu>"

#. Tag: para
#: index.docbook:313
#, no-c-format
msgid ""
"Select the game difficulty. Harder games have more balls and bigger black "
"box than easier games. You can also play with a custom difficulty level that "
"you can set up in the setting dialog of &kblackbox;."
msgstr ""
"Izaberite težinu igre. Teže igre imaju više loptica i veće crne kutije nego "
"li lakše igre. Možete također igrati i sa podešenom težinom nivoa koji "
"možete podesiti u postavkama dijaloga &kblackbox;-a."

#. Tag: para
#: index.docbook:314
#, no-c-format
msgid ""
"Note: games with 4 balls or less can always be solved with certainty! That "
"is not the case for games with 5 balls or more."
msgstr ""
"Napomena: igre sa 4 loptice ili manje uvijek mogu biti riješene sa "
"sigurnošću! To nije slučaj za igre sa 5 loptica i više."

#. Tag: para
#: index.docbook:319
#, no-c-format
msgid ""
"Additionally &kblackbox; has the common &kde; <guimenu>Settings</guimenu> "
"and <guimenu>Help</guimenu> menu items, for more information read the "
"sections about the <ulink url=\"help:/fundamentals/ui.html#menus-settings"
"\">Settings Menu</ulink> and <ulink url=\"help:/fundamentals/ui.html#menus-"
"help\">Help Menu</ulink> of the &kde; Fundamentals."
msgstr ""
"Dodatno &kblackbox; ima uobičajne &kde; <guimenu>Postavke</guimenu> i "
"<guimenu>Pomoć</guimenu> meni stavke, za više informacija pročitajte "
"dijelove o <ulink url=\"help:/fundamentals/ui.html#menus-settings\">Postavke "
"meni</ulink> i <ulink url=\"help:/fundamentals/ui.html#menus-help\">Pomoć "
"meni</ulink> o &kde; osnovama."

#. Tag: title
#: index.docbook:328
#, no-c-format
msgid "Frequently asked questions"
msgstr "Često postavljena pitanja"

#. Tag: para
#: index.docbook:333
#, no-c-format
msgid "Can I use the keyboard to play this game?"
msgstr "Da li mogu koristiti tastaturu da igram ovu igru ?"

#. Tag: para
#: index.docbook:334
#, no-c-format
msgid ""
"Yes. You can use the directional keys to control the cursor, &Enter; to "
"place and remove balls, and <keycap>Spacebar</keycap> to place 'empty' marks."
msgstr ""
"Da. Možete koristiti tipke usmjerenja za kontrolu pokazivača, &Enter; za "
"postavljanje i uklanjanje loptica, i <keycap>Spacebar</keycap> za "
"postavljanje 'praznih' oznaka."

#. Tag: para
#: index.docbook:337
#, no-c-format
msgid ""
"I have to quit the game now, but I am not finished yet. Can I save my "
"progress?"
msgstr ""
"Moram da napustim igru, ali još nisam završio. Da li mogu da snimim napredak?"

#. Tag: para
#: index.docbook:338
#, no-c-format
msgid "&kblackbox; has no save feature at the moment."
msgstr "&kblackbox; u ovom trenutku nema mogućnost spašavanja."

