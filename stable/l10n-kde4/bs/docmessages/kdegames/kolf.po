#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Prikaži statusnu traku</guimenuitem>"

