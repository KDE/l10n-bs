#, no-c-format
msgid "<guimenu>Go</guimenu> <guimenuitem>Random Hole</guimenuitem>"
msgstr ""
"<guimenu>Idi</guimenu> <guimenuitem>Nasumično odabrana rupa</guimenuitem>"

#. Tag: action
