msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Igra</guimenu><guimenuitem>Izađi</guimenuitem>"

#. Tag: para
#: index.docbook:339
#, no-c-format
msgid "<action>Quit</action> &kappname;"
msgstr "<action>Izađi</action> &kappname;"

