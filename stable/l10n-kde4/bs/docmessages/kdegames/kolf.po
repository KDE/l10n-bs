#. Tag: para
#: index.docbook:357
#, no-c-format
msgid "<action>Switch to editing mode</action> to edit the current hole."
msgstr "<action>Prebaci se u mod uređivanja</action> da uredite trenutnu rupu."

#. Tag: menuchoice
#: index.docbook:362
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo> </shortcut> <guimenu>Hole</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo> </shortcut> <guimenu>Rupa</guimenu> <guimenuitem>Nova</guimenuitem>"

#. Tag: para
#: index.docbook:369
#, no-c-format
msgid "<action>Create a new hole.</action> (Only while editing.)"
msgstr "<action>Kreiraj novu rupu.</action> (Samo prilikom uređivanja.)"

#. Tag: menuchoice
#: index.docbook:374
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap> </"
"keycombo></shortcut> <guimenu>Hole</guimenu> <guimenuitem>Clear</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap> </"
"keycombo></shortcut> <guimenu>Rupa</guimenu> <guimenuitem>Ukloni sve</"
"guimenuitem>"

#. Tag: para
#: index.docbook:381
#, no-c-format
msgid ""
"<action>Remove all objects from the current hole.</action> (Only while "
"editing.)"
msgstr ""
"<action>Ukloni sve objekte iz trenutne rupe.</action> (Samo prilikom "
"uređivanja.)"

#. Tag: menuchoice
#: index.docbook:387
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Reset</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Rupa</guimenu> <guimenuitem>Resetuj</guimenuitem>"

#. Tag: para
#: index.docbook:394
#, no-c-format
msgid ""
"<action>Reset the current hole to its starting position</action>, so that "
"you can start over."
msgstr ""
"<action>Postaviti rupu na njenu početnu poziciju</action>, tako da možete "
"ponovo započeti."

#. Tag: menuchoice
#: index.docbook:400
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Show Info</guimenuitem>"
msgstr ""
