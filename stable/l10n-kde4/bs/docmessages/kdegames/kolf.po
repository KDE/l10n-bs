"shortcut> <guimenu>Rupa</guimenu> <guimenuitem>Prikaži Informacije</"
"guimenuitem>"

#. Tag: action
#: index.docbook:407
#, no-c-format
msgid "Show information about objects on the current hole."
msgstr "Prikaži informacije o objektima na trenutnoj rupi."

#. Tag: menuchoice
#: index.docbook:412
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Undo Shot</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Rupa</guimenu> <guimenuitem>Poništi Udarac</guimenuitem>"

#. Tag: action
#: index.docbook:419
#, no-c-format
msgid "Undo the last shot you made."
msgstr "Poništava vaš posljednji udarac."

