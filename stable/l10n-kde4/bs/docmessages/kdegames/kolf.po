#, no-c-format
msgid "The Settings Menu"
msgstr "Postavke Meni"

#. Tag: menuchoice
#: index.docbook:507
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Prikaži alatnu traku</guimenuitem>"

