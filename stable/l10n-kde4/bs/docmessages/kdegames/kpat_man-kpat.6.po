"<arg choice=\"opt\" rep=\"repeat\">KDE-opcija</arg> <group choice=\"opt"
"\"><option>--solvegame</option> <replaceable> datoteka</replaceable></group> "
"<group choice=\"opt\"><option>--solve</option> <replaceable> num</"
"replaceable></group> <group choice=\"opt\"><option>--start</option> "
"<replaceable> num</replaceable></group> <group choice=\"opt\"><option>--end</"
