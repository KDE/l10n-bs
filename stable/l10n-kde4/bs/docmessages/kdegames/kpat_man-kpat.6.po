msgid "Show version information and exit."
msgstr "Prikaži verziju informacije i izađi."

#. Tag: title
#: man-kpat.6.docbook:110
#, no-c-format
msgid "Qt Options"
msgstr "Qt Opcije"

#. Tag: option
#: man-kpat.6.docbook:114
#, no-c-format
msgid "--display <replaceable>displayname</replaceable>"
msgstr "--display <replaceable>prikaz imena</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:116
#, no-c-format
msgid "Use the X-server display <emphasis>displayname</emphasis>."
msgstr "Koristi X-server prikaz <emphasis>prikaz imena</emphasis>."

#. Tag: option
#: man-kpat.6.docbook:121
#, no-c-format
msgid "--session <replaceable>sessionId</replaceable>"
msgstr "--session <replaceable>sesijaId</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:123
#, no-c-format
msgid ""
"Restore the application for the given <replaceable>sessionId</replaceable>."
msgstr "Povratiti aplikaciju za dato <replaceable>sesijaId</replaceable>."

#. Tag: option
#: man-kpat.6.docbook:130
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-kpat.6.docbook:132
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display."
msgstr "Uzrokuje da aplikacija instalira privatnu mapu boja na 8-bitni ekran."

#. Tag: option
#: man-kpat.6.docbook:140
#, no-c-format
msgid "--ncols <replaceable>count</replaceable>"
msgstr "--ncols <replaceable>broji</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:142
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on a 8-bit display, "
"if the application is using the <methodname>QApplication::ManyColor</"
"methodname> color specification."
msgstr ""
"Ograničava broj boja dodijeljenih u kocki boje na 8-bitnom zaslonu, ako "
"aplikacija koristi <methodname> QApplication :: ManyColor </methodname> "
"specifikaciju boje."

#. Tag: option
#: man-kpat.6.docbook:151
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-kpat.6.docbook:153
#, no-c-format
msgid "tells Qt to never grab the mouse or the keyboard."
msgstr "govori QT da nikada ne uhvati miš ili tastaturu."

#. Tag: option
#: man-kpat.6.docbook:157
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-kpat.6.docbook:159
#, no-c-format
msgid ""
"running under a debugger can cause an implicit <option>-nograb</option>, use "
"<option>-dograb</option> to override."
msgstr ""
"pokrenuto pod debugger-om može izazvati implicitne <option>-nograb </"
"option>, koristiti<option>-dograb </option> da bi oborilii."

#. Tag: option
#: man-kpat.6.docbook:167
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-kpat.6.docbook:169
#, no-c-format
msgid "switches to synchronous mode for debugging."
msgstr "prelazi u sinhroni mod za ispravljanje pogrešaka."

#. Tag: term
#: man-kpat.6.docbook:173
#, no-c-format
msgid ""
"<option>--fn</option>, <option>--font <replaceable>fontname</replaceable></"
"option>"
msgstr ""
"<option>--fn</option>, <option>--font <replaceable>fontname</replaceable></"
"option>"

#. Tag: para
#: man-kpat.6.docbook:175
#, no-c-format
msgid "defines the application font."
msgstr "definira font aplikacije."

#. Tag: term
#: man-kpat.6.docbook:179
#, no-c-format
msgid ""
"<option>--bg</option>, <option>--background <replaceable>color</"
"replaceable></option>"
msgstr ""
"<option>--bg</option>, <option>--background <replaceable>boja</replaceable></"
"option>"

#. Tag: para
#: man-kpat.6.docbook:181
#, no-c-format
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"postavlja zadanu boju pozadine i paletu aplikacije (svijetle i tamne nijanse "
"su izračunate)."

#. Tag: term
#: man-kpat.6.docbook:189
#, no-c-format
msgid ""
"<option>--fg</option>,<option>--foreground <replaceable>color</replaceable></"
"option>"
msgstr ""
"<option>--fg</option>,<option>--foreground <replaceable>boja</replaceable></"
"option>"

#. Tag: para
#: man-kpat.6.docbook:191
#, no-c-format
msgid "sets the default foreground color."
msgstr "postavlja zadanu prednju boju."

#. Tag: term
#: man-kpat.6.docbook:195
#, no-c-format
msgid ""
"<option>--btn</option>, <option>--button <replaceable>color</replaceable></"
"option>"
msgstr ""
"<option>--btn</option>, <option>--button <replaceable>boja</replaceable></"
"option>"

#. Tag: para
#: man-kpat.6.docbook:197
#, no-c-format
msgid "sets the default button color."
msgstr "postavlja zadanu boju dugmeta."

#. Tag: option
#: man-kpat.6.docbook:201
#, no-c-format
msgid "--name <replaceable>name</replaceable>"
msgstr "--name <replaceable>ime</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:203
#, no-c-format
msgid "sets the application name."
msgstr "postavlja ime aplikacije."

#. Tag: option
#: man-kpat.6.docbook:207
#, no-c-format
msgid "--title <replaceable>title</replaceable>"
msgstr "--title <replaceable>naslov</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:209
#, no-c-format
msgid "sets the application title (caption)."
msgstr "postavlja naslov aplikacije (natpis)."

#. Tag: option
#: man-kpat.6.docbook:213
#, no-c-format
msgid "--visual <replaceable>TrueColor</replaceable>"
msgstr "--visual <replaceable>TrueColor</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:215
#, no-c-format
msgid "forces the application to use a TrueColor visual on an 8-bit display."
msgstr ""
"prisiljava aplikaciju da koristi TrueColor prikaz  na 8-bitnom zaslonu."

#. Tag: option
#: man-kpat.6.docbook:222
#, no-c-format
msgid "--inputstyle"
msgstr "--inputstyle"

#. Tag: para
#: man-kpat.6.docbook:224
#, no-c-format
msgid ""
"sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root."
msgstr ""
"postavlja XIM (X Input Method) stil ulaza. Moguće vrijednosti su na mjestu, "
"preko mjesta, iza mjesta i root."

#. Tag: option
#: man-kpat.6.docbook:232
#, no-c-format
msgid "--im <replaceable>XIM server</replaceable>"
msgstr "--im <replaceable>XIM server</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:234
#, no-c-format
msgid "set XIM server."
msgstr "postavlja XIM server."

#. Tag: option
#: man-kpat.6.docbook:238
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-kpat.6.docbook:240
#, no-c-format
msgid "disable XIM."
msgstr "onemogućiti XIM."

#. Tag: option
#: man-kpat.6.docbook:244
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-kpat.6.docbook:246
#, no-c-format
msgid "mirrors the whole layout of widgets."
msgstr "odražava cijeli raspored widgeta."

#. Tag: option
#: man-kpat.6.docbook:250
#, no-c-format
msgid "--stylesheet <replaceable>file.qss</replaceable>"
msgstr "--stylesheet <replaceable>file.qss</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:252
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets."
msgstr "primjenjuje Qt stil za prijavu widgeta."

#. Tag: option
#: man-kpat.6.docbook:256
#, no-c-format
msgid "--graphicssystem <replaceable>system</replaceable>"
msgstr "--graphicssystem <replaceable>sistem</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:258
#, no-c-format
msgid ""
"use a different graphics system instead of the default one, options are "
"<quote>raster</quote> and <quote>opengl</quote> (experimental)."
msgstr ""
"koristi različit grafički sistem umjesto zadanog, opcije su <quote>raster</"
"quote><quote>opengl </quote> (eksperimentalno)."

#. Tag: title
#: man-kpat.6.docbook:266
#, no-c-format
msgid "KDE Options"
msgstr "KDE Opcije"

#. Tag: option
#: man-kpat.6.docbook:269
#, no-c-format
msgid "--caption <replaceable>caption</replaceable>"
msgstr "--caption <replaceable>natpis</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:271
#, no-c-format
msgid "Use <emphasis>caption</emphasis> as name in the titlebar."
msgstr "Koristi <emphasis>natpis</emphasis> kao ime u naslovnom baru."

#. Tag: option
#: man-kpat.6.docbook:276
#, no-c-format
msgid "--icon <replaceable>icon</replaceable>"
msgstr "--icon <replaceable>ikona</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:278
#, no-c-format
msgid "Use <emphasis>icon</emphasis> as the application icon."
msgstr "Koristi <emphasis>ikonu</emphasis> kao ikonu aplikacije."

#. Tag: option
#: man-kpat.6.docbook:283
#, no-c-format
msgid "--config <replaceable>filename</replaceable>"
msgstr "--config <replaceable>imedatoteke</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:285
#, no-c-format
msgid "Use alternative configuration file."
msgstr "Koristi alternativnu konfiguracijsku datoteku."

#. Tag: option
#: man-kpat.6.docbook:292
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kpat.6.docbook:294
#, no-c-format
msgid "Disable crash handler, to get core dumps."
msgstr "Onemogućite upravitelja sudara, da se jezgra deponiraju na smetljište."

#. Tag: option
#: man-kpat.6.docbook:299
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kpat.6.docbook:301
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Čeka na WM_NET kompatibilni prozor menadžer."

#. Tag: option
#: man-kpat.6.docbook:308
#, no-c-format
msgid "--style <replaceable>style</replaceable>"
msgstr "--style <replaceable>stil</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:310
#, no-c-format
msgid "sets the application &GUI; style."
msgstr "postavlja aplikaciju &GUI; stil."

#. Tag: option
#: man-kpat.6.docbook:315
#, no-c-format
msgid "--geometry <replaceable>geometry</replaceable>"
msgstr "--geometry <replaceable>geometrija</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:317
#, no-c-format
msgid ""
"sets the client geometry of the main widget - see the manual page <ulink url="
"\"man:/X\">man:/X</ulink> for the argument format (usually WidthxHeight+XPos"
"+YPos)."
msgstr ""
"postavlja geometriju klijenta glavnog widgeta - pogledajte priručnik "
"stranicu <ulink url=\"man: /X\">man:/X</ulink>za format argumenta (obično "
"WidthxHeight + XPos + ypos)."

#. Tag: title
#: man-kpat.6.docbook:329
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: term
#: man-kpat.6.docbook:333
#, no-c-format
msgid "<option>--solvegame</option> <replaceable> file</replaceable>"
msgstr "<option>--solvegame</option> <replaceable> datoteka</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:335
#, no-c-format
msgid "Try to find a solution to the given savegame"
msgstr "Pokušati naći rješenje kako saćuvati igru"

#. Tag: term
#: man-kpat.6.docbook:340
#, no-c-format
msgid "<option>--solve</option> <replaceable> num</replaceable>"
msgstr "<option>--solve</option> <replaceable> num</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:342
#, no-c-format
msgid "Dealer to solve (debug)"
msgstr "Djelilac rješava (ispravljanje)"

#. Tag: term
#: man-kpat.6.docbook:347
#, no-c-format
msgid "<option>--start</option> <replaceable> num</replaceable>"
msgstr "<option>--start</option> <replaceable> num</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:349
#, no-c-format
msgid "Game range start (default 0:INT_MAX)"
msgstr "Početak opsega igre (default 0:INT_MAX)"

#. Tag: term
#: man-kpat.6.docbook:354
#, no-c-format
msgid "<option>--end</option> <replaceable> num</replaceable>"
msgstr "<option>--end</option> <replaceable> num</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:356
#, no-c-format
msgid "Game range end (default start:start if start given)"
msgstr "Kraj opsega igre (default 0:INT_MAX)"

#. Tag: term
#: man-kpat.6.docbook:361
#, no-c-format
msgid "<option>--gametype</option> <replaceable> game</replaceable>"
msgstr "<option>--gametype</option> <replaceable> igra</replaceable>"

#. Tag: para
#: man-kpat.6.docbook:363
#, no-c-format
msgid ""
"Skip the selection screen and load a particular game type. Valid values are: "
"acesup, fortyeight, freecell, golf, grandfather, grandfathersclock, gypsy, "
"klondike, mod3, simplesimon, spider, yukon"
msgstr ""
"Preskoči ekran za izbor i učitataj određeni tip igre. Važeće vrijednosti su: "
"acesup, fortyeight, FreeCell, golf, grandfather, grandfathersclock, gypsy,"
"klondike, mod3, simplesimon, pauk, yukon"

#. Tag: title
#: man-kpat.6.docbook:371
#, no-c-format
msgid "Arguments"
msgstr "Argumenti"

#. Tag: replaceable
#: man-kpat.6.docbook:375
#, no-c-format
msgid "file"
msgstr "datoteka"

#. Tag: para
#: man-kpat.6.docbook:377
#, no-c-format
msgid "File to load"
msgstr "Datoteka za učitavanje"

#. Tag: title
#: man-kpat.6.docbook:387
#, no-c-format
msgid "SEE ALSO"
msgstr "TOKOĐER POGLEDAJTE"

#. Tag: para
#: man-kpat.6.docbook:388
#, no-c-format
msgid ""
"&kpatience; is documented in detail in <emphasis>The &kpatience; Handbook</"
"emphasis> (<filename>$<envar>KDEDIR</envar>/share/doc/HTML/en/kpat/index."
"html</filename> or enter <userinput>help:/kpat/index.html</userinput> in "
"&konqueror;)."
msgstr ""
"&kpatience; je dokumentovan detaljno <emphasis>The &kpatience; Priručnik </"
"emphasis> (<filename>$<envar>KDEDIR</envar>/share/doc/HTML/en/kpat/index."
"html</filename> ili unesite <userinput> help:/kpat/index.html </userinput>in "
"&konqueror;)."

