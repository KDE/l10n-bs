msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kpat.6.docbook:73
#, no-c-format
msgid "Show Qt specific options"
msgstr "Prikaži Qt specifične opcije"

#. Tag: option
#: man-kpat.6.docbook:78
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kpat.6.docbook:80
#, no-c-format
msgid "Show &kde; specific options"
msgstr "Prikaži &kde; specifične opcije"

#. Tag: option
#: man-kpat.6.docbook:85
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kpat.6.docbook:87
#, no-c-format
msgid "Show all options"
msgstr "Prikaži sve opcije"

#. Tag: option
