"sljedećih kartica:"

#. Tag: guilabel
#: index.docbook:236
#, no-c-format
msgid "Display"
msgstr "Ekran"

#. Tag: para
#: index.docbook:237
#, no-c-format
msgid "Here you can change the &ksquares; color settings."
msgstr "Ovdje možete promijeniti &ksquares; postavke boje."

#. Tag: guilabel
#: index.docbook:240
#, no-c-format
msgid "Computer Player"
msgstr "Računarski igrač"

#. Tag: para
#: index.docbook:241
#, no-c-format
msgid "Use this tab to regulate the game difficulty."
msgstr "Koristite ovu karticu da regulišete težinu igre."

