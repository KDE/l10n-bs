#: imap4.cc:573
msgid "Message from %1 while processing '%2': %3"
msgstr "Poruka od %1 prilikom procesiranja '%2': %3"

#: imap4.cc:885
msgid "What do you want to store in this folder?"
msgstr "Šta želite smjestiti u ovaj direktorij?"

#: imap4.cc:885
msgid "Create Folder"
msgstr "Napravi direktorij"

#: imap4.cc:886
msgid "&Messages"
msgstr "&Poruke"

#: imap4.cc:886
msgid "&Subfolders"
msgstr "&Poddirektoriji"

#: imap4.cc:1179
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "Odjava sa direktorija %1 nije uspjela. Server je vratio: %2"

#: imap4.cc:1199
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "Prijava na direktorij %1 nije uspjela. Server je vratio: %2"

#: imap4.cc:1235 imap4.cc:1246
msgid "Changing the flags of message %1 failed."
msgstr "Izmjena oznaka poruke %1 nije uspjelo."

#: imap4.cc:1280
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Postavljanje ACL na direktoriju %1 za korisnika %2 nije uspjelo. Server je "
"vratio: %3"

#: imap4.cc:1298
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Brisanje ACL na direktoriju %1 za korisnika %2 nije uspjelo. Server je "
"vratio: %3"

#: imap4.cc:1314 imap4.cc:1339
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: "
"%2"
msgstr "Čitanje ACL na direktoriju %1 za nije uspjelo. Server je vratio: %2"

#: imap4.cc:1386 imap4.cc:1453
msgid "Unable to close mailbox."
msgstr "Ne mogu zatvoriti sanduče."

#: imap4.cc:1483
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Ne mogu dobiti informacije o direktoriju %1. Server je odgovorio: %2"

#: imap4.cc:1648
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Server %1 ne podržava ni IMAP4 ni IMAP4rev1.\n"
"Identifikovao se kao: %2"

#: imap4.cc:1659
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Server ne podržava TLS.\n"
"Isključite ovu sigurnosnu mogućnost da se spojite bez enkripcije."

#: imap4.cc:1684
msgid "Starting TLS failed."
msgstr "Pokretanje TLS nije uspjelo."

#: imap4.cc:1694
msgid "The authentication method %1 is not supported by the server."
msgstr "Metod provjere identiteta %1 nije podržano na serveru."

#: imap4.cc:1705
msgid "Username and password for your IMAP account:"
msgstr "Korisničko ime i šifra za vaš IMAP račun:"

#: imap4.cc:1719
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Ne mogu se prijaviti. Vjerovatno šifra nije ispravna.\n"
"Server je odgovorio:\n"
"%1"

#: imap4.cc:1725
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Ne mogu potvrditi identitet putem %1.\n"
"Server je odgovorio:\n"
"%2"

#: imap4.cc:2215
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Ne mogu otvoriti direktorij %1. Server je odgovorio: %2"
