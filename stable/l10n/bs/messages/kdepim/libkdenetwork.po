msgstr "Opozvan"

#: kpgpui.cpp:500
msgid "Expired"
msgstr "Istekao"

#: kpgpui.cpp:503
msgid "Disabled"
msgstr "Isključen"

#: kpgpui.cpp:506
msgid "Invalid"
msgstr "Neispravan"

#: kpgpui.cpp:512
msgid "Undefined trust"
msgstr "Nedefinisano povjerenje"

#: kpgpui.cpp:515
msgid "Untrusted"
msgstr "Nepovjerljiv"

#: kpgpui.cpp:518
msgid "Marginally trusted"
msgstr "Malo povjerljiv"

#: kpgpui.cpp:521
msgid "Fully trusted"
msgstr "Potpuno povjerljiv"

#: kpgpui.cpp:524
msgid "Ultimately trusted"
msgstr "Krajnje povjerljiv"

