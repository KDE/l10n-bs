#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Otvara datoteke na udaljenim računarima, nadgleda promjene, pita za "
"upload."

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Tretiraj URLove kao lokalne datoteke i obriši ih poslije"

#: main.cpp:55
msgid "Command to execute"
msgstr "Naredba koju treba izvršiti"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URLovi ili lokalne datoteke korištene za 'naredbu'."

#: main.cpp:72
msgid ""
"'command' expected.\n"
msgstr ""
"'naredba' očekivana.\n"

#: main.cpp:97
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"nije ispravan"

#: main.cpp:99
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Udaljeni URL %1\n"
"nije dozvoljen sa opcijom --tempfiles"

#: main.cpp:226
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Navodno privremena datoteka\n"
"%1\n"
"je promijenjena.\n"
"Da li je i dalje želite obrisati?"

#: main.cpp:227 main.cpp:234
msgid "File Changed"
msgstr "Datoteka promijenjena"

#: main.cpp:233
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Datoteka\n"
"%1\n"
"je promijenjena.\n"
"Da li želite poslati promjene?"

#: main.cpp:261
msgid "KIOExec"
msgstr "KIOExec"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Amila Akagić"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "bono@linux.org.ba"

