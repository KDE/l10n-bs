#: kcmdnssd.cpp:42
msgid "kcm_kdnssd"
msgstr "kcm_kdnssd"

#: kcmdnssd.cpp:43
msgid "ZeroConf configuration"
msgstr "ZeroConf podešavanje"

#: kcmdnssd.cpp:44
msgid "(C) 2004, Jakub Stachowski"
msgstr "(C) 2004, Jakub Stachowski"

#: kcmdnssd.cpp:45
msgid "Setup services browsing with ZeroConf"
msgstr "Podesite pregledanje servisa sa ZeroConf"

#. i18n: file configdialog.ui line 30
#: rc.cpp:3 rc.cpp:44
#, no-c-format
msgid "MyDialog1"
msgstr "MyDialog1"

#. i18n: file configdialog.ui line 41
#: rc.cpp:6 rc.cpp:47
#, no-c-format
msgid "Browse local network"
msgstr "Pregledaj lokalnu mrežu"

#. i18n: file configdialog.ui line 44
#: rc.cpp:9 rc.cpp:50
#, no-c-format
msgid "Browse local network (domain .local) using multicast DNS."
msgstr "Pregledaj lokalnu mrežu (domena .local) koristeći multicast DNS."

#. i18n: file configdialog.ui line 60
#: rc.cpp:12 rc.cpp:53
#, no-c-format
msgid "Additional Domains"
msgstr "Dodatne domene"

#. i18n: file configdialog.ui line 64
#: rc.cpp:15 rc.cpp:56
#, no-c-format
msgid ""
"List of Internet domains  that will be browsed for services. Do not put .local "
"here - it\n"
"is configured with 'Browse local network' option above."
msgstr ""
"Lista Internet domena na kojima će biti potražene usluge. Nemojte stavljati "
".local ovdje - nju\n"
"podešavate gornjom opcijom 'Pregledaj lokalnu mrežu'."

#. i18n: file configdialog.ui line 80
#: rc.cpp:19 rc.cpp:60
#, no-c-format
msgid "Discover more domains"
msgstr "Otkrij još domena"

#. i18n: file configdialog.ui line 84
#: rc.cpp:22 rc.cpp:63
#, no-c-format
msgid ""
"If selected every configured domain will be queried for list of domain to "
"browse. This \n"
"process will be recursive."
msgstr ""
"Ako je uključeno, svaka podešena domena će biti ispitana za listu domena za "
"pretraživanje.\n"
"Ovaj proces će biti rekurzivan."

#. i18n: file configdialog.ui line 100
#: rc.cpp:26 rc.cpp:67
#, no-c-format
msgid "Publishing Mode"
msgstr "Režim objavljivanja"

#. i18n: file configdialog.ui line 111
#: rc.cpp:29 rc.cpp:70
#, no-c-format
msgid "Local network"
msgstr "Lokalna mreža"

#. i18n: file configdialog.ui line 117
#: rc.cpp:32 rc.cpp:73
#, no-c-format
msgid ""
"Advertise services on local network (in domain .local) using multicast DNS."
msgstr ""
"Objavi servise na lokalnoj mreži (u domeni .local) koristeći multicast DNS."

#. i18n: file configdialog.ui line 125
#: rc.cpp:35 rc.cpp:76
#, no-c-format
msgid "Wide area network"
msgstr "Globalna mreža"

#. i18n: file configdialog.ui line 128
#: rc.cpp:38 rc.cpp:79
#, no-c-format
msgid ""
"Advertise services on Internet domain using public IP. To have this option "
"working you need to configure hostname, zone and secret for this domain in "
"/etc/mdnsd.conf"
msgstr ""
"Objavi servise na Internet domeni koristeći javnu IP adresu. Da bi ova opcija "
"radila, morate podesiti hostname, zonu i tajne podatke (secret) za ovu domenu u "
"/etc/mdnsd.conf"

#. i18n: file configdialog.ui line 147
#: rc.cpp:41 rc.cpp:82
#, no-c-format
msgid "Default domain:"
msgstr "Podrazumijevana domena:"

