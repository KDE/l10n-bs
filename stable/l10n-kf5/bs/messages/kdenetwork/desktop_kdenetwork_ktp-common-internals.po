msgstr "Primljena je označena poruka u grupnom ćaskanju"

#: data/ktelepathy.notifyrc:1137
msgctxt "Name"
msgid "Highlight in Active Group Chat"
msgstr "Označi u aktivnom grupnom ćaslamki"

#: data/ktelepathy.notifyrc:1177
msgctxt "Comment"
msgid "A highlighted message has been received in the active group chat window"
msgstr "Primljena je označena poruka u prozoru grupnog ćaslanja"

#: data/ktelepathy.notifyrc:1222
msgctxt "Name"
msgid "Message Dropped"
msgstr "Poruka je ispuštena"

#: data/ktelepathy.notifyrc:1267
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "Poruka je filtrirana pomoću priključka za privatnost"

#: data/ktelepathy.notifyrc:1315
msgctxt "Name"
msgid "Service Message"
msgstr "Servisna poruka"

#: data/ktelepathy.notifyrc:1362
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr "Servisna poruka je primljena (npr. zahtijev za ovlaštenje)"

#: data/ktelepathy.notifyrc:1415
msgctxt "Name"
msgid "New incoming chat"
msgstr "Novo dolazno ćaskanje"

#: data/ktelepathy.notifyrc:1460
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "Nova instantna poruka je primljena"

#: data/ktelepathy.notifyrc:1510
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "Dolazni transfer datoteke"

#: data/ktelepathy.notifyrc:1555
msgctxt "Comment"
msgid "An incoming file transfer request has been received"
msgstr "Primljen je zahtjev za dolaznu datoteku"

#: data/ktelepathy.notifyrc:1605
msgctxt "Name"
msgid "Incoming call"
msgstr "Dolazni poziv"

#: data/ktelepathy.notifyrc:1651
msgctxt "Comment"
msgid "An incoming audio/video call request has been received"
msgstr "Dolazni audio/video poziv je primljen"

#: data/ktelepathy.notifyrc:1704
msgctxt "Name"
msgid "Chatstyle Install Request"
msgstr "Zahtjev za instalaciju stila ćaskanja"

#: data/ktelepathy.notifyrc:1753
msgctxt "Name"
msgid "Chatstyle Installed Successfully"
msgstr "Stil ćaskanja uspješno instaliran"

#: data/ktelepathy.notifyrc:1802
msgctxt "Name"
msgid "Chatstyle Installation Failed"
msgstr "Neuspješna instalacija stila ćaskanja"

#: data/ktelepathy.notifyrc:1850
msgctxt "Name"
msgid "Emoticonset Install Request"
msgstr "Zahtjev za instalaciju skupa emotikona"

#: data/ktelepathy.notifyrc:1898
msgctxt "Name"
msgid "Emoticonset Installed Successfully"
msgstr "Uspješna instalacija skupa emotikona"

#: data/ktelepathy.notifyrc:1948
msgctxt "Name"
msgid "Emoticonset Installation failed"
msgstr "Neuspješna instalacija skupa emotikona"

#: data/ktelepathy.notifyrc:1996
msgctxt "Name"
msgid "Contact status changed"
msgstr "Status kontakta promijenjen"

#: data/ktelepathy.notifyrc:2040
msgctxt "Comment"
msgid "A contact has changed their status"
msgstr "Kontaknta osoba promijenila je status"

#: data/ktelepathy.notifyrc:2088
msgctxt "Name"
msgid "File renamed for sending with Google Talk"
msgstr "Datoteka preimenovana za slanje s Google Talk"

#: data/ktelepathy.notifyrc:2128
msgctxt "Comment"
msgid "An outgoing file with forbidden extension .exe or .ini has been renamed"
msgstr ""
"Izlazna datoteka s zabranjenom ekstenzijom .exe ili .ini je preimenovana"

