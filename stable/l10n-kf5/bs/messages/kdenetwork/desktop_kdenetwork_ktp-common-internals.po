msgctxt "Comment"
msgid "An incoming message has been received"
msgstr "Dolazeća poruka je primljena"

#: data/ktelepathy.notifyrc:680
msgctxt "Name"
msgid "Incoming Message in Active Chat"
msgstr "Dolazeća poruka u aktivnom ćaskanju"

