#: data/ktelepathy.notifyrc:3
msgctxt "Name"
msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:49
msgctxt "Comment"
msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:97
msgctxt "Name"
msgid "Group"
msgstr "Grupa"

#: data/ktelepathy.notifyrc:145
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Grupa u kojoj kontakt prebivaju"

#: data/ktelepathy.notifyrc:193
msgctxt "Name"
msgid "Contact"
msgstr "Kontakt"

#: data/ktelepathy.notifyrc:241
msgctxt "Comment"
