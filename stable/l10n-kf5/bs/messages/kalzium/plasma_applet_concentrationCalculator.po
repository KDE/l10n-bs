#: concentrationCalculator.cpp:1224
#, kde-format
msgid "Percentage should be less than 100.0, please enter a valid value."
msgstr "Procenat mora biti manji od 100,0. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1227
#, kde-format
msgid "Density cannot be zero, please enter a valid value."
msgstr "Gustoća ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1230
#, kde-format
msgid "Mass cannot be zero, please enter a valid value."
msgstr "Masa ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1233
#, kde-format
msgid "Volume cannot be zero, please enter a valid value."
msgstr "Zapremina ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1236
#, kde-format
msgid "Number of moles cannot be zero, please enter a valid value."
msgstr "Broj molova ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1239
#, kde-format
msgid "Molar mass of solvent is zero, please enter a valid value."
msgstr "Molarna masa otapala je nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1242
#, kde-format
msgid "Number of equivalents is zero - cannot calculate equivalent mass."
msgstr "Broj ekvivalenata je nula. Nije moguće izračunati ekvivalentnu masu."

#: concentrationCalculator.cpp:1245
#, kde-format
msgid "Concentration is zero, please enter a valid value."
msgstr "Koncentracija je nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1248
#, kde-format
msgid ""
"Insufficient data to calculate the required value, please specify normality."
msgstr ""
"Nedovoljno podataka za izračunati potrebnu vrijednost. Odredite normalitet."

#: concentrationCalculator.cpp:1251
#, kde-format
msgid ""
"Insufficient data, please specify molarity / mole fraction / molality to "
"calculate."
msgstr ""
"Nedovoljno podataka. Odredite molaritet / množinski omjer / molalitet za "
"računanje."

#: concentrationCalculator.cpp:1254
#, kde-format
msgid ""
"Amount is specified in moles, cannot calculate molar/equivalent masses. "
"Please specify mass/volume."
msgstr ""
"Navedena količina je u molima, ne mogu izračunatu molarne/ekvivalentnu masu. "
"Navedite masu/zapreminu."

#: concentrationCalculator.cpp:1257
#, kde-format
msgid ""
"You can only calculate the molar mass of a solvent if the mole fraction is "
"specified."
msgstr ""
"Možete računati molarnu masu rastvarača samo ako je određen molarni omjer."

#: concentrationCalculator.cpp:1260
#, kde-format
msgid "Molar mass cannot be zero, please enter a valid value."
msgstr "Molarna masa ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1263
#, kde-format
msgid "Equivalent mass cannot be zero, please enter a valid value."
msgstr "Ekvivalentna masa ne može biti nula. Unesite ispravnu vrijednost."

#: concentrationCalculator.cpp:1274
#, kde-format
msgid "General"
msgstr "Opšte"

