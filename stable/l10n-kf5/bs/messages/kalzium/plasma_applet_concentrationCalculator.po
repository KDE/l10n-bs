#: concentrationCalculatorConfig.ui:17
#, kde-format
msgid "Amount of solute is always specified in terms of mass"
msgstr "Količina rastvora uvijek  je navedena kao masa"

#. i18n: ectx: property (text), widget (QCheckBox, solventVolume)
#: concentrationCalculatorConfig.ui:24
#, kde-format
msgid "Amount of solvent is always specified in terms of volume"
msgstr "Količina rastvarača uvijek je navedena kao zapremina"
