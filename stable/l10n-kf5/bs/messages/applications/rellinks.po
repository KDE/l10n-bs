#: plugin_rellinks.cpp:67
#, kde-format
msgid "Rellinks"
msgstr "Relveze"

#: plugin_rellinks.cpp:75
#, kde-format
msgid "&Top"
msgstr "&Vrh"

#: plugin_rellinks.cpp:78
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr "<p>Ova veza upućuje na početnu stranicu ili vrh neke hijerarhije.</p>"

#: plugin_rellinks.cpp:82
#, kde-format
msgid "&Up"
msgstr "&Gore"

#: plugin_rellinks.cpp:85
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr "<p>Ova veza upućuje na neposrednog sadržaoca trenutnog dokumenta.</p>"

#: plugin_rellinks.cpp:91
#, kde-format
msgid "&First"
msgstr "&Prvi"

#: plugin_rellinks.cpp:94
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Ova vrsta veze kazuje pretraživačima koji dokument se, po autoru, smatra "
"početnom tačkom zbirke.</p>"

#: plugin_rellinks.cpp:98
#, kde-format
msgid "&Previous"
msgstr "&Prethodni"

#: plugin_rellinks.cpp:101
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Ova veza upućuje na prethodni dokument u uređenoj seriji dokumenata.</p>"

#: plugin_rellinks.cpp:105
#, kde-format
msgid "&Next"
msgstr "&Sljedeći"

#: plugin_rellinks.cpp:108
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Ova veza upućuje na sljedeći dokument u uređenoj seriji dokumenata.</p>"

#: plugin_rellinks.cpp:112
#, kde-format
msgid "&Last"
msgstr "&Posljednji"

#: plugin_rellinks.cpp:115
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Ova veza upućuje na kraj grupe dokumenata.</p>"

#: plugin_rellinks.cpp:120
#, kde-format
msgid "&Search"
msgstr "&Traži"

#: plugin_rellinks.cpp:123
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr "<p>Ova veza upućuje na pretraživanje.</p>"

#: plugin_rellinks.cpp:127
#, kde-format
msgid "Document"
msgstr "Dokument"

#: plugin_rellinks.cpp:129
#, kde-format
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr "<p>Ovaj meni sadrži veze koje upućuju na informacije dokumenta.</p>"

#: plugin_rellinks.cpp:133
#, kde-format
msgid "Table of &Contents"
msgstr "&Sadržaj"

#: plugin_rellinks.cpp:135
#, kde-format
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Ova veza upućuje na sadržaj.</p>"

#: plugin_rellinks.cpp:139
#, kde-format
msgid "Chapters"
msgstr "Poglavlja"

#: plugin_rellinks.cpp:144
#, kde-format
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Ovaj meni upućuje na poglavlja dokumenta.</p>"

#: plugin_rellinks.cpp:147
#, kde-format
msgid "Sections"
msgstr "Odjeljci"

#: plugin_rellinks.cpp:153
#, kde-format
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Ovaj meni upućuje na odjeljke dokumenta.</p>"

#: plugin_rellinks.cpp:156
#, kde-format
msgid "Subsections"
msgstr "Pododeljci"

#: plugin_rellinks.cpp:161
#, kde-format
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Ovaj meni upućuje na pododjeljke dokumenta.</p>"

#: plugin_rellinks.cpp:164
#, kde-format
msgid "Appendix"
msgstr "Dodatak"

#: plugin_rellinks.cpp:169
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Ova veza upućuje na dodatak.</p>"

#: plugin_rellinks.cpp:173
#, kde-format
msgid "&Glossary"
msgstr "&Pojmovnik"

#: plugin_rellinks.cpp:175
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Ova veza upućuje na pojmovnik.</p>"

#: plugin_rellinks.cpp:180
#, kde-format
msgid "&Index"
msgstr "&Indeks"

#: plugin_rellinks.cpp:182
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Ova veza upućuje na indeks.</p>"

#: plugin_rellinks.cpp:187
#, kde-format
msgid "More"
msgstr "Više"

#: plugin_rellinks.cpp:189
#, kde-format
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Ovaj meni sadrži ostale važne veze.</p>"

#: plugin_rellinks.cpp:193
#, kde-format
msgid "&Help"
msgstr "&Pomoć"

#: plugin_rellinks.cpp:196
#, kde-format
msgid "<p>This link references the help.</p>"
msgstr "<p>Ova veza upućuje na pomoć.</p>"

#: plugin_rellinks.cpp:201
#, kde-format
msgid "&Authors"
msgstr "&Autori"

#: plugin_rellinks.cpp:204
#, kde-format
msgid "<p>This link references the author.</p>"
msgstr "<p>Ova veza upućuje na autora.</p>"

#: plugin_rellinks.cpp:209
#, kde-format
msgid "Copy&right"
msgstr "Autorska p&rava"

#: plugin_rellinks.cpp:212
#, kde-format
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Ova veza upućuje na autorska prava.</p>"

#: plugin_rellinks.cpp:216
#, kde-format
msgid "Bookmarks"
msgstr "Markeri"

#: plugin_rellinks.cpp:219
#, kde-format
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Ovaj meni upućuje na markere.</p>"

#: plugin_rellinks.cpp:223
#, kde-format
msgid "Other Versions"
msgstr "Ostale verzije"

#: plugin_rellinks.cpp:226
#, kde-format
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr "<p>Ova veza upućuje na druge verzije ovog dokumenta.</p>"

#: plugin_rellinks.cpp:231
#, kde-format
msgid "Miscellaneous"
msgstr "Razno"

#: plugin_rellinks.cpp:234
#, kde-format
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Razne veze.</p>"

