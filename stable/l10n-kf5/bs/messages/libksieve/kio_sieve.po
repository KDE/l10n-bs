#: sieve.cpp:338
#, kde-format
msgid "Connecting to %1..."
msgstr "Povezujem se na %1..."

#: sieve.cpp:341
#, kde-format
msgid "The connection to the server was lost."
msgstr "Veza sa serverom je izgubljena."

#: sieve.cpp:353
#, kde-format
msgid "Server identification failed."
msgstr "Neuspjela identifikacija servera."

#: sieve.cpp:359
#, kde-format
msgid "Can not use TLS since the underlying Qt library does not support it."
msgstr "Ne mogu da koristim TLS jer ga podložna Qt biblioteka ne podržava."

#: sieve.cpp:366
#, kde-format
msgid ""
"TLS encryption was requested, but your Sieve server does not advertise TLS "
"in its capabilities.\n"
"You can choose to try to initiate TLS negotiations nonetheless, or cancel "
"the operation."
msgstr ""
"Zatraženo je šifrovanje TLS‑om, ali Sieve server ne navodi TLS među svojim "
"mogućnostima.\n"
" Možete izabrati da se svejedno započnu TLS pregovori, ili odustanete od "
"postupka."

#: sieve.cpp:368
#, kde-format
msgid "Server Does Not Advertise TLS"
msgstr "Server ne oglašava TLS"

#: sieve.cpp:368
#, kde-format
msgid "&Start TLS nonetheless"
msgstr "&Svejedno pokreni TLS"

#: sieve.cpp:368
#, kde-format
msgid "&Cancel"
msgstr "&Odustani"

#: sieve.cpp:369
#, kde-format
msgid "TLS encryption requested, but not supported by server."
msgstr "Zatraženo šifrovanje TLS‑om, ali ga server ne podržava."

#: sieve.cpp:390
#, kde-format
msgid ""
"Your Sieve server claims to support TLS, but negotiation was unsuccessful."
msgstr "Sieve server tvrdi da podržava TLS, ali pregovor nije prošao."

#: sieve.cpp:392
#, kde-format
msgid "Connection Failed"
msgstr "Veza nije ostvarena"

#: sieve.cpp:399
#, kde-format
msgid ""
"The server does not seem to support TLS. Disable TLS if you want to connect "
"without encryption."
msgstr ""
"Izgleda da server ne podržava TLS. Isključite TLS ako želite da se povežete "
"bez šifrovanja."

#: sieve.cpp:411
#, kde-format
msgid "Authenticating user..."
msgstr "Autentifikujem korisnika..."

#: sieve.cpp:414
#, kde-format
msgid "Authentication failed."
msgstr "Neuspjela autentifikacija."

#: sieve.cpp:478
#, kde-format
msgctxt "special command completed"
msgid "Done."
msgstr "Gotovo."

#: sieve.cpp:491
#, kde-format
msgid "Activating script..."
msgstr "Aktiviram skriptu..."

#: sieve.cpp:508
#, kde-format
msgid "There was an error activating the script."
msgstr "Greška pri aktiviranju skripte."

#: sieve.cpp:528
#, kde-format
msgid "There was an error deactivating the script."
msgstr "Greška pri deaktiviranju skripte."

#: sieve.cpp:560
#, kde-format
msgid "Sending data..."
msgstr "Šaljem podatke..."

#: sieve.cpp:577
#, kde-format
msgid "KIO data supply error."
msgstr "Greška u KIO snabdjevanju podataka."

#: sieve.cpp:628 sieve.cpp:1163
#, kde-format
msgid "Network error."
msgstr "Mrežna greška."

#: sieve.cpp:640
#, kde-format
msgid "Verifying upload completion..."
msgstr "Provjeravam završetak slanja..."

#: sieve.cpp:664 sieve.cpp:671
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"Skripta nije uspješno poslala.\n"
"Ovo je vjerovatno zbog grešaka u skripti.\n"
"Server javlja:\n"
"%1"

#: sieve.cpp:675 sieve.cpp:679
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"Skripta nije uspješno poslala.\n"
"Možda sadrži neke greške."

#: sieve.cpp:687
#, kde-format
msgctxt "data upload complete"
msgid "Done."
msgstr "Gotovo."

#: sieve.cpp:719
#, kde-format
msgid "Retrieving data..."
msgstr "Dobavljam podatke..."

#: sieve.cpp:769
#, kde-format
msgid "Finishing up..."
msgstr "Dovršavam..."

#: sieve.cpp:778
#, kde-format
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr "Greška protokola pri pokušaju da se dogovori preuzimanje skriptom."

#: sieve.cpp:783
#, fuzzy, kde-format
#| msgctxt "special command completed"
#| msgid "Done."
msgctxt "data retrieval complete"
msgid "Done."
msgstr "Gotovo."

#: sieve.cpp:790
#, kde-format
msgid "Folders are not supported."
msgstr "Direktoriji nisu podržani."

#: sieve.cpp:799
#, kde-format
msgid "Deleting file..."
msgstr "Brišem datoteku..."

#: sieve.cpp:815
#, kde-format
msgid "The server would not delete the file."
msgstr "Server nije htio da obriše datoteku."

#: sieve.cpp:819
#, kde-format
msgctxt "file removal complete"
msgid "Done."
msgstr "Gotovo."

#: sieve.cpp:834
#, kde-format
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr ""
"Ne mogu da promijenim dozvole na bilo šta osim 0700 (za aktivnu) ili 0600 "
"(za neaktivnu skriptu)."

#: sieve.cpp:996
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Greška pri autentifikaciji: %1"

#: sieve.cpp:1020
#, kde-format
msgid "Sieve Authentication Details"
msgstr "Detalji autentifikacije programom Sieve"

#: sieve.cpp:1021
#, kde-format
msgid ""
"Please enter your authentication details for your sieve account (usually the "
"same as your email password):"
msgstr ""
"Unesite detalje za autentifikaciju na Sieve nalogu (obično isto kao lozinka "
"e‑pošte):"

#: sieve.cpp:1094
#, kde-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"Greška protokola pri autentifikaciji.\n"
"Izaberite drugi metod autentifikacije umesto %1."

#: sieve.cpp:1133
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Neuspela autentifikacija.\n"
"Najverovatnije je lozinka pogrešna.\n"
"Server javlja:\n"
"%1"

#: sieve.cpp:1218
#, kde-format
msgid "A protocol error occurred."
msgstr "Greška u protokolu."

#~ msgctxt "data retrival complete"
#~ msgid "Done."
#~ msgstr "Gotovo."
