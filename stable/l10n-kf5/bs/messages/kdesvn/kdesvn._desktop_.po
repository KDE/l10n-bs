#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "kdesvnd  subverzija modul"

#: src/kdesvnd/kdesvnd.desktop:34
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr "Daje razne Subversion akcije menadžerima datoteka i drugom softveru"

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:40
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Subverzije zapisnik (zadnji 100)"

#: src/kdesvnd/kdesvn_subversion.desktop:73
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:41
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Prikazi Subverzije zapisnik"

#: src/kdesvnd/kdesvn_subversion.desktop:106
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Detaljna Subverzija info"

#: src/kdesvnd/kdesvn_subversion.desktop:141
msgctxt "Name"
msgid "Add to Repository"
msgstr "Dodaj u repozitorij"

#: src/kdesvnd/kdesvn_subversion.desktop:178
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Provjerite unversioned predmete"

#: src/kdesvnd/kdesvn_subversion.desktop:212
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Briši iz repozitorija"

#: src/kdesvnd/kdesvn_subversion.desktop:247
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Poništi lokalne promjene"

#: src/kdesvnd/kdesvn_subversion.desktop:281
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Ukloni bilo koje promjene napravljene lokalno. Upozorenje - ovo ne može biti "
"ponovno vraćeno."

#: src/kdesvnd/kdesvn_subversion.desktop:314
msgctxt "Name"
msgid "Rename..."
msgstr "Preimenuj..."

#: src/kdesvnd/kdesvn_subversion.desktop:349
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Preimenuj datoteku lokalno i u spremištu. Koristi ovo radije nego dodavanje "
"i brisanje za preimenovanje datoteke."

#: src/kdesvnd/kdesvn_subversion.desktop:382
msgctxt "Name"
msgid "Import Repository"
msgstr "Uvezi spremište"

#: src/kdesvnd/kdesvn_subversion.desktop:416
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr "Stavi direktorij na postojeće spremište radi kontrole revizija."

#: src/kdesvnd/kdesvn_subversion.desktop:449
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:74
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Izdvoji iz spremišta..."

#: src/kdesvnd/kdesvn_subversion.desktop:482
#: src/kdesvnd/kdesvn_subversion.desktop:980
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:107
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:303
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Izdvoji izlazne datoteke sa postojećeg spremišta u ovaj direktorij."

#: src/kdesvnd/kdesvn_subversion.desktop:515
msgctxt "Name"
msgid "Switch..."
msgstr "Prebaci..."

#: src/kdesvnd/kdesvn_subversion.desktop:547
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Prebaci radnu kopiju u drugu granu"

#: src/kdesvnd/kdesvn_subversion.desktop:581
msgctxt "Name"
msgid "Merge..."
msgstr "Spoji..."

#: src/kdesvnd/kdesvn_subversion.desktop:615
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Spoji promjene između ove i drugih grana"

#: src/kdesvnd/kdesvn_subversion.desktop:649
msgctxt "Name"
msgid "Blame..."
msgstr "Okrivi..."

#: src/kdesvnd/kdesvn_subversion.desktop:682
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Pogledaj ko je napisao svaku liniju u datoteci i pod kakvom kontrolom"

#: src/kdesvnd/kdesvn_subversion.desktop:716
msgctxt "Name"
msgid "Create Patch..."
msgstr "Kreiraj zakrpu..."

#: src/kdesvnd/kdesvn_subversion.desktop:751
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:140
msgctxt "Name"
msgid "Export..."
msgstr "Izvezi..."

#: src/kdesvnd/kdesvn_subversion.desktop:785
#: src/kdesvnd/kdesvn_subversion.desktop:1045
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:174
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:368
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Izvezi bezverzijsku kopiju stabla iz repozitorija"

#: src/kdesvnd/kdesvn_subversion.desktop:818
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diff (lokalno)"

#: src/kdesvnd/kdesvn_subversion.desktop:851
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Prikaži lokalne promjene nakon zadnjeg ažuriranja"

#: src/kdesvnd/kdesvn_subversion.desktop:884
msgctxt "Name"
msgid "KDESvn Update"
msgstr "KDESvn Azuriranje"

#: src/kdesvnd/kdesvn_subversion.desktop:917
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "KDESvn obavezati"

#: src/kdesvnd/kdesvn_subversion.desktop:949
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:272
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Izdvoji iz spremišta..."

#: src/kdesvnd/kdesvn_subversion.desktop:1013
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:336
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Izvoz iz Subversion repozitorija..."

#: src/kdesvnd/kdesvn_subversion.desktop:1078
msgctxt "Name"
msgid "Display revision tree"
msgstr "Prikaz stabla revizija"

#: src/kdesvnd/kdesvn_subversion.desktop:1110
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Prikazi kompletno revizija stablo"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "kdesvn dnevnik (zadnjih 100)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:207
