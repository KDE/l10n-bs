#. Tag: para
#: index.docbook:87 index.docbook:103
#, no-c-format
msgid ""
"&kfloppy; Formatter is a utility that provides a straightforward graphical "
"means to format 3.5\" and 5.25\" floppy disks."
msgstr ""
"&kfloppy; Formater je uslužni program koji pruža jednostavno grafičko "
"sredstvo za formatiranje 3.5 \"i 5.25\" diskete."

#. Tag: keyword
#: index.docbook:92
#, no-c-format
