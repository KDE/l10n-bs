#, no-c-format
msgid "Starts a new game of &kappname;."
msgstr "Započinje novu igru &kappname;."

#. Tag: menuchoice
#: index.docbook:186
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>New Round</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Igra</guimenu><guimenuitem>Nova Runda</guimenuitem>"

#. Tag: para
#: index.docbook:190
#, no-c-format
msgid "Starts a new round, at the current level."
msgstr "Započinje novu rundu, na trenutnom levelu."

#. Tag: menuchoice
#: index.docbook:194
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>Pause</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\"><keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Igra</guimenu><guimenuitem>Pauza</guimenuitem>"

#. Tag: para
#: index.docbook:197
#, no-c-format
msgid "Pauses and unpauses the game."
msgstr "Pauzira i pokreće igru."

#. Tag: menuchoice
#: index.docbook:200
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>Igra</guimenu><guimenuitem>Izlaz</guimenuitem>"

#. Tag: para
#: index.docbook:206
#, no-c-format
msgid "<action>Quits</action> &kappname;"
msgstr "<action>Izlazi</action> &kappname;"

#. Tag: menuchoice
#: index.docbook:209
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kappname;...</"
"guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Podesi &kappname;...</guimenuitem>"

#. Tag: para
#: index.docbook:213
#, no-c-format
msgid ""
"Opens a configuration dialog which lets you define many settings of the "
"game, refer to the chapter <link linkend=\"configuration\">Game Options</"
"link> for further information."
msgstr ""
"Otvara dijalog konfiguracije koja vam omogućuje da definirate mnoge postavke "
"igre, pogledajte poglavlje <link linkend=\"configuration\">Opcije igre</"
"link> za dodatne informacije."

