#, no-c-format
msgid "Quit Game"
msgstr "Završi Igru"

#. Tag: guibutton
#: index.docbook:658
#, no-c-format
msgid "<guibutton>Quit</guibutton>"
msgstr "<guibutton>Izlaz</guibutton>"

#. Tag: action
