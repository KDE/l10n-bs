#. Tag: para
#: details-impexp.docbook:448
#, no-c-format
msgid ""
"See <link linkend=\"details.impexp.gncquotes\">\"Online Quotes\"</link> "
"above."
msgstr ""
"Pogledajte <link linkend=\"details.impexp.gncquotes\">\"Online navodi\"</"
