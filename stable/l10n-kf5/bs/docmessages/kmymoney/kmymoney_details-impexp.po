msgid "&details-impexp-csv; &details-impexp-csvexp; &details-impexp-woob;"
msgstr "&details-impexp-csv;"

#. Tag: title
#: details-impexp.docbook:1164
#, no-c-format
msgid "Writing Importer Plugins"
msgstr "Pisanje Importer dodataka"

#. Tag: para
#: details-impexp.docbook:1166
#, fuzzy, no-c-format
#| msgid ""
#| "&kappname; contains explicit support for importer plugins. If you have a "
#| "custom format, and you would like to write an importer plugin, we would "
#| "value your contribution. To do so, you'll need to compile the program "
#| "from source. Then use the OFX Importer Plugin as an example."
msgid ""
"&kmymoney; contains explicit support for additional importer and/or exporter "
"plugins. If you would like to write a plugin to handle a custom format, we "
"would value your contribution. To do so, you'll need to compile the program "
"from source. Then use the OFX Importer Plugin as an example."
msgstr ""
"&kappname; sadrži eksplicitnu podršku za importer dodatke. Ukoliko "
"posjeduete specifičanformat i ukoliko želite da napišete importer dodatak, "
"mi bismo cijenili vaš doprinos. Da biste to uradili, moraćete komajlirati "
"program iz izvora. Zatim upotrijebite OFX Importer dodatak kao primjer."

