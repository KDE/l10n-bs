#. Tag: para
#: details-impexp.docbook:522
#, no-c-format
msgid "Inconsistencies in account types and actions taken"
msgstr "Nedosljednosti u tipovima računa i poduzetim akcijama"

#. Tag: para
#: details-impexp.docbook:526
#, no-c-format
msgid "Details of suspect schedules"
msgstr "Detalje o sumnjičavim rasporedima"

#. Tag: author
#: details-impexp.docbook:544 details-impexp.docbook:913
