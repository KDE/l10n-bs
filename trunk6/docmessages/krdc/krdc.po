#~ msgid ""
#~ "The high level implementation of a system using the Remote Frame Buffer "
#~ "protocol is known as Virtual Network Computer, or more often just as "
#~ "<acronym>VNC</acronym>."
#~ msgstr ""
#~ "Visoki nivo implementacije sistema koji korisni Remote Frame Buffer "
#~ "protokol je poznat kao Virtual Network Computer, ili češće samo kao "
