#, no-c-format
msgid ""
"&i18n-cmd_syntax;<command>&no-i18n-cmd_edit_label;</command>"
"(<replaceable>index</replaceable>)"
msgstr ""

#. Tag: para
#: index.docbook:3402
#, no-c-format
msgid ""
"Opens a window in which the user can edit the position and the description "
"of a label, which is identified by its index (starting from zero). If no "
"label with the given index exists, this command does nothing."
msgstr ""

#. Tag: entry
#: index.docbook:3410
#, no-c-format
msgid "index of the label to edit, starting with 0"
msgstr ""

#. Tag: title
#: index.docbook:3415
#, no-c-format
msgid "&no-i18n-cmd_expandtolabel;"
msgstr ""

#. Tag: title
#: index.docbook:3417
#, no-c-format
msgid ""
"&i18n-cmd_syntax;<command>&no-i18n-tag;&no-i18n-cmd_expandtolabel;</command>"
"()"
msgstr ""

#. Tag: para
#: index.docbook:3418
#, no-c-format
msgid ""
"Expands the current selection to the labels left and right from the current "
"selection borders. If the border of selection already is on a label, it "
"stays unchanged. If there is no label left or right of the current "
"selection, it will be expanded to the start or end of the file."
msgstr ""

