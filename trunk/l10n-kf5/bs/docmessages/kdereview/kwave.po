msgstr ""

#. Tag: para
#: index.docbook:3336
#, no-c-format
msgid ""
"Deletes the currently selected range of samples. If the selection is empty, "
"this command does nothing. Affects all tracks."
msgstr ""

#. Tag: title
#: index.docbook:3345
#, no-c-format
msgid "&no-i18n-cmd_delete_label;"
msgstr ""

