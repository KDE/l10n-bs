#, no-c-format
msgid ""
"&i18n-cmd_syntax;<command>&no-i18n-cmd_delete_label;</command>"
"(<replaceable>index</replaceable>)"
msgstr ""

#. Tag: para
#: index.docbook:3348
#, no-c-format
msgid ""
"Deletes a label, identified by its index (starting from zero). If no label "
"with the given index exists, this command does nothing."
msgstr ""

#. Tag: entry
#: index.docbook:3354 index.docbook:3368 index.docbook:3410 index.docbook:3518
#: index.docbook:4294 index.docbook:4308 index.docbook:4323
#, no-c-format
