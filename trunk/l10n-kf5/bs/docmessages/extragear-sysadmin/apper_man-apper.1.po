#. Tag: title
#: man-apper.1.docbook:60
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-apper.1.docbook:61
#, no-c-format
msgid "Apper is the &kde; interface for PackageKit"
msgstr "Izgled je &kde; sučelje za PackageKit"

#. Tag: para
#: man-apper.1.docbook:62
#, no-c-format
msgid ""
"Apper is able to manage packages, applications and updates in a cross-"
"distribution way thanks to the PackageKit project."
msgstr ""
"Aplikacija je u mogućnosti da upravlja paketom, aplikacije i updates u cross-"
"distibuciji su način zahvaljivanja PackageKit projektu."

#. Tag: para
#: man-apper.1.docbook:63
#, no-c-format
msgid ""
"It is providing Linux users a single application that they can learn and use "
"in whatever distribution they are."
msgstr ""
"To je pružanje Linux korisnicima jedne aplikacije da oni mogu naučiti kako "
"ih koristiti."

#. Tag: title
#: man-apper.1.docbook:68
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: option
#: man-apper.1.docbook:72
#, no-c-format
msgid "--updates"
msgstr "--updates"

#. Tag: para
#: man-apper.1.docbook:73
#, no-c-format
msgid "Show available updates"
msgstr "Prikaži dostupne update"

#. Tag: option
#: man-apper.1.docbook:77
#, no-c-format
msgid "--settings"
msgstr "--settings"

#. Tag: para
#: man-apper.1.docbook:78
#, no-c-format
msgid "Show Apper configuration page."
msgstr "Stranica sa prikazom Konfiguracije."

#. Tag: term
#: man-apper.1.docbook:82
#, no-c-format
msgid "<option>--backend-details</option> <replaceable>name</replaceable>"
msgstr "<option>--backend-details</option> <replaceable>ime</replaceable>"

#. Tag: para
#: man-apper.1.docbook:83
#, no-c-format
msgid "Display information about the backend PackageKit uses at time."
msgstr "Prikaz informacija o PackageKit koriščenju u ovom trenutku."

#. Tag: term
#: man-apper.1.docbook:87
#, no-c-format
msgid ""
"<option>--install-mime-type</option> <replaceable>mime-type</replaceable>"
msgstr ""
"<option>--install-mime-type</option> <replaceable>mime-type</replaceable>"

#. Tag: para
#: man-apper.1.docbook:88
#, no-c-format
msgid "Call the mime-type installer."
msgstr "Pozovite mime-tip instaler."

#. Tag: term
#: man-apper.1.docbook:92
#, no-c-format
msgid "<option>--install-package-name</option> <replaceable>name</replaceable>"
msgstr ""
"<option>--install-package-name</option> <replaceable>name</replaceable>"

#. Tag: para
#: man-apper.1.docbook:93
#, no-c-format
msgid "Install package with the name <replaceable>name</replaceable>."
msgstr "Instaliraj paket s imenom <replaceable>naziv</replaceable>."

#. Tag: term
#: man-apper.1.docbook:97
#, no-c-format
msgid "<option>--install-provide-file</option> <replaceable>file</replaceable>"
msgstr ""
"<option>--install-provide-file</option> <replaceable>fajl</replaceable>"

#. Tag: para
#: man-apper.1.docbook:98
#, no-c-format
msgid "Install package providing file <replaceable>file</replaceable>."
msgstr "Instaliraj paket pružanja fajlova  <replaceable>fajl</replaceable>."

#. Tag: term
#: man-apper.1.docbook:102
#, no-c-format
msgid ""
"<option>--install-font-resource</option> <replaceable>font</replaceable>"
msgstr ""
"<option>--install-font-resource</option> <replaceable>font</replaceable>"

#. Tag: para
#: man-apper.1.docbook:103
#, no-c-format
msgid "Install a font resource."
msgstr "Instaliraj pretraživanje fontova."

#. Tag: term
#: man-apper.1.docbook:107
#, no-c-format
msgid "<option>--install-catalog</option> <replaceable>file</replaceable>"
msgstr "<option>--install-catalog</option> <replaceable>file</replaceable>"

#. Tag: para
#: man-apper.1.docbook:108
#, no-c-format
msgid "Install the package catalog in <replaceable>file</replaceable>."
msgstr "Instaliraj paket kataloga u <replaceable>fajl</replaceable>."

#. Tag: term
#: man-apper.1.docbook:112
#, no-c-format
msgid ""
"<option>--remove-package-by-file</option> <replaceable>filename</replaceable>"
msgstr ""
"<option>--remove-package-by-file</option> <replaceable>naziv fajla</"
"replaceable>"

#. Tag: para
#: man-apper.1.docbook:113
#, no-c-format
msgid "Remove a package containing file <replaceable>filename</replaceable>."
msgstr ""
"Uklonite paket koji sadržava fajlove <replaceable>naziv fajla</replaceable>."

