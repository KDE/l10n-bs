#. Tag: para
#: index.docbook:45
#, no-c-format
msgid ""
"<ulink url=\"http://extragear.kde.org/apps/kiosktool.php\">&kiosktool;</"
"ulink> is a &kde; administration tool that offers system administrators an "
"easy way to predefine desktop configurations for groups of users, lock down "
"settings or otherwise restrict features of the &kde; desktop environment."
msgstr ""
"<ulink url=\"http://extragear.kde.org/apps/kiosktool.php\">&kiosktool;</"
"ulink> je &kde; administracijski alat koji nudi sistemsku administraciju kao "
"lagani način da predefinirate desktop konfiguraciju za grupe korisnika, "
"zaključate postavke ili na drugi naćin ogranići osobine &kde; desktop "
"okoline."

