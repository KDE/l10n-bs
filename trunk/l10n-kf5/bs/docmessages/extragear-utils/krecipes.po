msgstr "pile*"

#. Tag: para
#: index.docbook:853
#, no-c-format
msgid "chicken broth"
msgstr "pileća čorba"

#. Tag: para
#: index.docbook:854
#, no-c-format
msgid "chicken breast"
msgstr "pileća prsa"

#. Tag: para
#: index.docbook:855
#, no-c-format
msgid "chicken"
msgstr "piletina"

#. Tag: entry
#: index.docbook:858
#, no-c-format
msgid "can*cherries"
msgstr "k*višnje"

#. Tag: para
#: index.docbook:858
#, no-c-format
msgid "canned cherries"
msgstr "konzervirane višnje"

#. Tag: para
#: index.docbook:859
#, no-c-format
msgid "candied red cherries"
msgstr "kandirane crvene višnje"

#. Tag: para
#: index.docbook:860
#, no-c-format
msgid "candied green cherries"
msgstr "kandirane zelene višnje"

#. Tag: entry
#: index.docbook:863
#, no-c-format
msgid "egg?"
msgstr "jaj?"

#. Tag: para
#: index.docbook:863
