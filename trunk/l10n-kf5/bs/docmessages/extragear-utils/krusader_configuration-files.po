#. Tag: para
#: configuration-files.docbook:150
#, no-c-format
msgid ""
"This is a <literal role=\"extension\">.ini</literal> file that holds a <link "
"linkend=\"configure-shortcuts\">Key binding profile</link>. Until "
"&krusader;-1.70.0 this was a binary file. &krusader; is backwards compatible "
"for importing this legacy binary format."
msgstr ""
"Ovo je <literal role=\"extension\">.ini</literal> datoteka koja čuva <link "
"linkend=\"configure-shortcuts\">Profil kombinovanja tipku</link>. Sve do "
"&krusader;-1.70.0 ovo je bila binarna datoteka. &krusader; je kompatibilan "
"za uvoz binarnog formata tog legata."

