#. Tag: title
#: index.docbook:418
#, no-c-format
msgid "Requirements"
msgstr "Zahtjevi"

#. Tag: para
#: index.docbook:429
#, no-c-format
msgid "In order to successfully use &kvpnc;, you need &kde; 4."
msgstr "Kako bi uspješno koristili &kvpnc;,  trebate &kde; 4."

#. Tag: para
#: index.docbook:430
#, no-c-format
msgid ""
"The following tools are optional but minimal one of them is required for "
"normal use."
msgstr ""
"Prateći alati su neobavezni ali minimalno jedan od njih je potreban za "
"normalnu upotrenu."

#. Tag: para
#: index.docbook:432
#, no-c-format
msgid ""
"<ulink url=\"http://www.unix-ag.uni-kl.de/~massar/vpnc/\">vpnc</ulink> >= "
