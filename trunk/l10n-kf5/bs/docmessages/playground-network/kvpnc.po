#. Tag: title
#: index.docbook:118
#, no-c-format
msgid "Introduction"
msgstr "Uvod"

#. Tag: para
#: index.docbook:125
#, no-c-format
msgid ""
"KVpnc is a <ulink url=\"http://www.kde.org/\">&kde;</ulink> frontend for "
"various vpn clients. It supports Cisco VPN (<ulink url=\"http://www.unix-ag."
"uni-kl.de/~massar/vpnc/\">vpnc</ulink>), IPSec (<ulink url=\"http://www."
"freeswan.org\">FreeS/WAN</ulink> (OpenS/WAN), <ulink url=\"http://ipsec-"
"tools.sourceforge.net/\">racoon</ulink>), PPTP (<ulink url=\"http://"
"sourceforge.net/projects/pptpclient/\">pptpclient</ulink>) and <ulink url="
"\"http://www.openvpn.org/\">OpenVPN</ulink>."
msgstr ""
"KVpnc je <ulink url=\"http://www.kde.org/\">&kde;</ulink> sučelje za razne "
"vpn klijente. On podržava Cisco VPN (<ulink url=\"http://www.unix-ag.uni-kl."
"de/~massar/vpnc/\">vpnc</ulink>), IPSec (<ulink url=\"http://www.freeswan.org"
"\">FreeS/WAN</ulink> (OpenS/WAN), <ulink url=\"http://ipsec-tools."
"sourceforge.net/\">racoon</ulink>), PPTP (<ulink url=\"http://sourceforge."
"net/projects/pptpclient/\">pptpclient</ulink>) and <ulink url=\"http://www."
"openvpn.org/\">OpenVPN</ulink>."

