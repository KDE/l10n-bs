msgstr "<para>SVN</para>"

#. Tag: para
#: index.docbook:404
#, no-c-format
msgid ""
"The latest development code can be obtain from the &kde; source repository. "
"Simply do:"
msgstr ""
"Najnoviji programerski kod može biti preuzet sa  &kde; izvornog skladišta. "
"Samo uradite:"

#. Tag: para
#: index.docbook:405
#, no-c-format
msgid ""
"svn export svn://anonsvn.kde.org/home/kde/trunk/playground/network/&kvpnc;"
msgstr ""
"svn export svn://anonsvn.kde.org/home/kde/trunk/playground/network/&kvpnc;"

#. Tag: para
#: index.docbook:406
#, no-c-format
msgid "cd &kvpnc;"
msgstr "cd &kvpnc;"

#. Tag: para
#: index.docbook:407
#, no-c-format
