msgstr "mkdir builddir"

#. Tag: para
#: index.docbook:408
#, no-c-format
msgid "cd builddir"
msgstr "cd builddir"

#. Tag: para
#: index.docbook:409
#, no-c-format
msgid "cmake .."
msgstr "cnapravi .."

#. Tag: para
#: index.docbook:410 index.docbook:454
#, no-c-format
msgid "make"
msgstr "napravi"

#. Tag: para
#: index.docbook:411 index.docbook:455
#, no-c-format
msgid "<para>su</para>"
msgstr "<para>su</para>"

