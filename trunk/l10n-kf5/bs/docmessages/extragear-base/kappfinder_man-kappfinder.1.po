#. Tag: refpurpose
#: man-kappfinder.1.docbook:20
#, no-c-format
msgid "An app to add installed applications to the &kde; menu."
msgstr "Aplikacija za dodavanje instaliranih aplikacija u &kde; meni."

#. Tag: cmdsynopsis
#: man-kappfinder.1.docbook:24
#, no-c-format
msgid ""
"<command>kappfinder</command> <group><option>--dir</option> <replaceable> "
"directory</replaceable></group> <group><option>KDE Generic Options</option></"
"group> <group><option>Qt Generic Options</option></group>"
msgstr ""
"<command>kappfinder</command> <group><option>--dir</option> <replaceable> "
"direktorij</replaceable></group> <group><option>KDE genericke opcije</"
"option></group> <group><option>Qt Genericke opcije </option></group>"

#. Tag: title
#: man-kappfinder.1.docbook:34
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kappfinder.1.docbook:36
#, no-c-format
msgid ""
"The KDE application finder (&kappfinder;) looks for legacy and third party "
"applications that are installed on your system and adds them to the KDE menu "
"system."
msgstr ""
"KDE pronalazac aplikacija (&kappfinder;) trazi naslijeđene i ostale "
"aplikacije koje su instalirane u vasem sistemu i dodaje ih u KDE sistem "
"menija."

#. Tag: title
#: man-kappfinder.1.docbook:43
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: term
#: man-kappfinder.1.docbook:47
#, no-c-format
msgid "<option>--dir</option> <replaceable>directory</replaceable>"
msgstr "<option>--dir</option> <replaceable>Direktorij</replaceable>"

#. Tag: para
#: man-kappfinder.1.docbook:49
#, no-c-format
msgid ""
"Install <filename>.desktop</filename> files into directory "
"<replaceable>directory</replaceable>"
msgstr ""
"Instalacija <filename>.desktop</filename> datoteka u direktorij "
"<replaceable>direktorij</replaceable>"

#. Tag: title
#: man-kappfinder.1.docbook:70
#, no-c-format
msgid "Authors"
msgstr "Autori"

#. Tag: para
#: man-kappfinder.1.docbook:72
#, no-c-format
