msgstr "<screeninfo>&kmix; Master kanal</screeninfo>"

#. Tag: phrase
#: index.docbook:207
#, no-c-format
msgid "<phrase>&kmix; Master Channel</phrase>"
msgstr "<phrase>&kmix; Master kanal</phrase>"

#. Tag: para
#: index.docbook:211
#, no-c-format
msgid "Select your &kmix; master channel."
msgstr "Odaberite &kmix; glavni kanal-."

#. Tag: title
#: index.docbook:215
#, no-c-format
msgid "Configure &kmix;"
msgstr "Konfigurišite &kmix;"

#. Tag: title
#: index.docbook:217
#, no-c-format
msgid "General configuration"
msgstr "Opšta konfiguracija"

#. Tag: screeninfo
#: index.docbook:221
#, no-c-format
msgid "<screeninfo>General configuration of &kmix;</screeninfo>"
msgstr "<screeninfo>Opšta konfiguracija &kmix;</screeninfo>"

#. Tag: phrase
#: index.docbook:227
#, no-c-format
msgid "<phrase>General configuration of &kmix;</phrase>"
msgstr "<phrase>Opšta konfiguracija &kmix;</phrase>"

#. Tag: para
#: index.docbook:231
#, no-c-format
msgid "Configure general &kmix; parameters."
msgstr "Konfigurišite glavne &kmix; parametre."

#. Tag: menuchoice
#: index.docbook:235
#, no-c-format
msgid "<guimenu>Behavior</guimenu> <guimenuitem>Volume Feedback</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:239
#, no-c-format
msgid "Check this box to enable audible feedback on volume change."
msgstr ""
"Označite ovaj kvadrat da omogućite zvučnu povratnu informaciju o promjeni "
"glasnoče."

#. Tag: menuchoice
#: index.docbook:243
#, no-c-format
msgid "<guimenu>Behavior</guimenu> <guimenuitem>Volume Overdrive</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:247
#, no-c-format
msgid ""
"Check this box to allow volume to be more than recommended value (sometimes "
"PulseAudio maximal volume exceeds the normal value). &kmix; restart is "
"needed for this setting to take effect."
msgstr ""
"Označite ovaj kvadratić da omogućite da glasnoča ima više predloženih "
"vrijednosti (ponekad PulseAudio maksimalna jačina prelazi normalnu "
"vrijednost). &kmix; potreban je restart da se primjene promjene."

#. Tag: para
#: index.docbook:249
#, no-c-format
msgid ""
"Uncheck this item if there are audible sound distortions at the maximal "
"volume."
msgstr ""
"Poništite ovu stavku ako postoji zvučna distorzija na maksimalnoj jačini."

#. Tag: menuchoice
#: index.docbook:257
#, no-c-format
msgid "<guimenu>Visual</guimenu> <guimenuitem>Show tickmarks</guimenuitem>"
msgstr ""
"<guimenu>Vizualno</guimenu> <guimenuitem>Prikaži markeres</guimenuitem>"

#. Tag: action
#: index.docbook:261
#, no-c-format
msgid "Check this box to show tickmarks on controls."
msgstr "Označite ovo da prikažete tickmarks oznake i kontrole."

#. Tag: menuchoice
#: index.docbook:265
#, no-c-format
msgid "<guimenu>Visual</guimenu> <guimenuitem>Show labels</guimenuitem>"
msgstr "<guimenu>Vizualno</guimenu> <guimenuitem>Prikaži oznake</guimenuitem>"

#. Tag: action
#: index.docbook:269
#, no-c-format
msgid "Check this box to show labels of controls."
msgstr "Označite ovo da prikažete labele sa kontrolama."

#. Tag: menuchoice
#: index.docbook:273
#, no-c-format
msgid ""
"<guimenu>Visual</guimenu> <guimenuitem>Show On Screen Display (OSD)</"
"guimenuitem>"
msgstr ""
"<guimenu>Vizualno</guimenu> <guimenuitem>Prikaži na ekranu (OSD)</"
"guimenuitem>"

#. Tag: action
#: index.docbook:277
#, no-c-format
msgid "Check this box to enable OSD show on hovering &kmix; tray widget."
msgstr "Označite ovo da uključite prikaz na ekranui &kmix; kontrole za trag."

#. Tag: menuchoice
#: index.docbook:281
#, no-c-format
msgid ""
"<guimenu>Slider orientation</guimenu> <guimenuitem>Horizontal</guimenuitem>"
msgstr ""
"<guimenu>Usmjerenje klizača</guimenu> <guimenuitem>Horizontalno</guimenuitem>"

#. Tag: action
#: index.docbook:285
#, no-c-format
msgid "Check this radio button to orientate the control slider horizontally."
msgstr "Označite ovo dugme za horizontalnu orijentaciju klizača kontrola."

#. Tag: menuchoice
#: index.docbook:289
#, no-c-format
msgid ""
"<guimenu>Slider orientation</guimenu> <guimenuitem>Vertical</guimenuitem>"
msgstr ""
"<guimenu>Usmjerenje klizača</guimenu> <guimenuitem>Vertikalno</guimenuitem>"

#. Tag: action
#: index.docbook:293
#, no-c-format
msgid "Check this radio button to orientate the control slider vertically."
msgstr "Označite ovo dugme za vertikalnu orijentaciju kotrolnog klizača."

#. Tag: menuchoice
#: index.docbook:297
#, no-c-format
msgid ""
"<guimenu>Slider orientation (System tray volume control)</guimenu> "
"<guimenuitem>Horizontal/Vertical</guimenuitem>"
msgstr ""
"<guimenu>Usmjerenje klizača (Kontrola zvuka u sistemskom uglu)</guimenu> "
"<guimenuitem>Horizontalno/Vertikalno</guimenuitem>"

#. Tag: para
#: index.docbook:301
#, no-c-format
msgid ""
"Same as the previous two radio buttons but for the system tray volume "
"control (the panel that is shown after &LMB; click on &kmix; tray icon)."
msgstr ""
"Isto kao prethodna dva drugmeta ali za sistemske zvukove (panel koji je "
"naknadno prikazan &LMB; kliknite na &kmix; tray icon)."

#. Tag: title
#: index.docbook:308
#, no-c-format
msgid "Start configuration"
msgstr "Početna konfiguracija"

#. Tag: screeninfo
#: index.docbook:312
#, no-c-format
msgid "<screeninfo>Start configuration of &kmix;</screeninfo>"
msgstr "<screeninfo>Početna konfiguracija za &kmix;</screeninfo>"

#. Tag: phrase
#: index.docbook:318
#, no-c-format
msgid "<phrase>Start configuration of &kmix;</phrase>"
msgstr "<phrase>Početna konfiguracija &kmix;</phrase>"

#. Tag: para
#: index.docbook:322
#, no-c-format
msgid "This page allows you to configure various &kmix; start parameters."
msgstr ""
"Ova opcija vam omogućava da konfigurišete razne &kmix; početne parametre."

#. Tag: menuchoice
#: index.docbook:326
#, no-c-format
msgid ""
"<guimenu>Startup</guimenu> <guimenuitem>Restore volumes on login</"
"guimenuitem>"
msgstr ""
"<guimenu>Pokretanje</guimenu> <guimenuitem>Vrati jačinu pri prijavi</"
"guimenuitem>"

#. Tag: action
#: index.docbook:330
#, no-c-format
msgid "Check this box to enable volume restoration on login."
msgstr "Označite ovo da omogućite restauraciju jačine pri pokretanju."

#. Tag: para
#: index.docbook:332
#, no-c-format
msgid "Dynamic controls from PulseAudio and MPRIS2 will not be restored."
msgstr "Dinamičke kontrole iz PulseAudio i MPRIS2 neće biti vraćene."

#. Tag: menuchoice
#: index.docbook:340
#, no-c-format
msgid "<guimenu>Startup</guimenu> <guimenuitem>Autostart</guimenuitem>"
msgstr "<guimenu>Pokretanje</guimenu> <guimenuitem>Autostart</guimenuitem>"

#. Tag: action
#: index.docbook:344
#, no-c-format
msgid "Check this box to enable &kmix; autostart with desktop environment."
msgstr "Označite ovo da omogućite &kmix; pokretanje sa desktopa."

#. Tag: title
#: index.docbook:351
#, no-c-format
msgid "Sound menu configuration"
msgstr "Konfiguracija menija za zvuk"

#. Tag: screeninfo
#: index.docbook:355
#, no-c-format
msgid "<screeninfo>Sound menu configuration of &kmix;</screeninfo>"
msgstr "<screeninfo>Konfiguracija menija za zvuk za &kmix;</screeninfo>"

#. Tag: phrase
#: index.docbook:361
#, no-c-format
msgid "<phrase>Sound menu configuration of &kmix;</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:365
#, no-c-format
msgid "This page allows you to configure various &kmix; sound menu parameters."
msgstr ""
"Ova opcija vam omogućava razne konfiguracije &kmix; zvučnih parametara."

#. Tag: guilabel
#: index.docbook:369
#, no-c-format
msgid "Dock in system tray"
msgstr "Usidri u sistemsku kasetu"

#. Tag: action
#: index.docbook:371
#, no-c-format
msgid "Check this box to dock &kmix; in system tray."
msgstr "Ovo vam omogućava da usidrite &kmix; u sistemsku kasetu."

#. Tag: para
#: index.docbook:375
#, no-c-format
msgid ""
"It is possible to select mixers that will be shown in the sound menu using "
"the corresponding list on this page."
msgstr ""
"Moguće je da se izaberu mikseru koji će biti prikazani u meniju za zvuk "
"pomoću odgovarajuće liste na ovoj stranici."

#. Tag: title
#: index.docbook:384
#, no-c-format
msgid "Advanced usage"
msgstr "Napredna upotreba"

#. Tag: title
#: index.docbook:386
#, no-c-format
msgid "Remote controlling and scripting via &DBus;"
msgstr "Daljinsko upravljanje i skriptiranje preko &DBUS;"

#. Tag: para
#: index.docbook:387
#, no-c-format
msgid ""
"You can control &kmix; via &DBus;. This is for advanced users who want to "
"achieve special tasks, like muting the PC every day at 10 pm, or for any "
"other scripting task."
msgstr ""
"Možete kontrolirati &kmix; preko &DBus;. Ovo je za napredne korisnike koji "
"žele postići posebne zadatke, kao što je prigušivanje PC svaki dan u 10 "
"sati, ili za bilo koju drugi zadatak."

#. Tag: para
#: index.docbook:391
#, no-c-format
msgid "List all &kmix; related &DBus; methods and properties"
msgstr "Izlistaj sve &kmix; srodne &DBus; metode i svojstva."

#. Tag: programlisting
#: index.docbook:393
#, no-c-format
msgid "qdbus org.kde.kmix"
msgstr "qdbus org.kde.kmix"

#. Tag: para
#: index.docbook:396
#, no-c-format
msgid "Getting volume level (0-100%):"
msgstr "Uzimanje jačine zvuka (0-100%):"

#. Tag: programlisting
#: index.docbook:398
#, no-c-format
msgid ""
"qdbus org.kde.kmix /Mixers/0/Master_0 org.freedesktop.DBus.Properties.Get "
"org.kde.KMix.Control volume"
msgstr ""
"qdbus org.kde.kmix /Mixers/0/Master_0 org.freedesktop.DBus.Properties.Get "
"org.kde.KMix.Control volume"

#. Tag: para
#: index.docbook:401
#, no-c-format
msgid "Setting volume level (0-100%):"
msgstr "Postavljanje jačine (0-100%):"

#. Tag: programlisting
#: index.docbook:403
#, no-c-format
msgid ""
"qdbus org.kde.kmix /Mixers/0/Master_0 org.freedesktop.DBus.Properties.Set "
"org.kde.KMix.Control volume 70"
msgstr ""
"qdbus org.kde.kmix /Mixers/0/Master_0 org.freedesktop.DBus.Properties.Set "
"org.kde.KMix.Control volume 70"

