msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Podešavanje zvuka</guimenuitem>"

#. Tag: para
#: index.docbook:175
#, no-c-format
msgid ""
"<action>Open <ulink url=\"help:/kcontrol/phonon\">&phonon; &systemsettings; "
"module</ulink></action> to configure the sound and video device preference "
"and the backends used by &kde; multimedia API, &phonon;."
msgstr ""
"<action>Open <ulink url=\"help:/kcontrol/phonon\">&phonon; &systemsettings; "
"module</ulink></action> za konfiguraciju zvučnih i video uređaja i za "
"sistemsku podršku koriste &kde; multimedia API, &phonon;."

#. Tag: title
#: index.docbook:199
#, no-c-format
msgid "Select Master Channel"
msgstr "Izaberite glavni kanal"

#. Tag: screeninfo
#: index.docbook:201
#, no-c-format
