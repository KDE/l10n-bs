#. Tag: title
#: man-xsldbg.1.docbook:62
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-xsldbg.1.docbook:64
#, no-c-format
msgid ""
"&xsldbg; is a tool intended to help understand stylesheets. What makes it "
"different to other stylesheet debuggers is the ability to search for items "
"of interest and trace stylesheet execution."
msgstr ""
"&xsldbg; je alatka za pomoć pri razumijevanju stilova. Ono što ga razlikuje "
"od drugih stilova debagera je sposobnost da trazi stavke od interesa i prati "
"izvršenje stila."

#. Tag: para
#: man-xsldbg.1.docbook:70
#, no-c-format
msgid ""
"&xsldbg; is a text based tool to debug stylesheets (the eXtensible "
"Stylesheet Language) and has commands similar to the Unix/Linux debugger "
"gdb. It has three major modes of execution of stylesheets."
msgstr ""
"&xsldbg; je alat na osnovu teksta za debug stilova (Extensible Stylesheet "
"Language) i komande slične Unix / Linux debugger GDB. Ona ima tri glavna "
"načina izvršenja stilova."

#. Tag: para
#: man-xsldbg.1.docbook:76
#, no-c-format
msgid "Run the whole stylesheet"
msgstr "Pokrenite cijeli stil"

#. Tag: para
#: man-xsldbg.1.docbook:77
#, no-c-format
msgid "Step to next xsl instruction"
msgstr "Korak do naredne xsl instrukcije"

#. Tag: para
#: man-xsldbg.1.docbook:78
#, no-c-format
msgid "Continue until next break point is found, or stylesheet has restarted"
msgstr ""
"Nastavi dok ne nadjes sljedecu prelomnu tačku ili dok stil nije restartovan."

#. Tag: title
#: man-xsldbg.1.docbook:86
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: title
#: man-xsldbg.1.docbook:89
#, no-c-format
msgid "Application Options"
msgstr "Opcije programa"

#. Tag: para
#: man-xsldbg.1.docbook:90
#, no-c-format
msgid ""
"Note: To turn off an option append a 'no' before that option name, eg 'nonet'"
msgstr ""
"Napomena: Da biste isključili opciju dodanu 'ne' prije toga naziva opcije, "
"npr 'Nonet'"

#. Tag: para
#: man-xsldbg.1.docbook:91
#, no-c-format
msgid "Note: Options that are marked with a '*' are on by default"
msgstr "Napomena: Opcije koje su markirane sa '*'su zadano uključene"

#. Tag: option
#: man-xsldbg.1.docbook:93
#, no-c-format
msgid "--shell"
msgstr "--shell"

#. Tag: para
#: man-xsldbg.1.docbook:94
#, no-c-format
msgid ""
"Start a shell, once a shell is started use &xsldbg;'s help command to get "
"run time help."
msgstr ""
"Pokreni shell, jednom kada je shell pokrenut &xsldbg;'s pomaže komandu "
"pokretanja pomoći."

#. Tag: option
#: man-xsldbg.1.docbook:98
#, no-c-format
msgid "--cd &lt;PATH&gt;"
msgstr "--cd &lt;PATH&gt;"

#. Tag: para
#: man-xsldbg.1.docbook:99
#, no-c-format
msgid ""
"Path to change into before loading files. See also 'cd' command documentation"
msgstr ""
"Put promijeniti u prije učitavanja datoteke. Također 'cd' komandna "
"dokumentacija"

#. Tag: option
#: man-xsldbg.1.docbook:103
#, no-c-format
msgid "--param &lt;NAME&gt;:&lt;VALUE&gt;"
msgstr "--param &lt;NAME&gt;:&lt;VALUE&gt;"

#. Tag: para
#: man-xsldbg.1.docbook:104
#, no-c-format
msgid ""
"Add a parameter named &lt;NAME&gt; and value &lt;VALUE&gt; to XSL "
"environment. See also 'addparam' command documentation"
msgstr ""
"Dodaje parametar nazvan &lt;NAME&gt; i vrijednost &lt;VRIJEDNOST&gt; u XSL "
"okruženje. Također kao 'addparam' komandnu dokumentaciju"

#. Tag: para
#: man-xsldbg.1.docbook:105
#, no-c-format
msgid "Note:A '=' can be used as name, value separator instead of ':'"
msgstr ""
"Napomena: '=' može biti korišten kao ime, separator vrijednosti umjesto ':'"

#. Tag: option
#: man-xsldbg.1.docbook:109
#, no-c-format
msgid "--lang &lt;LANG&gt;"
msgstr "--lang &lt;LANG&gt;"

#. Tag: para
#: man-xsldbg.1.docbook:110
#, no-c-format
msgid "Use ISO 639 language code specified; for example en_US"
msgstr "Zadata je upotreba ISO 639 jezičkog kôda; na primjer en_US"

#. Tag: option
#: man-xsldbg.1.docbook:114
#, no-c-format
msgid "--output &lt;FILE&gt;"
msgstr "--output &lt;FILE&gt;"

#. Tag: para
#: man-xsldbg.1.docbook:115
#, no-c-format
msgid "Save to a given file. See also output command documentation"
msgstr "Snimi u zadatu datoteku. Također kao izlaznu komandnu dokumentaciju"

#. Tag: option
#: man-xsldbg.1.docbook:119
#, no-c-format
msgid "--version"
msgstr "--version"

#. Tag: para
#: man-xsldbg.1.docbook:120
#, no-c-format
msgid "Show the version of libxml and libxslt used"
msgstr "Prikaži verzije libxml-a and libxslt-a koje se koriste"

#. Tag: option
#: man-xsldbg.1.docbook:124
#, no-c-format
msgid "--verbose"
msgstr "--verbose"

#. Tag: para
#: man-xsldbg.1.docbook:125
#, no-c-format
msgid "Show logs of what is happening"
msgstr "Prikaži dnevnike dešavanja"

#. Tag: option
#: man-xsldbg.1.docbook:129
#, no-c-format
msgid "--timing"
msgstr "--timing"

#. Tag: para
#: man-xsldbg.1.docbook:130
#, no-c-format
msgid "Display the time used"
msgstr "Prikaži potrošeno vrijeme"

#. Tag: option
#: man-xsldbg.1.docbook:134
#, no-c-format
msgid "--repeat"
msgstr "--repeat"

#. Tag: para
#: man-xsldbg.1.docbook:135
#, no-c-format
msgid ""
"Run the transformation 20 times, if --repeat is listed twice then run "
"transformation 100 time"
msgstr ""
"Pokreni transformaciju 20 puta, ako --repeat je izlistano 2 puta onda "
"pokreni transformaciju 100 puta"

#. Tag: option
#: man-xsldbg.1.docbook:139
#, no-c-format
msgid "--noautoloadconfig"
msgstr "--noautoloadconfig"

#. Tag: para
#: man-xsldbg.1.docbook:140
#, no-c-format
msgid "Automatically load/save configuration"
msgstr "Automatski učitaj/snimi konfiguraciju"

#. Tag: option
#: man-xsldbg.1.docbook:144
#, no-c-format
msgid "--debug"
msgstr "--debug"

#. Tag: para
#: man-xsldbg.1.docbook:145
#, no-c-format
msgid "Dump the tree of the result instead if libxml has such support enabled"
msgstr "Izbaci stablo rezultata umjesto ako je omogućio takvu podršku libxml"

#. Tag: option
#: man-xsldbg.1.docbook:149
#, no-c-format
msgid "--valid*"
msgstr "--valid*"

#. Tag: para
#: man-xsldbg.1.docbook:150
#, no-c-format
msgid "Enables the DTD loading phase, by default this is on"
msgstr "Omogućuje DTD fazu učitavanja, zadano je uključeno"

#. Tag: option
#: man-xsldbg.1.docbook:154
#, no-c-format
msgid "--out*"
msgstr "--out*"

#. Tag: para
#: man-xsldbg.1.docbook:155
#, no-c-format
msgid "Enable the output of the result, by default this is on"
msgstr "Omogućiti izlaz rezultata, zadano je uključeno"

#. Tag: option
#: man-xsldbg.1.docbook:159
#, no-c-format
msgid "--maxdepth val"
msgstr "--maxdepth val"

#. Tag: para
#: man-xsldbg.1.docbook:160
#, no-c-format
msgid "Increase the maximum depth"
msgstr "Povećaj maksimalnu dubinu"

#. Tag: option
#: man-xsldbg.1.docbook:164
#, no-c-format
msgid "--html"
msgstr "--html"

#. Tag: para
#: man-xsldbg.1.docbook:165
#, no-c-format
msgid ""
"The input document is(are) an HTML file(s) treat the as such if libxml has "
"such support enabled"
msgstr ""
"Ulazni dokument/ti je(su) HTML datoteka/ke tretiraju kao takva, ako libxml "
"ima takvu podršku omogućenu"

#. Tag: option
#: man-xsldbg.1.docbook:169
#, no-c-format
msgid "--docbook"
msgstr "--docbook"

#. Tag: para
#: man-xsldbg.1.docbook:170
#, no-c-format
msgid "The input document is SGML docbook if libxml has such support enabled"
msgstr ""
"Ulazni dokument je SGML knjiga dokumenata ako je libxml omogućio takvu "
"podršku"

#. Tag: option
#: man-xsldbg.1.docbook:174
#, no-c-format
msgid "--net*"
msgstr "--net*"

#. Tag: para
#: man-xsldbg.1.docbook:175
#, no-c-format
msgid ""
"Enable the fetching DTDs or entities over network, by default this is on"
msgstr ""
"Omogućite dohvaćanja DTD ili entiteta preko mreže, po defaultu to je "
"uključeno"

#. Tag: option
#: man-xsldbg.1.docbook:179
#, no-c-format
msgid "--catalogs"
msgstr "--catalogs"

#. Tag: para
#: man-xsldbg.1.docbook:180
#, no-c-format
msgid ""
"Use the catalogs from $SGML_CATALOG_FILES if libxml has such support enabled"
msgstr ""
"Koristi katalog iz $SGML_CATALOG_FILES ako libxml ima takvu podršku uključenu"

#. Tag: option
#: man-xsldbg.1.docbook:184
#, no-c-format
msgid "--xinclude*"
msgstr "--xinclude*"

#. Tag: para
#: man-xsldbg.1.docbook:185
#, no-c-format
msgid ""
"Enable XInclude processing on document input if libxml has such support "
"enabled, by default this is on"
msgstr ""
"Omogući XInclude procesiranje nadokument ulaz ako libxml ima takvu podršku "
"dopuštenu, zadano je uljučeno"

#. Tag: option
#: man-xsldbg.1.docbook:189
#, no-c-format
msgid "--profile"
msgstr "--profile"

#. Tag: para
#: man-xsldbg.1.docbook:190
#, no-c-format
msgid "Print profiling information"
msgstr "Ispis profiliranih informacija"

#. Tag: option
#: man-xsldbg.1.docbook:194
#, no-c-format
msgid "--gdb*"
msgstr "--gdb*"

#. Tag: para
#: man-xsldbg.1.docbook:195
#, no-c-format
msgid ""
"Run in GDB compatability mode and print more information, by default this is "
"on"
msgstr ""
"Pokrenuti u GDB kompatibilnost modu i ispisati više informacija, po defaultu "
"to je uključeno"

#. Tag: option
#: man-xsldbg.1.docbook:199
#, no-c-format
msgid "--autoencode*"
msgstr "--autoencode*"

#. Tag: para
#: man-xsldbg.1.docbook:200
#, no-c-format
msgid "Detect and use encodings in the stylesheet"
msgstr "Detektuj i koristi kodiranja u opisu stila"

#. Tag: option
#: man-xsldbg.1.docbook:204
#, no-c-format
msgid "--utf8input"
msgstr "--utf8input"

#. Tag: para
#: man-xsldbg.1.docbook:205
#, no-c-format
msgid "Treat command line input as encoded in UTF-8"
msgstr "Tretiraj ulaz sa komandne linije kao UTF-8 kodiran"

#. Tag: option
#: man-xsldbg.1.docbook:209
#, no-c-format
msgid "--preferhtml"
msgstr "--preferhtml"

#. Tag: para
#: man-xsldbg.1.docbook:210
#, no-c-format
msgid "Use HTML output when generating search reports"
msgstr "Koristi HTML izlaz pri generisanju izvještaja o pretrazi"

#. Tag: option
#: man-xsldbg.1.docbook:214
#, no-c-format
msgid "--stdout"
msgstr "--stdout"

#. Tag: para
#: man-xsldbg.1.docbook:215
#, no-c-format
msgid ""
"Print all error messages to stdout, normally error messages go to stderr"
msgstr "Ispisuj sve poruke o greškama na std.izl., normalno one idu na std.gr."

#. Tag: option
#: man-xsldbg.1.docbook:219
#, no-c-format
msgid "--autorestart"
msgstr "--autorestart"

#. Tag: para
#: man-xsldbg.1.docbook:220
#, no-c-format
msgid ""
"Enable the automatic restarting of execution when current processing pass is "
"complete"
msgstr ""
"Omogućiti automatsko ponovno pokretanje izvršenja kada je trenutna obrada "
"završena"

#. Tag: option
#: man-xsldbg.1.docbook:224
#, no-c-format
msgid "+XSLSource"
msgstr "+XSLSource"

#. Tag: para
#: man-xsldbg.1.docbook:225
#, no-c-format
msgid "XSL script to run (optional)"
msgstr "XSL skripta pokrenuti (opcionalna)"

#. Tag: option
#: man-xsldbg.1.docbook:229
#, no-c-format
msgid "+XMLData"
msgstr "+XMLData"

#. Tag: para
#: man-xsldbg.1.docbook:230
#, no-c-format
msgid "XML data to be transform (optional if XSLSource is specified)"
msgstr "XML podatci transformisati(opcionalno ako XSLSource je određeno)"

#. Tag: title
#: man-xsldbg.1.docbook:238
#, no-c-format
msgid "Authors"
msgstr "Autori"

#. Tag: para
#: man-xsldbg.1.docbook:239
#, no-c-format
msgid ""
"&xsldbg; is currently written and maintained by Keith "
"Isdale<email>keith@kdewebdev.org</email>"
msgstr ""
"&xsldbg; trenutno napisana i održavana od strane Keith "
"Isdale<email>keith@kdewebdev.org</email>"
