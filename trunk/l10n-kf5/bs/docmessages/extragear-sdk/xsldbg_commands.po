#. Tag: para
#: commands.docbook:6
#, no-c-format
msgid ""
"Add a libxslt parameter; equivalent to providing --param &lt;QNAME&gt;:&lt;"
"XPATH&gt; via command line."
msgstr ""
"Dodavanje libxslt parametra; ekvivalent pružanje --param&lt;QNAME&gt;:&lt;"
"XPATH&gt;  putem komandne linije."

#. Tag: title
#: commands.docbook:9
#, no-c-format
msgid "Addparam usage"
msgstr "Addparam upotreba"

#. Tag: entry
#: commands.docbook:11
#, no-c-format
msgid ""
"addparam &lt;QNAME&gt; &lt;XPATH&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(The "
"&lt;XPATH&gt; must not contain any spaces nor double quotation marks.) </"
"emphasis>"
msgstr ""
"addparam  &lt;QNAME&gt; &lt;XPATH&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(The "
"&lt;XPATH&gt; ne smije sadržavati nikakve prostore niti dvostruke navodnike)"
"</emphasis>"

#. Tag: entry
#: commands.docbook:12
#, no-c-format
msgid ""
"addparam &lt;QNAME&gt; \"&lt;XPATH&gt;\"&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>"
"(Must not contain double quotation marks in &lt;XPATH&gt;)</emphasis>"
msgstr ""
"addparam &lt;QNAME&gt; \"&lt;XPATH&gt;\"&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>"
"(Ne smije sadržavati dvostruke navodnike u &lt;XPATH&gt;)</emphasis>"

