#. Tag: title
#: commands.docbook:734
#, no-c-format
msgid "<title>Tty</title>"
msgstr "<title>Tty</title>"

#. Tag: para
#: commands.docbook:735
#, no-c-format
msgid "Open a terminal. Set the level of tty redirection."
msgstr "Otvorite terminal. Postavite nivo tty preusmjeravanje."

#. Tag: title
#: commands.docbook:736
#, no-c-format
msgid "Tty usage"
msgstr "Tty upotreba"

#. Tag: entry
#: commands.docbook:739
#, no-c-format
msgid ""
"tty &lt;DEVICE_PATH&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(Where &lt;"
"DEVICE_PATH&gt; is a valid terminal on the operating system. Just tries to "
"open the terminal</emphasis>"
msgstr ""
"tty &lt;DEVICE_PATH&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(Gdje &lt;"
"DEVICE_PATH&gt;je važeći terminal na operativnom sistemu. Samo pokuša "
"otvoriti terminal</emphasis>"

#. Tag: entry
#: commands.docbook:740
#, no-c-format
msgid ""
"tty &lt;TTY_LEVEL&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(Set the level of tty "
"redirection, where &lt;TTY_LEVEL&gt; is a valid level of input/output to use)"
"</emphasis>"
msgstr ""
"tty &lt;TTY_LEVEL&gt;&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(Postavite nivo tty "
"preusmjeravanje, gdje je &lt;TTY_LEVEL&gt;  je važeći nivo ulaz / izlaz za "
"korištenje)</emphasis>"

#. Tag: para
#: commands.docbook:741
#, no-c-format
msgid "Where level is"
msgstr "Gdje je nivo"

#. Tag: para
#: commands.docbook:746
#, no-c-format
msgid "0 = Default input/output"
msgstr "0 = Podrazumijevani ulaz/izlaz"

#. Tag: para
#: commands.docbook:747
#, no-c-format
msgid ""
"1 = Terminal output of results of transformation, tracing and walking &nbsp;"
"&nbsp;&nbsp;&nbsp;<emphasis>(Default state when tty device has been opened. "
"Not fully implemented yet.)</emphasis>"
msgstr ""
"1 = Terminal izlaz rezultata transformacije, praćenje i kretanje &nbsp;&nbsp;"
"&nbsp;&nbsp;<emphasis>( Uobičajeno stanje kada je otvoren tty uređaja  nije "
"još u potpunosti implementiran) </emphasis>"

#. Tag: para
#: commands.docbook:748
#, no-c-format
msgid ""
"2 = Full redirection to terminal&nbsp;&nbsp;&nbsp;&nbsp;<emphasis>(Not "
"implemented yet.)</emphasis>"
msgstr ""
"2 = Potpuno preusmjeravanje na terminal &nbsp;&nbsp;&nbsp;&nbsp;<emphasis>"
"(Još nije implementirana)</emphasis>"

#. Tag: para
#: commands.docbook:749
#, no-c-format
msgid "All other integer values are assumed to mean level 0"
msgstr "Sve ostale cijeli vrijednosti se pretpostavlja da znači nivo 0"

