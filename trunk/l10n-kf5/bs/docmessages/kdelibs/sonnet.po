#. Tag: title
#: index.docbook:12
#, no-c-format
msgid "Check Spelling Dialog"
msgstr "Dijalog za provjeru spelovanja"

#. Tag: author
#: index.docbook:15
#, no-c-format
msgid "&David.Sweet; &David.Sweet.mail;"
msgstr "&David.Sweet; &David.Sweet.mail;"

