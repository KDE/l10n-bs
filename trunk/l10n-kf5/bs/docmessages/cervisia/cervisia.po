#: index.docbook:2997
#, no-c-format
msgid "The Repository Menu"
msgstr "Izbornik Skladištenja"

#. Tag: menuchoice
#: index.docbook:3002
#, no-c-format
msgid "<guimenu>Repository</guimenu><guimenuitem>Create...</guimenuitem>"
