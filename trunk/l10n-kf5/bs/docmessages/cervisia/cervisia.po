#: index.docbook:2838
#, no-c-format
msgid ""
"Opens all branches in the file tree so that you can see all files and "
"folders. See <xref linkend=\"mainscreen\"/>."
msgstr ""
"Otvara sve branches u fajlu tako da možete vidjeti sve fajlove i foldere. "
"Pogledajte <xref linkend=\"mainscreen\"/>."

#. Tag: menuchoice
#: index.docbook:2845
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Fold File Tree</guimenuitem>"
msgstr "<guimenu>Pregled</guimenu><guimenuitem>Fold File Tree</guimenuitem>"

#. Tag: para
#: index.docbook:2848
#, no-c-format
msgid ""
"Closes all branches in the file tree. See <xref linkend=\"mainscreen\"/>."
msgstr ""
"Zatvara sve branches u stablu fajlova. Pogledajte  <xref linkend=\"mainscreen"
"\"/>."

#. Tag: title
#: index.docbook:2860
#, no-c-format
msgid "The Advanced Menu"
msgstr "Preporučeni Izbornik"

#. Tag: menuchoice
#: index.docbook:2865
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Tag/Branch...</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno </guimenu><guimenuitem>Tag/Branch...</guimenuitem>"

#. Tag: para
#: index.docbook:2868
#, no-c-format
msgid ""
"Tags or branches the selected files. See <xref linkend=\"taggingbranching\"/"
">."
msgstr ""
"Oznake branches selektovanih fajlova.Pogledajte<xref linkend="
"\"taggingbranching\"/>."

#. Tag: menuchoice
#: index.docbook:2874
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Delete Tag...</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Brišite Oznaku...</guimenuitem>"

#. Tag: para
#: index.docbook:2877
#, no-c-format
msgid ""
"Removes a given tag from the selected files. See <xref linkend="
"\"taggingbranching\"/>."
msgstr ""
"Uklanja datu oznaku za selektovani fajl. Pogledajte <xref linkend="
"\"taggingbranching\"/>."

#. Tag: menuchoice
#: index.docbook:2883
#, no-c-format
msgid ""
"<guimenu>Advanced</guimenu><guimenuitem>Update to Tag/Date...</guimenuitem>"
msgstr ""
"<guimenu>Napredno</guimenu><guimenuitem>Nadogradi na oznaku/datum...</"
"guimenuitem>"

#. Tag: para
#: index.docbook:2886
#, no-c-format
msgid ""
"Brings the selected files to a given tag or date, making it sticky. See "
"<xref linkend=\"updatingto\"/>."
msgstr ""
"Donosi selektovane fajlove do date oznate ili podatka, čineći ih ljepljivim. "
"Pogledajte <xref linkend=\"updatingto\"/>."

#. Tag: menuchoice
#: index.docbook:2893
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Update to HEAD...</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Update to HEAD...</guimenuitem>"

#. Tag: para
#: index.docbook:2896
#, no-c-format
msgid ""
"Brings the selected files to the respective HEAD revision. See <xref linkend="
"\"updatingto\"/>."
msgstr ""
"Donosi selektovane fajlove u retrospektivu HEAD revizije. Pogledajte <xref "
"linkend=\"updatingto\"/>."

#. Tag: menuchoice
#: index.docbook:2902
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Merge...</guimenuitem>"
msgstr "<guimenu>Preporučeno</guimenu><guimenuitem>Margine...</guimenuitem>"

#. Tag: para
#: index.docbook:2905
#, no-c-format
msgid ""
"Merges either a given branch or the modifications between two tags into the "
"selected files. See <xref linkend=\"taggingbranching\"/>."
msgstr ""
"Spaja ili datu granu ili modifikacije između dvije oznake u odabranim "
"datotekama. Pogledajte <xref linkend=\"taggingbranching\"/>."

#. Tag: menuchoice
#: index.docbook:2912
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Add Watch...</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Dodaj pratitelja...</guimenuitem>"

#. Tag: para
#: index.docbook:2915
#, no-c-format
msgid ""
"Adds a watch for a set of events on the selected files. See <xref linkend="
"\"watches\"/>."
msgstr ""
"Dodajte pratitelja za set događaja u selektovanom fajlu. Pogledajte <xref "
"linkend=\"watches\"/>."

#. Tag: menuchoice
#: index.docbook:2920
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Remove Watch...</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Ukloni pratitelja...</guimenuitem>"

#. Tag: para
#: index.docbook:2923
#, no-c-format
msgid ""
"Removes a watch for a set of events from the selected files. See <xref "
"linkend=\"watches\"/>."
msgstr ""
"Uklanja pratitelja za set događaja u selektovanom fajlu. Pogledajte <xref "
"linkend=\"watches\"/>."

#. Tag: menuchoice
#: index.docbook:2928
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Show Watchers</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Prikaži Pratitelje</guimenuitem>"

#. Tag: para
#: index.docbook:2931
#, no-c-format
msgid ""
"Lists the watchers of the selected files. See <xref linkend=\"watches\"/>."
msgstr ""
"Lista pratitelja seletovanih fajlova. Pogledajte  <xref linkend=\"watches\"/"
">."

#. Tag: menuchoice
#: index.docbook:2937
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Edit Files</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Uredite Fajlove</guimenuitem>"

#. Tag: para
#: index.docbook:2940
#, no-c-format
msgid ""
"Runs <command>cvs edit</command> on the selected files. See <xref linkend="
"\"watches\"/>."
msgstr ""
"Pokreni <command>cvs edit</command> na selektovanim fajlovima. Pogledajte "
"<xref linkend=\"watches\"/>."

#. Tag: menuchoice
#: index.docbook:2946
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Unedit Files</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Neuređeni Fajlovi</guimenuitem>"

#. Tag: para
#: index.docbook:2949
#, no-c-format
msgid ""
"Runs <command>cvs unedit</command> on the selected files. See <xref linkend="
"\"watches\"/>."
msgstr ""
"Pokreni <command>cvs unedit</command> na selektovanim fajlovima. Pogledajte  "
"<xref linkend=\"watches\"/>."

#. Tag: menuchoice
#: index.docbook:2955
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Show Editors</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Prikaži Urednike</guimenuitem>"

#. Tag: para
#: index.docbook:2958
#, no-c-format
msgid ""
"Runs <command>cvs editors</command> on the selected files. See <xref linkend="
"\"watches\"/>."
msgstr ""
"Pokreni <command>cvs editors</command> na selektovanim fajlovima. Pogledajte "
"<xref linkend=\"watches\"/>."

#. Tag: menuchoice
#: index.docbook:2964
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Lock Files</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Zaključaj Fajlove</guimenuitem>"

#. Tag: para
#: index.docbook:2967
#, no-c-format
msgid "Locks the selected files. See <xref linkend=\"locking\"/>."
msgstr "Zaključaj selektovane fajlove. Pogledajte <xref linkend=\"locking\"/>."

#. Tag: menuchoice
#: index.docbook:2973
#, no-c-format
msgid "<guimenu>Advanced</guimenu><guimenuitem>Unlock Files</guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Otključaj Fajlove</guimenuitem>"

#. Tag: para
#: index.docbook:2976
#, no-c-format
msgid "Unlocks the selected files. See <xref linkend=\"locking\"/>."
msgstr ""
"Otključava selektovanje fajlove. Pogledajte <xref linkend=\"locking\"/>."

#. Tag: menuchoice
#: index.docbook:2982
#, no-c-format
msgid ""
"<guimenu>Advanced</guimenu><guimenuitem>Create Patch Against Repository...</"
"guimenuitem>"
msgstr ""
"<guimenu>Preporučeno</guimenu><guimenuitem>Kreira Zakrpu Protiv "
"Skladištenja...</guimenuitem>"

#. Tag: para
#: index.docbook:2985
#, no-c-format
msgid ""
"Creates a patch from the modifications in your sandbox. See <xref linkend="
"\"creatingpatches\"/>."
msgstr ""
"Kreira zakrpu iz modifikacije u vašem pješčaniku. Pogledajte <xref linkend="
"\"creatingpatches\"/>."

