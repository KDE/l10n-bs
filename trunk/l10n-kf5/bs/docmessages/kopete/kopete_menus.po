#. Tag: title
#: menus.docbook:3
#, no-c-format
msgid "Menu Entries"
msgstr "Unosi menija"

#. Tag: para
#: menus.docbook:5
#, no-c-format
msgid ""
"Each menu item is discussed below. When there is a keyboard shortcut that "
"performs a menu item function, the default shortcut is listed with the menu "
"item."
msgstr ""
"Svaki član menija je diskutovan ispod. Kada imamo kraticu na tastaturi koja "
"obavlja funkciju člana menija, zadana kratica je naznačena sa članom menija."

#. Tag: title
#: menus.docbook:8
#, no-c-format
msgid "The Contact List Window's Menus"
msgstr "Prozor kontaktne liste menija"

#. Tag: title
#: menus.docbook:10
#, no-c-format
msgid "File Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:15
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Online</guimenuitem>"
msgstr ""
"<guimenu>Datoteka</guimenu> <guisubmenu>Postavi Status</guisubmenu> "
"<guimenuitem>Online</guimenuitem>"

#. Tag: para
#: menus.docbook:22
#, no-c-format
msgid "Go online with all accounts"
msgstr "Idi online sa svim računima"

#. Tag: menuchoice
#: menus.docbook:28
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Away</guimenuitem>"
msgstr ""
"<guimenu>Datoteka</guimenu> <guisubmenu>Postavi Status</guisubmenu> "
"<guimenuitem>Na putu</guimenuitem>"

#. Tag: para
#: menus.docbook:35
#, no-c-format
msgid "Set all connected accounts away"
msgstr "Postavi sve spojene račune na putu"

#. Tag: menuchoice
#: menus.docbook:41
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Set Status</guisubmenu> "
"<guimenuitem>Offline</guimenuitem>"
msgstr ""
"<guimenu>Datoteka</guimenu> <guisubmenu>Postavi Status</guisubmenu> "
"<guimenuitem>Offline</guimenuitem>"

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid "Set all accounts offline"
msgstr "Postavi sve račune offline"

#. Tag: menuchoice
#: menus.docbook:54
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Add Contact...</guimenuitem>"
msgstr ""
"<guimenu>Datoteka</guimenu> <guimenuitem>Dodaj kontakt...</guimenuitem>"

#. Tag: para
#: menus.docbook:60
#, no-c-format
msgid ""
"This displays the Add Contact Wizard, which allows you to add a new contact "
"to your list"
msgstr ""
"Ovo pakazuje čarobnjaka za dodavanje kontakata, što vam omogućava da dodate "
"novi kontakt u vašu listu"

#. Tag: menuchoice
#: menus.docbook:66
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Create New Group...</guimenuitem>"
msgstr ""
"<guimenu>Datoteka</guimenu> <guimenuitem>Kreiraj novu grupu...</guimenuitem>"

#. Tag: para
#: menus.docbook:72
#, no-c-format
msgid "Prompts you for the new group's name and adds it to the contact list."
msgstr "Od vas traži naziv nove grupe i to dodaje na listu kontakata."

#. Tag: menuchoice
#: menus.docbook:78
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Datoteka</guimenu> <guimenuitem>Prekini</guimenuitem>"

#. Tag: para
#: menus.docbook:86
#, no-c-format
msgid ""
"Disconnects you from all &im; systems, closes all the windows and exits the "
"application."
msgstr ""
"Odspaja vas sa svih &im; sistema, zatvara sve prozore i izlazi iz aplikacije."

#. Tag: title
#: menus.docbook:93 menus.docbook:421
#, no-c-format
msgid "Edit Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:126
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Send Single Message...</guimenuitem>"
msgstr ""
"<guimenu>Izmijeni</guimenu> <guimenuitem>Pošalji jednu poruku...</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:132
#, no-c-format
msgid ""
"Opens an email-style message window with the selected contact, to send a "
"single message."
msgstr ""
"Otvara se prozor u email stilu poruke s odabranom kontaktom, za slanje jedne "
"poruke."

#. Tag: menuchoice
#: menus.docbook:138
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Start Chat...</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Pokreni Chat...</guimenuitem>"

#. Tag: para
#: menus.docbook:144
#, no-c-format
msgid "Opens a chat window with the selected contact, to have a conversation."
msgstr "Otvara chat prozor sa izabranim kontaktom, radi razgovora."

#. Tag: menuchoice
#: menus.docbook:150
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Send File...</guimenuitem>"
msgstr ""
"<guimenu>Uredi</guimenu> <guimenuitem>Pošalji datoteku...</guimenuitem>"

#. Tag: para
#: menus.docbook:156
#, no-c-format
msgid ""
"If supported by the &im; system, this opens a file selector to choose a file "
"to send to the selected contact."
msgstr ""
"Ako je podržano od &im; sistema, otvara se izbornik datoteka da se izabere "
"datoteka i pošalje odabranaom kontaktu."

#. Tag: menuchoice
#: menus.docbook:162
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Move To</guisubmenu>"
msgstr "<guimenu>Uredi</guimenu> <guisubmenu>Pomjeri u</guisubmenu>"

#. Tag: para
#: menus.docbook:168
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose another group from the sub-menu, "
"and the contact will move to that group."
msgstr ""
"(Omogućeno kada je izabran kontakt) Odaberite drugu grupu iz podizbornika i "
"kontakt će se preseliti u tu grupu."

#. Tag: menuchoice
#: menus.docbook:174
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Copy To</guisubmenu>"
msgstr "<guimenu>Uredi</guimenu> <guisubmenu>Kopiraj u</guisubmenu>"

#. Tag: para
#: menus.docbook:180
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose a group from the sub-menu, and "
"the contact will be copied to group. &im; systems that allow contacts to be "
"in more than one group on the server contact list will be updated "
"accordingly."
msgstr ""
"(Omogućeno kada je izabran kontakt) Odaberite grupu iz podizbornika i "
"kontakt će se kopirati u grupu. &im; sistemi koji omogućuju kontaktima da su "
"u više od jedne grupe na popisu kontakata servera će biti u skladu s tim "
"ažurirani."

#. Tag: menuchoice
#: menus.docbook:186
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Add Contact...</guisubmenu>"
msgstr "<guimenu>Uredi</guimenu> <guisubmenu>Dodaj kontakt...</guisubmenu>"

#. Tag: para
#: menus.docbook:192
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Choose another account from the "
"submenu, and you can add another way to message that person using that "
"account."
msgstr ""
"(Omogućeno kada je izabran kontakt) Odaberite drugi račun iz podizbornika, a "
"možete dodati još jedan način da pošaljete poruku osobi koja koristi taj "
"račun."

#. Tag: menuchoice
#: menus.docbook:198
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Add to Your Contact List...</"
"guimenuitem>"
msgstr ""
"<guimenu>Uredi</guimenu> <guimenuitem>Dodajte na vašu kontaktnu listu...</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:204
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Sometimes people will message you who "
"aren't on your contact list already. In this case, &kopete; creates a "
"temporary entry for them, but to keep them on your contact list, use this "
"function."
msgstr ""
"(Omogućeno kada je izabran kontakt) Ponekad će vam ljudi slati poruke a koji "
"nisu na vašem popisu kontakata. U tom slučaju, &kopete; stvara privremeni "
"upis za njih, ali da bi ih zadržali na vašem popisu kontakata, koristite ovu "
"funkciju."

#. Tag: menuchoice
#: menus.docbook:210
#, no-c-format
msgid ""
"<shortcut><keycombo><keycap>Del</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Delete Contact</guimenuitem>"
msgstr ""
"<shortcut><keycombo><keycap>Del</keycap></keycombo> </shortcut> "
"<guimenu>Uredi</guimenu> <guimenuitem>Izbriši kontakt</guimenuitem>"

#. Tag: para
#: menus.docbook:218
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Removes a contact from the contact list "
"entirely."
msgstr ""
"(Omogućeno kada je izabran kontakt) Uklanja kontakt s liste kontakata u "
"potpunosti."

#. Tag: menuchoice
#: menus.docbook:224
#, no-c-format
msgid ""
"<shortcut><keycombo><keycap>F2</keycap></keycombo></shortcut> <guimenu>Edit</"
"guimenu> <guimenuitem>Rename</guimenuitem>"
msgstr ""
"<shortcut><keycombo><keycap>F2</keycap></keycombo></shortcut> "
"<guimenu>Uredi</guimenu> <guimenuitem>Preimenuj</guimenuitem>"

#. Tag: para
#: menus.docbook:231
#, no-c-format
msgid ""
"(Enabled when a contact is selected) Renames the contact on the contact "
"list. If you do this, the contact list entry will no longer change if the "
"contact changes their display name remotely. You can re-enable this using "
"the contact's Properties dialog."
msgstr ""
"(Omogućeno kada je izabran kontakt) Preimenuje kontakt na listi kontakata. "
"Ako ste to učinili, ulaz liste kontakata više se neće mijenjati, ako kontakt "
"mijenja svoje ime za prikaz daljinski. Možete ponovno omogućiti ovo pomoću "
"okvira svojstava kontakata."

#. Tag: menuchoice
#: menus.docbook:237
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Properties</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Svojstva</guimenuitem>"

#. Tag: para
#: menus.docbook:243
#, no-c-format
msgid ""
"The Properties dialog lets you choose custom icons for the selected item, "
"and change its name."
msgstr ""
"Okvir svojstava omogućuje da odaberete prilagođene ikone za odabranu stavku, "
"i promijeniti ime."

#. Tag: para
#: menus.docbook:244
#, no-c-format
msgid ""
"For contacts, you can change the &kde; Address Book entry that they are "
"associated with."
msgstr ""
"Za kontakte, možete promijeniti &kde; Ulaz adresara sa kojim su povezani."

#. Tag: menuchoice
#: menus.docbook:250
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Remove Group</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Izbriši grupu</guimenuitem>"

#. Tag: para
#: menus.docbook:256
#, no-c-format
msgid ""
"(Enabled when a group is selected) Removes a group from the contact list "
"entirely. Any contacts that are only in this group are moved to the top "
"level."
msgstr ""
"(Omogućeno kada je odabrana grupa) Uklanja grupu s popisa kontakata u "
"potpunosti. Bilo koji kontakt iz grupe se premješta prema gore."

#. Tag: menuchoice
#: menus.docbook:262
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Rename Group</guimenuitem>"
msgstr "<guimenu>Uredi</guimenu> <guimenuitem>Preimenuj grupu</guimenuitem>"

#. Tag: para
#: menus.docbook:268
#, no-c-format
msgid "(Enabled when a group is selected) Renames the group."
msgstr "(Omogućeno kada je odabrana grupa) Preimenuje grupu."

#. Tag: title
#: menus.docbook:276 menus.docbook:583
#, no-c-format
msgid "Settings Menu"
msgstr ""

#. Tag: para
#: menus.docbook:277 menus.docbook:584
#, no-c-format
msgid ""
"&kopete; has a default &kde; Settings menu as described in the <ulink url="
"\"help:/fundamentals/menus.html#menus-settings\">&kde; Fundamentals</ulink> "
"with additional entries:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:285
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show Offline Users</guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Pokaži Offline korisnike</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:291
#, no-c-format
msgid ""
"This shows/hides contacts who are currently offline. They will become "
"visible when they go online again."
msgstr ""
"Ovo pokazuje/krije kontakte koji su trenutno offline. Postat će vidljivi "
"kada ponovo budu online."

#. Tag: menuchoice
#: menus.docbook:297
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> </"
"shortcut> <guimenu>Settings</guimenu> <guimenuitem>Show Empty Groups</"
"guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> </"
"shortcut> <guimenu>Postavke</guimenu> <guimenuitem>Pokaži prazne grupe</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:305
#, no-c-format
msgid ""
"This shows/hides groups which do not have any members, or where all the "
"members are offline and hidden (see above)."
msgstr ""
"Ovo pokazuje/krije grupe koje nemaju nikakve članove, odnosno gdje su svi "
"članovi offline i skriveni (vidi gore)."

#. Tag: menuchoice
#: menus.docbook:311
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Global Shortcuts...</"
"guimenuitem>"
msgstr ""
"<guimenu>Postavke</guimenu> <guimenuitem>Podesi globalne kratice...</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:317
#, no-c-format
msgid ""
"Displays the &kde; standard Configure Global Shortcuts dialog, where you can "
"change keyboard shortcuts that work all the time under &kde;."
msgstr ""
"Pokazuje &kde; standardni okvir podešavanja globalnih kratica, gdje možete "
"promijeniti kratice na tastaturi koje svo vrijeme rade na &kde;."

#. Tag: title
#: menus.docbook:324 menus.docbook:605
#, no-c-format
msgid "Help Menu"
msgstr ""

#. Tag: para
#: menus.docbook:325
#, no-c-format
msgid ""
"The contact list window has the common &kde; Help menu items, for more "
"information read the section about the <ulink url=\"help:/fundamentals/menus."
"html#menus-help\">Help Menu</ulink> of the &kde; Fundamentals."
msgstr ""

#. Tag: title
#: menus.docbook:332
#, no-c-format
msgid "The Chat Window's Menus"
msgstr "Meniji chat prozora"

#. Tag: title
#: menus.docbook:334
#, no-c-format
msgid "Chat Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:338
#, no-c-format
msgid ""
"<shortcut><keycap>Return</keycap> </shortcut> <guimenu>Chat</guimenu> "
"<guimenuitem>Send Message</guimenuitem>"
msgstr ""
"<shortcut><keycap>Vratiti</keycap> </shortcut> <guimenu>Chat</guimenu> "
"<guimenuitem>Pošalji poruku</guimenuitem>"

#. Tag: para
#: menus.docbook:346
#, no-c-format
msgid "Sends a message."
msgstr "Šalje poruku."

#. Tag: menuchoice
#: menus.docbook:352
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Spasiti</guimenuitem>"

#. Tag: para
#: menus.docbook:360
#, no-c-format
msgid "Saves the content of the chat to a file."
msgstr "Spašava sadržaj chata u datoteku."

#. Tag: menuchoice
#: menus.docbook:366
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Printati...</guimenuitem>"

#. Tag: para
#: menus.docbook:374
#, no-c-format
msgid "Prints off a hard copy of the chat."
msgstr "Printa na papir chat."

#. Tag: menuchoice
#: menus.docbook:380
#, no-c-format
msgid "<guimenu>Chat</guimenu> <guisubmenu>Contacts</guisubmenu>"
msgstr "<guimenu>Chat</guimenu> <guisubmenu>Kontakti</guisubmenu>"

#. Tag: para
#: menus.docbook:386
#, no-c-format
msgid ""
"This menu lists all the people in the chat. You have access to the same "
"contact menu you get by <mousebutton>right</mousebutton>-clicking a "
"contact's name in the Contact List, allowing you to perform contact specific "
"actions such as sending them a file, viewing their user info or blocking "
"them."
msgstr ""
"Ovaj meni navodi sve ljude u chatu. Imate pristup istom meniju kontakata "
"koje ste dobili <mousebutton>desnim</mousebutton> -klikom na ime kontakta sa "
"liste kontakata, što vam omogućuje da prema kontaktu imate određene radnje, "
"kao što su slanje datoteke, gledanje njihovih korisničkih podatke ili da ih "
"blokirate."

#. Tag: menuchoice
#: menus.docbook:393
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Zatvori</guimenuitem>"

#. Tag: para
#: menus.docbook:401
#, no-c-format
msgid ""
"Closes the current chat. If there are chats taking place in other tabs in "
"this window, the window will stay open."
msgstr ""
"Zatvara trenutni chat. Ako postoje chatovi u drugim karticama u ovom "
"prozoru, prozor će ostati otvoren."

#. Tag: menuchoice
#: menus.docbook:407
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Chat</guimenu> <guimenuitem>Prestati</guimenuitem>"

#. Tag: para
#: menus.docbook:415
#, no-c-format
msgid "Closes all chats taking place in this window."
msgstr "Zatvara sve chatove u ovom prozoru."

#. Tag: menuchoice
#: menus.docbook:425
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Izreži</guimenuitem>"

#. Tag: para
#: menus.docbook:432
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and "
"put into the clipboard. Note that you can also select text and drag it to a "
"new position."
msgstr ""
"Rezanje teksta radi kao i kod većine urednika: odabrani tekst je uklonjen i "
"stavljen u međuspremnik. Imajte na umu da možete odabrati tekst i prebaciti "
"ga na novo mjesto."

#. Tag: menuchoice
#: menus.docbook:440
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Kopiraj</guimenuitem>"

#. Tag: para
#: menus.docbook:448
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, "
"and drag it to a new position to copy it."
msgstr ""
"Kopiranje teksta radi kao i kod većine urednika: odabrani tekst je kopiran u "
"međuspremnik. Imajte na umu da možete odabrani tekst držeći &Ctrl; tipku, "
"povući na novu poziciju da bi ga kopirali."

#. Tag: menuchoice
#: menus.docbook:456
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Uredi</guimenu> <guimenuitem>Zalijepi</guimenuitem>"

#. Tag: para
#: menus.docbook:463
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""
"Lijepljenje radi isto kao i kod većine urednika: tekst iz međuspremnika se "
"zalijepi na trenutnu poziciju kursora."

#. Tag: title
#: menus.docbook:470
#, no-c-format
msgid "Format Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:474
#, no-c-format
msgid "<guimenu>Format</guimenu> <guisubmenu>Add Smiley</guisubmenu>"
msgstr "<guimenu>Format</guimenu> <guisubmenu>Dodaj Smješka</guisubmenu>"

#. Tag: para
#: menus.docbook:480
#, no-c-format
msgid ""
"This menu contains all the smileys/emoticons that the current emoticon "
"scheme includes. You can change the scheme <link linkend=\"configuring-"
"appearance-emoticons\">in the Configure Kopete Dialog</link>."
msgstr ""
"Ovaj meni sadrži sve smajlije/emotikone koje sadašnja emotikon shema "
"uključuje. Možete promijeniti shemu <link linkend=\"configuring-appearance-"
"emoticons\"> u okviru podešavanja Kopete </link>."

#. Tag: title
#: menus.docbook:536
#, no-c-format
msgid "Tabs Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:540
#, no-c-format
msgid "<guimenu>Tabs</guimenu> <guisubmenu>Tab Placement</guisubmenu>"
msgstr ""
"<guimenu>Kartice</guimenu> <guisubmenu>Raspoređivanje kartica</guisubmenu>"

#. Tag: para
#: menus.docbook:546
#, no-c-format
msgid ""
"This menu allows you to change whether tabs appear at the top or the bottom "
"of the chat view."
msgstr ""
"Ovaj meni vam omogućuje da promijenite da li će se kartica pojaviti na vrhu "
"ili na dnu u prikazu chata."

#. Tag: menuchoice
#: menus.docbook:552
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></"
"keycombo> </shortcut> <guimenu>Tabs</guimenu> <guimenuitem>Detach Chat</"
"guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></"
"keycombo> </shortcut> <guimenu>Kartice</guimenu> <guimenuitem>Odvojiti Chat</"
"guimenuitem>"

#. Tag: para
#: menus.docbook:560
#, no-c-format
msgid "Separates the current chat into its own window."
msgstr "Odvaja trenutni chat u vlastiti prozor."

#. Tag: menuchoice
#: menus.docbook:566
#, no-c-format
msgid "<guimenu>Tabs</guimenu> <guisubmenu>Move Tab to Window</guisubmenu>"
msgstr ""
"<guimenu>Kartice</guimenu> <guisubmenu>Pomjeri karticu u prozor</guisubmenu>"

#. Tag: para
#: menus.docbook:572
#, no-c-format
msgid ""
"You can move chats between windows using this menu. Choose the chat window "
"the tab should move to from the menu."
msgstr ""
"Možete premjestiti chatove između prozora pomoću ovog menija. Odaberite chat "
"prozor u koji bi se kartica trebala pomjeriti iz menija."

#. Tag: title
#: menus.docbook:579
#, no-c-format
msgid "Tools Menu"
msgstr ""

#. Tag: para
#: menus.docbook:580
#, no-c-format
msgid ""
"This menu contains items added by the plugins you have loaded. See the <link "
"linkend=\"plugins\">plugins chapter</link> for details."
msgstr ""
"Ovaj meni sadrži stavke dodane od priključaka koju ste umetnuli. Pogledajte "
"<link linkend=\"plugins\">Poglavlje priključaka</link> za detalje."

#. Tag: menuchoice
#: menus.docbook:592
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Show Participants</guisubmenu>"
msgstr "<guimenu>Postavke</guimenu> <guisubmenu>Pokaži učesnike</guisubmenu>"

#. Tag: para
#: menus.docbook:598
#, no-c-format
msgid ""
"This menu controls whether the Participants list appears on the right of the "
"Chat View."
msgstr ""
"Ovaj meni kontrolira hoće li se popis učesnika pojaviti desno kod chat "
"preglednika."

#. Tag: para
#: menus.docbook:606
#, no-c-format
msgid ""
"The chat window has the common &kde; Help menu items, for more information "
"read the section about the <ulink url=\"help:/fundamentals/menus.html#menus-"
"help\">Help Menu</ulink> of the &kde; Fundamentals."
msgstr ""

