#. Tag: title
#: index.docbook:3156
#, no-c-format
msgid "Capabilities"
msgstr "Mogućnosti"

#. Tag: para
#: index.docbook:3157
#, no-c-format
msgid ""
"The import function has successfully been used to import "
"<emphasis>Northwind</emphasis> database well known to MS <guilabel>Access</"
"guilabel> users. Many other <guilabel>Access</guilabel> template databases "
"can be also imported."
msgstr ""
"Funkcija uvoza se uspješno koristi za uvoz  <emphasis>Northwind</emphasis> "
"baze podataka, dobro poznate MS <guilabel>Access</guilabel> korisnicima. "
"Mnogi drugi <guilabel>Access</guilabel> predlošci baza podataka također mogu "
"biti uvezeni."

