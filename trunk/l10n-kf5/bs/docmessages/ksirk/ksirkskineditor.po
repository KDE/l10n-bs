msgstr "vrsta"

#. Tag: entry
#: index.docbook:279
#, no-c-format
msgid "The type of goal. Can be continents, countries or player"
msgstr "Vrsta cilja. Mogu biti kontinenti, države ili igrači"

#. Tag: entry
#: index.docbook:280
#, no-c-format
msgid "nbArmiesByCountry"
msgstr "nbArmiesByCountry"

#. Tag: entry
#: index.docbook:280
#, no-c-format
msgid ""
"set the minimal number of armies the player will have to put on each country"
msgstr ""
"postavite minimalni broj vojska koje će igrač morati staviti na svaku zemlju"

#. Tag: entry
