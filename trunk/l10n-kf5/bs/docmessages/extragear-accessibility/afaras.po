#. Tag: entry
#: index.docbook:126
#, no-c-format
msgid "Toggle between \"play\" and \"stop\" for the current sample."
msgstr "Toggle between \"početak\" i \"stop\"za trenutni primjerak."

#. Tag: parameter
#: index.docbook:129
#, no-c-format
msgid "<parameter>B</parameter>"
msgstr "<parameter>B</parameter>"

#. Tag: entry
#: index.docbook:130
