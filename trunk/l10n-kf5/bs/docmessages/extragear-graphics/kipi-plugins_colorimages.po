#. Tag: para
#: colorimages.docbook:12
#, no-c-format
msgid ""
"The Kipi Color Images plugin is a tool to change or improve the images' "
"color rendering."
msgstr ""

#. Tag: keyword
#: colorimages.docbook:18
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword> KDE </keyword>"

#. Tag: keyword
#: colorimages.docbook:19
#, no-c-format
msgid "Kipi"
msgstr "Kipi"

#. Tag: title
#: colorimages.docbook:23
#, no-c-format
msgid "Color Images"
msgstr ""

#. Tag: para
#: colorimages.docbook:25
#, no-c-format
msgid ""
"This plugin can be used for batch colors enhancement of images in an Album. "
"It uses the <command>convert</command> program from the "
"<application>ImageMagick</application> package. A plugin effect preview "
"(partial or full) is available. Ten color filter types are available:"
msgstr ""

#. Tag: para
#: colorimages.docbook:36
#, no-c-format
msgid "<guilabel>Decrease Contrast</guilabel>: reduces the image contrast."
msgstr ""

#. Tag: para
#: colorimages.docbook:37
#, no-c-format
msgid "<guilabel>Depth</guilabel>: changes the color depth of the image."
msgstr ""

#. Tag: para
#: colorimages.docbook:38
#, no-c-format
msgid ""
"<guilabel>Equalize</guilabel>: performs histogram equalization to the image."
msgstr ""

#. Tag: para
#: colorimages.docbook:39
#, no-c-format
msgid ""
"<guilabel>Fuzz</guilabel>: merges colors within a distance are considered "
"equal."
msgstr ""

#. Tag: para
#: colorimages.docbook:40
#, no-c-format
msgid ""
"<guilabel>Gray scales</guilabel>: converts colors images to gray scales "
"image."
msgstr ""

#. Tag: para
#: colorimages.docbook:41
#, no-c-format
msgid "<guilabel>Increase Contrast</guilabel>: enhances the image contrast."
msgstr ""

#. Tag: para
#: colorimages.docbook:42
#, no-c-format
msgid ""
"<guilabel>Monochrome</guilabel>: transforms the image to black and white."
msgstr ""

#. Tag: para
#: colorimages.docbook:43
#, no-c-format
msgid ""
"<guilabel>Negate</guilabel>: replaces every pixel with its complementary "
"color."
msgstr ""

#. Tag: para
#: colorimages.docbook:44
#, no-c-format
msgid ""
"<guilabel>Normalize</guilabel>: transforms image to span the full range of "
"color values."
msgstr ""

#. Tag: para
#: colorimages.docbook:45
#, no-c-format
msgid ""
"<guilabel>Segment</guilabel>: segments an image by analyzing the histograms "
"of the color components."
msgstr ""

#. Tag: para
#: colorimages.docbook:46
#, no-c-format
msgid "<guilabel>Trim</guilabel>: trims an image (fuzz reverse technic)."
msgstr ""

