#, no-c-format
msgid "<firstname>Gilles</firstname><surname>Caulier</surname>"
msgstr "<firstname>Gilles</firstname><surname>Caulier</surname>"

#. Tag: email
#: resizeimages.docbook:7
#, no-c-format
msgid "caulier dot gilles at gmail dot com"
msgstr "caulier dot gilles at gmail dot com"

#. Tag: para
#: resizeimages.docbook:12
#, no-c-format
msgid ""
"The Kipi Resize Images plugin is a tool that resizes or adapts images' "
"dimensions."
msgstr ""

#. Tag: keyword
#: resizeimages.docbook:18
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword> KDE </keyword>"

#. Tag: keyword
#: resizeimages.docbook:19
#, no-c-format
msgid "Kipi"
msgstr "Kipi"

#. Tag: title
#: resizeimages.docbook:23
#, no-c-format
msgid "Resize Images"
msgstr "Promjeni veličinu slika"

#. Tag: para
#: resizeimages.docbook:25
#, no-c-format
msgid ""
"This plugin can be used to batch resize images in an image collection. It "
"uses the <command>convert</command> program from the "
"<application>ImageMagick</application> package. You can make images larger "
"or smaller. Three resizing types have been implemented:"
msgstr ""

#. Tag: para
#: resizeimages.docbook:32
#, no-c-format
msgid ""
"<guilabel>Proportional (1 dim.)</guilabel>: standard auto-resizing using one "
"dimension. The width or the height of the images will be automatically "
"selected depending on the images orientation. The images' aspect ratio is "
"preserved."
msgstr ""

#. Tag: para
#: resizeimages.docbook:36
#, no-c-format
msgid ""
"<guilabel>Proportional (2 dim.)</guilabel>: auto-resizing using two "
"dimensions. The images aspect ratio are preserved. For example, you can use "
"this for to adapt your images size to your screen size."
msgstr ""

#. Tag: para
#: resizeimages.docbook:39
#, no-c-format
msgid ""
"<guilabel>Non proportional</guilabel>: non proportional resizing using two "
"dimensions. The images' aspect ratio is not preserved."
msgstr ""

#. Tag: para
#: resizeimages.docbook:41
#, no-c-format
msgid ""
"<guilabel>Prepare to print</guilabel>: prepare the image for photographic "
"printing. The user can set the print resolution and the photographic paper "
"size. The target image will be adapted to the best dimensions (including the "
"background size, margin size, and background color)."
msgstr ""
