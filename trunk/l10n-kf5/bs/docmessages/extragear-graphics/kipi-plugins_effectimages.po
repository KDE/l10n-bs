msgstr "Kipi"

#. Tag: title
#: effectimages.docbook:23
#, no-c-format
msgid "Effect Images"
msgstr ""

#. Tag: para
#: effectimages.docbook:25
#, no-c-format
msgid ""
"This plugin can be used for batch FX transforming images in an Album. It "
"uses the <command>convert</command> program from the "
"<application>ImageMagick</application> package. An image effect preview "
"(partial or full) is also available. Eleven FX filter types have been "
"implemented:"
msgstr ""

#. Tag: para
#: effectimages.docbook:35
#, no-c-format
msgid ""
"<guilabel>Adaptive threshold</guilabel>: perform local adaptive thresholding."
msgstr ""

#. Tag: para
#: effectimages.docbook:37
#, no-c-format
msgid "<guilabel>Charcoal</guilabel>: simulate a charcoal drawing."
msgstr ""

#. Tag: para
#: effectimages.docbook:38
#, no-c-format
msgid "<guilabel>Detect edges</guilabel>: detect edges within an image."
msgstr ""

#. Tag: para
#: effectimages.docbook:39
#, no-c-format
msgid ""
"<guilabel>Emboss</guilabel>: returns a grayscale image with a three-"
"dimensional effect."
msgstr ""

#. Tag: para
#: effectimages.docbook:41
#, no-c-format
msgid "<guilabel>Implode</guilabel>: implode image pixels about the center."
msgstr ""

#. Tag: para
#: effectimages.docbook:42
#, no-c-format
msgid ""
"<guilabel>Paint</guilabel>: applies a special effect filter that simulates "
"an oil painting."
msgstr ""

#. Tag: para
#: effectimages.docbook:44
#, no-c-format
msgid ""
"<guilabel>Shade light</guilabel>: shines a distant light on an image to "
"create a three-dimensional effect."
msgstr ""

#. Tag: para
#: effectimages.docbook:46
#, no-c-format
msgid ""
"<guilabel>Solarize</guilabel>: negate all pixels above the threshold level."
msgstr ""

#. Tag: para
#: effectimages.docbook:47
#, no-c-format
msgid ""
"<guilabel>Spread</guilabel>: this is a special effects method that randomly "
"displaces each pixel in a block defined by the radius parameter."
msgstr ""

#. Tag: para
#: effectimages.docbook:49
#, no-c-format
msgid ""
"<guilabel>Swirl</guilabel>: swirls the pixels about the center of the image."
msgstr ""

#. Tag: para
#: effectimages.docbook:50
#, no-c-format
msgid ""
"<guilabel>Wave</guilabel>: creates a ripple effect in the image by shifting "
"the pixels vertically along a sine wave."
msgstr ""

