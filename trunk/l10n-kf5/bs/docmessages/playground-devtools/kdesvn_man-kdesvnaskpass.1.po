msgstr "Prompt koji je prikazan korisniku."

#. Tag: title
#: man-kdesvnaskpass.1.docbook:46
#, no-c-format
msgid "Generic options:"
msgstr "Generičke opcije:"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:49
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:51
#, no-c-format
msgid "Show help about options"
msgstr "Prikaži pomoć o opcijama"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:55
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:57
#, no-c-format
msgid "Show Qt specific options"
msgstr "Prikaži Qt specifične opcije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:61
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:63
#, no-c-format
msgid "Show KDE specific options"
msgstr "Prikaži KDE specifične opcije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:67
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:69
#, no-c-format
msgid "Show all options"
msgstr "Prikaži sve opcije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:73
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:75
#, no-c-format
msgid "Show author information"
msgstr "Prikaži podatke o autoru"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:79
#, no-c-format
msgid "-v, --version"
msgstr "-v, --version"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:81
#, no-c-format
msgid "Show version information"
msgstr "Prikaži podatke o izdanju"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:85
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:87
#, no-c-format
msgid "Show license information"
msgstr "Prikaži podatke o licenci"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:91
#, no-c-format
msgid "<option>--</option>"
msgstr "<option>--</option>"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:93
#, no-c-format
msgid "End of options"
msgstr "Kraj opcija"

#. Tag: title
#: man-kdesvnaskpass.1.docbook:99
#, no-c-format
msgid "KDE options:"
msgstr "KDE opcije:"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:102
#, no-c-format
msgid "--caption &lt;caption&gt;"
msgstr "--caption &lt;caption&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:104
#, no-c-format
msgid "Use 'caption' as name in the titlebar"
msgstr "Koristi 'caption' kao tekst naslovne trake"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:108
#, no-c-format
msgid "--icon &lt;icon&gt;"
msgstr "--icon &lt;icon&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:110
#, no-c-format
msgid "Use 'icon' as the application icon"
msgstr "Koristi 'icon' za ikonu aplikacije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:114
#, no-c-format
msgid "--config &lt;filename&gt;"
msgstr "--config &lt;filename&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:116
#, no-c-format
msgid "Use alternative configuration file"
msgstr "Koristi alternativnu datoteku sa postavkama"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:120
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:122
#, no-c-format
msgid "Disable crash handler, to get core dumps"
msgstr "Isključi rukovalac rušenja, za dobijanje popisa jezgra"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:126
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:128
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Čeka na menadžer prozora saglasan WM_NET‑u"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:132
#, no-c-format
msgid "--style &lt;style&gt;"
msgstr "--style &lt;style&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:134
#, no-c-format
msgid "sets the application GUI style"
msgstr "postavlja GUI stil aplikacije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:138
#, no-c-format
msgid "--geometry &lt;geometry&gt;"
msgstr "--geometry &lt;geometry&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:140
#, no-c-format
msgid ""
"sets the client geometry of the main widget - see man X for the argument "
"format"
msgstr ""
"podešava geometriju klijenta iz glavne forme - pogledajte man X za format "
"argumenata"

#. Tag: title
#: man-kdesvnaskpass.1.docbook:146
#, no-c-format
msgid "Qt options:"
msgstr "Qt opcije:"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:149
#, no-c-format
msgid "--display &lt;displayname&gt;"
msgstr "--display &lt;displayname&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:151
#, no-c-format
msgid "Use the X-server display 'displayname'"
msgstr "Koristi X-server display 'displayname'"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:155
#, no-c-format
msgid "--session &lt;sessionId&gt;"
msgstr "--session &lt;sessionId&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:157
#, no-c-format
msgid "Restore the application for the given 'sessionId'"
msgstr "Obnovi aplikaciju za dati 'sessionId'"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:161
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:163
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Uzrokuje da aplikacija instalirata privatnu mapu boja na 8-bitnom zaslonu"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:168
#, no-c-format
msgid "--ncols &lt;count&gt;"
msgstr "--ncols &lt;count&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:170
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Ograničava broj boja dodijeljenih u boji kocke na 8-bitnom zaslonu, ako "
"aplikacija koristi QApplication::ManyColor specifikaciju boja"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:177
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:179
#, no-c-format
msgid "tells Qt to never grab the mouse or the keyboard"
msgstr "govori Qt‑u da nikada ne zahvata miš ili tastaturu"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:183
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:185
#, no-c-format
msgid ""
"running under a debugger can cause an implicit -nograb, use -dograb to "
"override"
msgstr ""
"pokretanje pod debuggerom može prouzrokovati implicitni -nograb, koristite -"
"nograb za override"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:190
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:192
#, no-c-format
msgid "switches to synchronous mode for debugging"
msgstr "prebacuje u sinhroni režim za debuggiranje"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:196
#, no-c-format
msgid "--fn, --font &lt;fontname&gt;"
msgstr "--fn, --font &lt;fontname&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:198
#, no-c-format
msgid "defines the application font"
msgstr "definiše font aplikacije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:202
#, no-c-format
msgid "--bg, --background &lt;color&gt;"
msgstr "--bg, --background &lt;color&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:204
#, no-c-format
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)"
msgstr ""
"postavlja podrazumjevanu boju pozadine i paletu aplikacije (svijetle i tamne "
"sijenke su proračunate)"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:210
#, no-c-format
msgid "--fg, --foreground &lt;color&gt;"
msgstr "--fg, --foreground &lt;color&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:212
#, no-c-format
msgid "sets the default foreground color"
msgstr "postavlja podrazumijevanu boju ispisa"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:216
#, no-c-format
msgid "--btn, --button &lt;color&gt;"
msgstr "--btn, --button &lt;color&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:218
#, no-c-format
msgid "sets the default button color"
msgstr "postavlja podrazumijevanu boju dugmadi"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:222
#, no-c-format
msgid "--name &lt;name&gt;"
msgstr "--name &lt;name&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:224
#, no-c-format
msgid "sets the application name"
msgstr "postavlja ime aplikacije"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:228
#, no-c-format
msgid "--title &lt;title&gt;"
msgstr "--title &lt;title&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:230
#, no-c-format
msgid "sets the application title (caption)"
msgstr "postavlja naslovnu liniju aplikacije (caption)"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:234
#, no-c-format
msgid "--visual TrueColor"
msgstr "--visual TrueColor"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:236
#, no-c-format
msgid "forces the application to use a TrueColor visual on an 8-bit display"
msgstr "prisiljava aplikaciju da koristi TrueColor visual na 8-bitnom zaslonu"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:241
#, no-c-format
msgid "--inputstyle &lt;inputstyle&gt;"
msgstr "--inputstyle &lt;inputstyle&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:243
#, no-c-format
msgid ""
"sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root"
msgstr ""
"postavlja XIM (X Input Method) stil ulaza. Moguće vrijednosti su onthespot, "
"overthespot, offthespot and korijen"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:249
#, no-c-format
msgid "--im &lt;XIM server&gt;"
msgstr "--im &lt;XIM server&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:251
#, no-c-format
msgid "set XIM server"
msgstr "podesi XIM server"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:255
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:257
#, no-c-format
msgid "disable XIM"
msgstr "isključi XIM"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:261
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:263
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr "izvrće cijeli raspored grafičkih kontrola"

#. Tag: option
#: man-kdesvnaskpass.1.docbook:267
#, no-c-format
msgid "--stylesheet &lt;file.qss&gt;"
msgstr "--stylesheet &lt;file.qss&gt;"

#. Tag: para
#: man-kdesvnaskpass.1.docbook:269
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets"
msgstr "primjenjuje Qt‑ov opis stila na programske grafičke kontrole"

