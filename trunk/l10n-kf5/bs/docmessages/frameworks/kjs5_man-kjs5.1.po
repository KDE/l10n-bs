#. Tag: title
#: man-kjs5.1.docbook:108
#, no-c-format
msgid "Usage"
msgstr "Upotreba"

#. Tag: para
#: man-kjs5.1.docbook:109
#, fuzzy, no-c-format
#| msgid ""
#| "<command>kjs</command> <parameter>file</parameter>, as many other "
#| "interpreters, when called without parameters uses a line editor to enter "
#| "statements, showing the prompt <literallayout>JS></literallayout> To exit "
#| "the line editor type <command>quit()</command> or press <command>Ctrl+D</"
#| "command>."
msgid ""
"<command>kjs5</command> <parameter>file</parameter>, as many other "
"interpreters, when called without parameters uses a line editor to enter "
"statements, showing the prompt <literallayout>JS></literallayout> To exit "
"the line editor type <command>quit()</command> or press <command>Ctrl+D</"
"command>."
msgstr ""
"<command>kjs</command> <parameter>file</parameter>, kao i druge prevodioce "
"kada su pozvani bez parametara koriste editore da unesu izvještaje, te "
"prikazuje gotove <literallayout>JS></literallayout> Da napustite editor "
"kucajte <command>quit()</command>ili <command>Ctrl+D</command>."

