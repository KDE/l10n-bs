#: tools/scriptbuilder.cpp:170
#, kde-format
msgid ""
"Point the display at the specified location. %1 can be the name of an "
"object, a cardinal point on the compass, or 'zenith'."
msgstr ""
"Uperi prikaz na navedenu lokaciju. %1 može biti ime objekta, kardinalna "
"tačka na kompasu, ili „zenit“."

#: tools/scriptbuilder.cpp:171
#, kde-format
msgid "Add a name label to the object named %1."
msgstr "Dodaj ime oznake objektu nazvanom %1."

#: tools/scriptbuilder.cpp:172
#, kde-format
msgid "Remove the name label from the object named %1."
msgstr "Odstrani imensku oznaku objekta %1."

#: tools/scriptbuilder.cpp:173
#, kde-format
msgid "Add a trail to the solar system body named %1."
msgstr "Dodaj trag objektu solarnog sistema, koji se zove %1."

#: tools/scriptbuilder.cpp:174
#, kde-format
msgid "Remove the trail from the solar system body named %1."
msgstr "Ukloni trag objektu Sunčevog sistema, koji se zove %1."

#: tools/scriptbuilder.cpp:175
msgid ""
"Point the display at the specified RA/Dec coordinates.  RA is expressed in "
"Hours; Dec is expressed in Degrees."
msgstr ""
"Usmjeri prikaz na odrežene RA/Dec koordinate. RA je izražen u satima; Dec je "
"izražen u stepenima."

#: tools/scriptbuilder.cpp:177
msgid ""
"Point the display at the specified Alt/Az coordinates.  Alt and Az are "
"expressed in Degrees."
msgstr ""
"Usmjeri prikaz na određene Alt/Az koordinate. Alt i Az su izražene u "
"stepenima."

#: tools/scriptbuilder.cpp:179
msgid "Increase the display Zoom Level."
msgstr "Povećaj nivo uvećanja."

#: tools/scriptbuilder.cpp:180
msgid "Decrease the display Zoom Level."
msgstr "Smanji nivo uvećanja."

#: tools/scriptbuilder.cpp:181
msgid "Set the display Zoom Level to its default value."
msgstr "Podesi nivo uvećanja na podrazumijevanu vrijednost."

#: tools/scriptbuilder.cpp:182
msgid "Set the display Zoom Level manually."
msgstr "Ručno podesi nivo uvećanja."

#: tools/scriptbuilder.cpp:183
msgid "Set the system clock to the specified Local Time."
msgstr "Podešava sistemski sat na navedeno Lokalno vrijeme."

#: tools/scriptbuilder.cpp:185
msgid "Pause script execution for specified number of seconds."
msgstr "Prekini izvođenje skripte za određen broj sekundi."

#: tools/scriptbuilder.cpp:186
msgid ""
"Halt script execution until the specified key is pressed.  Only single-key "
"strokes are possible; use 'space' for the spacebar."
msgstr ""
"Zaustaviti izvršenje skripte sve dok je navedena tipka pritisnuta. Samo "
"ključni potezi su mogući; koristi 'pr5azan prostor' za razmak."

#: tools/scriptbuilder.cpp:188
msgid "Set whether the display is tracking the current location."
msgstr "Određuje da li prikaz prati trenutnu lokaciju."

#: tools/scriptbuilder.cpp:189
#, kde-format
msgid "Change view option named %1 to value %2."
msgstr "Izmijeni opciju pogleda pod imenom %1 na vrijednost %2."

#: tools/scriptbuilder.cpp:190
msgid ""
"Set the geographic location to the city specified by city, province and "
