#: package/contents/ui/FullRepresentation.qml:181
#, kde-format
msgid "Click to access this device from other applications."
msgstr "Kliknite da pristupite ovom uređaju iz drugih programa."

#: package/contents/ui/FullRepresentation.qml:183
#, kde-format
msgid "Click to eject this disc."
msgstr "Kliknite za izbacivanje ovog diska."

#: package/contents/ui/FullRepresentation.qml:185
#, kde-format
msgid "Click to safely remove this device."
msgstr "Kliknite da bezbjedno uklonite ovaj uređaj."

