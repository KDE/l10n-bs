#. i18n: ectx: property (windowTitle), widget (QWidget, WdgCrashReporter)
#: crashreporter/wdg_crash_reporter.ui:14
msgid "Krita Error Reporter"
msgstr "Krita izvjštaj grešaka"

#. i18n: ectx: property (text), widget (QLabel, label)
#: crashreporter/wdg_crash_reporter.ui:58
msgid ""
"<html><head/><body><p>Sorry!</p><p>Krita closed unexpectedly! Please help us "
"make Krita better by sending us more information.</p><p>If you'd like us to "
"contact you, please add your email address. We will not share your email "
"address with anyone.</p></body></html>"
msgstr ""
"<html><head/><body><p>Izvinite!</p><p>Krita je zatvorena neočekivano ! "
"Molimo Vas pomozite nam da napravimo  Kritu boljom šaljući nam više "
"informacija.</p><p>Ako želite da Vas kontaktiramo , dodajte svoju e-mail "
"adresu . Nećemo dijeliti vašu email adresu sa bilo kim .</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#. i18n: ectx: property (text), widget (QLabel, label)
#. i18n: ectx: property (text), widget (QLabel, label_8)
#: crashreporter/wdg_crash_reporter.ui:76
#: plugins/extensions/resourcemanager/wdgdlgbundlemanager.ui:459
#: plugins/extensions/resourcemanager/wdgdlgcreatebundle.ui:268
msgid "Email:"
msgstr "Email:"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: crashreporter/wdg_crash_reporter.ui:95
msgid ""
"<html><head/><body><p>Please describe what you were doing when the crash "
"happened or anything strange that you might have seen :</p></body></html>"
msgstr ""
"<html><head/><body><p>Opišite što ste radili kad se sudar dogodio ili bilo "
"šta čudno da ste možda vidijeli :</p></body></html>"

