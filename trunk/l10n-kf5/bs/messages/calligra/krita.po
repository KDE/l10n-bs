#: ui/recorder/kis_node_query_path_editor.cc:86
msgid ""
"<b>/</b> represents the root of the image, or a separator<br/>\n"
"<b>a number</b> represents a layer<br/>\n"
"<b>.</b> represents the current layer<br/>\n"
"<b>..</b> represents the parent layer<br/>\n"
"\n"
"<b>Examples:</b><br/>\n"
"<i>/0</i> represents the bottom layer of the image<br/>\n"
"<i>../1</i> represents the second layer from the bottom of the parent of the "
"current layer<br/>\n"
"<i>./0</i> represents the first child of the current layer"
msgstr ""
"<b>/</b> predstavlja korijen slike, ili seperator<br/>\n"
"<b>a number</b> predstavlja sloj<br/>\n"
"<b>.</b> predstavlja trenutni sloj<br/>\n"
"<b>..</b> predstavlja sloj roditelj<br/>\n"
"\n"
"<b>Primjeri:</b><br/>\n"
"<i>/0</i> predstavlja sloj na dnu slike<br/>\n"
"<i>../1</i> predstavlja drugi sloj od dna roditelj trenutnog sloja<br/>\n"
"<i>./0</i> predstavlja prvo dijete trenutnog sloja"

