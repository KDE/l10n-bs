#: sqliteadmin.cpp:42
#, kde-format
msgid "Could not compact database \"%1\"."
msgstr "Nisam mogao da sažmem bazu podataka \"%1\"."

#: sqliteconnection.cpp:312
#, kde-format
msgid "Could not remove file \"%1\"."
msgstr "Nisam mogao da uklonim datoteku \"%1\"."

#: sqliteconnection.cpp:314
msgid ""
"Check the file's permissions and whether it is already opened and locked by "
"another application."
msgstr ""
"Provjerite dozvole datoteke, kao i da li je možda već otvorio i zaključao "
"neki drugi program."

#: sqlitevacuum.cpp:131
msgctxt "@title:window"
msgid "Compacting Database"
msgstr "Kompakcija baze podataka"

#: sqlitevacuum.cpp:132
#, kde-format
msgctxt "@info"
msgid "Compacting database <resource>%1</resource>..."
msgstr "Kompakcija baze podataka <resource>%1</resource>..."

#: sqlitevacuum.cpp:212
#, kde-format
msgctxt "@info"
msgid "The database has been compacted. Current size decreased by %1% to %2."
msgstr "Baza je sažeta. Tekuća veličina je smanjena %1%, na %2."
