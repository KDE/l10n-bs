msgstr "Vraćeni ID zapisa ne odgovara poslatom: "

#: metaweblog.cpp:66
#, kde-format
msgid "Media is a null pointer."
msgstr "Medijum je nulti pokazivač."

#: metaweblog.cpp:174
#, kde-format
