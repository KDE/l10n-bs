#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Plazma radni prostor"

#: plasma_workspace.notifyrc:39
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Smeće: ispražnjeno"

#: plasma_workspace.notifyrc:73
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Smeće je ispražnjeno"

#: plasma_workspace.notifyrc:111
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Dopuna teksta: rotacija"

#: plasma_workspace.notifyrc:144
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Dostignut je kraj spiska poklapanja"

#: plasma_workspace.notifyrc:181
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Dopuna teksta: nema poklapanja"

#: plasma_workspace.notifyrc:214
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Nije nađeno nijedno poklapanje za dopunu"

#: plasma_workspace.notifyrc:251
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Dopuna teksta: delimično poklapanje"

#: plasma_workspace.notifyrc:284
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Postoji više od jednog mogućeg poklapanja"

#: plasma_workspace.notifyrc:321
msgctxt "Name"
msgid "Fatal Error"
msgstr "Kobna greška"

#: plasma_workspace.notifyrc:354
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Došlo je do ozbiljne greške zbog koje je program obustavljen"

#: plasma_workspace.notifyrc:392
msgctxt "Name"
msgid "Notification"
msgstr "Obavještenje"

#: plasma_workspace.notifyrc:426
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Nešto posebno se dogodilo u programu"

#: plasma_workspace.notifyrc:463
msgctxt "Name"
msgid "Warning"
msgstr "Upozorenje"

#: plasma_workspace.notifyrc:497
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Došlo je do greške u programu koja može izazvati probleme"

#: plasma_workspace.notifyrc:534
msgctxt "Name"
msgid "Catastrophe"
msgstr "Katastrofa"

#: plasma_workspace.notifyrc:567
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Došlo je do vrlo ozbiljne greške, zbog koje je bar program obustavljen"

#: plasma_workspace.notifyrc:605
msgctxt "Name"
msgid "Login"
msgstr "Prijava"

#: plasma_workspace.notifyrc:639
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Nova sesija započinje"

#: plasma_workspace.notifyrc:676
msgctxt "Name"
msgid "Logout"
msgstr "Odjavi se"

#: plasma_workspace.notifyrc:710
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Izlaz iz sesije"

#: plasma_workspace.notifyrc:748
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Odjava otkazana"

#: plasma_workspace.notifyrc:782
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Plazma odjava je prekinuta"

#: plasma_workspace.notifyrc:819
msgctxt "Name"
msgid "Print Error"
msgstr "Greška štampanja"

#: plasma_workspace.notifyrc:853
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Došlo je do greške pri štampanju"

#: plasma_workspace.notifyrc:890
msgctxt "Name"
msgid "Information Message"
msgstr "Informativna poruka"

#: plasma_workspace.notifyrc:924
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Prikazana je informativna poruka"

#: plasma_workspace.notifyrc:961
msgctxt "Name"
msgid "Warning Message"
msgstr "Upozoravajuća poruka"

#: plasma_workspace.notifyrc:995
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Prikazana je upozoravajuća poruka"

#: plasma_workspace.notifyrc:1032
msgctxt "Name"
msgid "Critical Message"
msgstr "Kritična poruka"

#: plasma_workspace.notifyrc:1066
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Prikazana je kritična poruka"

#: plasma_workspace.notifyrc:1103
msgctxt "Name"
msgid "Question"
msgstr "Pitanje"

#: plasma_workspace.notifyrc:1137
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Nešto ste upitani"

#: plasma_workspace.notifyrc:1175
msgctxt "Name"
msgid "Beep"
msgstr "Bip"

#: plasma_workspace.notifyrc:1209
msgctxt "Comment"
msgid "Sound bell"
msgstr "Zvučno zvono"
