#: main.cpp:172
#, fuzzy, kde-format
msgid ""
"Examples:\n"
"  konsolekalendar --view\n"
"  konsolekalendar --list-calendars\n"
"  konsolekalendar --add --calendar 42 --date 2016-12-04 --time 10:00 --end-"
"time 12:00 \\\n"
"                  --summary \"Doctor Visit\" --description \"Get My Head "
"Examined\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"
msgstr ""
"Primjeri\n"
"  konsolekalendar --view\n"
"  konsolekalendar --list-collections\n"
"  konsolekalendar --add --collection 42 --date 2003-06-04 --time 10:00 --end-"
"time 12:00 \\\n"
"                  --summary \"Doctor Visit\" --description \"Ispitajte mi "
"glavu\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"

