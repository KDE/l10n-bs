#. (itstool) path: component/name
#: org.kde.kwave.appdata.xml:6
msgid "Kwave"
msgstr "Kwave"

#. (itstool) path: component/summary
#: org.kde.kwave.appdata.xml:7
#, fuzzy
#| msgid "Kwave is a sound editor designed for the KDE Desktop Environment"
msgid "Kwave is a sound editor built on KDE Frameworks 5"
msgstr "Kwave je uređivač zvuka dizajniran za KDE Desktop Environment"

#. (itstool) path: description/p
#: org.kde.kwave.appdata.xml:9
msgid ""
"With Kwave you can record, play back, import and edit many sorts of audio "
"files including multi channel files."
msgstr ""
"Sa KWave možete snimati, reprodukovati, uvoziti i uređivati mnogo vrsta "
"audio datoteka uključujući višekanalne datoteke."

#. (itstool) path: description/p
#: org.kde.kwave.appdata.xml:12
msgid ""
"Kwave includes some plugins to transform audio files in several ways and "
"presents a graphical view with a complete zoom- and scroll capability."
msgstr ""
"Kwave uključuje neke dodatke za transformaciju audio datoteka na više načina "
"i predstavlja grafički pogled s kompletnom mogućnošću uvećanja i klizanja."
