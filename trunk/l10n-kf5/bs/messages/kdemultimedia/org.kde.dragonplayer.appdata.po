#. (itstool) path: component/name
#: org.kde.dragonplayer.appdata.xml:6
msgid "Dragon Player"
msgstr "Dragon plejer"

#. (itstool) path: component/summary
#: org.kde.dragonplayer.appdata.xml:7
msgid "Video player with focus on simplicity"
msgstr ""

#. (itstool) path: description/p
#: org.kde.dragonplayer.appdata.xml:9
#, fuzzy
#| msgid ""
#| "Dragon Player is a multimedia player where the focus is on simplicity, "
#| "instead of features. Dragon Player does one thing, and only one thing, "
#| "which is playing multimedia files. It's simple interface is designed not "
#| "to get in your way and instead empower you to simply play multimedia "
#| "files."
msgid ""
"Dragon Player is a multimedia player where the focus is on simplicity, "
"instead of features. Dragon Player does one thing, and only one thing, which "
"is playing multimedia files. Its simple interface is designed not to get in "
"your way and instead empower you to simply play multimedia files."
msgstr ""
"Dragon Player  je multimedijalni plejer gdje je fokus na jednostavnosti, "
"umesto funkcija. Dragon Player  radi jednu stvar, i samo jednu stvar, a to "
"je izvedba multimedijalnih fajlova. Njiegov jednostavan interfejs je "
"dizajniran da se ne stane na put, a umjesto toga osnaži vas da jednostavno "
"reprodukujete multimedijalne fajlove."

#. (itstool) path: description/p
#: org.kde.dragonplayer.appdata.xml:14
msgid "Features:"
msgstr "Svojstva:"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:16
msgid "Simple Interface"
msgstr "Prosto sučelje"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:17
msgid ""
"Resuming videos: Starts playing a video where you were watching it last time"
msgstr "Nastavak video: Počinje video na mjestu gdje ste ga gledali zadnji put"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:18
msgid ""
"Support for subtitles: Automatically loads subtitles with the matching name"
msgstr ""
"Podrška za podnaslove: Automatski učitava podnaslove s odgovarajućim imenom"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:19
msgid "Video display settings (brightness, contrast)"
msgstr "Postavke ekrana (osvjetljenje, kontrast)"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:20
msgid ""
"Due to using Solid and Phonon DragonPlayer is independent of any multimedia "
"framework or hardware abstraction layer"
msgstr ""
"Pošto kotisti Solid i Phonon DragonPlayer je neovisan od bilo kog "
"multimedijalnog radnog okvira ili hardverskog sloja apstracije."

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:21
