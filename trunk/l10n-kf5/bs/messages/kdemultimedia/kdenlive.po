msgstr "Tri-po-em razmak. Širina: 1/3 za jedno <em>em</em>"

#: src/titler/unicodedialog.cpp:170
msgid "Four-Per-Em Space. Width: 1/4 of one <em>em</em>"
msgstr "Četiri-po-em razmak. Šitina: 1/4 za jedno <em>em</em>"

