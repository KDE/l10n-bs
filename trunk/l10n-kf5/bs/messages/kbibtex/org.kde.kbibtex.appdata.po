#. (itstool) path: component/name
#: org.kde.kbibtex.appdata.xml:14
msgid "KBibTeX"
msgstr "KBibTeX"

#. (itstool) path: component/summary
#: org.kde.kbibtex.appdata.xml:15
#, fuzzy
#| msgid "BibTeX editor for KDE to edit bibliographies used with LaTeX"
msgid "BibTeX editor by KDE to edit bibliographies used with LaTeX"
msgstr "Uređivač BibTeX za KDE za uređivanje bibliografija korištenih sa LaTeX"

#. (itstool) path: description/p
#: org.kde.kbibtex.appdata.xml:17
msgid ""
"KBibTeX is a reference management application which can be used to collect "
"TeX/LaTeX bibliographies and export them in various formats."
msgstr ""
"KBibTeX je aplikacija za upravljanje referencom koja može biti "
"upotrijebljena za skupljanje TeX/LaTeX bibliografijama i izvoziti ih u "
"raznim formatima."

#. (itstool) path: description/p
#: org.kde.kbibtex.appdata.xml:20
msgid "KBibTeX can do the following things:"
msgstr "KBibTeX može uraditi sljedeće stvari:"

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:22
msgid ""
"Preview bibliography entries in various formats (Source (BibTeX), Source "
"(RIS), Wikipedia, standard (XML/XSLT), fancy (XML/XSLT), and abstract-only "
"(XML/XSLT)). Additional preview styles become available when bibtex2html is "
"installed."
msgstr ""
"Pregled ulaza bibliografija u raznim formatima (Source(BibTeX), Source(RIS), "
"Wikipedia, standard(XML/XSLT), fancy(XML/XSLT) i abstract-only(XML/XSLT)). "
"Dodatni pregled stilova postaje dostupan kada je bibtex2html instaliran."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:23
msgid ""
"Import data in various bibliography file formats such as BibTeX, RIS and ISI "
"(requires bibutils) and export data to PDF (requires pdflatex), PostScript "
"(requires latex), RTF (requires latex2rtf), and HTML."
msgstr ""
"Uvoz podataka u raznim bibliografskim formatima datoteke kao što su BibTeX, "
"RIS i ISI (zahtijeva bibutils) i izvoz podataka u PDF(zahtijeva pdflatex), "
"PostScript(zahtijeva latex), RTF(zahtijeva latex2rtf) i HTML."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:24
msgid ""
"Search for the bibliography entries data in online databases (e.g. Google "
"Scholar, ACM, IEEE, arXiv, etc.)"
msgstr ""
"Pretraga za ulazne podatke bibliografije u online bazama podataka (npr. "
"Google Scholar, ACM, IEEE,arXiv, itd.)"

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:25
msgid ""
"Preview local or remote (online) resources, e.g. PDF files, linked in the "
"BibTEX entry."
msgstr ""
"Pregled lokalnih ili udaljenih (online) resursa , npr. PDF datoteke, "
"povezane u BibTEX ulazu."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:26
msgid "Find and merge duplicate entries in bibliography."
msgstr "Potraži i spoji duplikate ulaza u bibliografiju."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:27
msgid "Integrate your bibliographies with LaTeX editors such as Kile and LyX."
msgstr ""
"Integriraj vaše bibliografije sa LaTeX uređivačima kao što su Kile i LyX."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:28
msgid "Import your Zotero library."
msgstr "Uvoz vaše Zotero biblioteke."

