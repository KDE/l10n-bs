#: tools/astrocalc.cpp:48
#, kde-format
msgid ""
"<QT><H2>KStars Astrocalculator</H2><P>The KStars Astrocalculator contains "
"several <B>modules</b> which perform a variety of astronomy-related "
"calculations.  The modules are organized into several categories: "
"<UL><LI><B>Time calculators: </B>Convert between time systems, and predict "
"the timing of celestial events</LI><LI><B>Coordinate converters: </B>Convert "
"between various coordinate systems</LI><LI><B>Solar system: </B>Predict the "
"position of any planet, from a given location on Earth at a given time</LI></"
"UL></QT>"
msgstr ""
"<QT><H2>KStars Astrokalkulator</H2><P> KStars Astrokalkulator sadrži "
"nekoliko <B>modula</b> koji služe za izvođenje različitih astronomskih "
"srodnih kalkulacija. Moduli su organizovani u nekoliko kategorija: "
"<UL><LI><B>Time kalkulatori: </B>Pretvaranje vremenskih sistema, i "
"predviđanje vremena nebeskih događaja</LI><LI><B>Pretvarači koordinata: </"
"B>Pretvaranje između različitih koordinatnih sistema</LI><LI><B>Solarni "
"sistem: </B>Predviđanje pozicije bilo koje planete, sa date lokacije na "
"Zemlji u dato vrijeme</LI></UL></QT>"

#: tools/astrocalc.cpp:63
#, kde-format
msgid ""
"<QT>Section which includes algorithms for computing time "
"ephemeris<UL><LI><B>Julian Day:</B> Julian Day/Calendar conversion</"
"LI><LI><B>Sidereal Time:</B> Sidereal/Universal time conversion</"
"LI><LI><B>Almanac:</B> Rise/Set/Transit timing and position data for the Sun "
"and Moon</LI><LI><B>Equinoxes & Solstices:</B> Equinoxes, Solstices and "
"duration of the seasons</LI></UL></QT>"
msgstr ""
"<QT>Odjeljak koji uključuje algoritme za računanje vremena "
"ephemeris<UL><LI><B>Julijanski Dan:</B> Julijanski Dan /Konverzija "
"kalendara</LI><LI><B>Zvjezdano vrijeme:</B> Zvijezdano/Univerzalno vrijeme "
"pretvorbe</LI><LI><B>Almanac:</B> Rast/Postavi/Prijelaz</"
"LI><LI><B>Ravnodnevnica & Solsticij:</B> Ravnodnevnice, Solsticiji i "
"trajanja godišnjih doba</LI></UL></QT>"

#: tools/astrocalc.cpp:77
#, kde-format
msgid ""
"<QT>Section with algorithms for the conversion of different astronomical "
"systems of coordinates<UL><LI><B>Galactic:</B> Galactic/Equatorial "
"coordinates conversion</LI><LI><B>Apparent:</B> Computation of current "
"equatorial coordinates from a given epoch</LI><LI><B>Ecliptic:</B> Ecliptic/"
"Equatorial coordinates conversion</LI><LI><B>Horizontal:</B> Computation of "
"azimuth and elevation for a given source, time, and location on the Earth</"
"LI><LI><B>Angular Distance:</B> Computation of angular distance between two "
"objects whose positions are given in equatorial coordinates</"
"LI><LI><B>Geodetic Coords:</B> Geodetic/XYZ coordinate conversion</"
"LI><LI><B>LSR Velocity:</B> Computation of the heliocentric, geocentric and "
"topocentric radial velocity of a source from its LSR velocity</LI></UL></QT>"
msgstr ""
"<QT>Odjeljak s algoritmima za konverziju različitih astronomskih sistema "
"koordinata<UL><LI><B>Galaktički:</B> Konverzija Galaktičkih /ekvatorijalnih "
"koordinata</LI><LI><B>Odgovarajuće:</B> Izračun trenutnih ekvatorijalnih "
"koordinata iz date epohe</LI><LI><B>Ekliptičke:</B> Konverzijaekliptičkih/"
"ekvatorijalnih koordinata</LI><LI><B>Horizontalne:</B> Račun azimuta  i "
"nadmorske visine za određeni izvor, vrijeme i mjesto na Zemlji </"
"LI><LI><B>Ugaona udaljenost:</B> Račun ugaone udaljenosti između dva  "
"objekta čije su pozicije u ekvatorijalnim koordinatama</LI><LI><B>Geodetske "
"koordinate:</B> Konverzija geodetskih/XYZ koordinata </LI><LI><B>LSR brzina:"
"</B> Izračun heliocentrične, geocentrične i topocentrične radijalne brzine "
"izvora iz njegove LSR brzine</LI></UL></QT>"

#: tools/astrocalc.cpp:100
#, kde-format
msgid ""
"<QT>Section with algorithms regarding information on solar system bodies "
"coordinates and times<UL><LI><B>Planets Coords:</B> Coordinates for the "
"planets, moon and sun at a given time and from a given position on Earth </"
"LI></UL></QT>"
msgstr ""
"<QT>Odjeljak sa algoritmima povodom informacija o koordinatama i vremenima "
"tijela solarnog sistema<UL><LI><B>Planete Coords:</B> Koordinate za planete, "
"mjesec i sunce u određenom vremenskom trenutku sa određene pozicije na "
"Zemlji </LI></UL></QT>"

