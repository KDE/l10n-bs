msgstr "Ako je uključeno, biće nacrtan nebeski ekvator na karti neba."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ShowEquator)
#: options/opsguides.ui:351
#, kde-format
msgid "Celestial e&quator"
msgstr "&Nebeski ekvator"

