#: blendingdlg/enfusesettings.cpp:185
#, fuzzy
#| msgid ""
#| "Use Color Appearance Modelling (CIECAM02) to render detailed colors. Your "
#| "input files should have embedded ICC profiles. If no ICC profile is "
#| "present, sRGB color space will be used instead. The difference between "
#| "using this option and default color blending algorithm is very slight, "
#| "and will be most noticeable when you need to blend areas of different "
#| "primary colors together."
msgctxt "@info:whatsthis"
msgid ""
"Use Color Appearance Modelling (CIECAM02) to render detailed colors. Your "
"input files should have embedded ICC profiles. If no ICC profile is present, "
"sRGB color space will be assumed. The difference between using this option "
"and default color blending algorithm is very slight, and will be most "
"noticeable when you need to blend areas of different primary colors together."
msgstr ""
"Koristite modeliranje izgleda boja (CIECAM02) da obradite detaljne boje. "
"Vaša ulazna datoteka treba imati ugrađene ICC profilie. Ako nema ICC "
"profila, sRGB prostor boja će se koristiti umjesto toga. Razlika između "
"korištenja ove opcije i uobičajenog miješanja boja je vrlo mala, te će biti "
"najviše primjetna kada je potrebno uklapanje područja različitih primarnih "
"boja zajedno."

