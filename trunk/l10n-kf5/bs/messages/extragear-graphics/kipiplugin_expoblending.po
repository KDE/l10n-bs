#: importwizard/lastpage.cpp:68
#, kde-format
msgid ""
"<qt><p><h1><b>Bracketed Images Pre-Processing is Done</b></h1></"
"p><p>Congratulations. Your images are ready to be fused. </p><p>To perform "
"this operation, <b>%1</b> program from <a href='%2'>Enblend</a> project will "
"be used.</p><p>Press \"Finish\" button to fuse your items and make a pseudo "
"HDR image.</p></qt>"
msgstr ""
"<qt><p><h1><b>Pred-Obrada uokvirenih slika je završena</b></h1></"
"p><p>Čestitam. Vaše slike su spremne da da budu spojene.</p><p>Da obavite "
"ovu operaciju, <b>%1</b> program iz <a href='%2'>Enblend</a> projekta će se "
"koristiti.</p><p>Pritisnite \"Završi\" dugme da spojite objekte i napravite "
"pseudo HDR sliku.</p></qt>"

#: importwizard/preprocessingpage.cpp:98
#, fuzzy
#| msgid "<b>Pre-Processing Bracketed Images</b>"
msgctxt "@title:window"
msgid "<b>Pre-Processing Bracketed Images</b>"
msgstr "<b>Pre-procesiranje uzastopne slike</b>"

#: importwizard/preprocessingpage.cpp:110
#, fuzzy
#| msgid "Align bracketed images"
msgctxt "@option:check"
msgid "Align bracketed images"
msgstr "Poravnaj uzastopne slike"

#: importwizard/preprocessingpage.cpp:157
#, kde-format
msgid ""
"<qt><p>Now, we will pre-process bracketed images before fusing them.</"
"p><p>To perform auto-alignment, the <b>%1</b> program from the <a href='%2'>"
"%3</a> project will be used. Alignment must be performed if you have not "
"used a tripod to take bracketed images. Alignment operations can take a "
"while.</p><p>Pre-processing operations include Raw demosaicing. Raw images "
"will be converted to 16-bit sRGB images with auto-gamma.</p><p>Press \"Next"
"\" to start pre-processing.</p></qt>"
msgstr ""
"<qt><p>Sada ćemo predprocesirati uokvirene slike prije njihovog spajanja.</"
"p><p>Da odrdimo automatsko poravnavanje<b>%1</b> program iz <a href='%2'>%3</"
"a> projekta će se koristiti. Poravnanje se mora izvršiti ako niste koristili "
"stativ da uokviritea slike. Operacija poravnanja može potrajati.</"
"p><p>OPeracije predprocesiranja uključuju Raw demozaik. Raw se mogu "
"konvertovati u 16-bit sRGB slike s auto-gamma.</p><p>Pritisnite \"Dalje\" za "
"početak pred-obrade.</p></qt>"

#: importwizard/preprocessingpage.cpp:176
msgid ""
"<qt><p>Pre-processing is under progress, please wait.</p><p>This can take a "
"while...</p></qt>"
msgstr ""
"<qt><p>Pred-obrada je u toku, molim sačekajte.</p><p>Ovo može potrajati...</"
"p></qt>"

#: importwizard/preprocessingpage.cpp:220
#, fuzzy
