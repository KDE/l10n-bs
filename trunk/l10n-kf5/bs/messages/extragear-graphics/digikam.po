#: core/libs/dimg/filters/lc/localcontrastfilter.cpp:88
#, kde-format
msgid "Local Contrast Filter"
msgstr "Lokalni Kontrast Filter"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:169
#, kde-format
msgid "Function:"
msgstr "Funkcija:"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:171
#, kde-format
msgid "Power"
msgstr "Moć"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:174
#, kde-format
msgid ""
"<b>Function</b>: This function combines the original RGB channels with the "
"desaturated blurred image. This function is used in each of the tonemapping "
"stages. It can be linear or power. Basically, this function increases the "
"values where both the original and blurred image's value are low and do the "
"opposite on high values."
msgstr ""
"<b>Funkcija</b>: Ova funkcija kombinira originalni RGB kanal sa nezasićenom, "
"zamagljenom slikom. Koristi se u svakoj fazi preslikavanja nijansi. Može "
"biti linearna ili startna. U osnovi, ova funkcija povećava one vrijednosti "
"koje su niske i za originalnu i za zamagljenu sliku i radi suprotno sa "
"visokim vrijednostima."

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:182
#, kde-format
msgid "Stretch contrast"
msgstr "Rastegni kontrast"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:183
#, kde-format
msgid ""
"<b>Stretch contrast</b>: This stretches the contrast of the original image. "
"It is applied before the tonemapping process."
msgstr ""
"<b>Rastegni kontrast</b>:Ovo rasteže kontrast originalne slike.Primjenjuje "
"se prije procesa mapiranja nijansi."

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:189
#, kde-format
msgid "Highlights saturation:"
msgstr "Označiti zasićenje:"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:194
#, kde-format
msgid ""
"<b>Highlights saturation</b>: Usually the (perceived) saturation is "
"increased. The user can choose to lower the saturation on original highlight "
"and shadows from the image with these parameters."
msgstr ""
"<b>Označiti zasićenje</b>: Obično (percipirano) zasićenje je povećano. "
"Korisnik može odabrati niže zasićenje na izvornom označivaču i sjene od "
"slike s tim parametrima."

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:200
#, kde-format
msgid "Shadow saturation:"
msgstr "Sjena zasićenja:"

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:205
#, kde-format
msgid ""
"<b>Shadow saturation</b>: Usually the (perceived) saturation is increased. "
"The user can choose to lower the saturation on original highlight and "
"shadows from the image with these parameters."
msgstr ""
"<b>Sjena zasićenja</b>:  Obično (percipirano) zasićenje je povećano. "
"Korisnik može odabrati niže zasićenje na izvornom označivaču i sjene od "
"slike s tim parametrima."

