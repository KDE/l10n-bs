#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:242
#, kde-format
msgid "No Lens Filter"
msgstr "Bez filtera sočiva"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:243
#, kde-format
msgid ""
"<b>No Lens Filter</b>:<p>Do not apply a lens filter when rendering the image."
"</p>"
msgstr ""
"<b>Bez filtera sočiva</b>:<p>Nemoj primjeniti filter sočiva kad učitavaš "
"sliku.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:246
#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:332
#, kde-format
msgid "Green Filter"
msgstr "Zeleni filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:247
#, kde-format
msgid ""
"<b>Black & White with Green Filter</b>:<p>Simulate black and white film "
"exposure using a green filter. This is useful for all scenic shoots, "
"especially portraits photographed against the sky.</p>"
msgstr ""
"<b>Crno i bijelo sa zelenim filterom</b>:<p>Simuliraj crno-bijelu "
"ekspoziciju korištenjem zelenog filtera. Ovo je korisno za sve slikovite "
"snimke, naročito portrete napravljene sa fotoaparatom okrenutim prema nebu.</"
"p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:252
#, kde-format
msgid "Orange Filter"
msgstr "Narandžasti filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:253
#, kde-format
msgid ""
"<b>Black & White with Orange Filter</b>:<p>Simulate black and white film "
"exposure using an orange filter. This will enhance landscapes, marine scenes "
"and aerial photography.</p>"
msgstr ""
"<b>Crno i bijelo sa narandžastim filterom</b>:<p>Simuliraj crno-bijelu "
"ekspoziciju korištenjem narandžastog filtera. Ovo će produbiti pejzaže, "
"morske prizore i zračne fotografije.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:258
#, kde-format
msgid "Red Filter"
msgstr "Crveni filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:259
#, kde-format
msgid ""
"<b>Black & White with Red Filter</b>:<p>Simulate black and white film "
"exposure using a red filter. This creates dramatic sky effects, and "
"simulates moonlight scenes in the daytime.</p>"
msgstr ""
"<b>Crno & Bijeli sa Crvenim Filterom</b>:<p>Simulirajte crno-bijelo "
"izlaganje filma koristeći crveni filter.Ovo kreira dramatične efekate neba, "
"i simulira scene mjesečine za vrijeme dana.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:264
#, kde-format
msgid "Yellow Filter"
msgstr "Žuti filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:265
#, kde-format
msgid ""
"<b>Black & White with Yellow Filter</b>:<p>Simulate black and white film "
"exposure using a yellow filter. This has the most natural tonal correction, "
"and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<b>Crno & Bijeli sa Žutim Filterom</b>:<p>Simulirajte crno-bijelo izlaganje "
"filma koristeći žuti filter. Ovo ima najprirodniju korekciju tonova, i "
"poboljšava kontrast.Idealan za pejzaže.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:270
#, kde-format
msgid "Yellow-Green Filter"
msgstr "Žuto-Zeleni Filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:271
#, kde-format
msgid ""
"<b>Black & White with Yellow-Green Filter</b>:<p>Simulate black and white "
"film exposure using a yellow-green filter. A yellow-green filter is highly "
"effective for outdoor portraits because red is rendered dark while green "
"appears lighter. Great for correcting skin tones, bringing out facial "
"expressions in close-ups and emphasizing the feeling of liveliness. This "
"filter is highly effective for indoor portraits under tungsten lighting.</p>"
msgstr ""
"<b>Crno i bijelo sa žuto-zelenim filterom</b>:<p>Simuliraj crno-bijelu "
"ekspoziciju korištenjem žuto-zelenog filtera. Žuto-zeleni filter je jako "
"učinkovit za portrete napravljene na otvorenom, zato što se crvena boja "
"potamnjuje, a zelena posvjetljava. Odličan je za korekcije tena, naglašava "
"izraze lica na snimcima izbliza, te daje osjećaj živosti. Ovaj filter je "
"jako učinkovit i za portrete napravljene u zatvorenom prostoru pod "
"volframovim svjetlom.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:278
#, kde-format
msgid "Blue Filter"
msgstr "Plavi Filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:279
#, kde-format
msgid ""
"<b>Black & White with Blue Filter</b>:<p>Simulate black and white film "
"exposure using a blue filter. This accentuates haze and fog. Used for dye "
"transfer and contrast effects.</p>"
msgstr ""
"<b>Crno & Bijeli sa Plavim Filterom</b>:<p>Simulirajte crno-bijelo izlaganje "
"filma koristeći plavi filter. Ovo naglašava izmaglicu i maglu. Korišteno za "
"prelaz bolje i efekte kontrasta.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:284
#, kde-format
msgid "Strength:"
msgstr "Jačina:"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:290
#, kde-format
msgid "Here, set the strength adjustment of the lens filter."
msgstr "Ovdje,postavite prilagodbu jačine za filter sočiva."

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:301
#, kde-format
msgid "No Tone Filter"
msgstr "Bez filtera nijanse"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:302
#, kde-format
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr ""
"<b>Bez filtera nijanse</b>:<p>Ne primenjuj filter nijanse na sliku.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:305
#, kde-format
msgid "Sepia Filter"
msgstr "Sepia Filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:306
#, kde-format
msgid ""
"<b>Black & White with Sepia Tone</b>:<p>Gives a warm highlight and mid-tone "
"while adding a bit of coolness to the shadows - very similar to the process "
"of bleaching a print and re-developing in a sepia toner.</p>"
msgstr ""
"<b>Crno i bijelo sa sepija nijansom</b>:<p>Daje toplije tonove i srednje "
"nijanse osvijetljenim dijelovima, dodajući hladnoću osjenčenim dijelovima - "
"veoma slično procesu izbjeljivanja snimka i ponovnom razvoju sepija tonerom."
"</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:311
#, kde-format
msgid "Brown Filter"
msgstr "Smeđi Filter"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:312
#, kde-format
msgid ""
"<b>Black & White with Brown Tone</b>:<p>This filter is more neutral than the "
"Sepia Tone filter.</p>"
msgstr ""
"<b>Crno & Bijelo sa smeđim nijansama</b>:<p>Ovaj filter je više neutralan "
"od  Sepia  filtera boja.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:316
#, kde-format
msgid "Cold Filter"
msgstr "Filter hladnoće"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:317
#, kde-format
msgid ""
"<b>Black & White with Cold Tone</b>:<p>Start subtly and replicate printing "
"on a cold tone black and white paper such as a bromide enlarging paper.</p>"
msgstr ""
"<b>Crno i bijelo sa hladnom nijansom</b>:<p>Suptilno počinje i replicira "
"ispis na hladnoj nijansi crno-bijelog papira, kao što je papir za "
"uvećavanje, napravljen od bromida.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:322
#, kde-format
msgid "Selenium Filter"
msgstr "Filter selenijuma"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:323
#, kde-format
msgid ""
"<b>Black & White with Selenium Tone</b>:<p>This effect replicates "
"traditional selenium chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Crno i bijelo sa nijansom selenijuma</b>:<p>Ovaj efekt replicira hemijsku "
"reakciju toniranja selenijumom u mračnoj komori.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:327
#, kde-format
msgid "Platinum Filter"
msgstr "Filter platine"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:328
#, kde-format
msgid ""
"<b>Black & White with Platinum Tone</b>:<p>This effect replicates "
"traditional platinum chemical toning done in the darkroom.</p>"
msgstr ""
"<b>Crno i bijelo sa nijansom platine</b>:<p>Ovaj efekt replicira hemijsku "
"reakciju toniranja platinom u mračnoj komori.</p>"

#: core/libs/dimg/filters/bw/bwsepiasettings.cpp:333
#, kde-format
msgid ""
"<b>Black & White with greenish tint</b>:<p>This effect is also known as "
"Verdante.</p>"
msgstr ""
"<b>Black & White with greenish tint</b>:<p>Ovaj efekat je još poznat i kao "
"Verdante.</p>"

