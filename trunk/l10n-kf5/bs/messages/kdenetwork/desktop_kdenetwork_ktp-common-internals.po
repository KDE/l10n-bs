msgctxt "Comment"
msgid "An incoming message in the active group chat window has been received"
msgstr "Dolazeća poruka u prozoru aktivnog grupnog ćaskanja je primljena"

#: data/ktelepathy.notifyrc:909
msgctxt "Name"
msgid "Outgoing Message"
msgstr "Odlazna poruka"

