msgctxt "@title:window"
msgid "Authenticate with VKontakte"
msgstr "Prijava s VKontakte"

#: authenticationdialog.cpp:74
msgid "Loading Page:"
msgstr "Učitavam stranicu:"

#: authenticationdialog.cpp:136
#, kde-format
msgid ""
"<b>VKontakte Error Description:</b> %1<br><b>VKontakte Error:</b> %2<br>"
