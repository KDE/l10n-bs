msgctxt "@title:window"
msgid "Authentication Problem"
msgstr "Problem s prijavom"

#: authenticationdialog.cpp:177
msgid ""
"There was a network error when trying to authenticate with VKontakte web "
"service."
msgstr "Desila se mrežna greška pri prijavi na VKontakte web uslugu."

