#: kpgpui.cpp:148
msgid "GnuPG - Gnu Privacy Guard"
msgstr "GnuPG — Gnu Privacy Guard"

#: kpgpui.cpp:149
msgid "PGP Version 2.x"
msgstr "PGP verzije 2.x"

#: kpgpui.cpp:150
msgid "PGP Version 5.x"
msgstr "PGP verzije 5.x"

#: kpgpui.cpp:151
msgid "PGP Version 6.x"
