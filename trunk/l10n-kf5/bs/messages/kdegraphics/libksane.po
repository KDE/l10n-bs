#: ksanewidget.cpp:636
#, kde-format
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr ""
"Slika je sadržavala 16 bita po boji, ali se dubina boje smanjila na 8 bita "
"po boji."

#: ksanewidget_p.cpp:369
#, kde-format
