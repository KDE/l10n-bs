#, kde-format
msgid "Open scan dialog"
msgstr "Otvori dijaloški okvir za skeniranje"

#: i18n-hplip.cpp:3
#, kde-format
msgid "None"
msgstr "Ništa"

#: i18n-hplip.cpp:4
