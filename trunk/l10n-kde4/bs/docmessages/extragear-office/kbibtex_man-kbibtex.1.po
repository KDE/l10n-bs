#. Tag: title
#: man-kbibtex.1.docbook:8
#, no-c-format
msgid "KDE User's Manual"
msgstr "KDE Korisnički priručnik"

#. Tag: author
#: man-kbibtex.1.docbook:9
#, no-c-format
msgid ""
"<firstname>Thomas</firstname><surname>Fischer</surname> <contrib>KBibTeX man "
"page.</contrib> <email>fischer@unix-ag.uni-kl.de</email>"
msgstr ""
"<firstname>Thomas</firstname><surname>Fischer</surname> <contrib>KBibTeX man "
"page.</contrib> <email>fischer@unix-ag.uni-kl.de</email>"

#. Tag: date
#: man-kbibtex.1.docbook:12
#, no-c-format
msgid "2013-12-30"
msgstr "2013-12-30"

#. Tag: productname
#: man-kbibtex.1.docbook:13
#, no-c-format
msgid "K Desktop Environment"
msgstr "K Desktop okruženje"

#. Tag: manvolnum
#: man-kbibtex.1.docbook:18
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refpurpose
#: man-kbibtex.1.docbook:23
#, no-c-format
msgid ""
"a BibTeX editor for KDE written by Thomas Fischer and released under the GPL "
"version 2 or later."
msgstr ""
"a BibTeX uređivač za KDE je napisao Thomas Fischer i izdao pod GPL verzijom "
"2 ili kasnijom."

#. Tag: cmdsynopsis
#: man-kbibtex.1.docbook:27
#, no-c-format
msgid ""
"<command>kbibtex</command> <arg choice=\"opt\"><replaceable>Qt-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>KDE-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>URL</replaceable></arg>"
msgstr ""
"<command>kbibtex</command> <arg choice=\"opt\"><replaceable>Qt-opcije</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>KDE-opcije</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>URL</replaceable></arg>"

#. Tag: title
#: man-kbibtex.1.docbook:36
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kbibtex.1.docbook:37
#, no-c-format
msgid ""
"KBibTeX is a BibTeX editor for KDE written by Thomas Fischer and released "
"under the GPL version 2 or later."
msgstr ""
"KBibTeX je BibTeX uređivač koji je napisao Thomas Fischer, izdan u GPL "
"verziji 2 ili kasnijoj."

#. Tag: para
#: man-kbibtex.1.docbook:40
#, no-c-format
msgid ""
"KBibTeX can be started as a standalone program or embedded as a KPart into "
"virtually every &kde; program (&eg; Konqueror)."
msgstr ""
"KBibTeX se može pokrenuti kao samostalan program ili ugrađen pomoću KParta u "
"svaki &kde; program (&eg; Konqueror)."

#. Tag: title
#: man-kbibtex.1.docbook:45
#, no-c-format
msgid "Generic Options"
msgstr "Opće opcije"

#. Tag: option
#: man-kbibtex.1.docbook:48
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kbibtex.1.docbook:50
#, no-c-format
msgid "Show help about options."
msgstr "Prikaži pomoć o opcijama."

#. Tag: option
#: man-kbibtex.1.docbook:54
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kbibtex.1.docbook:56
#, no-c-format
msgid "Show Qt specific options."
msgstr "Prikaži Qt posebne opcije."

#. Tag: option
#: man-kbibtex.1.docbook:60
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kbibtex.1.docbook:62
#, no-c-format
msgid "Show KDE specific options."
msgstr "Prikaži KDE posebne opcije."

#. Tag: option
#: man-kbibtex.1.docbook:66
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kbibtex.1.docbook:68
#, no-c-format
msgid "Show all options."
msgstr "Prikaži sve opcije."

#. Tag: option
#: man-kbibtex.1.docbook:72
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kbibtex.1.docbook:74
#, no-c-format
msgid "Show author information."
msgstr "Prikaži informacije o autoru."

#. Tag: option
#: man-kbibtex.1.docbook:78
#, no-c-format
msgid "-v, --version"
msgstr "-v, --version"

#. Tag: para
#: man-kbibtex.1.docbook:80
#, no-c-format
msgid "Show version information."
msgstr "Prikaži informacije o verziji."

#. Tag: option
#: man-kbibtex.1.docbook:84
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kbibtex.1.docbook:86
#, no-c-format
msgid "Show license information."
msgstr "Prikaži informacija o licenci."

#. Tag: option
#: man-kbibtex.1.docbook:90
#, no-c-format
msgid "<option>--</option>"
msgstr "<option>--</option>"

#. Tag: para
#: man-kbibtex.1.docbook:92
#, no-c-format
msgid "End of options."
msgstr "Kraj opcija."

#. Tag: title
#: man-kbibtex.1.docbook:98
#, no-c-format
msgid "Arguments"
msgstr "Argumenti"

#. Tag: option
#: man-kbibtex.1.docbook:101
#, no-c-format
msgid "<option>URL</option>"
msgstr "<option>URL</option>"

#. Tag: para
#: man-kbibtex.1.docbook:103
#, no-c-format
msgid ""
"An address or several addresses of the bibliography documents to be opened."
msgstr "Jedna ili više adresa bibliografskih dokumenata za otvaranje."

#. Tag: title
#: man-kbibtex.1.docbook:110
#, no-c-format
msgid "See Also"
msgstr "Također pogledajte"

#. Tag: para
#: man-kbibtex.1.docbook:111
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/kbibtex"
"\">help:/kbibtex</ulink> (either enter this <acronym>URL</acronym> into "
"&konqueror;, or run <userinput><command>khelpcenter</command> "
"<parameter>help:/kbibtex</parameter></userinput>)."
msgstr ""
"Dokumentacija sa dodatnim detaljima je dostupna na  <ulink url=\"help:/"
"kbibtex\">help:/kbibtex</ulink> (ili ukucajte ovo <acronym>URL</acronym> u  "
"&konqueror;, ili pokrenite <userinput><command>khelpcenter</command> "
"<parameter>help:/kbibtex</parameter></userinput>)."

#. Tag: para
#: man-kbibtex.1.docbook:117
#, fuzzy, no-c-format
#| msgid ""
#| "There is also further information available at the <ulink url=\"http://"
#| "home.gna.org/kbibtex/\">KBibTeX official website</ulink>."
msgid ""
"There is also further information available at the <ulink url=\"https://"
"userbase.kde.org/KBibTeX\">KBibTeX official website</ulink>."
msgstr ""
"Dodatne informacije se također nalaze na <ulink url=\"http://home.gna.org/"
"kbibtex/\">KBibTeX oficijelnoj web stranici</ulink>."

