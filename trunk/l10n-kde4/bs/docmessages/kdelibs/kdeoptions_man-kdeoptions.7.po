#. Tag: refpurpose
#: man-kdeoptions.7.docbook:21
#, no-c-format
msgid ""
"Common commandline options for all applications based on the KDE libraries"
msgstr ""
"Uobičajene opcije komandne linije za sve aplikacije bazirane na KDE "
"biblioteci."

#. Tag: cmdsynopsis
#: man-kdeoptions.7.docbook:25
#, no-c-format
msgid ""
"<command><replaceable>KDE application</replaceable></command> <arg choice="
"\"opt\">KDE Generic Options</arg>"
msgstr ""
"<command><replaceable>KDE application</replaceable></command> <arg choice="
"\"opt\">KDE Generic Options</arg>"

#. Tag: title
#: man-kdeoptions.7.docbook:33
#, no-c-format
msgid "Options"
msgstr "Opcije"

#. Tag: para
#: man-kdeoptions.7.docbook:35
#, no-c-format
msgid "The following options apply to all &kde; applications:"
msgstr "Sljedeće opcije primjenjuju na sve &kde; aplikacije:"

#. Tag: term
#: man-kdeoptions.7.docbook:38
#, no-c-format
msgid "<option>--caption</option> <parameter>caption</parameter>"
msgstr "<option>--caption</option> <parameter>caption</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:39
#, no-c-format
msgid "Use <parameter>caption</parameter> as name in the titlebar."
msgstr "Koristite <parameter>caption</parameter>  kao ime u naslovnoj liniji."

#. Tag: term
#: man-kdeoptions.7.docbook:43
#, no-c-format
msgid "<option>--icon</option> <parameter>icon</parameter>"
msgstr "<option>--icon</option> <parameter>icon</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:44
#, no-c-format
msgid "Use <parameter>icon</parameter> as the application icon."
msgstr "Koristite <parameter>icon</parameter>  kao ikonu aplikacije."

#. Tag: term
#: man-kdeoptions.7.docbook:47
#, no-c-format
msgid "<option>--config</option> <parameter>filename</parameter>"
msgstr "<option>--config</option> <parameter>filename</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:48
#, no-c-format
msgid "Use the alternative configuration <parameter>filename</parameter>"
msgstr "Koristet alternativnu konfiguraciju <parameter>filename</parameter>"

#. Tag: option
#: man-kdeoptions.7.docbook:51
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kdeoptions.7.docbook:52
#, no-c-format
msgid "Disable the crash handler, to get core dumps."
msgstr "Onemogućite obradu rušenja sistema da dobijete  izdvojak jezgra."

#. Tag: option
#: man-kdeoptions.7.docbook:55
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kdeoptions.7.docbook:56
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Čeka pogodni WM_NET kompatibilni windowmanager."

#. Tag: term
#: man-kdeoptions.7.docbook:59
#, no-c-format
msgid "<option>--style</option> <parameter>style</parameter>"
msgstr "<option>--style</option> <parameter>style</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:60
#, no-c-format
msgid "Sets the application &GUI; style."
msgstr "Postavlja &GUI; stil aplikacije."

#. Tag: term
#: man-kdeoptions.7.docbook:63
#, no-c-format
msgid "<option>--geometry</option> <parameter>geometry</parameter>"
msgstr "<option>--geometry</option> <parameter>geometry</parameter>"

#. Tag: para
#: man-kdeoptions.7.docbook:64
#, no-c-format
msgid "Sets the client geometry of the main widget."
msgstr "Postavlja geometriju klijenta glavne alatke."

#. Tag: title
#: man-kdeoptions.7.docbook:71
#, no-c-format
msgid "See Also"
msgstr "Vidi također"

