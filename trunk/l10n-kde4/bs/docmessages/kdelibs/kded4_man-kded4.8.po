#. Tag: option
#: man-kded4.8.docbook:144
#, no-c-format
msgid "Notification area watcher"
msgstr "Posmatrac podrucja notifikacije"

#. Tag: para
#: man-kded4.8.docbook:145
#, no-c-format
msgid ""
"Keeps track of applications that want to use the D-Bus based notification "
