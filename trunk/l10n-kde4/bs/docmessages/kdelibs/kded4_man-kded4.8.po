msgstr ""
"Održava trag aplikacija koje žele koristiti D-Bus podrucje notifikacija."

#. Tag: option
#: man-kded4.8.docbook:149
#, no-c-format
msgid "KMixD"
msgstr "KMixD"

#. Tag: para
