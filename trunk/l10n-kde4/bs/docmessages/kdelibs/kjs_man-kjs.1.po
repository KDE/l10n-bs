msgstr "&kde; ECMAScript kompatibilni interpreteri"

#. Tag: title
#: man-kjs.1.docbook:35
#, no-c-format
msgid "Synopsis"
msgstr "Sinopsis"

#. Tag: cmdsynopsis
#: man-kjs.1.docbook:37
#, no-c-format
msgid ""
"<command>kjs</command> <group> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg "
"choice=\"opt\">-e<replaceable> statement</replaceable></arg> </group> "
"<group> <arg choice=\"plain\"><replaceable>script</replaceable></arg> </"
"group>"
msgstr ""
"<command>kjs</command> <group> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">-help</arg> <arg choice=\"opt\">-h</arg> </group> <group> <arg "
"choice=\"opt\">-e<replaceable> statement</replaceable></arg> </group> "
"<group> <arg choice=\"plain\"><replaceable>script</replaceable></arg> </"
"group>"

#. Tag: title
#: man-kjs.1.docbook:60
#, no-c-format
msgid "Description"
msgstr "Opis"

#. Tag: para
#: man-kjs.1.docbook:62
#, no-c-format
msgid "<command>kjs</command> is KDE ECMAScript/JavaScript engine."
msgstr "<command>kjs</command> je KDE ECMAScript/JavaScript alat."

#. Tag: title
#: man-kjs.1.docbook:141
#, no-c-format
msgid "Application Options"
msgstr "Opcije programa"

#. Tag: term
#: man-kjs.1.docbook:145
#, no-c-format
msgid "<option>--help</option>,<option>-help</option>,<option>-h</option>"
msgstr "<option>--help</option>,<option>-help</option>,<option>-h</option>"

#. Tag: para
#: man-kjs.1.docbook:147
#, no-c-format
msgid "Show <command>kjscmd</command> usage."
msgstr "Pokaži <command>kjscmd</command> upotrebu."

#. Tag: term
#: man-kjs.1.docbook:154
#, no-c-format
msgid "<option>-e</option><parameter> statement</parameter>"
msgstr "<option>-e</option><parameter> statement</parameter>"

#. Tag: para
#: man-kjs.1.docbook:156
#, no-c-format
msgid "Executes the statement and exits. For example:"
msgstr "Izvršava naredbu i izlazi. Na primjer:"

#. Tag: screen
#: man-kjs.1.docbook:157
#, no-c-format
msgid "<command>kjs</command> -e \"print('hello world')\""
msgstr "<command>kjs</command> -e \"print('hello world')\""

#. Tag: parameter
#: man-kjs.1.docbook:162
#, no-c-format
msgid "script"
msgstr "skripta"

#. Tag: para
#: man-kjs.1.docbook:164
#, no-c-format
msgid "Executes the statements included in file <parameter>script</parameter>."
msgstr "Izvršava izmjenu ukljulečnu u datoteci <parameter>script</parameter>."

#. Tag: title
#: man-kjs.1.docbook:173
#, no-c-format
msgid "Usage"
msgstr "Upotreba"

#. Tag: para
#: man-kjs.1.docbook:174
#, no-c-format
msgid ""
"<command>kjs</command> <parameter>file</parameter>, as many other "
"interpreters, when called without parameters uses a line editor to enter "
"statements, showing the prompt <literallayout>JS></literallayout> To exit "
"the line editor type <command>quit()</command> or press <command>Ctrl+D</"
"command>."
msgstr ""
"<command>kjs</command> <parameter>file</parameter>, kao i druge prevodioce "
"kada su pozvani bez parametara koriste editore da unesu izvještaje, te "
"prikazuje gotove <literallayout>JS></literallayout> Da napustite editor "
"kucajte <command>quit()</command>ili <command>Ctrl+D</command>."

#. Tag: title
#: man-kjs.1.docbook:183
#, no-c-format
msgid "See Also"
msgstr "Vidite i"

#. Tag: para
#: man-kjs.1.docbook:184
#, no-c-format
msgid "<replaceable>kjs</replaceable>(1)"
msgstr "<replaceable>kjs</replaceable>(1)"

#. Tag: title
#: man-kjs.1.docbook:188
#, no-c-format
msgid "Bugs"
msgstr "Bagovi"

#. Tag: para
#: man-kjs.1.docbook:189
#, no-c-format
msgid ""
"There are probably tons of bugs. Use <ulink url=\"http://bugs.kde.org\">bugs."
"kde.org</ulink> to report them."
msgstr ""
"Moguće je da ima mnogo kvarova. Korisite<ulink url=\"http://bugs.kde.org"
"\">bugs.kde.org</ulink> da ih prijavite."
