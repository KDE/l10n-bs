#. Tag: refentrytitle
#: man-kdesvn.1.docbook:10
#, no-c-format
msgid "KDESVN"
msgstr "KDESVN"

#. Tag: manvolnum
#: man-kdesvn.1.docbook:11
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr "<manvolnum>1</manvolnum>"

#. Tag: refmiscinfo
#: man-kdesvn.1.docbook:12
#, no-c-format
msgid "Sep 2008"
msgstr "Septembar 2008"

#. Tag: refmiscinfo
#: man-kdesvn.1.docbook:13
#, no-c-format
msgid "K Desktop Environment"
msgstr "K Desktop okruženje"

#. Tag: refname
#: man-kdesvn.1.docbook:16
#, no-c-format
msgid "kdesvn"
msgstr "kdesvn"

#. Tag: refpurpose
#: man-kdesvn.1.docbook:17
#, no-c-format
msgid ""
"<refpurpose>A Subversion client for KDE (standalone application)</refpurpose>"
msgstr ""
"<refpurpose>Klijent sistema Subversion za KDE (samostalna aplikacija)</"
"refpurpose>"

#. Tag: cmdsynopsis
#: man-kdesvn.1.docbook:21
#, no-c-format
msgid ""
"<command>kdesvn</command> <arg choice=\"opt\"><replaceable>Qt-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>KDE-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>options</replaceable></"
"arg> <arg choice=\"plain\"><replaceable>exec</replaceable></arg> <arg choice="
"\"plain\"><replaceable>&lt;command&gt;</replaceable></arg> <arg choice=\"opt"
"\"><replaceable>URL</replaceable></arg>"
msgstr ""
"<command>kdesvn</command> <arg choice=\"opt\"><replaceable>Qt-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>KDE-options</"
"replaceable></arg> <arg choice=\"opt\"><replaceable>options</replaceable></"
"arg> <arg choice=\"plain\"><replaceable>exec</replaceable></arg> <arg choice="
"\"plain\"><replaceable>&lt;command&gt;</replaceable></arg> <arg choice=\"opt"
"\"><replaceable>URL</replaceable></arg>"

#. Tag: title
#: man-kdesvn.1.docbook:32
#, no-c-format
msgid "DESCRIPTION"
msgstr "OPIS"

#. Tag: para
#: man-kdesvn.1.docbook:33
#, no-c-format
msgid "<para>A Subversion client for KDE (standalone application)</para>"
msgstr "<para>Podverzija klijenta za KDE (samostalna aplikacija)</para>"

#. Tag: title
#: man-kdesvn.1.docbook:36
#, no-c-format
msgid "OPTIONS"
msgstr "OPCIJE"

#. Tag: title
#: man-kdesvn.1.docbook:38
#, no-c-format
msgid "Arguments:"
msgstr "Argumenti:"

#. Tag: term
#: man-kdesvn.1.docbook:41
#, no-c-format
msgid "<emphasis>exec</emphasis> &lt;command&gt;"
msgstr "<emphasis>exec</emphasis> &lt;command&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:42
#, no-c-format
msgid ""
"Execute subversion command (\"exec help\" for more information, opens KDE "
"Help Center)"
msgstr ""
"Izvrši naredbu podverzije (\"exec help\" za više informacija, otvara KDE "
"Help Center)"

#. Tag: emphasis
#: man-kdesvn.1.docbook:46
#, no-c-format
msgid "<emphasis>URL</emphasis>"
msgstr "<emphasis>URL</emphasis>"

#. Tag: para
#: man-kdesvn.1.docbook:48
#, no-c-format
msgid "Path to local working copy or a repository."
msgstr "Putanja do lokalne radne verzije ili spremišta."

#. Tag: title
#: man-kdesvn.1.docbook:54
#, no-c-format
msgid "Options:"
msgstr "Opcije:"

#. Tag: option
#: man-kdesvn.1.docbook:57
#, no-c-format
msgid "-r startrev[:endrev]"
msgstr "-r startrev[:endrev]"

#. Tag: para
#: man-kdesvn.1.docbook:59
#, no-c-format
msgid "Execute single subversion command on specific revision(-range)"
msgstr "Izvrši jednu naredbu podverzije za određeno prerađeno izdanje(-range)"

#. Tag: option
#: man-kdesvn.1.docbook:63
#, no-c-format
msgid "<option>-R</option>"
msgstr "<option>-R</option>"

#. Tag: para
#: man-kdesvn.1.docbook:65
#, no-c-format
msgid "Ask for revision when executing single command"
msgstr "Pitaj za reviziju kada izvršavaš jednu naredbu"

#. Tag: option
#: man-kdesvn.1.docbook:69
#, no-c-format
msgid "<option>-f</option>"
msgstr "<option>-f</option>"

#. Tag: para
#: man-kdesvn.1.docbook:71
#, no-c-format
msgid "Force operation"
msgstr "Prisili operaciju"

#. Tag: option
#: man-kdesvn.1.docbook:75
#, no-c-format
msgid "-o &lt;file&gt;"
msgstr "-o &lt;file&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:77
#, no-c-format
msgid "Save output of subversion command (eg \"cat\") into file &lt;file&gt;"
msgstr "Snimi izlaz naredbe podverzije (eg \"cat\") u datoteku &lt;file&gt;"

#. Tag: option
#: man-kdesvn.1.docbook:81
#, no-c-format
msgid "-l &lt;number&gt;"
msgstr "-l &lt;number&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:83
#, no-c-format
msgid "Limit log output to &lt;number&gt;"
msgstr "Ograniči unos izlaza u &lt;number&gt;"

#. Tag: title
#: man-kdesvn.1.docbook:89
#, no-c-format
msgid "Generic options:"
msgstr "Generičke opcije:"

#. Tag: option
#: man-kdesvn.1.docbook:92
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: man-kdesvn.1.docbook:94
#, no-c-format
msgid "Show help about options"
msgstr "Prikaži pomoć o opcijama"

#. Tag: option
#: man-kdesvn.1.docbook:98
#, no-c-format
msgid "--help-qt"
msgstr "--help-qt"

#. Tag: para
#: man-kdesvn.1.docbook:100
#, no-c-format
msgid "Show Qt specific options"
msgstr "Prikaži Qt specifične opcije"

#. Tag: option
#: man-kdesvn.1.docbook:104
#, no-c-format
msgid "--help-kde"
msgstr "--help-kde"

#. Tag: para
#: man-kdesvn.1.docbook:106
#, no-c-format
msgid "Show KDE specific options"
msgstr "Prikaži KDE specifične opcije"

#. Tag: option
#: man-kdesvn.1.docbook:110
#, no-c-format
msgid "--help-all"
msgstr "--help-all"

#. Tag: para
#: man-kdesvn.1.docbook:112
#, no-c-format
msgid "Show all options"
msgstr "Prikaži sve opcije"

#. Tag: option
#: man-kdesvn.1.docbook:116
#, no-c-format
msgid "--author"
msgstr "--author"

#. Tag: para
#: man-kdesvn.1.docbook:118
#, no-c-format
msgid "Show author information"
msgstr "Prikaži podatke o autoru"

#. Tag: option
#: man-kdesvn.1.docbook:122
#, no-c-format
msgid "-v, --version"
msgstr "-v, --version"

#. Tag: para
#: man-kdesvn.1.docbook:124
#, no-c-format
msgid "Show version information"
msgstr "Prikaži podatke o verziji"

#. Tag: option
#: man-kdesvn.1.docbook:128
#, no-c-format
msgid "--license"
msgstr "--license"

#. Tag: para
#: man-kdesvn.1.docbook:130
#, no-c-format
msgid "Show license information"
msgstr "Prikaži podatke o licenci"

#. Tag: option
#: man-kdesvn.1.docbook:134
#, no-c-format
msgid "<option>--</option>"
msgstr "<option>--</option>"

#. Tag: para
#: man-kdesvn.1.docbook:136
#, no-c-format
msgid "End of options"
msgstr "Kraj opcija"

#. Tag: title
#: man-kdesvn.1.docbook:142
#, no-c-format
msgid "KDE options:"
msgstr "KDE opcije:"

#. Tag: option
#: man-kdesvn.1.docbook:145
#, no-c-format
msgid "--caption &lt;caption&gt;"
msgstr "--caption &lt;caption&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:147
#, no-c-format
msgid "Use 'caption' as name in the titlebar"
msgstr "Koristi 'caption' kao tekst naslovne trake"

#. Tag: option
#: man-kdesvn.1.docbook:151
#, no-c-format
msgid "--icon &lt;icon&gt;"
msgstr "--icon &lt;icon&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:153
#, no-c-format
msgid "Use 'icon' as the application icon"
msgstr "Koristi 'icon' za ikonu aplikacije"

#. Tag: option
#: man-kdesvn.1.docbook:157
#, no-c-format
msgid "--config &lt;filename&gt;"
msgstr "--config &lt;filename&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:159
#, no-c-format
msgid "Use alternative configuration file"
msgstr "Koristi alternativnu datoteku sa postavkama"

#. Tag: option
#: man-kdesvn.1.docbook:163
#, no-c-format
msgid "--nocrashhandler"
msgstr "--nocrashhandler"

#. Tag: para
#: man-kdesvn.1.docbook:165
#, no-c-format
msgid "Disable crash handler, to get core dumps"
msgstr "Isključi rukovalac rušenja, za dobijanje popisa jezgra"

#. Tag: option
#: man-kdesvn.1.docbook:169
#, no-c-format
msgid "--waitforwm"
msgstr "--waitforwm"

#. Tag: para
#: man-kdesvn.1.docbook:171
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Čeka na menadžer prozora saglasan WM_NET‑u"

#. Tag: option
#: man-kdesvn.1.docbook:175
#, no-c-format
msgid "--style &lt;style&gt;"
msgstr "--style &lt;style&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:177
#, no-c-format
msgid "sets the application GUI style"
msgstr "postavlja GUI stil aplikacije"

#. Tag: option
#: man-kdesvn.1.docbook:181
#, no-c-format
msgid "--geometry &lt;geometry&gt;"
msgstr "--geometry &lt;geometry&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:183
#, no-c-format
msgid ""
"sets the client geometry of the main widget - see man X for the argument "
"format"
msgstr ""
"podešava geometriju klijenta iz glavne forme - pogledajte man X za format "
"argumenata"

#. Tag: title
#: man-kdesvn.1.docbook:189
#, no-c-format
msgid "Qt options:"
msgstr "Qt opcije:"

#. Tag: option
#: man-kdesvn.1.docbook:192
#, no-c-format
msgid "--display &lt;displayname&gt;"
msgstr "--display &lt;displayname&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:194
#, no-c-format
msgid "Use the X-server display 'displayname'"
msgstr "Koristi X-server display 'displayname'"

#. Tag: option
#: man-kdesvn.1.docbook:198
#, no-c-format
msgid "--session &lt;sessionId&gt;"
msgstr "--session &lt;sessionId&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:200
#, no-c-format
msgid "Restore the application for the given 'sessionId'"
msgstr "Obnovi aplikaciju za dati 'sessionId'"

#. Tag: option
#: man-kdesvn.1.docbook:204
#, no-c-format
msgid "--cmap"
msgstr "--cmap"

#. Tag: para
#: man-kdesvn.1.docbook:206
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Uzrokuje da aplikacija instalirata privatnu mapu boja na 8-bitnom zaslonu"

#. Tag: option
#: man-kdesvn.1.docbook:211
#, no-c-format
msgid "--ncols &lt;count&gt;"
msgstr "--ncols &lt;count&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:213
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Ograničava broj boja dodijeljenih u boji kocke na 8-bitnom zaslonu, ako "
"aplikacija koristi QApplication::ManyColor specifikaciju boja"

#. Tag: option
#: man-kdesvn.1.docbook:220
#, no-c-format
msgid "--nograb"
msgstr "--nograb"

#. Tag: para
#: man-kdesvn.1.docbook:222
#, no-c-format
msgid "tells Qt to never grab the mouse or the keyboard"
msgstr "govori Qt‑u da nikada ne zahvata miš ili tastaturu"

#. Tag: option
#: man-kdesvn.1.docbook:226
#, no-c-format
msgid "--dograb"
msgstr "--dograb"

#. Tag: para
#: man-kdesvn.1.docbook:228
#, no-c-format
msgid ""
"running under a debugger can cause an implicit -nograb, use -dograb to "
"override"
msgstr ""
"pokretanje pod debuggerom može prouzrokovati implicitni -nograb, koristite -"
"nograb za override"

#. Tag: option
#: man-kdesvn.1.docbook:233
#, no-c-format
msgid "--sync"
msgstr "--sync"

#. Tag: para
#: man-kdesvn.1.docbook:235
#, no-c-format
msgid "switches to synchronous mode for debugging"
msgstr "prebacuje u sinhroni režim za debuggiranje"

#. Tag: option
#: man-kdesvn.1.docbook:239
#, no-c-format
msgid "--fn, --font &lt;fontname&gt;"
msgstr "--fn, --font &lt;fontname&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:241
#, no-c-format
msgid "defines the application font"
msgstr "definiše font aplikacije"

#. Tag: option
#: man-kdesvn.1.docbook:245
#, no-c-format
msgid "--bg, --background &lt;color&gt;"
msgstr "--bg, --background &lt;color&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:247
#, no-c-format
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)"
msgstr ""
"postavlja podrazumjevanu boju pozadine i paletu aplikacije (svijetle i tamne "
"sijenke su proračunate)"

#. Tag: option
#: man-kdesvn.1.docbook:253
#, no-c-format
msgid "--fg, --foreground &lt;color&gt;"
msgstr "--fg, --foreground &lt;color&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:255
#, no-c-format
msgid "sets the default foreground color"
msgstr "postavlja podrazumijevanu boju ispisa"

#. Tag: option
#: man-kdesvn.1.docbook:259
#, no-c-format
msgid "--btn, --button &lt;color&gt;"
msgstr "--btn, --button &lt;color&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:261
#, no-c-format
msgid "sets the default button color"
msgstr "postavlja podrazumijevanu boju dugmadi"

#. Tag: option
#: man-kdesvn.1.docbook:265
#, no-c-format
msgid "--name &lt;name&gt;"
msgstr "--name &lt;name&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:267
#, no-c-format
msgid "sets the application name"
msgstr "postavlja ime aplikacije"

#. Tag: option
#: man-kdesvn.1.docbook:271
#, no-c-format
msgid "--title &lt;title&gt;"
msgstr "--title &lt;title&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:273
#, no-c-format
msgid "sets the application title (caption)"
msgstr "postavlja naslovnu liniju aplikacije (caption)"

#. Tag: option
#: man-kdesvn.1.docbook:277
#, no-c-format
msgid "--visual TrueColor"
msgstr "--visual TrueColor"

#. Tag: para
#: man-kdesvn.1.docbook:279
#, no-c-format
msgid "forces the application to use a TrueColor visual on an 8-bit display"
msgstr "prisiljava aplikaciju da koristi TrueColor visual na 8-bitnom zaslonu"

#. Tag: option
#: man-kdesvn.1.docbook:284
#, no-c-format
msgid "--inputstyle &lt;inputstyle&gt;"
msgstr "--inputstyle &lt;inputstyle&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:286
#, no-c-format
msgid ""
"sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root"
msgstr ""
"postavlja XIM (X Input Method) stil ulaza. Moguće vrijednosti su onthespot, "
"overthespot, offthespot and korijen"

#. Tag: option
#: man-kdesvn.1.docbook:292
#, no-c-format
msgid "--im &lt;XIM server&gt;"
msgstr "--im &lt;XIM server&gt;"

#. Tag: para
#: man-kdesvn.1.docbook:294
#, no-c-format
msgid "set XIM server"
msgstr "podesi XIM server"

#. Tag: option
#: man-kdesvn.1.docbook:298
#, no-c-format
msgid "--noxim"
msgstr "--noxim"

#. Tag: para
#: man-kdesvn.1.docbook:300
#, no-c-format
msgid "disable XIM"
msgstr "isključi XIM"

#. Tag: option
#: man-kdesvn.1.docbook:304
#, no-c-format
msgid "--reverse"
msgstr "--reverse"

#. Tag: para
#: man-kdesvn.1.docbook:306
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr "izvrće cijeli raspored grafičkih kontrola"

#. Tag: option
#: man-kdesvn.1.docbook:310
#, no-c-format
msgid "--stylesheet"
msgstr "--stylesheet"

#. Tag: para
#: man-kdesvn.1.docbook:312
#, no-c-format
msgid "&lt;file.qss&gt; applies the Qt stylesheet to the application widgets"
msgstr ""
"&lt;file.qss&gt; primjenjuje Qt stylesheet na grafičke kontrole aplikacije"

#. Tag: title
#: man-kdesvn.1.docbook:320
#, no-c-format
msgid "EXAMPLE"
msgstr "PRIMJER"

#. Tag: para
#: man-kdesvn.1.docbook:321
#, no-c-format
msgid "kdesvn file:///<replaceable>path/to/local/working/copy</replaceable>"
msgstr "kdesvn file:///<replaceable>path/to/local/working/copy</replaceable>"

#. Tag: para
#: man-kdesvn.1.docbook:322
#, no-c-format
msgid "kdesvn http://<replaceable>remote/svn/project/trunk</replaceable>"
msgstr "kdesvn http://<replaceable>remote/svn/project/trunk</replaceable>"

#. Tag: title
#: man-kdesvn.1.docbook:326
#, no-c-format
msgid "SEE ALSO"
msgstr "TOKOĐER POGLEDAJTE"

#. Tag: para
#: man-kdesvn.1.docbook:327
#, no-c-format
msgid ""
"Full user documentation is available through the KDE Help Center. You can "
"also enter the URL <emphasis>help:/kdesvn/</emphasis> directly into "
"konqueror or you can run <emphasis>`khelpcenter help:/kdesvn/'</emphasis> "
"from the command-line."
msgstr ""
"Cijela korisnička dokumentacija je dostupna preko KDE Help Centra. Također "
"možete unijeti URL <emphasis>help:/kdesvn/</emphasis> direktno u konqueror "
"ili možete pokrenuti <emphasis>`khelpcenter help:/kdesvn/'</emphasis> sa "
"komandne linije."

#. Tag: title
#: man-kdesvn.1.docbook:335
#, no-c-format
msgid "AUTHORS"
msgstr "AUTORI"

#. Tag: literallayout
#: man-kdesvn.1.docbook:336
#, no-c-format
msgid "Rajko Albrecht &lt;ral@alwins-world.de&gt;"
msgstr "Rajko Albrecht &lt;ral@alwins-world.de&gt;"
