#: index.docbook:4692
#, no-c-format
msgid ""
"&i18n-cmd_syntax;<command>&no-i18n-tag;&no-i18n-cmd_window_cascade;</command>"
"()"
msgstr ""

#. Tag: para
#: index.docbook:4693
#, no-c-format
msgid ""
"Cascades all sub windows when in MDI mode. All sub windows that are "
"currently minimized stay minimized, they will not be restored."
msgstr ""

#. Tag: title
#: index.docbook:4701
#, no-c-format
msgid "&no-i18n-cmd_window_click;"
msgstr ""

