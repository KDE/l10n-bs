#: index.docbook:3983
#, no-c-format
msgid ""
"&i18n-cmd_syntax;<command>&no-i18n-tag;&no-i18n-cmd_redo_all;</command>()"
msgstr ""

#. Tag: para
#: index.docbook:3984
#, no-c-format
