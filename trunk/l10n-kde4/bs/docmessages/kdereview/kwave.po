#: index.docbook:4718 index.docbook:4742 index.docbook:4789 index.docbook:4817
#: index.docbook:4842
#, no-c-format
msgid "<parameter>class</parameter>:"
msgstr ""

#. Tag: entry
#: index.docbook:4719 index.docbook:4743 index.docbook:4790 index.docbook:4818
#: index.docbook:4843
#, no-c-format
msgid "name of the window class"
msgstr ""

#. Tag: entry
#: index.docbook:4720
#, no-c-format
msgid "<parameter>x</parameter>:"
msgstr ""

#. Tag: entry
#: index.docbook:4721
#, no-c-format
msgid "x position, relative to the left border of the window (in pixels)"
msgstr ""

#. Tag: entry
#: index.docbook:4722
#, no-c-format
msgid "<parameter>y</parameter>:"
msgstr ""

#. Tag: entry
#: index.docbook:4723
#, no-c-format
