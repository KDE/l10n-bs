#: index.docbook:4791
#, no-c-format
msgid "<parameter>width</parameter>:"
msgstr ""

#. Tag: entry
#: index.docbook:4792
#, no-c-format
msgid "new width of the window (in pixels)"
msgstr ""

#. Tag: entry
#: index.docbook:4793
#, no-c-format
msgid "<parameter>height</parameter>:"
msgstr ""

#. Tag: entry
#: index.docbook:4794
#, no-c-format
msgid "new height of the window (in pixels)"
msgstr ""

