#: ie-menu.docbook:37
#, no-c-format
msgid "Display the last image of current Album."
msgstr "Prikazati posljednju sliku u trenutnom albumu."

#. Tag: menuchoice
#: ie-menu.docbook:41
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu><guimenuitem>Save</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Datoteka</guimenu><guimenuitem>Snimi</guimenuitem>"

