#: ie-menu.docbook:52
#, no-c-format
msgid "Save the current image in a new file."
msgstr "Snimite trenutnu sliku u novu datoteku."

#. Tag: menuchoice
#: ie-menu.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Revert</guimenuitem>"
msgstr "<guimenu>Datoteka</guimenu><guimenuitem>Vrati</guimenuitem>"

#. Tag: action
#: ie-menu.docbook:59
#, no-c-format
msgid ""
"Restore the current image from the original file if it has been modified."
msgstr "Vrattite trenutnu sliku iz originalne datoteteke ako je modificirana."

#. Tag: menuchoice
#: ie-menu.docbook:63
#, no-c-format
msgid ""
"<shortcut><keycombo>&Shift;<keycap>Del</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu><guimenuitem>Delete File/Move to trash</guimenuitem>"
msgstr ""
"<shortcut><keycombo>&Shift;<keycap>Obrisi</keycap></keycombo> </shortcut> "
"<guimenu>Datoteka</guimenu><guimenuitem>Obrisi datoteku/Premjesti u smece</"
"guimenuitem>"

#. Tag: action
#: ie-menu.docbook:67
#, no-c-format
msgid "Delete/Move to trash the current image from the current Album."
msgstr "Obrisi/premjesti u smece trenutnu fotografiju iz trenutnog albuma."

#. Tag: menuchoice
#: ie-menu.docbook:72
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu><guimenuitem>Print Image</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Datoteka</guimenu><guimenuitem>Isprintaj sliku</"
"guimenuitem>"

#. Tag: action
#: ie-menu.docbook:76
#, no-c-format
msgid "Print the current image."
msgstr "Isprintaj trenutnu sliku."

#. Tag: menuchoice
#: ie-menu.docbook:80
#, no-c-format
msgid ""
"<shortcut><keycombo>&Ctrl;<keycap>Q</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu><guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut><keycombo>&Ctrl;<keycap>Q</keycap></keycombo> </shortcut> "
"<guimenu>Datoteka</guimenu><guimenuitem>Izađi</guimenuitem>"

#. Tag: action
#: ie-menu.docbook:84
#, no-c-format
msgid "Quit &digikam; Image Editor."
msgstr "Napusti &digikam; uređivač slika."

#. Tag: title
#: ie-menu.docbook:94
#, no-c-format
msgid "The Edit Menu"
msgstr "Uređivački meni."

#. Tag: menuchoice
#: ie-menu.docbook:100
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Copy</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu><guimenuitem>Kopiraj</guimenuitem>"

#. Tag: action
#: ie-menu.docbook:104
#, no-c-format
msgid "Copy the current image selection in the clipboard."
msgstr "Kopirajte izabranu sliku u međumemoriju."

#. Tag: menuchoice
#: ie-menu.docbook:108
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Undo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Uredi</guimenu><guimenuitem>Vrati nazad</guimenuitem>"

#. Tag: action
#: ie-menu.docbook:112
#, no-c-format
msgid "Cancel the last action applied to the current image using history."
msgstr ""
"Otkazite posljednju primjenjenu akciju na trenutnu sliku koristeci historiju."

#. Tag: menuchoice
#: ie-menu.docbook:116
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Uredi</guimenu><guimenuitem>Vrati naprijed</"
"guimenuitem>"

#. Tag: action
#: ie-menu.docbook:120
#, no-c-format
msgid "Redo the last action applied to the current image using history."
msgstr ""
"Ponovo primjenite posljednju akciju na trenutnu sliku koristeci historiju."

