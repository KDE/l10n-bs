#: ie-menu.docbook:325
#, no-c-format
msgid ""
"Image Editor tool to remove hot pixels on the current image <link linkend="
"\"hotpixels\">(help)</link>."
msgstr ""
"Alat uređivanja slika za uklanjanje jarkih piksela na trenutnoj slici <link "
"linkend=\"hotpixels\">(help)</link>."

#. Tag: menuchoice
#: ie-menu.docbook:332
#, no-c-format
