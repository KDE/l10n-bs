#. Tag: title
#: ie-menu.docbook:1
#, no-c-format
msgid "The Image Editor"
msgstr "Uređivač slika"

#. Tag: title
#: ie-menu.docbook:3
#, no-c-format
msgid "The File Menu"
msgstr "Izbornik datoteka"

#. Tag: menuchoice
#: ie-menu.docbook:9
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"press\"><keycap>PgUp</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu><guimenuitem>Back</guimenuitem>"
msgstr ""
"<shortcut><keycombo action=\"press\"><keycap>StrGore</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu><guimenuitem>Nazad</guimenuitem>"

#. Tag: action
#: ie-menu.docbook:13
#, no-c-format
msgid "Display the previous image of the current Album."
msgstr "Prikazi prethodnu sliku u trenutnom albumu."

#. Tag: menuchoice
#: ie-menu.docbook:17
#, no-c-format
