#. i18n: file: functions/engineering.xml:130
#: xml_doc.cpp:864
msgid ""
"Supported mass units: g (gram), sg (pieces), lbm (pound), u (atomic mass), "
"ozm (ounce), stone, ton, grain, pweight (pennyweight), hweight "
"(hundredweight)."
msgstr ""
"Podržane jedinice mase: g(gram),sg(komada),lbm(oko 45 kg),u (atomska masa),"
"ozm(28.349 grama),kamen,tona,žito,pweight(mjera težine),hweight(težina oko "
