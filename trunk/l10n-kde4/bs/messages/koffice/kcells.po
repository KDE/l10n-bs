#: xml_doc.cpp:2527
msgid "EPS()"
msgstr "EPS()"

#. i18n: file: functions/math.xml:119
#: xml_doc.cpp:2529
msgid "On most systems, this returns 2^-52=2.2204460492503131e-16"
msgstr "Na većini sistema, ovo vraća 2^-52=2.2204460492503131e-16"

