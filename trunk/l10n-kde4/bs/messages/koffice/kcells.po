msgstr "COSH(0.8) je 1.33743495"

#. i18n: file: functions/trig.xml:131
#: xml_doc.cpp:4897
msgid "COSH(0) equals 1"
msgstr "COSH(0) je 1"

#. i18n: file: functions/trig.xml:144
#: xml_doc.cpp:4901
msgid ""
"The SINH() function returns the hyperbolic sine of x, which is defined "
"mathematically as (exp(x) - exp(-x)) / 2."
msgstr ""
"Funkcija SINH() vraća hiperbolički sinus od x, što je matematički definisano "
"kao (exp(x) - exp(-x)) / 2."

#. i18n: file: functions/trig.xml:145
#: xml_doc.cpp:4903
msgid "SINH(Float)"
msgstr "SINH(r.broj)"

