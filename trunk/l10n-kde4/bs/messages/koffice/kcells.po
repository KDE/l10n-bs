#: xml_doc.cpp:2727
msgid "SUMIF(A1:A4;\">1\") sums all values in range A1:A4 which match >1"
msgstr "SUMIF(A1:A4;\">1\") sumira sve vrijednosti u opsegu A1:A4 koje su >1"

#. i18n: file: functions/math.xml:444
#: xml_doc.cpp:2729
