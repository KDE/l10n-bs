#. i18n: file: functions/financial.xml:408
#: xml_doc.cpp:1542
msgid ""
"The DOLLARFR() function returns a dollar price expressed as a fraction. The "
"decimal dollar is the number to be converted and the fraction is the "
"denominator of the fraction"
msgstr ""
"Funkcija DOLLARFR() vraća cijenu dolara izraženu kao razlomak. Decimalni "
"dolar je broj za pretvaranje a razlomak je imenilac razlomka."

#. i18n: file: functions/financial.xml:409
#: xml_doc.cpp:1544
msgid "DOLLARFR(fractional dollar; fraction)"
msgstr "DOLLARFR(frakcioni dolar; razlomak)"

#. i18n: file: functions/financial.xml:410
