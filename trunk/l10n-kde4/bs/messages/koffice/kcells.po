msgstr "Broj perioda"

#. i18n: file: functions/financial.xml:646
#: xml_doc.cpp:1665
msgid "Present values"
msgstr "Trenutne vrijednosti"

#. i18n: file: functions/financial.xml:650
#. i18n: file: functions/financial.xml:1036
