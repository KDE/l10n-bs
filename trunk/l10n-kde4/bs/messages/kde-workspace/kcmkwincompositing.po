#. i18n: ectx: property (text), item, widget (QComboBox, glScaleFilter)
#: main.ui:751
msgid "Accurate"
msgstr "Precizno"

#. i18n: ectx: property (text), widget (QCheckBox, unredirectFullscreen)
#: main.ui:761
