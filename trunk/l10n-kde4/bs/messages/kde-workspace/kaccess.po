#: kaccess.cpp:736
#, kde-format
msgid ""
"Do you really want to activate \"%1\", and \"%2\" and to deactivate \"%3\" "
"and \"%4\"?"
msgstr "Želite li zaista da aktivirate „%1“ i „%2“ i deaktivirate „%3“ i „%4“?"

#: kaccess.cpp:743
#, kde-format
