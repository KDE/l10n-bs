msgstr "Proces distribucijske  nadgradnje je izašao sa kodom %1."

#: ApperKCM/Updater/DistroUpgrade.cpp:115 SmartIcon/KpkDistroUpgrade.cpp:134
msgid "The distribution upgrade process failed to start."
msgstr "Proces distribucijske nadgradnje nije uspio da počne"

