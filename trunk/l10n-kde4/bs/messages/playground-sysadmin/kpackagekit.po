msgstr "Potrebna je izmjena medija"

#: libkpackagekit/KpkStrings.cpp:478
msgid "Authorization failed"
msgstr "Ovlaštenje nije uspjelo"

#: libkpackagekit/KpkStrings.cpp:480
msgid "Update not found"
msgstr "Ažuriranje nije pronađeno"

#: libkpackagekit/KpkStrings.cpp:482
msgid "Cannot install from untrusted origin"
msgstr "Instalacija nije moguća od nesigurnog izvora"

#: libkpackagekit/KpkStrings.cpp:484
msgid "Cannot update from untrusted origin"
msgstr "Ažuriranje nije moguće od nesigurnog izvora"

#: libkpackagekit/KpkStrings.cpp:486
msgid "Cannot get the file list"
msgstr "Spisak datoteka se ne može dobiti"

#: libkpackagekit/KpkStrings.cpp:488
msgid "Cannot get package requires"
msgstr "Ne mogu se dobiti paketski zahtjevi"

#: libkpackagekit/KpkStrings.cpp:490
msgid "Cannot disable origin"
msgstr "Ne može se onesposobiti izvor"

#: libkpackagekit/KpkStrings.cpp:492
msgid "The download failed"
msgstr "Preuzimanje nije uspjelo"

#: libkpackagekit/KpkStrings.cpp:494
msgid "Package failed to configure"
msgstr "Konfiguracija paketa nije uspjela"

#: libkpackagekit/KpkStrings.cpp:496
msgid "Package failed to build"
msgstr "Izgradnja paketa nije uspjela"

#: libkpackagekit/KpkStrings.cpp:498
msgid "Package failed to install"
msgstr "Instalacija paketa nije uspjela"

#: libkpackagekit/KpkStrings.cpp:500
msgid "Package failed to be removed"
msgstr "Otklanjanje paketa nije uspjelo"

#: libkpackagekit/KpkStrings.cpp:502
msgid "Update failed due to running process"
msgstr "Ažuriranje neuspjelo zbog pokrenutog procesa"

#: libkpackagekit/KpkStrings.cpp:504
msgid "The package database was changed"
msgstr "Paketska baza podataka je izmjenjena"

#: libkpackagekit/KpkStrings.cpp:507
msgid "Unknown error"
msgstr "Nepoznata greška"

#: libkpackagekit/KpkStrings.cpp:517
msgid ""
"There is no network connection available.\n"
"Please check your connection settings and try again"
msgstr ""
"Nema dostupne mrežne veze\n"
"Provjerite postavke i probajte ponovo."

#: libkpackagekit/KpkStrings.cpp:520
msgid ""
"The package list needs to be rebuilt.\n"
"This should have been done by the backend automatically."
msgstr "Spisak paketa mora biti ponovno napravljen"

#: libkpackagekit/KpkStrings.cpp:523
msgid ""
"The service that is responsible for handling user requests is out of "
"memory.\n"
"Please close some programs or restart your computer."
msgstr ""
"Servisu koji je odgovoran za obradu zahtjeva korsinika nedostaje memorije.\n"
"Zatvorite neke programe ili ponovo pokrenite računar"

#: libkpackagekit/KpkStrings.cpp:526
msgid "A thread could not be created to service the user request."
msgstr "Aplikacija ne može biti napravljena da usluži zahtjev korisnika"

#: libkpackagekit/KpkStrings.cpp:528
msgid ""
"The action is not supported by this backend.\n"
"Please report a bug as this should not have happened."
msgstr "Radnja nije podržana ovom aplikacijom"

#: libkpackagekit/KpkStrings.cpp:531
msgid ""
"A problem that we were not expecting has occurred.\n"
"Please report this bug with the error description."
msgstr ""
"Pojavio se je neočekivani problem.\n"
"Prijavite ovu grešku s opisom greške."

#: libkpackagekit/KpkStrings.cpp:534
msgid ""
"A security trust relationship could not be made with the software origin.\n"
"Please check your software signature settings."
msgstr ""
"Sigurnosna veza se nije mogla napraviti sa programskim izvorom\n"
"Provjerite postavke potpisivanja softvera."

#: libkpackagekit/KpkStrings.cpp:537
msgid ""
"The package that is trying to be removed or updated is not already installed."
msgstr "Paket koji pokušavate ukloniti ili ažurirati nije instaliran"

#: libkpackagekit/KpkStrings.cpp:539
msgid ""
"The package that is being modified was not found on your system or in any "
"software origin."
msgstr ""
"Paket koji je promijenjen nije pronađen u vašem sistemu ili u nekom od "
"softverskih izvora"

#: libkpackagekit/KpkStrings.cpp:541
msgid "The package that is trying to be installed is already installed."
msgstr "paket koji pokušavate instalirati je već instaliran"

#: libkpackagekit/KpkStrings.cpp:543
msgid ""
"The package download failed.\n"
"Please check your network connectivity."
msgstr ""
"Preuzimanje paketa nije uspjelo.\n"
"Provjerite vašu mrežnu povezanost."

#: libkpackagekit/KpkStrings.cpp:546
msgid ""
"The group type was not found.\n"
"Please check your group list and try again."
msgstr ""
"Vrsta grupe nije pronađena.\n"
"Provjerite listu grupa i probajte ponovo."

#: libkpackagekit/KpkStrings.cpp:549
msgid ""
"The group list could not be loaded.\n"
"Refreshing your cache may help, although this is normally a software origin "
"error."
msgstr ""
"Grupni spisak se ne može učitati.\n"
"Osvježavanje keša može pomoći ako je to normalno softverska greška."

#: libkpackagekit/KpkStrings.cpp:553
msgid ""
"A package dependency could not be found.\n"
"More information is available in the detailed report."
msgstr ""
"Zavisnost paketa nije pronađena.\n"
"Više informacija možete naći u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:556
msgid "The search filter was not correctly formed."
msgstr "Pretraživački filter nije pravilno formiran"

#: libkpackagekit/KpkStrings.cpp:558
msgid ""
"The package identifier was not well formed when sent to the system daemon.\n"
"This normally indicates an internal bug and should be reported."
msgstr ""
"Identifikator paketa nije dobro formiran kada je poslan u sistem.\n"
"To je obično interna greška koja treba biti javljena."

#: libkpackagekit/KpkStrings.cpp:561
msgid ""
"An error occurred while running the transaction.\n"
"More information is available in the detailed report."
msgstr ""
"Pojavio se je problem u toku pokretanja transakcije.\n"
"Više informacija imate u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:564
msgid ""
"The remote software origin name was not found.\n"
"You may need to enable an item in Software Origins."
msgstr ""
"Porijeklo imena izdvojenog programa nije pronađeno.\n"
"Možda ćete morati omogućiti stavku u izvorima softvera."

#: libkpackagekit/KpkStrings.cpp:567
msgid "Removing a protected system package is not allowed."
msgstr "Uklanjanje zaštićenog sistemskog paketa nije dozvoljeno"

#: libkpackagekit/KpkStrings.cpp:569
msgid "The task was canceled successfully and no packages were changed."
msgstr "Zadatak je uspješno otkazan i nijedan paket nije izmjenjen"

#: libkpackagekit/KpkStrings.cpp:571
msgid ""
"The task was canceled successfully and no packages were changed.\n"
"The backend did not exit cleanly."
msgstr ""
"Zadatak je uspješno otkazan i nijedan paket nije izmjenjen.\n"
"Pozadina nije čisto izašla."

#: libkpackagekit/KpkStrings.cpp:574
msgid ""
"The native package configuration file could not be opened.\n"
"Please make sure your system's configuration is valid."
msgstr ""
"Izvorna konfiguracija paketa datoteke ne može biti otvorena\n"
"Provjerite ispravnost sistemske konfiguracije"

#: libkpackagekit/KpkStrings.cpp:577
msgid "The task is not safe to be cancelled at this time."
msgstr "Trenutno nije sigurno otkazati zadatak"

#: libkpackagekit/KpkStrings.cpp:579
msgid ""
"Source packages are not normally installed this way.\n"
"Check the extension of the file you are trying to install."
msgstr ""
"Izvorni paketi nisu normalno instalirani na ovaj način.\n"
"Provjerite ekstenziju datoteke koju pokušavate istalirati."

#: libkpackagekit/KpkStrings.cpp:582
msgid ""
"The license agreement was not agreed to.\n"
"To use this software you have to accept the license."
msgstr ""
"Licencni ugovor nije potvrđen.\n"
"Da biste koristili ovaj program morate prihvatiti licencu."

#: libkpackagekit/KpkStrings.cpp:585
msgid ""
"Two packages provide the same file.\n"
"This is usually due to mixing packages for different software origins."
msgstr ""
"Dva paketa pružaju istu datoteku\n"
"To se dešava kada se mješaju paketi s različitih softverskih izvora."

#: libkpackagekit/KpkStrings.cpp:588
msgid ""
"Multiple packages exist that are not compatible with each other.\n"
"This is usually due to mixing packages from different software origins."
msgstr ""
"Postoje višestruki paketi koji nisu kompatibilni jedan sa drugim.\n"
"To se dešava kada se mješaju paketi s različitih softverskih izvora."

#: libkpackagekit/KpkStrings.cpp:591
msgid ""
"There was a (possibly temporary) problem connecting to a software origins.\n"
"Please check the detailed error for further details."
msgstr ""
"Postoji (vjerovatno privremeni) problem u povezivanju sa porijeklom "
"programa\n"
"Pogledajte detaljan opis greške."

#: libkpackagekit/KpkStrings.cpp:594
msgid ""
"Failed to initialize packaging backend.\n"
"This may occur if other packaging tools are being used simultaneously."
msgstr ""
"Nije uspio početak paketskog backenda.\n"
"To se dešava ako se drugi paketski alati istovremeno koriste."

#: libkpackagekit/KpkStrings.cpp:597
msgid ""
"Failed to close down the backend instance.\n"
"This error can normally be ignored."
msgstr ""
"Nisam uspio zatvoriti pozadinsku kopijur.\n"
"Ta pogreška obično se može zanemariti."

#: libkpackagekit/KpkStrings.cpp:600
msgid ""
"Cannot get the exclusive lock on the packaging backend.\n"
"Please close any other legacy packaging tools that may be open."
msgstr ""
"Ne mogu dobiti ekskluzivno zaključavanje na pozadini paketa.\n"
"Molimo vas da zatvorite sve druge starije paketne alate koji mogu biti "
"otvoreni."

#: libkpackagekit/KpkStrings.cpp:603
msgid "None of the selected packages could be updated."
msgstr "Nijedan od izabranih paketa ne može biti ažuriran"

#: libkpackagekit/KpkStrings.cpp:605
msgid "The repository configuration could not be modified."
msgstr "Konfiguracija repozitorija se ne može mijenjati"

#: libkpackagekit/KpkStrings.cpp:607
msgid ""
"Installing the local file failed.\n"
"More information is available in the detailed report."
msgstr ""
"Instalacija lokalne datoteke nije uspjela.\n"
"Više informacija u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:610
msgid "The package signature could not be verified."
msgstr "Paketski potpis ne može biti potvrđen"

#: libkpackagekit/KpkStrings.cpp:612
msgid ""
"The package signature was missing and this package is untrusted.\n"
"This package was not signed with a GPG key when created."
msgstr "Nedostaje paketski potpis i ovaj paket je nesiguran"

#: libkpackagekit/KpkStrings.cpp:615
msgid "Repository configuration was invalid and could not be read."
msgstr "Konfiguracija repozitotija je nevažeća i nije čitljiva"

#: libkpackagekit/KpkStrings.cpp:617
msgid ""
"The package you are attempting to install is not valid.\n"
"The package file could be corrupt, or not a proper package."
msgstr ""
"Paket koji pokušavate instalirati nije važeći.\n"
"Paketska datoteka je možda oštećena ili nije ispravan paket."

#: libkpackagekit/KpkStrings.cpp:620
msgid ""
"Installation of this package was prevented by your packaging system's "
"configuration."
msgstr ""
"Instalacija ovog paketa je spriječena od strane vaše sistemske konfiguracije"

#: libkpackagekit/KpkStrings.cpp:622
msgid ""
"The package that was downloaded is corrupt and needs to be downloaded again."
msgstr "Preuzeti paket je oštećen i potrebno ga je ponovno preuzeti"

#: libkpackagekit/KpkStrings.cpp:624
msgid ""
"All of the packages selected for install are already installed on the system."
msgstr "Svi odabrani paketi za instalaciju su već instalirani na sistemu"

#: libkpackagekit/KpkStrings.cpp:626
msgid ""
"The specified file could not be found on the system.\n"
"Check that the file still exists and has not been deleted."
msgstr ""
"Određena datoteka nije pronađena u sistemu.\n"
"Provjerite da li datoteka još postoji i da nije obrisana."

#: libkpackagekit/KpkStrings.cpp:629
msgid ""
"Required data could not be found on any of the configured software origins.\n"
"There were no more download mirrors that could be tried."
msgstr ""
"Traženi podaci nisu pronađeni na bilo kojem konfigurisanom programskom "
"izvoru.\n"
"Nema ogledala za preuzimanje koja mogu biti isprobana."

#: libkpackagekit/KpkStrings.cpp:632
msgid ""
"Required upgrade data could not be found in any of the configured software "
"origins.\n"
"The list of distribution upgrades will be unavailable."
msgstr ""
"Tražena nadgradnja podataka nije pronađena na bilo kojem konfigurisanom "
"programskom izvoru.\n"
"Lista distribucijskih nadogradnji nije raspoloživa."

#: libkpackagekit/KpkStrings.cpp:635
msgid ""
"The package that is trying to be installed is incompatible with this system."
msgstr "Paket koji pokušavate instalirati nije kompatabilan sa sistemom"

#: libkpackagekit/KpkStrings.cpp:637
msgid ""
"There is insufficient space on the device.\n"
"Free some space on the system disk to perform this operation."
msgstr ""
"Nema dovoljno prostora na uređaju.\n"
"Oslobodite prostor na sistemskom disku da obavite operaciju."

#: libkpackagekit/KpkStrings.cpp:640
msgid "Additional media is required to complete the transaction."
msgstr "Dodatni medij je potreban da bi se završila transakcija"

#: libkpackagekit/KpkStrings.cpp:642
msgid ""
"You have failed to provide correct authentication.\n"
"Please check any passwords or account settings."
msgstr ""
"Niste uspjeli pružiti valjanu ovjeru.\n"
"Provjerite postavke lozinki i naloga."

#: libkpackagekit/KpkStrings.cpp:645
msgid ""
"The specified update could not be found.\n"
"It could have already been installed or no longer available on the remote "
"server."
msgstr ""
"Naznačena nadgradnja nije pronađena.\n"
"Možda je već instaliran ili nije više dostupan na udaljenom serveru."

#: libkpackagekit/KpkStrings.cpp:648
msgid "The package could not be installed from untrusted origin."
msgstr "Paket ne može biti instaliran iz nesigurnog izvora"

#: libkpackagekit/KpkStrings.cpp:650
msgid "The package could not be updated from untrusted origin."
msgstr "Paket ne može biti ažuriran iz nesigurnog izvora"

#: libkpackagekit/KpkStrings.cpp:652
msgid "The file list is not available for this package."
msgstr "Spisak datoteka za ovaj paket nije dostupan"

#: libkpackagekit/KpkStrings.cpp:654
msgid "The information about what requires this package could not be obtained."
msgstr "Informacije o tome šta zahtjeva ovaj paket ne mogu se dobiti"

#: libkpackagekit/KpkStrings.cpp:656
msgid "The specified software origin could not be disabled."
msgstr "Određeni programski izvor se ne može onemogućiti"

#: libkpackagekit/KpkStrings.cpp:658
msgid ""
"The download could not be done automatically and should be done manually.\n"
"More information is available in the detailed report."
msgstr ""
"The download could not be done automatically and should be done manually.\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:661
msgid ""
"One of the selected packages failed to configure correctly.\n"
"More information is available in the detailed report."
msgstr ""
"Jedan od naznačenih paketa nije se uspio pravilno konfigurisati.\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:664
msgid ""
"One of the selected packages failed to build correctly.\n"
"More information is available in the detailed report."
msgstr ""
"Jedan od naznačenih paketa nije uspio da se pravilno izgradi\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:667
msgid ""
"One of the selected packages failed to install correctly.\n"
"More information is available in the detailed report."
msgstr ""
"Jedan od naznačenih paketa nije uspio da se pravilno instalira.\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:670
msgid ""
"One of the selected packages failed to be removed correctly.\n"
"More information is available in the detailed report."
msgstr ""
"Jedan od naznačenih paketa nije uspio da se pravilno odstrani.\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:673
msgid ""
"A program is running that has to be closed before the update can proceed.\n"
"More information is available in the detailed report."
msgstr ""
"Program koji trenutno radi se mora zatvoriti prije da bi se nastavila "
"nadgradnja.\n"
"Više informacija je dostupno u detaljnom izvještaju."

#: libkpackagekit/KpkStrings.cpp:676
msgid "The package database was changed while the request was running."
msgstr "Paketska baza podataka je promjenjena za vrijeme trajanja zahtjeva"

#: libkpackagekit/KpkStrings.cpp:679
msgid ""
"Unknown error, please report a bug.\n"
"More information is available in the detailed report."
msgstr ""
"Nepoznata greška, molim vas prijavite kvar.\n"
"Više informacija je dostupno u detaljnom izvještaju."

