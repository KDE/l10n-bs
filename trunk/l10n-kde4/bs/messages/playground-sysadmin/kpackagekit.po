msgstr "Naznačena datoteka nije pronađena"

#: libkpackagekit/KpkStrings.cpp:468
msgid "No more mirrors are available"
msgstr "Nema više dostupnih ogledala"

#: libkpackagekit/KpkStrings.cpp:470
msgid "No distribution upgrade data is available"
msgstr "Distribucijska nadgradnja datoteke nije dostupna"

#: libkpackagekit/KpkStrings.cpp:472
msgid "Package is incompatible with this system"
msgstr "Paket nije u skladu sa sistemom"

#: libkpackagekit/KpkStrings.cpp:474
msgid "No space is left on the disk"
msgstr "Nema više slobodnog prostora na disku"

#: libkpackagekit/KpkStrings.cpp:476 libkpackagekit/PkTransaction.cpp:648
