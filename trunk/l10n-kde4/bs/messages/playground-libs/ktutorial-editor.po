#~ msgid ""
#~ "<para>Edit a condition to wait for until it is met.</para>\n"
#~ "<para>A condition can be a plain condition or a composed condition. Plain "
#~ "conditions wait for some specific thing to happen, for example, they wait "
#~ "until a signal is emitted. Composed conditions contain other conditions "
#~ "(plain or also composed) and wait until something happens in its "
#~ "contained conditions, for example, wait until all the contained "
#~ "conditions were met.</para>"
#~ msgstr ""
#~ "<para>Uredi uslov na čije se ispunjenje čeka.</para>\n"
#~ "<para>Uslov može biti jednostavan ili sastavljen. Jednostavni čeka na "
#~ "ispunjenje nekog specifičnog događaja, kao što je emitovanje signala. "
#~ "Sastavljeni uslovi sadrže druge uslove (jednostavne ili sastavljene) i "
#~ "čekaju na ispunjenje određenih događaja unutar tih uslova.</para>"

