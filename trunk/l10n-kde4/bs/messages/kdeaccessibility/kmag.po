#: kmag.cpp:102
msgid "&No Rotation (0 Degrees)"
msgstr "&Bez rotacije (0°)"

#: kmag.cpp:102
msgid "&Left (90 Degrees)"
msgstr "&Lijevo (90°)"

#: kmag.cpp:102
