#. i18n: ectx: property (whatsThis), widget (QListWidget, cellTypes)
#: configure_details.ui:308
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Only the checked cell "
"types can be added into the crossword grid.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Empty Cells</span> are also called \"Shaded Cells\", \"Blanks"
"\", \"Darks\", \"Blocks\", \"Black Squares\" or \"Shaded Squares\". You "
"cannot disallow empty cells.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Letter Cells</span> are also called \"White Cells\" or \"Lights"
"\". They contain one letter (or digit) of one or two answers / entries. A "
"letter cell that is part of two answers (both Across and Down) is called "
"<span style=\" font-style:italic;\">checked</span>, <span style=\" font-"
"style:italic;\">keyed</span> or <span style=\" font-style:italic;\">crossed</"
"span>. A letter cell that is part of only one answer is called <span style="
"\" font-style:italic;\">unchecked</span>, <span style=\" font-style:italic;"
"\">unkeyed</span> or <span style=\" font-style:italic;\">uncrossed</span>.</"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Clue Cells</span> contain the clue text in small print inside "
"and act as empty cells. Each clue cell has a little arrow indicating in "
"which direction from its initial cell the answer is to be written.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Double Clue Cells</span> contain two clue cells inside, one "
"above the other.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Solution Letter Cells</span> are letter cells that are part of "
"a solution word for the whole crossword.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Image Cells</span> contain images and can be stretched over a "
"block of multiple cells.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'FreeSans'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Samo odabrani tipovi "
"ćelije mogu biti dodani u rešetku križaljke.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Prazne ćelije</span> se takođe zovu \"Shaded Cells\", \"Blanks"
"\", \"Darks\", \"Blocks\", \"Black Squares\" ili \"Shaded Squares\". Ne "
"možete opovrgnuti prazne ćelije.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Ćelije slova</span> se takođe zovu \"White Cells\" ili \"Lights"
"\". Sadrže jedno slovo (ili cifru) od jednog od dva odgovora / ulaza. Čelija "
"slova je dio od dva odgovora (oba preko i dole) je nazvana <span style=\" "
"font-style:italic;\">checked</span>, <span style=\" font-style:italic;"
"\">keyed</span> or <span style=\" font-style:italic;\">crossed</span>. "
"Ćelija slova koja je dio samo jednog odogovora <span style=\" font-style:"
"italic;\">unchecked</span>, <span style=\" font-style:italic;\">unkeyed</"
"span> ili <span style=\" font-style:italic;\">uncrossed</span>.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Ćelije traga</span> sadržetrag teksta u malim otiscima unutar "
"i ponašaju se kao prazne ćelije. Svaka ćelija traga ima malu strelicu koja "
"pokazuje u kom pravcu od njene početne ćelije odgovor treba biti zapisan.</"
"p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Duple ćelije traga</span>sadrže dvije ćelije traga unutar, "
"jednu iznad druge.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Ćelije rješenja slova</span> su ćelije slova koje su dio rječi "
"rješenja za cijelu križaljku.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">- <span style=\" font-"
"weight:600;\">Ćelije slike </span> sadrže slike i mogu biti istegnute preko "
"bloka više ćelija.</p></body></html>"

