msgstr "Odaberi fajl sa profilom"

#: kmuddy/dialogs/dlgimportexportprofile.cpp:132
msgid "Enter target file"
msgstr "Unesite odredišnu datoteku"

#: kmuddy/dialogs/dlgmudlist.cpp:56
msgid "MUD Listing"
msgstr "MUD listing"

#: kmuddy/dialogs/dlgmudlist.cpp:69
msgid "&Filter:"
msgstr "&Filter:"

#: kmuddy/dialogs/dlgmultiline.cpp:33
msgid "Multi-line input"
msgstr "Višelinijski unos"

#: kmuddy/dialogs/dlgmultiline.cpp:45
msgid ""
"Enter commands that are to be sent to the MUD. Each line represents one "
"command."
msgstr ""
"Unesite komande koje će biti poslane MUD-u. Svaka linija predstavlja jednu "
"komandu."

#: kmuddy/dialogs/dlgmultiline.cpp:56
msgid "&Prefix:"
msgstr "&Prefiks:"

#: kmuddy/dialogs/dlgmultiline.cpp:59
msgid "&Suffix:"
msgstr "&Sufiks:"

#: kmuddy/dialogs/dlgmultiline.cpp:69
msgid ""
"Prefix and suffix may contain text, that will be added to the beginning "
"(prefix) or ending (suffix) of every line written to the multi-line editor."
msgstr ""
"Prefiks i sufiks mogu sadržavati tekst, koji će biti dodan na početak "
"(prefiks) ili kraj (sufiks) svake napisane linije višelinijskom editoru."

#: kmuddy/dialogs/dlgmultiline.cpp:79
msgid "&Send"
msgstr "&Pošalji"

#: kmuddy/dialogs/dlgmultiline.cpp:80
msgid "Sends current text to the MUD."
msgstr "Šalje trenutni tekst MUD-u."

#: kmuddy/dialogs/dlgmultiline.cpp:81
msgid ""
"This will send all the commands you've entered to the MUD. If you've entered "
"prefix and/or suffix, they will be added to the beginning and ending of each "
"command."
msgstr ""
"Ovo će poslati sve komande koje ste unijeli MUD-u. Ako se unijeli prefiks i/"
"ili sufiks, bit će dodani na početak i kraj svake komande."

#: kmuddy/dialogs/dlgmultiline.cpp:84
msgid "&Clear"
msgstr "&Očisti"

#: kmuddy/dialogs/dlgmultiline.cpp:85
msgid "Clears window contents."
msgstr "Očisti sadržaje prozora."

