#: kmuddy/dialogs/dlgeditprofile.cpp:42 kmuddy/dialogs/dlgeditprofile.cpp:193
#: kmuddy/dialogs/dlgeditprofile.cpp:198
msgid "Edit profile"
msgstr "Izmijeni profil"

#: kmuddy/dialogs/dlgeditprofile.cpp:52
msgid "&Select from MUD list"
msgstr "&Izaberi sa MUD liste"

#: kmuddy/dialogs/dlgeditprofile.cpp:56
msgid "Profile &name:"
msgstr "Ime &profila"

#: kmuddy/dialogs/dlgeditprofile.cpp:58
msgid ""
"Enter profile name here. You can enter any name, but it must be <b>unique</"
"b>."
msgstr ""
"Unesite ime profila ovdje. Možete unijeti bilo koje ime, ali mora biti "
"<b>jedinstveno</b>."

#: kmuddy/dialogs/dlgeditprofile.cpp:60
msgid "&Server:"
msgstr "&Server:"

#: kmuddy/dialogs/dlgeditprofile.cpp:62
msgid "Enter address of the server where your MUD is running."
msgstr "Unesite adresu servera gdje je vaš MUD pokrenut."

#: kmuddy/dialogs/dlgeditprofile.cpp:63 kmuddy/dialogs/dlgquickconnect.cpp:47
msgid "&Port:"
msgstr "&Port:"

#: kmuddy/dialogs/dlgeditprofile.cpp:66
msgid "Enter port on which your MUD running (usually some 4-digit number)."
msgstr ""
"Unesite port na kojem je vaš MUD pokrenut (obično neki četverocifreni broj)."

#: kmuddy/dialogs/dlgeditprofile.cpp:67
msgid "&Login name:"
msgstr "&Ime za login"

#: kmuddy/dialogs/dlgeditprofile.cpp:69
msgid ""
"Enter your login name on the MUD here.<p><i>This setting is optional.</i>"
msgstr ""
"Unesite vaše ime za login na MUD ovdje.<p><i>Ova postavka je opcionalna.</i>"

#: kmuddy/dialogs/dlgeditprofile.cpp:70
msgid "Pass&word:"
msgstr "Lo&zinka:"

#: kmuddy/dialogs/dlgeditprofile.cpp:73
msgid "Enter your password on the MUD here.<p><i>This setting is optional.</i>"
msgstr ""
"Unesite vašu lozinku na MUD ovdje.<p><i>Ova postavka je opcionalna.</i>"

#: kmuddy/dialogs/dlgeditprofile.cpp:74
msgid "&Connect sequence"
msgstr "&Povezna sekvenca"

#: kmuddy/dialogs/dlgeditprofile.cpp:78
msgid ""
"Commands to be sent to the MUD after logging in.<br><b>$name</b> expands to "
"username.<br><b>$password</b> expands to your password.<p><b>Important:</b> "
"these commands are sent exactly as you type them, with leading/trailing "
"spaces removed. No aliases, no macros, no speed-walk. Also note that empty "
"lines will also be sent, including the very last line."
msgstr ""
"Komande koje će biti poslane MUD-u poslije logovanja.<br><b>$ime</b> se "
"proširuje na korisničko ime.<br><b>$lozinka</b> se proširuje na vašu lozinku."
"<p><b>Bitno:</b> ove komande su poslane tačno onako kako ih unesete, sa "
"početnim i krajnjim razmacima sklonjenim. Bez aliasa, makroa, brzog hoda. "
"Također primjetite da će prazne linije također biti poslane, uključivo sa "
"posljednjom linijom."

#: kmuddy/dialogs/dlgeditprofile.cpp:193
msgid "Profile name cannot be empty."
msgstr "Ime profila ne može biti prazno."

#: kmuddy/dialogs/dlgeditprofile.cpp:198
msgid "Profile name cannot contain '/' character."
msgstr "Ime profila ne može sadržavati karakter '/'."

