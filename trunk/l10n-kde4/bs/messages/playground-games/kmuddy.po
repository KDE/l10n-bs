msgstr "&Počni na trenutnoj poziciji"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:48
msgid ""
"When this is enabled, only the part of history buffer from currently "
"displayed part up to the end of buffer will be dumped. Otherwise entire "
"buffer will be dumped (default)."
msgstr ""
"Kada je ovo uključeno, samo dio historije bafera od trenutno prikazanog "
"dijela do kraja bafera će biti odbačen. U durgom slučaju čitav bafer će biti "
"odbačen (podrazumijevano)."

