msgstr "Molim unesite ime za duplicirani profil"

#: kmuddy/dialogs/dlgconnect.cpp:244
msgid ""
"There was an error trying to duplicate the profile. Please ensure that you "
"have write access to the profile directory."
msgstr ""
"Dogodila se greška pri pokušaju dupliciranja profila. Molim osigurajte da "
"imate pristup pisanju za direktorij profila."

#: kmuddy/dialogs/dlgconnect.cpp:244
msgid "Unable to duplicate"
msgstr "Dupliciranje nije bilo moguće"

#: kmuddy/dialogs/dlgdumpbuffer.cpp:37
