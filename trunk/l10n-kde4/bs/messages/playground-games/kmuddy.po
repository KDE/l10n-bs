msgstr "&Dupliciraj profil"

#: kmuddy/dialogs/dlgconnect.cpp:71
msgid "Do not &send login sequence"
msgstr "Ne &šalji login sekvencu"

#: kmuddy/dialogs/dlgconnect.cpp:72
msgid ""
"Login sequence won't be sent for this connect. Useful when you're creating a "
"new character and you want to use QuickConnect for some reason."
msgstr ""
"Login sekvenca neće biti poslana za ovo konektovanje. Korisno kada kreirate "
"novi karakter i želite da iskoristite BrzoKonektovanje iz nekog razloga."

#: kmuddy/dialogs/dlgconnect.cpp:77
msgid "&Offline editing"
msgstr "&Editovanje van mreže"

#: kmuddy/dialogs/dlgconnect.cpp:78
msgid "This allows offline editing of profiles."
msgstr "Ovo omogućava editovanje profila van mreže"

#: kmuddy/dialogs/dlgconnect.cpp:92 kmuddy/dialogs/dlgquickconnect.cpp:65
msgid "&Connect"
msgstr "&Kreni"

#: kmuddy/dialogs/dlgconnect.cpp:93 kmuddy/dialogs/dlgquickconnect.cpp:66
msgid "Establishes connection with specified parameters."
msgstr "Uspostavlja konekciju sa specifičnim parametrima."

#: kmuddy/dialogs/dlgconnect.cpp:94
msgid "C&lose"
msgstr "Z&atvori"

#: kmuddy/dialogs/dlgconnect.cpp:95
