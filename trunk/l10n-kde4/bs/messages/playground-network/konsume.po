msgstr "Artikal završava za %2:<br><br><b>%1</b><br>"

#: ebay.cpp:37
#, kde-format
msgid ""
"There was an error parsing eBay's XML Response: Line %1, Column %2: %3\n"
"\n"
"%4"
msgstr ""
"Pojavila se greška u raščlanjivanju eBay-ovog XML Odziva: Linija %1, Kolona "
"%2: %3\n"
"\n"
"%4"

#: ebay.cpp:37 ebay.cpp:47 ebay.cpp:212 ebay.cpp:525
#, kde-format
msgid "XML Response Error"
msgstr "Greška XML Odziva"

#: ebay.cpp:47
#, kde-format
msgid "The response's ack-tag is not present or did not indicate success."
msgstr "Ack-tag odziva nije pristuan ili nije indicirao uspjeh."

#: ebay.cpp:67
#, kde-format
msgid "setting authentication token."
msgstr "postavljanje tokena za provjeru."

#: ebay.cpp:124
#, kde-format
msgid "There was an error communicating with the eBay servers: %1"
msgstr "Pojavila se greška u komunikaciji sa eBay serverima: %1"

#: ebay.cpp:124
#, kde-format
msgid "HTTP Communication Error"
msgstr "HTTP Komunikaijska Greška"

#: ebay.cpp:175
#, kde-format
msgid "Are you sure you want to revoke the saved eBay authentication token?"
msgstr ""
"Jeste li sigurni da želite da poništite spašeni eBay token za provjeru?"

#: ebay.cpp:175
#, kde-format
msgid "Reset token"
msgstr "Ponovo postavi token"

#: ebay.cpp:212
#, kde-format
msgid "Unable to revoke eBay authentication token."
msgstr "Nije bilo moguće poništiti eBay token za provjeru."

#: ebay.cpp:280
#, kde-format
msgid "Could not find session ID in response."
msgstr "Nije bilo moguće naći ID sesije u odzivu."

#: ebay.cpp:280 ebay.cpp:353 ebay.cpp:624 ebay.cpp:678
#, kde-format
msgid "Response Error"
msgstr "Greška Odziva"

#: ebay.cpp:290
#, kde-format
msgid ""
"Please wait for a browser to open eBay's login-page, log in and follow the "
"instructions. Then, press Ok."
msgstr ""
"Molim sačekajte pretraživač da otvori eBay stranicu za prijavu, prijavite se "
"i pratite instrukcije. Potom, pritisnite Ok."

#: ebay.cpp:290 ebay.cpp:291
#, kde-format
msgid "Generating Token"
msgstr "Generisanje Tokena."

#: ebay.cpp:291
#, kde-format
msgid "Did you successfully link your account to the generated token?"
msgstr "Da li ste uspješno povezali vaš račun sa generisanim tokenom?"

#: ebay.cpp:314
#, kde-format
msgid "Internal Error"
msgstr "Unutrašnja greška"

#: ebay.cpp:353
#, kde-format
msgid "Could not find auth token in response."
msgstr "Nije bilo moguće naći token za provjeru u odzivu."

#: ebay.cpp:380
#, kde-format
msgid ""
"Please generate an eBay-authentication-token for access to your eBay-"
"Watchlist using the Settings-tab."
msgstr ""
"Molim generišite eBay token za provjeru za pristup vašoj eBay listi za "
"praćenje koristeći karticu postavki."

#: ebay.cpp:380
#, kde-format
msgid "Setup required"
msgstr "Zahtijeva se postavka"

#: ebay.cpp:525
#, kde-format
msgid "Could not find timestamp in response."
msgstr "Nije bilo moguće naći iznaku vremena u odzivu."

#: ebay.cpp:624
#, kde-format
msgid "The current Item is not an XML-Element."
msgstr "Trenutni artikal nije XML-Element."

#: ebay.cpp:678
#, kde-format
msgid "Could not confirm item deletion from watchlist"
msgstr "Nije bilo moguće potvrditi brisanje atrikla sa liste za praćenje"

#: konsume.cpp:23
#, kde-format
msgid "Open in Browser"
msgstr "Otvori u Pretraživaču"

#: konsume.cpp:24
#, kde-format
msgid "Remove from Watchlist"
msgstr "Ukloni sa liste za praćenje"

#: konsume.cpp:272
#, kde-format
msgid "Are you sure you want to remove this item from your watchlist?"
msgstr ""
"Jeste li sigurni da želite da uklonite oaj artikal sa liste za praćenje?"

#: konsume.cpp:272
#, kde-format
msgid "Remove item from watchlist"
msgstr "Ukloni artikal sa liste za praćenje"

