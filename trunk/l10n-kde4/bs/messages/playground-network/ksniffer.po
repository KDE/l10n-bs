msgid ""
"<qt><p>Opens the Configure Dialog where you can choose the settings about "
"the capture.</p><p>In case you don't request all the options, the capture "
"will start using the default settings.</p></qt>"
msgstr ""
"<qt><p>Otvara konfiguracijski Dijalog gdje možete izabrati postavke o "
"dohvatanju. </p><p> U slučaju da ne traži sve opcije, hvatanje će početi "
"koristeći zadate postavke.</p></qt>"

