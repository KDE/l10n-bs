msgstr "put do svjetlosnog inicijalizacijskog ispisa"

#: thinklightplugin.cpp:73
#, kde-format
msgid ""
"%1 does not exist. If you have a Thinkpad laptop, please do a \"modprobe "
"ibm_acpi\" as root."
msgstr ""
"%1 ne postoji. Ako imate ThinkPad laptop, molimo postavite \"modprobe "
"ibm_acpi\" kao korijen."

#: thinklightplugin.cpp:79
#, kde-format
msgid ""
"%1 cannot be written to. Thinklight plugin could not initialize correctly. "
"Please contact your system administrator."
msgstr ""
"%1 ne može biti napisan. Svjetlosni dodatak se nije mogao inicijalizirati "
"pravilno. Molimo kontaktirate svog sistemskog administratora."

#: thinklightplugin.cpp:91
msgid ""
"The program \"kopete_thinklght_fixpermissons\" failed to start. Please "
"contact your system administrator."
msgstr ""
"Program \"kopete_thinklght_fixpermissons\" se nije uspio pokrenuti. Molimo "
"kontaktirajte svog sistemskog administratora."

#: thinklightplugin.cpp:94
#, kde-format
msgid ""
"The program \"kopete_thinklght_fixpermissons\" failed with error %1. Please "
"contact your system administrator."
msgstr ""
"U programu \"kopete_thinklght_fixpermissons\" došlo je do greške %1. Molimo "
"kontaktirajte svog sistemskog administratora."

