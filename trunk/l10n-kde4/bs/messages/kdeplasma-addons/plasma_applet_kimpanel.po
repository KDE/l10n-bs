#. i18n: file: kimpanelconfig.kcfg:27
#. i18n: ectx: label, entry (FloatingStatusbarLayout), group (Layout)
#: rc.cpp:17
msgid "Expand horizontally."
msgstr "Širenje vodoravno."

#. i18n: file: kimpanelconfig.kcfg:30
#. i18n: ectx: label, entry (FloatingStatusbarLayout), group (Layout)
#: rc.cpp:20
