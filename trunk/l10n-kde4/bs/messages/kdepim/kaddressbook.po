#: contactselectionwidget.cpp:118
msgctxt "@info:whatsthis"
msgid ""
"Choose this option you want to select all your contacts from all your "
"address books."
msgstr ""
"Izaberite ovu opciju ako želite slektovati sve vaše kontakte iz svih vaših "
"adresnih knjiga"

