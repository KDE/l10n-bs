#~ msgid "Default Email Attachment Method"
#~ msgstr "Metoda za podrazumijevani prilog elektronskoj pošti"

#~ msgid "The default way of attaching dropped emails to an event"
#~ msgstr "Podrazumijevani način kačenja ispuštene e-poruke"

#~ msgid "Always ask"
#~ msgstr "Uvijek pitati"

#~ msgid "Only attach link to message"
