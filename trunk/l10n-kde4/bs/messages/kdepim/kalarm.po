#: alarmtimewidget.cpp:52
msgctxt "@info/plain"
msgid ""
"Enter the length of time (in hours and minutes) after the current time to "
"schedule the alarm."
msgstr ""
"Upišite dužinu vremena (u satima i minutama) poslije sadašnjeg vremena da "
"podesite alarm."

