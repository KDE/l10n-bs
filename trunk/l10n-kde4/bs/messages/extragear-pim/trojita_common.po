msgctxt "ImapPage|"
msgid "Timeout of IMAP IDLE"
msgstr "Predah IMAP IDLE"

#: ../src/Gui/SettingsImapPage.ui:279
msgctxt "ImapPage|"
msgid ""
"How often to renew the IDLE session.\n"
"This is useful to prevent timeouts due to broken or overly aggressive "
"network middleboxes,\n"
"NAT gateways and other nasty annoyances.\n"
"The default value is 29 minutes."
msgstr ""
"Koliko često obnoviti IDLE sesiju.\n"
"Ovo je korisno da bi se sprijećio predah tokom pokvarenih ili previše "
"agresivnih mrežnih middlebox-ova,\n"
"NAT portala i drugih neugodnih smetnji.\n"
"Podrazumijevana vrijednost je 29 minuta."

#: ../src/Gui/SettingsImapPage.ui:295
msgctxt "ImapPage|"
msgid "Refresh Interval"
msgstr "Interval osvježavanja"

#: ../src/Gui/SettingsImapPage.ui:302
msgctxt "ImapPage|"
msgid ""
"How often to check for new emails in all IMAP folders.\n"
"The default value is 300 seconds (5 minutes)."
msgstr ""
"Koliko često provjeriti novu poštu u svim IMAP folderima.\n"
"Podrazumijevana vrijednost je 300 sekundi (5 minuta)."

#: ../src/Gui/SettingsImapPage.ui:306
msgctxt "ImapPage|"
msgid " seconds"
msgstr " sekundi"

