#: ../src/Gui/SettingsImapPage.ui:177
msgctxt "ImapPage|"
msgid "Path to Server &Binary"
msgstr "Put do servera &Binarno"

#: ../src/Gui/SettingsImapPage.ui:187
msgctxt "ImapPage|"
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'DejaVu Sans'; font-size:8pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">If you choose the <span "
"style=\" font-style:italic;\">Local process</span> option to connect to the "
"IMAP server, this field specifies the program to start. For example, to "
"connect to a remote mail server via SSH and launch a Dovecot instance in "
"there, you could use the following:</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"family:'Courier New,courier';\">ssh mail.example.org dovecot --exec-mail "
"imap</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Note that this command has "
"to be absolutely non-interactive, and therefore you have to have your SSH "
"set up to login without password, perhaps via the SSH keys.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'DejaVu Sans'; font-size:8pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Ako izaberete <span style="
"\" font-style:italic;\">opciju lokalnog procesa</span> za spajanje na IMAP "
"server, ovo polje specificira početak programa. Naprimjer, za spajanje sa "
"udaljenim mail serverom preko SSH i pokretanje Dovecot instance tamo, možete "
"koristiti sljedeće:</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"family:'Courier New,courier';\">ssh mail.primjer.org dovecot --exec-mail "
"imap</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Imajte na umu da ova "
"naredba mora biti apsolutno neiterativna i za ovo morate imati Vaš SSH "
"postavljen na prijavu bez šifre, možda preko SSH ključeva.</p></body></html>"

