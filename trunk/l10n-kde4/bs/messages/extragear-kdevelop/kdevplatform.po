msgstr ""
"<b>Korak u instrukciju</b><p>Ulazi u narednu asemblersku instrukciju.</p>"

#: shell/debugcontroller.cpp:277
msgid "Step O&ut"
msgstr "Korak iz&van"

#: shell/debugcontroller.cpp:279
msgid "Steps out of the current function"
