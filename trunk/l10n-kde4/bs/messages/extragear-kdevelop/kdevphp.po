#: duchain/builders/declarationbuilder.cpp:321
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "Tip pristupa za interfejsnu metodu %1 se mora ispustiti."

#: duchain/builders/declarationbuilder.cpp:325
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "Interfejsna funkcija %1 ne mođže sadržati tijelo"

#: duchain/builders/declarationbuilder.cpp:337
#, kde-format
msgid ""
"Class %1 contains abstract method %2 and must therefore be declared abstract "
"or implement the method."
msgstr ""
"Klasa %1 sadrži apstraktnu metodu %2pa se mora deklarisati apstraktnom ili "
"implementirati metod."

#: duchain/builders/declarationbuilder.cpp:343
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "Apstraktna funkcija %1 ne može sadržati tijelo."

#: duchain/builders/declarationbuilder.cpp:346
msgid "Cannot use the final modifier on an abstract class member."
msgstr "Ne mogu koristiti final modifikator na apstraktnom članu klase."

#: duchain/builders/declarationbuilder.cpp:356
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "Ne-apstraktna metoda %1 mora sadržati tijelo."

#: duchain/builders/declarationbuilder.cpp:370
msgid "Properties cannot be declared final."
msgstr "Svojstva se ne mogu deklarisati final."

#: duchain/builders/declarationbuilder.cpp:373
msgid "Properties cannot be declared abstract."
msgstr "Svojstva se ne mogu deklarisati abstract."

#: duchain/builders/declarationbuilder.cpp:473
#, kde-format
msgid "Cannot redeclare private property %1 from this context."
msgstr "Ne mogu redeklarisati privatno svojstvo %1 iz ovog konteksta."

#: duchain/builders/declarationbuilder.cpp:479
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr "Ne mogu redeklarisati zaštićeno svojstvo %1 iz ovog konteksta."

#: duchain/builders/declarationbuilder.cpp:512
msgid "Traits cannot have constants."
msgstr "Skup metoda ne može imati konstante."

#: duchain/builders/declarationbuilder.cpp:553
msgid ""
"Only booleans, ints, floats and strings are allowed for class constants."
msgstr ""
"Samo logičke, cjelobrojne, realne i stringovne vrijednosti su dopuštene za "
"konstante klase.."

#: duchain/builders/declarationbuilder.cpp:566
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr ""
"Podrazumijevana vrijednost parametara s savjetom tipa klase može biti samo "
"NULL."

#: duchain/builders/declarationbuilder.cpp:569
msgid "Following parameters must have a default value assigned."
msgstr ""
"Sljedeći parametri moraju imati dodijeljenu podrazumijevanu vrijednost."

#: duchain/builders/declarationbuilder.cpp:676
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "Ne mogu redeklarisati PHP internu %1."

#: duchain/builders/declarationbuilder.cpp:680
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr "Ne mogu redeklarisati %1, već deklarisano u %2 na liniji %3."

#: duchain/builders/declarationbuilder.cpp:726
msgid "Cannot re-assign $this."
msgstr "Ne mogu ponovo dodijeliti $this."

#: duchain/builders/declarationbuilder.cpp:1164
#, kde-format
msgid "The use statement with non-compound name '%1' has no effect."
msgstr "Naredba use sa imenom koje nije složeno '%1' nema efekta."

#: duchain/builders/declarationbuilder.cpp:1188
#, kde-format
msgid "Cannot use '%1' as '%2' because the name is already in use."
msgstr ""

#: duchain/builders/usebuilder.cpp:140
#, kde-format
msgid "Usage of %1 is deprecated."
msgstr "Upotreba %1 je zastarjela."

#: duchain/builders/usebuilder.cpp:142
#, kde-format
msgid "Declaration not found: %1"
msgstr "Deklaracija nije nađena: %1"

