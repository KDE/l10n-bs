#: src/kdesvn.desktop:2
msgctxt "Name"
msgid "kdesvn"
msgstr "kdesvn"

#: src/kdesvn.desktop:22 src/kdesvnpart.desktop:19
msgctxt "GenericName"
msgid "SVN Client"
msgstr "SVN klijent"

#: src/kdesvn.desktop:46 src/kdesvnpart.desktop:42
msgctxt "Comment"
msgid "A Subversion client for KDE"
msgstr "Subversion klijent za KDE"

#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "kdesvnd  subverzija modul"

#: src/kdesvnd/kdesvnd.desktop:20
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr "Daje razne Subversion akcije menadžerima datoteka i drugom softveru"

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:25
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Subverzije zapisnik (zadnji 100)"

#: src/kdesvnd/kdesvn_subversion.desktop:44
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:27
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Prikazi Subverzije zapisnik"

#: src/kdesvnd/kdesvn_subversion.desktop:63
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Detaljna Subverzija info"

#: src/kdesvnd/kdesvn_subversion.desktop:84
msgctxt "Name"
msgid "Add to Repository"
msgstr "Dodaj u repozitorij"

#: src/kdesvnd/kdesvn_subversion.desktop:108
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Provjerite unversioned predmete"

#: src/kdesvnd/kdesvn_subversion.desktop:128
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Briši iz repozitorija"

#: src/kdesvnd/kdesvn_subversion.desktop:150
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Poništi lokalne promjene"

#: src/kdesvnd/kdesvn_subversion.desktop:170
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Ukloni bilo koje promjene napravljene lokalno. Upozorenje - ovo ne može biti "
"ponovno vraćeno."

#: src/kdesvnd/kdesvn_subversion.desktop:190
msgctxt "Name"
msgid "Rename..."
msgstr "Preimenuj..."

#: src/kdesvnd/kdesvn_subversion.desktop:211
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Preimenuj datoteku lokalno i u spremištu. Koristi ovo radije nego dodavanje "
"i brisanje za preimenovanje datoteke."

#: src/kdesvnd/kdesvn_subversion.desktop:231
msgctxt "Name"
msgid "Import Repository"
msgstr "Uvezi spremište"

#: src/kdesvnd/kdesvn_subversion.desktop:251
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr "Stavi direktorij na postojeće spremište radi kontrole revizija."

#: src/kdesvnd/kdesvn_subversion.desktop:271
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:46
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Izdvoji iz spremišta..."

#: src/kdesvnd/kdesvn_subversion.desktop:291
#: src/kdesvnd/kdesvn_subversion.desktop:593
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:66
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:185
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Izdvoji izlazne datoteke sa postojećeg spremišta u ovaj direktorij."

#: src/kdesvnd/kdesvn_subversion.desktop:311
msgctxt "Name"
msgid "Switch..."
msgstr "Prebaci..."

#: src/kdesvnd/kdesvn_subversion.desktop:330
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Prebaci radnu kopiju u drugu granu"

#: src/kdesvnd/kdesvn_subversion.desktop:351
msgctxt "Name"
msgid "Merge..."
msgstr "Spoji..."

#: src/kdesvnd/kdesvn_subversion.desktop:371
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Spoji promjene između ove i drugih grana"

#: src/kdesvnd/kdesvn_subversion.desktop:392
msgctxt "Name"
msgid "Blame..."
msgstr "Okrivi..."

#: src/kdesvnd/kdesvn_subversion.desktop:411
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Pogledaj ko je napisao svaku liniju u datoteci i pod kakvom kontrolom"

#: src/kdesvnd/kdesvn_subversion.desktop:432
msgctxt "Name"
msgid "Create Patch..."
msgstr "Kreiraj zakrpu..."

#: src/kdesvnd/kdesvn_subversion.desktop:454
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:86
msgctxt "Name"
msgid "Export..."
msgstr "Izvezi..."

#: src/kdesvnd/kdesvn_subversion.desktop:475
#: src/kdesvnd/kdesvn_subversion.desktop:631
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:107
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:223
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Izvezi bezverzijsku kopiju stabla iz repozitorija"

#: src/kdesvnd/kdesvn_subversion.desktop:495
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diff (lokalno)"

#: src/kdesvnd/kdesvn_subversion.desktop:515
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Prikaži lokalne promjene nakon zadnjeg ažuriranja"

#: src/kdesvnd/kdesvn_subversion.desktop:535
msgctxt "Name"
msgid "KDESvn Update"
msgstr "KDESvn Azuriranje"

#: src/kdesvnd/kdesvn_subversion.desktop:555
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "KDESvn obavezati"

#: src/kdesvnd/kdesvn_subversion.desktop:575
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:167
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Izdvoji iz spremišta..."

#: src/kdesvnd/kdesvn_subversion.desktop:613
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:205
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Izvoz iz Subversion repozitorija..."

#: src/kdesvnd/kdesvn_subversion.desktop:651
msgctxt "Name"
msgid "Display revision tree"
msgstr "Prikaz stabla revizija"

#: src/kdesvnd/kdesvn_subversion.desktop:669
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Prikazi kompletno revizija stablo"

