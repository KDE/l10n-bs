#: editpatch.cpp:309
#, kde-format
msgid ""
"You are about to unapply a dynamic patch created by the command \"%1\". That "
"can be very dangerous. If the same command will not produce the same text "
"after the unapply, the patch cannot be reapplied and all data may be lost. \n"
"Recommendation: Make the patch a file-patch before unapplying it."
msgstr ""
"Spremate se odjaviti dinamicni sloj kreiran od strane komande \"%1\". To "
"moze biti jako opasno. Ako ista komanda ne proizvede isti tekst nakon "
"odjave, sloj se ne moze ponoviti i svi podaci se mogu izgubiti. \n"
"Preporuka: Napravite sloj fajl-sloj prije odjave."

#: editpatch.cpp:309
#, kde-format
msgid "Warning"
msgstr "Upozorenje"

