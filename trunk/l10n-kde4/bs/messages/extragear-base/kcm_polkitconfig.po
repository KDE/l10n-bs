#: kcmpolkitconfig.cpp:104
#, kde-format
msgid ""
"The changes will have no effect, since another policy has an higher priority "
"(%1). Please change the priority of policies defined through this module to "
"an higher value."
msgstr ""
"Promjene neće imati efekta jer drugo pravilo ima veći prioritet (%1). Molim "
"promijenite prioritet pravila definisan kroz ovaj modul na višu vrijednost."

