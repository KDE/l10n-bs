#: models/kptresourceallocationmodel.cpp:259
msgctxt "@info:whatsthis"
msgid ""
"<title>Required Resources</title><para>A working resource can be assigned to "
"one or more required resources. A required resource is a material resource "
"that the working resource depends on in order to do the work.</para><para>To "
"be able to use a material resource as a required resource, the material "
"resource must be part of a group of type <emphasis>Material</emphasis>.</"
"para>"
msgstr ""
"<title>Potrebni Resursi</title><para> Radni resurs moze biti dodjeljen "
"jednom ili više potrebnih resursa. Potrebni resurs je materijal resurs od "
"kojeg ovisi radni resurs kako bi radio.</para><para>Da bi bio u mogućnosti "
"da koristi material resurs kao potrebni resurs, material resurs mora biti "
"dio grupe tipa <emphasis>Material</emphasis>.</para>"

