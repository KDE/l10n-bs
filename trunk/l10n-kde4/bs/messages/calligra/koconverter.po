#: calligraconverter.cpp:146
msgid "CalligraConverter"
msgstr "Calligra Konverter Dokumenata"

#: calligraconverter.cpp:147
msgid "Calligra Document Converter"
msgstr "Calligra Konverter Dokumenata"

#: calligraconverter.cpp:149
msgid "(c) 2001-2011 Calligra developers"
msgstr "© 2001-2011, razvijači Calligra"

#: calligraconverter.cpp:150
msgid "David Faure"
msgstr "David Faure"

#: calligraconverter.cpp:151
msgid "Nicolas Goutte"
msgstr "Nicolas Goutte"

#: calligraconverter.cpp:152
msgid "Dan Leinir Turthra Jensen"
msgstr "Dan Lejnir Turtra Jensen"

#: calligraconverter.cpp:156
msgid "Input file"
msgstr "Ulazna Datoteka"

#: calligraconverter.cpp:157
msgid "Output file"
msgstr "Izlazna Datoteka"

#: calligraconverter.cpp:158
msgid "Make a backup of the destination file"
msgstr "Napravi rezervnu kopiju odredišne datoteke"

#: calligraconverter.cpp:159
msgid "Batch mode: do not show dialogs"
msgstr "Paketni režim: ne prikazuj dijaloge"

#: calligraconverter.cpp:160
msgid "Interactive mode: show dialogs (default)"
msgstr "Interaktivni režim: prikazuj dijaloge (podrazumevano)"

#: calligraconverter.cpp:161
msgid "Mimetype of the output file"
msgstr "Mimevrsta izlazne datoteke"

#: calligraconverter.cpp:164
msgid "The print orientation. This could be either Portrait or Landscape."
msgstr ""
"Orijentacija štampe. Može biti uspravno (portret) ili položeno (pejzaž)"

#: calligraconverter.cpp:165
msgid "The paper size. A4, Legal, Letter, ..."
msgstr "Veličina papira. A4, Legal, Letter, ..."

#: calligraconverter.cpp:166
msgid "The size of the paper margin. By default this is 0.2."
msgstr "Veličina margine papira. Podrazumijevano to je 0.2."

#: calligraconverter.cpp:178
msgid "Two arguments required"
msgstr "Dva argumenta se zahtijevaju"

#: calligraconverter.cpp:206
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "Mimevrsta za ulaznu datoteku %1 nije nađena!"

#: calligraconverter.cpp:215
#, kde-format
msgid "Mimetype not found %1"
msgstr "Mimevrsta nije nađena %1"

#: calligraconverter.cpp:221
msgid "Mimetype not found, try using the -mimetype option"
msgstr "Mimevrsta nije nađena, pokušaj koristiti mimevrsta opciju"

#: calligraconverter.cpp:245
msgid "*** The conversion failed! ***"
msgstr "*** Konverzija nije uspjela! ***"

