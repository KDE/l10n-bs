#: PlanTJPlugin.cpp:57
msgctxt "@info:whatsthis"
msgid ""
"<title>TaskJuggler Scheduler</title><para>This is a slightly modified "
"version of the scheduler used in TaskJuggler. It has been enhanced to handle "
"resource units.</para><para>Scheduling backwards is simulated by scheduling "
"all tasks as late as possible.</para><para><note>Plan does not utilize all "
"of its functionality.</note></para>"
msgstr ""
"<title>TaskJuggler raspoređivač</title><para>Ovo je pomalo izmijenjena "
"verzija raspoređivača korištenog u TaskJuggler. Poboljšan je da koristi "
"resursne jedinice.</para><para>Raspoređivanje unazad je simulirano "
"raspoređivanjem svih zadataka što kasnije moguće.</para><para><note>Plan ne "
"koristi svu funkcionalnost.</note></para>"

