#: kexidb/drivers/xbase/xbaseexport.cpp:270
msgid "Could not export back to destination database."
msgstr "Ne mogu izvesti nazad u odredišnui bazu podataka"

#: kexidb/drivers/xbase/xbaseexport.cpp:278
#, kde-format
msgid "Could not connect to data source \"%1\"."
msgstr "Nisam mogao da se povežem sa izvorom podataka \"%1\"."

#: kexidb/drivers/xbase/xbaseexport.cpp:306
#, kde-format
msgid "No tables to export found in data source \"%1\"."
msgstr "Nema tabela za umetanje nadjeno u izvoru podataka \"%1\"."

#: kexidb/drivers/xbase/xbaseexport.cpp:323
#, kde-format
msgid ""
"Could not create table in destination database \"%1\". Error reading table "
"\"%2\"."
msgstr ""
"Ne mogu kreirati tabelu u odredišnoj bazi podataka \"%1\". Greška čitanja "
"tabele \"%2\"."

#: kexidb/drivers/xbase/xbaseexport.cpp:333
#, kde-format
msgid "Could not copy table \"%1\" to destination database."
msgstr "Nisam mogao da kopiram tabelu \"%1\" u odredišnu bazu podataka."

#: kexidb/drivers/xbase/xbaseexport.cpp:349
#, kde-format
msgid "Could not export data to \"%1\"."
msgstr "Ne mogu se izvesti podaci u \"%1\"."
