#: plugins/formats/png/kis_wdg_options_png.ui:213
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">PNG</span> files "
"have <span style=\" font-style:italic;\">two</span> options to save <span "
"style=\" font-weight:600;\">sRGB</span> information: as a tag or as an "
"explicit profile. For use with in websites, <span style=\" font-style:italic;"
"\">disable</span> this option. For interchange with other applications, "
"<span style=\" font-style:italic;\">enable</span> this option.</p></body></"
"html>"
msgstr ""
"<html><head/><body><p><span style=\" font-weight:600;\">PNG</span> datoteke "
"imaju <span style=\" font-style:italic;\">dvije</span> opcije za snimanje "
"<span style=\" font-weight:600;\">sRGB</span> informacija: kao oznaku ili "
"kao eksplicitan profil. Za upotrebu na websajtovima, <span style=\" font-"
"style:italic;\">isključite</span> ovu opciju. Za razmjenu s drugim "
"aplikacijama, <span style=\" font-style:italic;\">uključite</span> ovui "
"opciju.</p></body></html>"

