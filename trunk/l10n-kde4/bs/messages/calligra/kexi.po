#: core/kexipart.cpp:285
msgid "Could not create object's window."
msgstr "Ne mogu kreirati objektov prozor."

#: core/kexipart.cpp:285
msgid "The plugin or object definition may be corrupted."
msgstr "Priključak ili definicija objekta može biti oštećeno"

#: core/kexipart.cpp:307
msgid "Could not load object's definition."
msgstr "Nisam uspio da učitam definiciju objekta."

#: core/kexipart.cpp:307
