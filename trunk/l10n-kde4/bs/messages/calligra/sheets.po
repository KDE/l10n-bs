msgstr "DopustitPoravnanje"

#: functions/statistical.xml:1430
msgid ""
"The TREND() function calculates a sequence of values based on a linear "
"regression of known value pairs."
msgstr ""
"TREND() funkcija računa niz vrijednosti na temelju linearne regresije "
"poznatih vrijednosti parova."

#: functions/statistical.xml:1431
msgid "Constraints: COUNT(knownY) = COUNT(knownX)."
msgstr "Ograničenja: COUNT(knownY) = COUNT(knownX)."

#: functions/statistical.xml:1432
msgid "TREND(knownY[;knownX[;newX[;allowOffset = TRUE]]])"
msgstr "TREND(knownY[;knownX[;newX[;allowOffset = TRUE]]])"

#: functions/statistical.xml:1443
msgid "dataSet"
msgstr "dataSet"

#: functions/statistical.xml:1447
msgid "cutOffFraction"
msgstr "cutOffFraction"

#: functions/statistical.xml:1451
msgid "The TRIMMEAN() function calculates the mean of a data set's fraction."
msgstr ""
"TRIMMEAN()  funkcija računa srednju vrijednost skupa frakcija podataka."

#: functions/statistical.xml:1452
msgid "TRIMMEAN(dataSet; cutOffFraction)"
msgstr "TRIMMEAN(dataSet; cutOffFraction)"

#: functions/statistical.xml:1463 functions/statistical.xml:1694
