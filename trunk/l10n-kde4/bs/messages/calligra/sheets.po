msgid "AND(true;true;true) returns True"
msgstr "AND(true;true;true) vraća Tačno"

#: functions/logic.xml:54
msgid "AND(true;false) returns False"
msgstr "AND(true;talse) vraća Netačno"

#: functions/logic.xml:82
msgid ""
"The OR() function returns True if at least one of the values is true. "
"Otherwise it returns False (unless any of the values is an error, then it "
"returns an error)."
msgstr ""
"OR() funkcija vraća Tačno ako je jedna od vrijednosti tačna. Inače vraća "
"Netačno (osim ako bilo koji od vrijednosti je greška,tada vraća grešku)."

