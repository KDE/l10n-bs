msgstr "Funkcija SKEW() vraća procjenu za iskrivljenost distribucije"

#: functions/statistical.xml:1087
msgid "SKEW(number; number2; ...)"
msgstr "SKEW(broj1; broj2; ...)"

#: functions/statistical.xml:1088
