msgstr "Odlazna poruka je poslana"

#: data/ktelepathy.notifyrc:759
msgctxt "Name"
msgid "Highlight"
msgstr "Istaknuto"

#: data/ktelepathy.notifyrc:800
msgctxt "Comment"
