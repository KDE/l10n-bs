msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:42
msgctxt "Comment"
msgid "Instant messaging"
msgstr "Trenutne poruke"

#: data/ktelepathy.notifyrc:83
msgctxt "Name"
msgid "Group"
msgstr "Grupa"

#: data/ktelepathy.notifyrc:123
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Grupa u kojoj kontakt prebivaju"

#: data/ktelepathy.notifyrc:165
msgctxt "Name"
msgid "Contact"
msgstr "Kontakt"

#: data/ktelepathy.notifyrc:205
msgctxt "Comment"
msgid "The specified contact"
msgstr "Određeni kontakt"

#: data/ktelepathy.notifyrc:247
msgctxt "Name"
msgid "Class"
msgstr "Klasa"

#: data/ktelepathy.notifyrc:287
msgctxt "Comment"
msgid "The message class"
