msgid "Interfaces"
msgstr "Sučelja"

#. i18n: ectx: property (whatsThis), widget (QListWidget, listBoxInterfaces)
#: configdlg.ui:31
msgid ""
"This lists the interfaces that you wish to monitor. Please use the names "
"understood by <i>ifconfig</i> ('eth0', 'wlan0', 'ppp0', etc.), or click "
"\"Add all interfaces\" below to include all of the interfaces currently "
"found on your system."
msgstr ""
"<html>Prikazuje sučelja koja želite da nadgledate. Koristite imena koja "
"razume <command>ifconfig</command> (<icode>eth0</icode>, <icode>wlan0</"
"icode>, <icode>ppp0</icode>, itd.), ili kliknite na <interface>Dodaj sva "
"sučelja</interface> da biste uključili sva sučelja koja se trenutno nalaze "
"na vašem sistemu.</html>"

