#: kabcresource.cpp:123
msgctxt "@info:status"
msgid "Changing address book plugin configuration"
msgstr "Mijenjam konfiguraciju dodatka adresara"

#: kabcresource.cpp:144
msgctxt "@info:status"
msgid "Acquiring address book plugin configuration"
msgstr "Nabavljam konfiguraciju dodatka adresara"

#: kabcresource.cpp:152 kabcresource.cpp:190 kabcresource.cpp:367
#: kabcresource.cpp:423 kabcresource.cpp:478 kabcresource.cpp:516
#: kabcresource.cpp:757 kabcresource.cpp:770 kabcresource.cpp:777
msgctxt "@info:status"
msgid "No KDE address book plugin configured yet"
msgstr "Nijedan dodatak KDE adresara nije još uvek konfigurisan"

#: kabcresource.cpp:168
msgctxt "@info:status"
msgid "Initialization based on newly created configuration failed."
msgstr "Pokretanje zasnovano na novostvorenoj konfiguraciji nije uspjelo."

#: kabcresource.cpp:175 kabcresource.cpp:796
msgctxt "@info:status"
msgid "Loading of address book failed."
msgstr "Nisam uspio da učitam adresar."

#: kabcresource.cpp:181 kabcresource.cpp:802
msgctxt "@info:status"
msgid "Loading address book"
msgstr "Učitavam adresar"

#: kabcresource.cpp:314
msgctxt "@info:status"
msgid ""
"Request for data of a specific distribution list failed because there is no "
"such list"
msgstr ""
"Zahtjev za podacima određene liste distribucije nije uspio, jer takva lista "
"ne postoji"

#: kabcresource.cpp:327
msgctxt "@info:status"
msgid ""
"Request for data of a specific address book entry failed because there is no "
"such entry"
msgstr ""
"Zahtjev za podacima određene stavke adresara nije uspio, jer takva stavka ne "
"postoji"

#: kabcresource.cpp:633
msgctxt "@info:status"
msgid ""
"Request for saving the address book failed. Probably locked by another "
"application"
msgstr ""
"Zahtjev za čuvanje adresara nije uspio. Vjerovatno je zaključan nekim drugim "
"programom."

#: kabcresource.cpp:787
msgctxt "@info:status"
msgid "Initialization based on stored configuration failed."
msgstr "Pokretanje zasnovano na sačuvanoj konfiguraciji nije uspjelo."
