#: popsettings.ui:384
msgid "Destination folder:"
msgstr "Odredišni direktorij:"

#. i18n: ectx: property (text), widget (QLabel, preCommandLabel)
#: popsettings.ui:391
msgid "Pre-com&mand:"
msgstr "Predkom&anda"

#. i18n: ectx: property (toolTip), widget (KLineEdit, precommand)
