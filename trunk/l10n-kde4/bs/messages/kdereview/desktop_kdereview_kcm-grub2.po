#: other/kcm_grub2.desktop:12
msgctxt "Name"
msgid "GRUB2 Bootloader"
msgstr "GRUB2 pokretač sistemar"

#: other/kcm_grub2.desktop:27
msgctxt "Comment"
msgid "Customise the GRUB2 bootloader"
msgstr "Podesi GRUB2 pokretač sistema"

#: src/helper/kcmgrub2.actions:2
msgctxt "Name"
msgid "GRUB2 Bootloader Control Module"
msgstr "Kontrolni modul GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:21
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr "Obnovi uobičajene postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:33
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr ""
"Potrebna je administratorska potvrda za obnovu podrazumijevanihpostavki "
"GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:48
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "Instaliraj GRUB2 pokretač sistema"

#: src/helper/kcmgrub2.actions:60
msgctxt "Description"
msgid "Administrator authorization is required to install the GRUB2 Bootloader"
msgstr ""
"Administratorska potvrda je potrebna za instaliranje GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:75
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "Učitaj postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:87
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader settings"
msgstr ""
"Administratorska potvrda je potrebna za čitanje postavki GRUB2 pokretača "
"sistema"

#: src/helper/kcmgrub2.actions:103
msgctxt "Name"
msgid "Probe devices for their GRUB2 names"
msgstr "Testiranje uređaja za njihova GRUB2 imena"

#: src/helper/kcmgrub2.actions:116
msgctxt "Description"
msgid ""
"Administrator authorization is required to probe devices for their GRUB2 "
"names"
msgstr ""
"Administratorska potvrda je potrebna za upit uređaja za njihova GRUB2 imena"

#: src/helper/kcmgrub2.actions:132
msgctxt "Name"
msgid "Probe VESA BIOS Extensions"
msgstr "Ispitaj VESA BIOS proširenja"

#: src/helper/kcmgrub2.actions:144
msgctxt "Description"
msgid "Administrator authorization is required to probe VESA BIOS Extensions"
msgstr ""
"Administratorska potvrda je potrebna za testiranje VESA BIOS proširenja"

#: src/helper/kcmgrub2.actions:160
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "Snimie postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:174
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader settings"
msgstr ""
"Administratorska potvrda je potrebna za snimanje postavki GRUB2 pokretača "
"sistema"
