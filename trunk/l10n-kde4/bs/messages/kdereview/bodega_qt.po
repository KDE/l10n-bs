#: bodega/assetjob.cpp:77
#, qt-format
msgid "%1 Mb"
msgstr "%1 Mb"

#: bodega/assetjob.cpp:79
#, qt-format
msgid "%1 Kb"
msgstr "%1 Kb"

#: bodega/error.cpp:87
msgid "Session Error"
msgstr "Sesijska greška"

#: bodega/error.cpp:91
msgid "Connection failed."
msgstr "Konekcija neuspjela"

#: bodega/error.cpp:94
msgid "The add-ons database could not be reached."
msgstr "Baza dodataka nije mogla biti pronađena"

#: bodega/error.cpp:97
msgid "This account may not perform the requested action."
msgstr "S ovim nalogom se  ne može izvrsiti zahtijevana radnja"

#: bodega/error.cpp:100
msgid "Required information was missing from the request."
msgstr "Obavezni podaci nedostaju u zahtjevu"

#: bodega/error.cpp:103
msgid "Wrong user name or password."
msgstr "Pogresno korisničko ime ili lozinka"

#: bodega/error.cpp:106
msgid "This account is not active."
msgstr "Ovaj nalog nije aktivan"

#: bodega/error.cpp:109
msgid "An account for that email already exists."
msgstr "Nalog za email vec postoji"

#: bodega/error.cpp:112
msgid "Could not purchase the requested item."
msgstr "Ne mogu nabaviti zahtijevanu stavku."

#: bodega/error.cpp:115
msgid "Failed to send email."
msgstr "Neuspješno slanje e-maila."

#: bodega/error.cpp:118
msgid "Failed to change account information."
msgstr "Nije uspjela promjena informacije o računu."

#: bodega/error.cpp:121
msgid "Encryption failed, please try again."
msgstr "Šifriranje nije uspjelo, molimo pokušajte ponovno."

#: bodega/error.cpp:124
msgid "The password is too short, please try again."
msgstr "Lozinka je prekratka, molimo pokušajte ponovo."

#: bodega/error.cpp:127 bodega/error.cpp:130
msgid "Could not complete the download of the requested item."
msgstr "Nije moguće dovršiti preuzimanje tražene stavke."

#: bodega/error.cpp:133
msgid "The supplied points code was not valid."
msgstr "Isporučena tačka  koda nije važeća."

#: bodega/error.cpp:137 bodega/error.cpp:141 bodega/error.cpp:145
#: bodega/error.cpp:149
msgid "Payment Method Error"
msgstr "Greska u  načinu plaćanja"

#: bodega/error.cpp:138 bodega/error.cpp:142 bodega/error.cpp:146
msgid "Failed to update purchase method details."
msgstr "Nije uspjelo ažuriranje detalja nacina kupovine."

#: bodega/error.cpp:150
msgid ""
"A valid payment method could not be found. Please add a payment method to "
"your account."
msgstr ""
"Važeći način plaćanja nije mogao biti pronađen. Dodajte način plaćanja na "
"svoj račun."

#: bodega/error.cpp:153
msgid "Purchase Method Error"
msgstr "Greška nacina kupovine"

#: bodega/error.cpp:154
msgid "No purchase method (e.g. credit card) information found."
msgstr "Nema nađenih informacija o metodi kupovine (npr. kreditne kartice)"

#: bodega/error.cpp:157
msgid "Could not locate the requested customer account."
msgstr "Nije moguće naći zahtijevani potrošački račun."

#: bodega/error.cpp:161 bodega/error.cpp:165 bodega/error.cpp:182
#: bodega/error.cpp:188 bodega/error.cpp:193 bodega/error.cpp:198
#: bodega/error.cpp:203 bodega/error.cpp:208 bodega/error.cpp:213
#: bodega/error.cpp:218 bodega/error.cpp:223 bodega/error.cpp:227
#: bodega/error.cpp:231
msgid "Transaction Error"
msgstr "Greška pri transakciji"

#: bodega/error.cpp:162
msgid ""
"Unable to complete the purchase process. No charge was made to your card."
msgstr ""
"Nije moguće završiti proces kupovine.Na vašoj kartici nije napravljeno "
"zaduženje."

#: bodega/error.cpp:166
msgid ""
"Transaction was successful, but could not record the result on the account"
msgstr "Transakcija je bila uspješna, ali nije zabilježeni rezultat na račun"

#: bodega/error.cpp:169
msgid "Purchase Error"
msgstr "Greška pri kupovini"

#: bodega/error.cpp:170
msgid "Your account lacks enough points to make this purchase."
msgstr "Vaš račun nema dovoljno bodova da bi napravili ovu kupovinu."

#: bodega/error.cpp:173 bodega/error.cpp:177
msgid "Creation Error"
msgstr "Greška pri stvaranju"

#: bodega/error.cpp:174
msgid "The collection already exists."
msgstr "Kolekcija vec postoji"

#: bodega/error.cpp:178
msgid "The asset already exists."
msgstr "Sredstva već postoje."

#: bodega/error.cpp:183
msgid "Your card has been declined. Please try another payment method"
msgstr "Vaša kartica je odbijena. Molimo Vas da se za drugačiji način plaćanja"

#: bodega/error.cpp:189
msgid "The card number supplied is incorrect. Please check it and try again."
msgstr ""
"Broj kartice isporučen je netačno. Molimo provjerite je i pokušajte ponovo."

#: bodega/error.cpp:194
msgid "The card expiry month supplied is incorrect."
msgstr "Mjesec isteka kartice je netačan."

#: bodega/error.cpp:199
msgid "The card expiry year supplied is incorrect."
msgstr "Godina isteka kartice je netačna."

#: bodega/error.cpp:204
msgid "The card CVC supplied is incorrect."
msgstr "CVC kartice je netačan"

#: bodega/error.cpp:209
msgid "Your card has expired. Please try another payment method."
msgstr "Vaša kartica je istekla. Pokušajte drugi način plaćanja."

#: bodega/error.cpp:214
msgid "The purchase amount was invalid. Please try again."
msgstr "Iznos kupovine je nevažeći. Pokušajte ponovno."

#: bodega/error.cpp:219
msgid "This transaction was already processed."
msgstr "Ova transakcija je već obrađena."

#: bodega/error.cpp:224
msgid "A processing error occured when making the purchase. Please try again."
msgstr "Greška prilikom obrade  kupovine. Pokušajte ponovno."

#: bodega/error.cpp:228
msgid ""
"Too few points were requested. A minimum of 500 points per purchase is "
"required."
msgstr ""
"Premalo bodova je traženo. Najmanje 500 bodova po kupovini je potrebno."

#: bodega/error.cpp:232
msgid "Too many points were requested. Please purchase fewer points."
msgstr "Previše bodova je traženo. Molimo Vas da kupite manje poena."

#: bodega/error.cpp:237
msgid "An unknown error occurred."
msgstr "Desila se nepoznata greška."

#: bodega/historymodel.cpp:60
msgid "No events for this account. Go download something interesting! :)"
msgstr "Nema događaja za ovaj račun. Preuzmite nešto zanimljivo! :)"

#: bodega/historymodel.cpp:175
#, qt-format
msgid "Downloaded %1"
msgstr "Preuzeto %1"

#: bodega/historymodel.cpp:177
#, qt-format
msgid "Purchased %1"
msgstr "Kupljeno %1"

#: bodega/historymodel.cpp:179
#, qt-format
msgid "Added %1 points"
msgstr "Dodano %1 poena"

#: bodega/networkjob.cpp:103
msgid "Invalid response from the server"
msgstr "Pogrešan odgovor sa servera"

#: bodega/networkjob.cpp:104
msgid "Server has sent an invalid response."
msgstr "Server je poslao nevažeći odgovor."

#: bodega/networkjob.cpp:128
msgid "Download error"
msgstr "Greška u preuzimanju"

#: bodega/networkjob.cpp:129
msgid "Error downloading the asset."
msgstr "Greška pri preuzimanju sredstva."

#: bodega/networkjob.cpp:177
msgid "Network Error"
msgstr "Mrežna greška"

#: bodega/networkjob.cpp:213
msgid "Authentication Error"
msgstr "Greška pri autentifikaciji"

#: bodega/networkjob.cpp:214
msgid "Invalid username or password"
msgstr "Netačno korisničko ime ili šifra"

