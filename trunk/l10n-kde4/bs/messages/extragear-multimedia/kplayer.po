msgstr "Opcija za određivanje donje granice postavke obojenosti slike."

#. i18n: ectx: property (toolTip), widget (QLabel, l_hue_maximum)
#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_hue_maximum)
#: kplayersettingshue.ui:100 kplayersettingshue.ui:134
msgid "Upper limit on the video hue"
msgstr "Gornja granica obojenosti"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_hue_maximum)
#. i18n: ectx: property (whatsThis), widget (KIntSpinBox, c_hue_maximum)
#: kplayersettingshue.ui:103 kplayersettingshue.ui:137
msgid "Option to specify an upper limit on the video hue setting."
msgstr "Opcija za određivanje gornje granice postavke obojenosti slike."

#. i18n: ectx: property (toolTip), widget (QLabel, l_hue_step)
#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_hue_step)
#: kplayersettingshue.ui:156 kplayersettingshue.ui:190
msgid "Amount of adjustment to video hue when using Increase/Decrease commands"
msgstr "Korak podešavanja obojenosti kada se koristi naredba Povećaj/Smanji"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_hue_step)
#. i18n: ectx: property (whatsThis), widget (KIntSpinBox, c_hue_step)
#: kplayersettingshue.ui:159 kplayersettingshue.ui:193
msgid ""
"Option to specify the amount by which to change video hue when using "
