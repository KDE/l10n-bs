msgstr "Početna veličina ili proporcija video prikaza"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_display_size)
#. i18n: ectx: property (whatsThis), widget (QComboBox, c_display_size)
#. i18n: ectx: property (whatsThis), widget (KLineEdit, c_display_width)
