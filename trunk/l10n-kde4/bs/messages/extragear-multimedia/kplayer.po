#: kplayer.cpp:467 kplayerplaylist.cpp:99
msgid "Playlist"
msgstr "Lista puštanja"

#: kplayer.cpp:468 kplayerengine.cpp:606 kplayersettingsdialog.cpp:95
msgid "Progress"
