#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_recent_menu_size)
#: kplayersettingsgeneral.ui:115 kplayersettingsgeneral.ui:155
msgid "Maximum number of entries on the Play Recent menu"
msgstr "Najveći broj stavki u meniju nedavnih datoteka"

