msgstr ""
"Naredba <interface>Nametni proporciju 4:3</interface> uključuje ili "
"isključuje opciju za očuvanje proporcije videa u odnosu četiri prema tri."

#: kplayerengine.cpp:749
msgid "Force 1&6-to-9 Aspect"
msgstr "Nametni proporciju 1&6:9"

#: kplayerengine.cpp:750
msgid "Sets a 16-to-9 video aspect ratio"
msgstr "Postavlja proporciju na 16:9"

#: kplayerengine.cpp:751
