#: kplayer.cpp:469 kplayerengine.cpp:615 kplayerengine.cpp:622
#: kplayersettingsdialog.cpp:101
msgid "Volume"
msgstr "Jačina zvuka"

#: kplayer.cpp:470 kplayerengine.cpp:836 kplayerengine.cpp:864
#: kplayersettingsdialog.cpp:107
msgid "Contrast"
