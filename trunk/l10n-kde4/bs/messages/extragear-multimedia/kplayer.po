msgstr "Bira %1 titl"

#: kplayerengine.cpp:953
#, kde-format
msgid "The 'Subtitles %1' command switches to the selected subtitle track."
msgstr "Naredba „Titlovi %1“ prebacuje na izabrane titlove."

