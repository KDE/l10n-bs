#. i18n: ectx: property (toolTip), widget (QCheckBox, c_doublebuffering)
#: kplayersettingsvideo.ui:258
msgid "Enable double buffering for video output"
msgstr "Uključuje dvostruko baferisanje video izlaza"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_doublebuffering)
#: kplayersettingsvideo.ui:261
msgid ""
"Option to choose whether double buffering should be used for video output. "
"This option is recommended, it gives smoother display in many cases."
msgstr ""
"Opcija kojom birate da li će se koristiti dvostruko baferisanje za video "
"izlaz. Ova opcija je preporučljiva jer daje glatkiji prikaz u većini "
"slučajeva."

#. i18n: ectx: property (text), widget (QCheckBox, c_doublebuffering)
#: kplayersettingsvideo.ui:264
msgid "Enable do&uble buffering"
msgstr "Uključi dvostr&uko baferisanje"

#. i18n: ectx: property (toolTip), widget (QCheckBox, c_direct_rendering)
#: kplayersettingsvideo.ui:271
msgid "Enable direct rendering for video output"
msgstr "Uključuje direktno renderovanje za video izlaz"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, c_direct_rendering)
#: kplayersettingsvideo.ui:274
msgid ""
"Option to choose whether direct rendering should be used for video output. "
"This option may give performance improvement, but may also cause video "
"display problems, for example when used along with double buffering option "
"or when playing with subtitles."
msgstr ""
"Opcija kojom birate da li će direktno renderovanje biti korišćeno za video "
"izlaz. Ova opcija može donijeti poboljšanja karakteristika ali takođe može "
"izazvati i probleme sa prikazivanjem slike, na primjer kada se koristi "
"zajedno sa dvostrukim baferisanjem ili kada se prikazuju titlovi."

#. i18n: ectx: property (text), widget (QCheckBox, c_direct_rendering)
#: kplayersettingsvideo.ui:277
msgid "Enable direc&t rendering"
msgstr "Uključi direk&tno renderovanje"

#. i18n: ectx: property (toolTip), widget (QLabel, l_volume_minimum)
#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_volume_minimum)
#: kplayersettingsvolume.ui:47 kplayersettingsvolume.ui:81
msgid "Lower limit on the sound volume"
msgstr "Donja granica jačine zvuka"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_volume_minimum)
#. i18n: ectx: property (whatsThis), widget (KIntSpinBox, c_volume_minimum)
#: kplayersettingsvolume.ui:50 kplayersettingsvolume.ui:84
msgid "Option to specify a lower limit on the sound volume setting."
msgstr "Opcija koja određuje donju granicu postavke jačine zvuka."

#. i18n: ectx: property (toolTip), widget (QLabel, l_volume_maximum)
#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_volume_maximum)
#: kplayersettingsvolume.ui:100 kplayersettingsvolume.ui:134
msgid "Upper limit on the sound volume"
msgstr "Gornja granica jačine zvuka"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_volume_maximum)
#. i18n: ectx: property (whatsThis), widget (KIntSpinBox, c_volume_maximum)
#: kplayersettingsvolume.ui:103 kplayersettingsvolume.ui:137
msgid "Option to specify an upper limit on the sound volume setting."
msgstr "Opcija koja određuje gornju granicu postavke jačine zvuka."

#. i18n: ectx: property (toolTip), widget (QLabel, l_volume_step)
#. i18n: ectx: property (toolTip), widget (KIntSpinBox, c_volume_step)
#: kplayersettingsvolume.ui:156 kplayersettingsvolume.ui:190
msgid ""
"Amount of adjustment to sound volume when using Increase/Decrease commands"
msgstr "Korak podešavanja jačine zvuka kada se koristi naredba Povećaj/Smanji"

#. i18n: ectx: property (whatsThis), widget (QLabel, l_volume_step)
#. i18n: ectx: property (whatsThis), widget (KIntSpinBox, c_volume_step)
#: kplayersettingsvolume.ui:159 kplayersettingsvolume.ui:193
msgid ""
"Option to specify the amount by which to change sound volume when using "
"Increase/Decrease Volume commands on Player/Audio menu or the corresponding "
"keyboard shortcuts."
msgstr ""
"Opcija koja određuje za koliko će se mijenjati jačina zvuka kada se koriste "
"naredbe Povećaj/Smanji jačinu zvuka iz menija Plejer/Audio ili odgovarajuća "
"prečica sa tastature."

