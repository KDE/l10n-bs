#: kcm_krfb.cpp:176
msgid ""
"<h1>Desktop Sharing</h1> This module allows you to configure the KDE desktop "
"sharing."
msgstr ""
"<h1>Dijeljenje radne površine</h1> Ovaj modul dozvoljava Vam da "
"konfigurišete KDE dijeljenje radne površine."

#~ msgid "Acc&ess"
#~ msgstr "Pr&istupi"

#~ msgid "Invitations"
#~ msgstr "Pozivnice"

#~ msgid "You have no open invitations."
#~ msgstr "Nemate otvorenih poziva."

#~ msgid "Create && &Manage Invitations..."
#~ msgstr "Kreiraj && &Upravljaj pozivima..."

#~ msgid "Click to view or delete the open invitations."
#~ msgstr "Kliknite ovdje da pogledate ili obrišete otvorene pozive."

#~ msgid "Uninvited Connections"
#~ msgstr "Nepozvane veze"

#~ msgid "Allow &uninvited connections"
#~ msgstr "Dozvoli &nepozvane veze"

#~ msgid ""
#~ "Select this option to allow connecting without inviting. This is useful "
#~ "if you want to access your desktop remotely."
#~ msgstr ""
#~ "Odaberite ovu opciju kako bi se omogućilo povezivanje bez poziva. Ovo je "
#~ "korisno ako želite pristup radnoj površini na daljinu."

#~ msgid "Announce service &on the network"
#~ msgstr "Objavi usluge i na mreži"

#~ msgid ""
#~ "If you allow uninvited connections and enable this option, Desktop "
#~ "Sharing will announce the service and your identity on the local network, "
#~ "so people can find you and your computer."
#~ msgstr ""
#~ "Ako dozvolite nepozvane veze i uključite ovu opciju, dijeljenje radne "
#~ "površine će to saopštiti servisu i objaviti vaš identitet na lokalnoj "
#~ "mreži, tako da ljudi mogu pronaći vas i vaš računar."

#~ msgid "Confirm uninvited connections &before accepting"
#~ msgstr "Potvrdi nepozvane veze &prije prihvaćanja"

#~ msgid ""
#~ "If enabled, a dialog will appear when somebody attempts to connect, "
#~ "asking you whether you want to accept the connection."
#~ msgstr ""
#~ "Ako je omogućeno, dijalog će se pojaviti kada se netko pokuša spojiti u "
#~ "vezu i pitati vas pitati želite li prihvatiti vezu."

#~ msgid "A&llow uninvited connections to control the desktop"
#~ msgstr "Dozvoli nepozvanim vezama da kontrolišu radnu površinu"

#~ msgid ""
#~ "Enable this option to allow uninvited user to control your desktop (using "
#~ "mouse and keyboard)."
#~ msgstr ""
#~ "Uključite ovu opciju kako bi se omogućilo nepozvanom korisniku da "
#~ "kontroliše vaš desktop (pomoću miša i tastature)."

#~ msgid "Pass&word:"
#~ msgstr "Lo&zinka:"

#~ msgid ""
#~ "If you allow uninvited connections, it is highly recommended to set a "
#~ "password in order to protect your computer from unauthorized access."
#~ msgstr ""
#~ "Ako dozvolite nepozvane veze, veoma je preporučljivo da postavite lozinku "
#~ "kako bi zaštitili svoj računar od neovlaštenog pristupa."

#~ msgid "&Session"
#~ msgstr "&Sesija"

#~ msgid "Session Preferences"
#~ msgstr "Postavke sesije"

#~ msgid "Always disable &background image"
#~ msgstr "Uvijek onemogućiti &pozadinsku sliku"

#~ msgid ""
#~ "Check this option to always disable the background image during a remote "
#~ "session. Otherwise the client decides whether the background will be "
#~ "enabled or disabled."
#~ msgstr ""
#~ "Uključite ovu opciju kako biste onemogućili pozadinsku sliku prilikom "
#~ "izvršavanja radnje koja je u dalekoj vezi. U suprotnom, klijent odlučuje "
#~ "da li će pozadina biti omogućena ili ne."

#~ msgid "&Network"
#~ msgstr "&Mreža"

#~ msgid "Network Port"
#~ msgstr "Mrežni port"

#~ msgid "Assi&gn port automatically"
#~ msgstr "Dodi&jeli port automatski"

#~ msgid ""
#~ "Check this option to assign the network port automatically. This is "
#~ "recommended unless your network setup requires you to use a fixed port, "
#~ "for example because of a firewall."
#~ msgstr ""
#~ "Uključite ovu opciju da biste dodijelili mrežni port automatski. To je "
#~ "preporučljivo osim ako podešavanje vaše mreže zahtijeva od vas da "
#~ "koristite fiksni port, na primjer zbog zaštite."

#~ msgid "P&ort:"
#~ msgstr "P&ort:"

#~ msgid "Enter the TCP port number here"
#~ msgstr "Unesite broj porta TCP ovdje"

#~ msgid ""
#~ "Use this field to set a static port number for the desktop sharing "
#~ "service. Note that if the port is already in use the Desktop Sharing "
#~ "service will not be accessible until you free it. It is recommended to "
#~ "assign the port automatically unless you know what you are doing.\n"
#~ "Most VNC clients use a display number instead of the actual port. This "
#~ "display number is the offset to port 5900, so port 5901 has the display "
#~ "number 1."
#~ msgstr ""
#~ "Koristite ovo polje da postavite statički broj porta za uslugu dijeljenja "
#~ "radne površine. Imajte na umu da, ako je port već u upotrebi, servis "
#~ "dijeljenja radne površine neće biti dostupan dok ga ne oslobodite. "
#~ "Preporučuje se da se port odredi automatski, osim ako znate šta radite.\n"
#~ "Većina VCN klijenata koristi prikaz broja umjesto samog porta. Ovaj "
#~ "prikaz broja je nadoknada na port 5900, tako da port 5901 ima prikaz broj "
#~ "1."
