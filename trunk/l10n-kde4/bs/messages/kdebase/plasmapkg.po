#: main.cpp:40
msgid "Install, list, remove Plasma packages"
msgstr "Instaliranje, nabrajanje, uklanjanje plasma paketa"

#: main.cpp:79
msgid "Package types that are installable with this tool:"
msgstr "Tipovi paketa koji se mogu instalisati ovim alatom"

#: main.cpp:80
msgid "Built in:"
msgstr "Ugrađeno:"

#: main.cpp:81
msgid "    dataengine: Plasma DataEngine plugin"
msgstr "    dataengine: Plasma DataEngine dodatak"

#: main.cpp:82
msgid "    layout-template: Plasma containment and widget layout script"
msgstr "    layout-template: Skripta za Plasma sadržaj i raspored kontrola"

#: main.cpp:83
msgid "    plasmoid: Plasma widget"
msgstr "    plasmoid: Plasma grafička kontrola"

#: main.cpp:84
msgid "    runner: Search plugin (KRunner, etc)"
msgstr "    runner: Dodatak pretraživač (KRunner, itd)"

#: main.cpp:85
msgid "    theme: Plasma SVG theme"
msgstr "    theme: Plasma SVG tema"

#: main.cpp:86
msgid "    wallpaper: Image pack for use with wallpaper backgrounds"
msgstr "    wallpaper: Paket slika za korišćenje za pozadine"

#: main.cpp:87
msgid "    wallpaperplugin: Wallpaper plugin"
msgstr "    wallpaperplugin: Dodatak za pozadinske slike"

#: main.cpp:92
msgid "Provided by plugins:"
msgstr "Navedeni dodaci:"

#: main.cpp:96 main.cpp:111
#, kde-format
msgctxt ""
"Plugin name and the kind of Plasma related content it provides, both from "
"the plugin's desktop file"
msgid "    %1: %2"
msgstr "    %1: %2"

#: main.cpp:102
msgid "Provided by .desktop files:"
msgstr "Dato preko .desktop datoteka:"

#: main.cpp:118
msgid "Plasma Package Manager"
msgstr "Plasmin menadžer paketa"

#: main.cpp:120
msgid "(C) 2008, Aaron Seigo"
msgstr "© 2008, Aron Dž. Sajgo"

#: main.cpp:121
msgid "Aaron Seigo"
msgstr "Aron Dž. Sajgo"

#: main.cpp:122
msgid "Original author"
msgstr "prvobitni autor"

#: main.cpp:131
msgid "For install or remove, operates on packages installed for all users."
msgstr ""
"Pri instaliranju ili uklanjanju, radi nad paketima instaliranim za sve "
"korisnike."

#: main.cpp:137
msgctxt ""
"theme, wallpaper, etc. are keywords, but they may be translated, as both "
"versions are recognized by the application (if translated, should be same as "
"messages with 'package type' context below)"
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, dataengine, runner, "
"layout-template, etc."
msgstr ""
"Tip paketa, jedno od: plasmoid theme wallpaper dataengine runner layout-"
"template"

#: main.cpp:141
msgctxt "Do not translate <path>"
msgid "Install the package at <path>"
msgstr "Instaliraj paket s date putanje"

#: main.cpp:143
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "Nadogradi paket s date putanje"

#: main.cpp:145
msgid "List installed packages"
msgstr "Nabroji instalirane pakete"

#: main.cpp:146
msgid "lists all known Package types that can be installed"
msgstr "prikazuje sve poznate tipove paketa koji se mogu instalisati"

#: main.cpp:148
msgctxt "Do not translate <name>"
msgid "Remove the package named <name>"
msgstr "Ukloni paket po imenu"

#: main.cpp:150
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr ""
"Apsolutna putanja do korijena paketa. Ako se ne zada, traži se po "
"standardnim direktorijumima u ovoj sesiji KDE‑a."

