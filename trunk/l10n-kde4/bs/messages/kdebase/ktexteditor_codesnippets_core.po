#: completionmodel.cpp:137 completionmodel.cpp:259
#, kde-format
msgid ""
"<qt>The error <b>%4</b><br /> has been detected in the file %1 at %2/%3</qt>"
msgstr "<qt>Otkrivena je greška <b>%4</b><br />u datoteci %1 kod %2:%3</qt>"

#: completionmodel.cpp:142 completionmodel.cpp:264
#, kde-format
msgid "Unable to open %1"
msgstr "Ne mogu da otvorim %1"

#: completionmodel.cpp:147 completionmodel.cpp:269
#, kde-format
msgid "Not a valid snippet file: %1"
msgstr "%1 nije dobra datoteka isječaka."

#: completionmodel.cpp:337 completionmodel.cpp:980
msgid "Snippets"
msgstr "Isječci"

#: completionmodel.cpp:552
msgid ""
"You have edited a data file not located in your personal data directory, but "
"a suitable filename could not be generated for storing a clone of the file "
"within your personal data directory."
msgstr ""
"Uređivali ste datoteku izvan svog ličnog direktorija podataka, ali se ne "
"može načiniti pogodno ime datoteke za skladištenje klona datoteke unutar "
"vašeg ličnog firektorija podataka."

#: completionmodel.cpp:554
msgid ""
"You have edited a data file not located in your personal data directory; as "
"such, a renamed clone of the original data file has been created within your "
"personal data directory."
msgstr ""
"Uređivali ste datoteku izvan svog ličnog direktorija podataka, zbog čega je "
"preimenovani klon izvorne datoeke upisan u vaš lični direktorij podataka."

#: completionmodel.cpp:560 completionmodel.cpp:597
#, kde-format
msgid "Output file '%1' could not be opened for writing"
msgstr "Izlazna datoteka %1ne može da se otvori za pisanje."

#: completionmodel.cpp:591
msgid ""
"It was not possible to create a unique file name for the given snippet "
"collection name"
msgstr ""
"Nije bilo moguće načiniti jedinstveno ime datoteke za dato ime zbirke "
"isječaka."

#: completionmodel.cpp:750
msgid "New Snippet"
msgstr "Novi isječak"

#. i18n: file: snippet_repository.ui:17
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:3
msgid "Snippet Repository:"
msgstr "Riznica isječaka:"

#. i18n: file: snippet_repository.ui:34
#. i18n: ectx: property (text), widget (KPushButton, btnNew)
#: rc.cpp:6
msgid "New Snippet File..."
msgstr "Nova datoteka isječka..."

#. i18n: file: snippet_repository.ui:41
#. i18n: ectx: property (text), widget (KPushButton, btnGHNS)
#: rc.cpp:9
msgid "Get New Snippets..."
msgstr "Dobavi nove isječke..."

#. i18n: file: snippet_repository.ui:53
#. i18n: ectx: property (text), widget (KPushButton, btnCopy)
#: rc.cpp:12
msgid "Copy to repository"
msgstr "Kopiraj u riznicu"

#: repository.cpp:181
msgid "all file types"
msgstr "svi tipovi datoteka"

#: repository.cpp:185
#, kde-format
msgid "!TAINTED!:%1"
msgstr "искварен: %1"

#: repository.cpp:195
#, kde-format
msgid ""
"%1 (%2)\n"
"content license: %3\n"
"repository license: %4 authors: %5"
msgstr ""
"%1 (%2)\n"
"licenca sadržaja: %3\n"
"licenca riznice: %4; autori: %5"

#: repository.cpp:356
#, kde-format
msgid ""
"Do you really want to delete the file '%1' from the repository? This action "
"is irreversible."
msgstr ""
"Želite li zaista da obrišete datoteku %1iz riznice? Ova radnja je neopoziva."

#: repository.cpp:357
msgid "Deleting snippet file"
msgstr "Brisanje datoteke isječka"

#: repository.cpp:367
#, kde-format
msgid ""
"Editor application for file '%1' with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"Uređivački program za datoteku %1sa MIME tipom application/x-ktesnippets ne "
"može da se pokrene."

#: repository.cpp:394 repository.cpp:401 repository.cpp:557 repository.cpp:585
msgid ""
"Editor application for new file with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"Uređivački program za novu datoteku sa MIME tipom application/x-ktesnippets "
"ne može da se pokrene."

#: repository.cpp:409
msgid "No file specified"
msgstr "Nijedna datoteka nije navedena"

#: repository.cpp:423
msgid "It was not possible to create a unique file name for the imported file"
msgstr ""
"Nije bilo moguće načiniti jedinstveno ime datoteke za uvezenu datoteku."

#: repository.cpp:426
msgid "Imported file has been renamed because of a name conflict"
msgstr "Uvezena datoteka je preimenovana zbog sukoba u imenu."

#: repository.cpp:433
msgid "File could not be copied to repository"
msgstr "Datoteka ne može da se kopira u riznicu."
