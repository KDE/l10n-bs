#: boardwidget.cpp:411
msgid "Undo operation done successfully."
msgstr "Poništavanje poteza uspješno dovršeno."

#: boardwidget.cpp:415
msgid "What do you want to undo? You have done nothing!"
msgstr "Šta želite poništiti? Niste još ništa ni učinili!"

#: boardwidget.cpp:434
msgid "Sorry, you have lost the game."
msgstr "Žao mi je, izgubili ste!"

#: boardwidget.cpp:479
msgid "Demo mode. Click mousebutton to stop."
msgstr "Demo način. Kliknite mišem za kraj."

#: boardwidget.cpp:488
msgid "Now it is you again."
msgstr "Opet ste vi na redu."

#: boardwidget.cpp:511
msgid "Your computer has lost the game."
msgstr "Računar je izgubio."

#: boardwidget.cpp:606
msgid "Congratulations. You have won!"
msgstr "Čestitam. Pobjedili ste!"

#: boardwidget.cpp:653
msgid "Calculating new game..."
msgstr "Namještam novu igru..."

#: boardwidget.cpp:658
msgid "Error converting board information!"
msgstr "Greška prilikom pretvaranja podataka sa ploče"

#: boardwidget.cpp:684
msgid "Ready. Now it is your turn."
msgstr "Spreman. Sada je vaš red."

#: boardwidget.cpp:692
msgid "Error generating new game!"
msgstr "Greška prilikom stvaranja nove igre!"

#: boardwidget.cpp:853
msgid "Game over: You have no moves left."
msgstr "Igra je gotova: Nemate više niti jedan potez"

