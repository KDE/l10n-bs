msgstr "Novac koji je posuđen ili posuđivanje novca"

#. i18n: ectx: property (text), widget (QLabel, TextLabel3_2)
#: kmymoney/wizards/newloanwizard/lendborrowwizardpagedecl.ui:19
msgid ""
"\n"
"Do you borrow or lend money?"
msgstr ""
"\n"
"Da li posuđujete novac za sebe ili ga posuđujete nekome ?"

#: kmymoney/wizards/newloanwizard/loanamountwizardpage.cpp:64
msgid ""
"Please enter the original loan amount in the field below or leave it empty "
"to be calculated."
msgstr ""
"Molimo unesite originalni iznos kredita u polje ispod ili ga ostavite prazno "
"da se izračuna."

#: kmymoney/wizards/newloanwizard/loanamountwizardpage.cpp:68
msgid ""
"Please enter the remaining loan amount of last years final statement in the "
"field below. You should not leave this field empty."
msgstr ""
"Molimo unesite preostali iznos kredita od posljednjih godina zadnjeg izvoda "
"u polje ispod. Ne biste trebali ostaviti ovo polje prazno."

#: kmymoney/wizards/newloanwizard/namewizardpage.cpp:52
msgid "To whom do you make payments?"
msgstr "Za koga da vršite uplate?"

#: kmymoney/wizards/newloanwizard/namewizardpage.cpp:53
msgid "Payments to"
msgstr "Plaćanja za"

#: kmymoney/wizards/newloanwizard/namewizardpage.cpp:55
msgid "From whom do you expect payments?"
msgstr "Od koga očekujete plaćanja?"

#: kmymoney/wizards/newloanwizard/namewizardpage.cpp:56
