msgstr "sat sa vodećom nulom (00..23 ili 01..12 ako je AM/PM prikazano)"

#: timestamp.cpp:186
msgid "the minute without a leading zero (0..59)"
msgstr "minuta bez vodeće nule (0..59)"

#: timestamp.cpp:188
msgid "the minute with a leading zero (00..59)"
msgstr "minuta sa vodećom nulom (00..59)"

#: timestamp.cpp:190
msgid "the second without a leading zero (0..59)"
msgstr "sekunda bez vodeće nule (0..59)"

#: timestamp.cpp:192
msgid "the second with a leading zero (00..59)"
msgstr "sekunda sa vodećom nulom (00..59)"

#: timestamp.cpp:194
msgid "the milliseconds without leading zeroes (0..999)"
msgstr "milisekunde bez vodećih nula (0..999)"

#: timestamp.cpp:196
msgid "the milliseconds with leading zeroes (000..999)"
msgstr "milisekunde sa vodećim nulama (000..999)"

#: timestamp.cpp:198
msgid "use AM/PM display. AP will be replaced by either \"AM\" or \"PM\""
msgstr "koristi AM/PM prikaz. AP će biti zamjenjeno sa \"AM\" ili \"PM\""

