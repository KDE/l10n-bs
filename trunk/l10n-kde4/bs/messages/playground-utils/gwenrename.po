#. i18n: ectx: property (title), widget (QGroupBox, groupBox2_2)
#: timestamp.cpp:146 timestamp.ui:95
msgid "Date Format"
msgstr "Format datuma"

#: timestamp.cpp:148
msgid "These expressions may be used for the date:"
msgstr "Ovi izrazi se mogu koristiti za datum:"

#: timestamp.cpp:150 timestamp.cpp:178
msgid "Expression"
msgstr "Izraz"

#: timestamp.cpp:152 timestamp.cpp:180
msgid "Output"
msgstr "Izlaz"

#: timestamp.cpp:154
msgid "the day as number without a leading zero (1-31)"
msgstr "dan kao broj bez vodeće nule (1-31)"

#: timestamp.cpp:156
msgid "the day as number with a leading zero (01-31)"
msgstr "dan kao broj sa vodećom nulom (01-31)"

#: timestamp.cpp:158
msgid "the abbreviated localized day name (e.g. 'Mon'..'Sun')"
msgstr "skraćeno lokalizovano ime dana  (npr. 'Pon'..'Ned')"

#: timestamp.cpp:160
msgid "the long localized day name (e.g. 'Monday'..'Sunday')"
msgstr "dugo lokalizovano ime dana  (npr. 'Ponedjeljak'..'Nedelja')"

#: timestamp.cpp:162
msgid "the month as number without a leading zero (1-12)"
msgstr "mjesec kao broj bez vodeće nule (1-12)"

#: timestamp.cpp:164
msgid "the month as number with a leading zero (01-12)"
msgstr "mjesec kao broj sa vodećom nulom (01-12)"

#: timestamp.cpp:166
msgid "the abbreviated localized month name (e.g. 'Jan'..'Dec')"
msgstr "skraćeno lokalizovano ime mjeseca  (npr. 'Jan'..'Dec')"

#: timestamp.cpp:168
msgid "the long localized month name (e.g. 'January'..'December')"
msgstr "dugo lokalizovano ime mjeseca  (npr. 'Januar'..'Decembar')"

#: timestamp.cpp:170
msgid "the year as two digit number (00-99)"
msgstr "godina kao dvocifreni broj (00-99)"

#: timestamp.cpp:172
msgid "the year as four digit number (1752-8000)"
msgstr "godina kao četverocifreni broj (1752-8000)"

#: timestamp.cpp:174
msgid "Time Format"
msgstr "Format vremena"

#: timestamp.cpp:176
msgid "These expressions may be used for the time:"
msgstr "Ovi izrazi će možda biti korišteni za vrijeme:"

#: timestamp.cpp:182
