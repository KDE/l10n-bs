#: ui/dialogaskcreateaclprefs.cpp:32
#, kde-format
msgid "New Secret Collection Access Policy"
msgstr "Nova politika pristupa tajne kolekcije"

#: ui/dialogaskcreateaclprefs.cpp:50
#, kde-format
msgid "You just created a secret collection named '%1'."
msgstr "Upravo ste kreirali tajnu kolekciju pod nazivom '%1'."

