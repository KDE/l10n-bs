#. i18n: file: kcmodule/ui/autotouchpadcontrolpage.ui:80
#. i18n: ectx: property (toolTip), widget (KComboBox, kcfg_KeysToIgnore)
#: rc.cpp:182
msgctxt "@info:tooltip"
msgid ""
"<para>These keys will be ignored when monitoring the keyboard:</para>\n"
"<para>\n"
"<list>\n"
"<item><interface>No keys</interface>:  No keys are ignored.  Every key "
"causes the touchpad to be switched off.</item>\n"
"<item><interface>Modifier keys</interface>: Modifier keys (e.g. Shift, Ctrl) "
"are ignored.  Every other key causes the touchpad to be switched off, even "
"when pressed in combination with a modifier key (e.g. Ctrl+S).</item>\n"
"<item><interface>Modifier combinations</interface>: Modifier keys and normal "
"keys in combination with modifier keys are ignored.  Every other key causes "
"the touchpad to be switched off. Note, that even Shift-combinations for "
"uppercase letters are ignored with this setting.</item>\n"
"</list>"
msgstr ""
"<para>Ovi tasteri će biti ignorisani prilikom praćenja tastature:</para>\n"
"<para>\n"
"<list>\n"
"<item><interface>Nijedan taster</interface>:  Nijedan taster nje ignorisan.  "
"Svaki taster čini da se dodirljiva ploča isključi .</item>\n"
"<item><interface>Modifikatorski tasteri</interface>: Modifikatorski tasteri "
"(npr. Shift, Ctrl) se ignorišu. Svaki drugi taster izaziva isključenje "
"dodirljive ploče čak i ako je pritisnuh u kombinaciji s modifikatorskim "
"tasterom(npr, Ctrl+S).</item>\n"
"<item><interface>Modifikatorske kombinacije</interface>: Modifikatorski "
"tasteri i normalni tasteri u kombinaciji s modifikatorskim tasterima se "
"ignorišu. Svi drugi tasteri izazivaju isključenje dodirljive ploče. "
"Primijetite na čak i Shift-kombinacije za velika slova se ignorišu ovom "
"postavkom.</item>\n"
"</list>"

