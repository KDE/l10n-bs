#: kthumb.cpp:94
#, kde-format
msgid ""
"             # Query for a standard path.\n"
"             # - base: the base directory of the local cache\n"
"             # - normal: the normal directory for thumbnails\n"
"             # - large: the directory for large thumbnails\n"
"             # - fail: the directory for information about failed thumbnail "
"generations\n"
msgstr ""
"             #  Upit za standardu stazu\n"
"#  -base: bazni direktorij za lokalni kes\n"
"# -normal: normalni direktorij za thumbnails\n"
"# -large: direktorij za velike thumbnails\n"
"# -fail: direktorij za informaciju o neuspijesnim thumbnail generations\n"

#: kthumb.cpp:107
#, kde-format
msgid ""
"kthumb: No command specified.\n"
"\n"
"Please see `kthumb --commands' for more information."
msgstr ""
"kthumb:  Nema specificirane naredbe.\n"
"Molimo vas vidite 'kthumb --commands' za vise informacija."
