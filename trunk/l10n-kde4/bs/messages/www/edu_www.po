#: messages.inc:128
msgid ""
"KStars Astrocalculator to access some of the internal calculations of "
"KStars, and also to predict conjunctions etc."
msgstr ""
"KStars Astrokalkulator pristupa nekim internim izračunima KStars, a također "
"predviđa veznike itd.."

#: messages.inc:129
msgid "Astroinfo project to help facilitate learning with the aid of KStars"
msgstr "Astroinfo projekt olakšava učenje uz pomoć KStars"

#: messages.inc:130
msgid "Internet links for further information / pictures of objects"
msgstr "Internet linkovi za dodatne informacije / slike objekata"

#: messages.inc:131
