#: svn/ksvnd/ksvnd.desktop:3
msgctxt "Name"
msgid "KDED Subversion Module"
msgstr "KDED modul za subversion kontrolor verzija"

#: svn/svn+file.protocol:15 svn/svn+http.protocol:15 svn/svn+https.protocol:15
#: svn/svn.protocol:15 svn/svn+ssh.protocol:15
msgctxt "Description"
msgid "Subversion ioslave"
msgstr "Ioslave za Subversion"

#: svn/svnhelper/apply_patch.desktop:8
msgctxt "Name"
msgid "Apply Patch..."
msgstr "Primijeni zakrpu..."

#: svn/svnhelper/apply_patch.desktop:66
msgctxt "Comment"
msgid "Apply the patch to another folder/file"
msgstr "Primijeni zakrpu na drugi direktorij/datoteku"

#: svn/svnhelper/subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion"
msgstr "Subversion"

#: svn/svnhelper/subversion.desktop:71
msgctxt "Name"
msgid "Add to Repository"
msgstr "Dodaj u spremište"

#: svn/svnhelper/subversion.desktop:131
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Obriši iz spremišta"

#: svn/svnhelper/subversion.desktop:190
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Vrati lokalne promjene"

#: svn/svnhelper/subversion.desktop:245
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Ukloni bilo koje promjene napravljene lokalno. Upozorenje - ovo ne može biti "
"ponovno vraćeno."

#: svn/svnhelper/subversion.desktop:296
msgctxt "Name"
msgid "Rename..."
msgstr "Preimenuj..."

#: svn/svnhelper/subversion.desktop:359
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Preimenuj datoteku lokalno i u spremištu. Koristi ovo radije nego dodavanje "
"i brisanje za preimenovanje datoteke."

#: svn/svnhelper/subversion.desktop:410
msgctxt "Name"
msgid "Import Repository"
msgstr "Uvezi spremište"

#: svn/svnhelper/subversion.desktop:467
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr "Stavi direktorij na postojeće spremište radi kontrole revizija."

#: svn/svnhelper/subversion.desktop:518
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Provjeri iz spremišta..."

#: svn/svnhelper/subversion.desktop:572
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Provjeri izlazne datoteke sa postojećeg spremišta u ovaj direktorij."

#: svn/svnhelper/subversion.desktop:623
msgctxt "Name"
msgid "Switch..."
msgstr "Prebaci..."

#: svn/svnhelper/subversion.desktop:680
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Prebaci datu radnu kopiju na drugu granu"

#: svn/svnhelper/subversion.desktop:733
msgctxt "Name"
msgid "Merge..."
msgstr "Sjedini..."

#: svn/svnhelper/subversion.desktop:792
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Sjedini promjene između ove i druge grane"

#: svn/svnhelper/subversion.desktop:844
msgctxt "Name"
msgid "Blame..."
msgstr "Krivica..."

#: svn/svnhelper/subversion.desktop:898
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Pogledaj ko je napisao svaku liniju u datoteci i pod kakvom kontrolom"

#: svn/svnhelper/subversion.desktop:950
msgctxt "Name"
msgid "Create Patch..."
msgstr "Napravi zakrpu..."

#: svn/svnhelper/subversion.desktop:1010
msgctxt "Name"
msgid "Export..."
msgstr "Izvezi..."

#: svn/svnhelper/subversion.desktop:1074
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Izvadi kopije drveta iz spremišta bez verzije"

#: svn/svnhelper/subversion.desktop:1125
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diff (lokalno)"

#: svn/svnhelper/subversion.desktop:1182
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Prikaži lokalne promjene od posljednjeg ažuriranja"

#: svn/svnhelper/subversion_toplevel.desktop:11
msgctxt "Name"
msgid "SVN Update"
msgstr "SVN Ažuriranje"

#: svn/svnhelper/subversion_toplevel.desktop:71
msgctxt "Name"
msgid "SVN Commit"
msgstr "SVN Potvrda"
