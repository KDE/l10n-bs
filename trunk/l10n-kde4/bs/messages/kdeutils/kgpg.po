#~ msgid ""
#~ "<qt><b>Allow encryption with untrusted keys:</b><br />\n"
#~ "<p>When importing a public key, the key is usually marked as untrusted "
#~ "and as such cannot be used unless it is signed by the default key (thus "
#~ "making it 'trusted'). Checking this box enables any key to be used even "
#~ "if it is untrusted.</p></qt>"
