msgid "GRUB2 Bootloader Control Module"
msgstr "Kontrolni modul GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:40
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr "Obnovi uobičajene postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:75
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr ""
"Potrebna je administratorska potvrda za obnovu podrazumijevanihpostavki "
"GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:113
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "Instaliraj GRUB2 pokretač sistema"

#: src/helper/kcmgrub2.actions:149
msgctxt "Description"
msgid "Administrator authorization is required to install the GRUB2 Bootloader"
msgstr ""
"Administratorska potvrda je potrebna za instaliranje GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:188
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "Učitaj postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:224
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader settings"
msgstr ""
"Administratorska potvrda je potrebna za čitanje postavki GRUB2 pokretača "
"sistema"

#: src/helper/kcmgrub2.actions:263
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "Snimie postavke GRUB2 pokretača sistema"

#: src/helper/kcmgrub2.actions:298
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader settings"
msgstr ""
"Administratorska potvrda je potrebna za snimanje postavki GRUB2 pokretača "
"sistema"

