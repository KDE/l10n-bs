msgstr "Stereografska"

#: src/lib/marble/projections/StereographicProjection.cpp:71
msgid "<p><b>Stereographic Projection</b> (\"orthogonal\")</p><p>Applications: Used for planetary cartography, geology and panorama photography.</p>"
msgstr "<p><b>Stereografska Projekcija</b> (\"ortogonalna\")</p><p>Primjene: Koristi se za planetarnu kartografiju, geologiju i panoramsku fotografiju.</p>"

#: src/lib/marble/projections/VerticalPerspectiveProjection.cpp:80
