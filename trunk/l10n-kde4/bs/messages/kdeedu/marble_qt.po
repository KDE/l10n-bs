#: src/lib/marble/projections/GnomonicProjection.cpp:71
msgid "<p><b>Gnomonic Projection</b> (\"rectilinear\")</p><p>Applications: Used for displaying panorama photography. Also used for navigation, radio and seismic work.</p>"
msgstr "<p><b>Gnomonička Projekcija</b> (\"rectilinear\")</p><p>Primjene: Koristi se za prikaz panoramskih fotografija. Takođe se koristi za navigaciju, radio i sizmičke aktivnosti.</p>"

