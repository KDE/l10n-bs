#: klettres.cpp:107
msgid ""
"The file sounds.xml was not found in\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"Please install this file and start KLettres again.\n"
"\n"
msgstr ""
"Datoteka sounds.xml nije pronađen u\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"Instalirajte ovaj datoteku i pokrenite KLettres ponovo.\n"
"\n"

#: klettres.cpp:110
msgid "KLettres - Error"
msgstr "KLettres-greška"

#: klettres.cpp:132
msgid "New Sound"
msgstr "Novi zvuk"

#: klettres.cpp:136
msgid "Play a new sound"
msgstr "Pusti novi zvuk"

#: klettres.cpp:137
msgid ""
"You can play a new sound by clicking this button or using the File menu, New "
"Sound."
msgstr ""
"Novi zvuk možete pustiti klikom na ovo dugme, ili preko menija Datoteka, "
"Novi zvuk."

#: klettres.cpp:140
msgid "Get Alphabet in New Language..."
msgstr "Nađi alfabet u novom jeziku..."

#: klettres.cpp:145
msgid "Replay Sound"
msgstr "Ponovo pusti zvuk"

#: klettres.cpp:148
msgid "Play the same sound again"
msgstr "Pušta isti zvuk ponovo"

#: klettres.cpp:150
msgid ""
"You can replay the same sound again by clicking this button or using the "
"File menu, Replay Sound."
msgstr ""
"Možete ponovo pustiti isti zvuk klikom na ovo dugme ili preko menija "
"Datoteka, Ponovo pusti zvuk."

#: klettres.cpp:156
msgctxt "@label:listbox which difficulty level to use"
msgid "L&evel"
msgstr "&Nivo"

#: klettres.cpp:157
msgid "Select the level"
msgstr "Izaberite nivo"

#: klettres.cpp:158
msgid ""
"You can select the level: level 1 displays a letter and you hear it; level 2 "
"does not display the letter, you only hear it; level 3 displays a syllable "
"and you hear it; level 4 does not display the syllable, you only hear it."
msgstr ""
"Možete izabrati nivo: nivo 1 prikazuje slovo i čujete ga; nivo 2 ne "
"prikazuje slovo, samo ga čujete; nivo 3 prikazuje slog i čujete ga; nivo 4 "
"ne prikazuje slog, samo ga čujete."

#: klettres.cpp:161
msgctxt "@label:listbox"
msgid "&Language"
msgstr "&Jezik"

#: klettres.cpp:164 klettres.cpp:165 klettres.cpp:166 klettres.cpp:167
#, kde-format
msgctxt "@item:inlistbox choose level"
msgid "Level %1"
msgid_plural "Level %1"
msgstr[0] "Nivo %1"
msgstr[1] "Nivo %1"
msgstr[2] "Nivo %1"

#: klettres.cpp:172
msgid "Themes"
msgstr "Teme"

#: klettres.cpp:175
msgid "Select the theme"
msgstr "Izaberite temu"

#: klettres.cpp:176
msgid ""
"Here you can change the theme for KLettres. A theme consists in the "
"background picture and the font color for the letter displayed."
msgstr ""
"Ovdje možete promijeniti temu za KLettres. Tema se sastoji od pozadinske "
"slike i boje kojom su slova prikazana."

#: klettres.cpp:179
msgid "Mode Kid"
msgstr "Režim za djecu"

#: klettres.cpp:183
msgid ""
"If you are in the Grown-up mode, clicking on this button will set up the Kid "
"mode. The Kid mode has no menubar and the font is bigger in the statusbar."
msgstr ""
"Ako ste u režimu za odrasle, klikom na ovo dugme dobit ćete režim za djecu. "
"Dječji režim nema traku menija i font je veći u statusnoj traci."

#: klettres.cpp:186
msgid "Mode Grown-up"
msgstr "Režim za odrasle"

#: klettres.cpp:190
msgid "The Grownup mode is the normal mode where you can see the menubar."
msgstr "Razvijeni način je normalan način, gdje možete vidjeti traku."

#: klettres.cpp:226
msgid "Font Settings"
msgstr "Podešavanja fonta"

#: klettres.cpp:230
msgid "Timer"
msgstr "Tajmer"

#: klettres.cpp:248 klettres.cpp:310
#, kde-format
msgctxt "@info:status the current level chosen"
msgid "(Level %1)"
msgstr "(Nivo %1)"

#: klettres.cpp:353
msgid "Grown-up mode is currently active"
msgstr "Režim za odrasle je trenutno aktivan"

#: klettres.cpp:354
msgid "Switch to Kid mode"
msgstr "Prebaci na režim za djecu"

#: klettres.cpp:372
msgid "Kid mode is currently active"
msgstr "Režim za djecu je trenutno aktivan"

#: klettres.cpp:373
msgid "Switch to Grown-up mode"
msgstr "Prebaci na režim za odrasle"

#: klettres.cpp:394
#, c-format, kde-format
msgid ""
"File $KDEDIR/share/apps/klettres/%1.txt not found;\n"
"please check your installation."
msgstr ""
"Datoteka $KDEDIR/share/apps/klettres/%1.txt nije pronađen;\n"
"provjerite svoju instalaciju."

