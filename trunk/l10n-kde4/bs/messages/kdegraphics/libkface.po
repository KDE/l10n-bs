#: libkface/database/databaseaccess.cpp:209
msgid ""
"The driver \"SQLITE\" for SQLite3 databases is not available.\n"
"digiKam depends on the drivers provided by the SQL module of Qt."
msgstr ""
"Drajver \"SQLITE\" za SQLite3 baze nije dostupan.\n"
"digiKam zavisi od drajvera koje pruža SQL modul Qt."

#: libkface/database/databaseaccess.cpp:233
#, kde-format
msgid ""
"Error opening database backend.\n"
"%1"
msgstr ""
"Greška pri otvaranju pozadine baze.\n"
"%1"

#: libkface/database/databaseconfigelement.cpp:221
msgid "Could not open the dbconfig.xml file. This file is installed with libkface and is absolutely required to run recognition. Please check your installation."
msgstr "Ne mogu otvoriti dbconfig.xml datoteku. Ova datoteka je instalirana s libkface i apsolutno je potrebna za pokretanje prepoznavanja. Molim provjerite vašu instalaciju."

#: libkface/database/databaseconfigelement.cpp:230
#, kde-format
msgid "Could not open dbconfig.xml file <filename>%1</filename>"
msgstr "Ne može se otvoriti  dbconfig.xml fajl <filename>%1</filename>"

#: libkface/database/databaseconfigelement.cpp:239
#, kde-format
msgid "The XML in the dbconfig.xml file <filename>%1</filename> is invalid and cannot be read."
msgstr "XML u  dbconfig.xml fajlu<filename>%1</filename> je neispravno i ne može se čitati."

#: libkface/database/databaseconfigelement.cpp:250
#, kde-format
msgid "The XML in the dbconfig.xml file <filename>%1</filename> is missing the required element <icode>%2</icode>"
msgstr "XML-u u  dbconfig.xml fajlu<filename>%1</filename>  nedostaje zahtjevani element <icode>%2</icode>"

#: libkface/database/databaseconfigelement.cpp:267
#, kde-format
msgid "An old version of the dbconfig.xml file <filename>%1</filename> is found. Please ensure that the right version of libkface is installed."
msgstr "Stara verzija dbconfig.xml datoteke <filename>%1</filename> je nađena. Molim osigurajte da je verzija izdana s pokrenutom verzijom programa libkface instalirana."

#: libkface/database/schemaupdater.cpp:133
msgid "The database is not valid: the \"DBVersion\" setting does not exist. The current database schema version cannot be verified. Try to start with an empty database. "
msgstr "Baza podataka nije ispravna: \"DBVersion\" postavka ne postoji. Trenutna šema baze podataka ne može biti ovjerena.Pokušajte početi sa praznom bazom podataka. "

#: libkface/database/schemaupdater.cpp:163
msgid "The database has been used with a more recent version of libkface and has been updated to a database schema which cannot be used with this version. (This means this libkface version is too old, or the database format is to recent.) Please use the more recent version of libkface that you used before."
msgstr "Baza je korištena s novijom verzijom libkfacei ažurirana je na šemu baze podataka koja se ne može koristiti s ovom verzijom . (To znači da je digiKam verzija prestara, ili format baze podataka previše nov.) Molim koristite noviju verziju libkface koju ste koristili ranije."

#: libkface/database/schemaupdater.cpp:192
#, kde-format
msgid ""
"Failed to create tables in database.\n"
"%1"
msgstr ""
"Neuspjelo kreiranje tabela u bazi podataka.\n"
"%1"

