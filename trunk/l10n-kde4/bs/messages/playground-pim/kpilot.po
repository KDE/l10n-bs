#, kde-format
msgid "File Installer"
msgstr "Instaler datoteka"

#: kpilot/kpilot.cc:284
#, kde-format
msgid "Select the kind of HotSync to perform next."
msgstr "Izaberite kako sljedeći put treba sinhronizovati."

#: kpilot/kpilot.cc:285
#, kde-format
msgid ""
"Select the kind of HotSync to perform next. This applies only to the next "
"HotSync; to change the default, use the configuration dialog."
msgstr ""
"Izaberite kako sljedeći put treba sinhronizovati. Ovo se odnosi samo na "
"sljedeću vruću sinhronizaciju; da bi ste izmijenili podrazumijevano, "
"upotrijebite dijalog za podešavanje."

#: kpilot/kpilot.cc:293
#, kde-format
msgid "&HotSync"
msgstr "&Vruće sinhronizuj"

#: kpilot/kpilot.cc:295
#, kde-format
msgid "Next HotSync will be normal HotSync."
msgstr "Sljedeća sinhronizacija će biti normalna vruća sinhronizacija."

#: kpilot/kpilot.cc:296
#, kde-format
msgid "Tell the daemon that the next HotSync should be a normal HotSync."
msgstr ""
"Kaži demonu da sljedeća sinhronizacija treba da bude normalna vruća "
"sinhronizacija."

#: kpilot/kpilot.cc:300
#, kde-format
msgid "Full&Sync"
msgstr "Potpuno &Sinhronizuj"

#: kpilot/kpilot.cc:302
#, kde-format
msgid "Next HotSync will be a FullSync."
msgstr "Sljedeća sinhronizacija će biti puna sinhronizacija."

#: kpilot/kpilot.cc:303
#, kde-format
msgid ""
"Tell the daemon that the next HotSync should be a FullSync (check data on "
"both sides)."
msgstr ""
"Kaži demonu da sljedeća sinhronizacija treba da bude potpuna sinhronizacija "
"(provjera vremena na obje strane)."

#: kpilot/kpilot.cc:310
#, kde-format
msgid "Next HotSync will copy PC to Handheld."
msgstr "Sljedeća sinhronizacija će kopirati sa PC-ja na ručni računar."

#: kpilot/kpilot.cc:311
#, kde-format
msgid ""
"Tell the daemon that the next HotSync should copy all data from the PC to "
"the Handheld, overwriting entries on the Handheld."
msgstr ""
"Kaži demonu da sljedeća sinhronizacija treba da kopira sve podatke sa PC-ja "
"na ručni računar, prebrisujući unose na ručnom računaru."

#: kpilot/kpilot.cc:319
#, kde-format
msgid "Next HotSync will copy Handheld to PC."
msgstr "Sljedeći HotSync će kopirati podatke sa uređaja na PC."

#: kpilot/kpilot.cc:320
#, kde-format
msgid ""
"Tell the daemon that the next HotSync should copy all data from the Handheld "
"to the PC, overwriting entries on the PC."
msgstr ""
"Kaži demonu da sljedeća sinhronizacija treba da kopira sve podatke sa ručnog "
"računara na PC, prebrisujući unose na PC-ju."

#: kpilot/kpilot.cc:326
#, kde-format
msgid "&Backup"
msgstr "&Napravi rezervnu kopiju"

#: kpilot/kpilot.cc:328
#, kde-format
msgid "Next HotSync will be backup."
msgstr "Sljedeća sinhronizacija će biti rezervna kopija."

#: kpilot/kpilot.cc:329
#, kde-format
msgid ""
"Tell the daemon that the next HotSync should back up the Handheld to the PC."
msgstr ""
"Kaži demonu da sljedeća sinhronizacija treba da napravi rezervnu kopiju "
"ručnog računara na PC-ju."

#: kpilot/kpilot.cc:334
#, kde-format
msgid "&Restore"
msgstr "&Povrati"

#: kpilot/kpilot.cc:336
#, kde-format
msgid "Next HotSync will be restore."
msgstr "Sljedeća sinhronizacija će biti vraćanje."

#: kpilot/kpilot.cc:337
#, kde-format
msgid ""
"Tell the daemon that the next HotSync should restore the Handheld from data "
"on the PC."
msgstr ""
"Kaži demonu da sljedeća vruća sinhronizacija treba da povrati ručni računar "
"pomoću podataka na računaru."

#: kpilot/kpilot.cc:342
#, kde-format
msgid "Rese&t Link"
msgstr "Resetu&j vezu"

#: kpilot/kpilot.cc:344
#, kde-format
msgid "Reset the device connection."
msgstr "Resetuj vezu sa uređajem."

#: kpilot/kpilot.cc:345
#, kde-format
msgid "Try to reset the daemon and its connection to the Handheld."
msgstr "Pokušaj da resetuješ demon i njegovu vezu sa ručnim računarom."

#: kpilot/kpilot.cc:350
#, kde-format
msgid "Quit KPilot, (and stop the daemon if configured that way)."
msgstr "Izađi iz KPilot-a (i zaustavi demon ako je tako podešeno)."

#: kpilot/kpilot.cc:385
#, kde-format
msgid "Next sync will be a backup. "
msgstr "Sljedeća sinhronizacija će biti rezervna kopija. "

#: kpilot/kpilot.cc:386 kpilot/kpilot.cc:394 kpilot/kpilot.cc:402
#: kpilot/kpilot.cc:410 kpilot/kpilot.cc:418 kpilot/kpilot.cc:426
#: kpilot/pilotDaemon.cc:485
#, kde-format
msgid "Please press the HotSync button."
msgstr "Pritisnite dugme Vruća sinhronizacija."

#: kpilot/kpilot.cc:393
#, kde-format
msgid "Next sync will restore the Pilot from backup. "
msgstr "Sljedeća sinhronizacija će povratiti Pilot iz rezervne kopije. "

#: kpilot/kpilot.cc:401
#, kde-format
msgid "Next sync will be a regular HotSync. "
msgstr "Sljedeća sinhronizacija će biti regularna vruća sinhronizacija. "

#: kpilot/kpilot.cc:409
#, kde-format
msgid "Next sync will be a Full Sync. "
msgstr "Sljedeća sinhronizacija će biti puna sinhronizacija. "

#: kpilot/kpilot.cc:417
#, kde-format
msgid "Next sync will copy Handheld data to PC. "
msgstr "Sljedeća sinhronizacija će kopirati podatke sa ručnog računara na PC. "

#: kpilot/kpilot.cc:425
#, kde-format
msgid "Next sync will copy PC data to Handheld. "
msgstr ""
"Sljedeća sinhronizacija će kopirati podatke sa PC-ja na ručni računar. "

#: kpilot/kpilot.cc:451
#, kde-format
msgid "The daemon has exited."
msgstr "Demon je obustavio rad."

#: kpilot/kpilot.cc:452
#, kde-format
msgid "No further HotSyncs are possible."
msgstr "Vruće sinhronizacije više nisu moguće."

#: kpilot/kpilot.cc:453
#, kde-format
msgid "Restart the daemon to HotSync again."
msgstr "Ponovo pokrenite demon ako želite vruću sinhronizaciju."

#: kpilot/kpilot.cc:550
#, kde-format
msgid "Resetting device connection ..."
msgstr "Ponovno postavljanje veze uređaja ..."

