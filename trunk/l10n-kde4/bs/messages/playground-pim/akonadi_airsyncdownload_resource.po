#: AirsyncDownloadResource.cxx:77
msgid "The resource is not configured correctly and can not work."
msgstr "Resurs nije korektno konfigurisan i ne može raditi"

#: AirsyncDownloadResource.cxx:83
msgid "The resource is offline."
msgstr "Resurs je odspojen"

#: AirsyncDownloadResource.cxx:91
msgid "Mail check already in progress, unable to start a second check."
msgstr "Provjera pošte već u toku, nemoguće početi drugu provjeru."

#: AirsyncDownloadResource.cxx:122
msgid "Mail check aborted."
msgstr "Provjera pošte prekinuta."

#: AirsyncDownloadResource.cxx:133
msgid "Mail check was canceled manually."
msgstr "Provjera pošte je ručno otkazana."

#: AirsyncDownloadResource.cxx:134
msgid "Ready"
msgstr "Spreman"

#: AirsyncDownloadResource.cxx:180
msgid "The configured mail target folder is not valid"
msgstr "Konfigurisano odredište elektronske pošte nije važeče"

#: AirsyncDownloadResource.cxx:225
msgid "The server authentication failed. Check username and password."
msgstr "Prijava na server nije uspjela. Provjerite korisničko ime i lozinku."

#: AirsyncDownloadResource.cxx:239
msgid "Checking for new mails"
msgstr "Provjeravam novu poštu."

#: AirsyncDownloadResource.cxx:255
msgid "Could not fetch mails from server"
msgstr "Ne mogu dohvatiti poštu s servera"

#: AirsyncDownloadResource.cxx:277
msgid "Deleting mails from the server."
msgstr "Brišem poštu s servera."

#: AirsyncDownloadResource.cxx:281
msgid "Could not delete mails from the server"
msgstr "Ne mobu obrisati poštu s servera."

#: AirsyncDownloadResource.cxx:293
msgid "Finished mail check, no mails downloaded."
msgstr "Završena provjera pošte, nema preuzetih poruka."

#: AirsyncDownloadResource.cxx:296
#, kde-format
msgid "Finished mail check, 1 mail downloaded."
msgid_plural "Finished mail check, %1 mails downloaded."
msgstr[0] "Završena provjera pošte, %1 preuzeta poruka."
msgstr[1] "Završena provjera pošte, %1 preuzete poruke."
msgstr[2] "Završena provjera pošte, %1 preuzetih poruka."

#: AirsyncDownloadResource.cxx:329
msgid "Unable to store downloaded mails."
msgstr "Nemoguće sačuvati preuzete poruke."

#: AirsyncDownloadResource.cxx:351
msgid "Mail check aborted after going offline."
msgstr "Provjera pošte prekinuta nakon odlaska van mreže."

#: SettingsDialog.cxx:49
msgid "AirSyncDownload Account Settings"
msgstr "AirSyncDownload postavke naloga"

#: SettingsDialog.cxx:56
msgid " minute"
msgid_plural " minutes"
msgstr[0] " minut"
msgstr[1] "minute"
msgstr[2] "minute"

#: SettingsDialog.cxx:125
msgid "Wallet disabled in system settings"
msgstr "Novčanik onemogućen u sistemskim postavkama"
