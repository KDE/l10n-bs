#: serviceproviderdatadialog.cpp:119
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<title>Delete GTFS Database</title><para>The GTFS database contains all data "
"imported from the GTFS feed. If you delete the database now the GTFS feed "
"needs to be imported again to make this service provider usable again.</"
"para><para>By deleting the database %1 disk space get freed.</para>"
msgstr ""
"<title>Izbriši GTFS bazu podataka</title><para>GTFS baza podataka sadrži sve "
"podatke unesene iz GTFS napajanja. Ako izbrišete bazu podataka sada, GTFS "
"napajanje mora biti ponovo uneseno da biste mogli ponovo koristiti ovu "
"uslugu.</para><para>Brisanjem baze podataka %1 memorija na disku se oslobađa."
"</para>"

