#: embed-win.cpp:88
#, kde-format
msgid "Embed new application"
msgstr "Ugradi novu aplikaciju"

#: embed-win.cpp:89
#, kde-format
msgid "Release embedded application"
msgstr "Izdanje ugrađene aplikacije"

#: embed-win.cpp:156
#, kde-format
msgid ""
"Click with the left mouse button on the window you want to embed.\n"
"Click anywhere with the right mouse button to cancel."
msgstr ""
"Kliknite lijevom tipkom miša na prozor koji želite ugraditi.\n"
"Kliknite bilo gdje desnom tipkom miša za odustajanje."

#: embed-win.cpp:243
#, kde-format
msgid "Cannot embed this window."
msgstr "Ne mogu ugraditi ovaj prozor."

#: embed-win.cpp:248
#, kde-format
msgid "Embedding client..."
msgstr "Ugradnja klijenta..."

#: embed-win.cpp:260
#, kde-format
msgid "Error while embedding client"
msgstr "Greška pri ugradnji klijenta"

#: embed-win.cpp:273
#, kde-format
msgid "Client is embedded. If you see this text please report a bug."
msgstr "Klijent je ugrađen. Ako vidite ovaj tekst, prijavite grešku."

#: embed-win.cpp:285
#, kde-format
msgid "Application have been closed"
msgstr "Aplikacija je bila zatvorena"

#: embed-win.cpp:288
#, kde-format
msgid "Application have been detached"
msgstr "Aplikacija je bila odspojena"
