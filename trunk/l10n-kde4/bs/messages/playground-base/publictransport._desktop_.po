#: applet-flights/plasma-applet-flights.desktop:2
msgctxt "Name"
msgid "Flights"
msgstr "Letovi"

#: applet-flights/plasma-applet-flights.desktop:26
msgctxt "Comment"
msgid "Shows flight departures/arrivals for a given airport."
msgstr "Prikazuje odlaske/dolaske aviona za određeni aerodrom."

#: applet-graphicaltimetableline/plasma-applet-graphicaltimetableline.desktop:2
msgctxt "Name"
msgid "GraphicalTimetableLine"
msgstr "GrafičkiRasporedLinija"

#: applet-graphicaltimetableline/plasma-applet-graphicaltimetableline.desktop:21
msgctxt "Comment"
msgid "Plasma GraphicalTimetableLine"
msgstr "Plazma GrafičkiRasporedLinija"

#: applet/plasma-applet-publictransport.desktop:2
#: runner/plasma-runner-publictransport.desktop:2
msgctxt "Name"
msgid "Public Transport"
msgstr "Javni Prijevoz"

#: applet/plasma-applet-publictransport.desktop:29
msgctxt "Comment"
msgid ""
"Plasma Public Transport shows a departure / arrival board for public "
"transport. It can also show journeys."
msgstr ""
"Plazma Javni Prijevoz prikazuje tablu odlazaka / dolazaka za javni prijevoz. "
"Također može prikazivati putovanja."

#: engine-openstreetmap/plasma-engine-openstreetmap.desktop:2
msgctxt "Name"
msgid "OpenStreetMap data engine"
msgstr "OtvorenaMapaUlice podaci motora"

#: engine-openstreetmap/plasma-engine-openstreetmap.desktop:25
msgctxt "Comment"
msgid ""
"The OpenStreetMap data engine can be used to query things near the user."
msgstr ""
"OpenStreetMap pogon podataka se može koristiti za upit stvari pored "
"korisnika."

#: engine/plasma-engine-publictransport.desktop:2
msgctxt "Name"
msgid "Public transport engine"
msgstr "Pogon javnog prijevoza"

#: engine/plasma-engine-publictransport.desktop:25
msgctxt "Comment"
msgid "Plasma data engine for public transport"
msgstr "Plazma pogon podataka za javni prijevoz"

#: engine/timetablemate/src/timetablemate.actions:2
#: engine/timetablemate/src/timetablemate.desktop:2
msgctxt "Name"
msgid "TimetableMate"
msgstr "PomoćniRaspored"

#: engine/timetablemate/src/timetablemate.actions:26
msgctxt "Name"
msgid "Install timetable accessor globally"
msgstr "Instalirajte pristup globalnom rasporedu"

#: engine/timetablemate/src/timetablemate.actions:45
msgctxt "Description"
msgid ""
"Authentication is required to install the timetable accessor files globally"
msgstr ""
"Da bi se intalirale datoteke za pristup globalnom rasporedu potrebna je "
"provjera autentičnosti"

#: engine/timetablemate/src/timetablemate.desktop:28
msgctxt "GenericName"
msgid ""
"A little IDE for adding support for new service providers to the "
"PublicTransport data engine"
msgstr ""
"Mali IDE za dodavanaje podrške za novi servis pružanja usluga za podatke "
"motora JavnogPrijevoza"

#: libpublictransporthelper/publictransporthelper.desktop:2
msgctxt "Name"
msgid "Public Transport Helper Library"
msgstr "Pomoćna Biblioteka Javnog Transporta"

#: libpublictransporthelper/publictransporthelper.desktop:23
msgctxt "Comment"
msgid ""
"A library to be used with the publictransport data engine. It provides "
"widgets/dialogs to setup stop settings."
msgstr ""
"Biblioteka će se koristiti sa podacima motora javnogprijevoza. Ona pruža "
"članke/dijaloge za postavljanje zaustavnih postavki."

#: runner/config/plasma-runner-publictransport_config.desktop:2
msgctxt "Name"
msgid "Public Transport Runner Config"
msgstr "Vodič Konfiguracija Javnog Prijevoza"

#: runner/config/plasma-runner-publictransport_config.desktop:22
msgctxt "Comment"
msgid "Configuration of the Public Transport Runner"
msgstr "Konfiguracije Vodiča Javnog Prijevoza"

#: runner/plasma-runner-publictransport.desktop:29
msgctxt "Comment"
msgid "Gives information about public transport departing from a given stop"
msgstr "Daje informacije o javnom prijevozu polazeći od određenog stajališta"
