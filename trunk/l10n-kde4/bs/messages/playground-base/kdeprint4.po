#: kpgeneralpage.cpp:121
msgid ""
" <qt> <p><b>\"General\"</b> </p>  <p>This dialog page contains <em>general</"
"em> print job settings. General settings are applicable to most printers, "
"most jobs and most job file types.</p>  <p>To get more specific help, enable "
"the \"What's This\" cursor and click on any of the text labels or GUI "
"elements of this dialog.</p> </qt>"
msgstr ""
" <qt> <p><b>\"General\"</b> </p> <p>Dijaloška stranica sadži  <em>opšta</em> "
"Podešavanje štampanja zadatka. Generalna podešavanja su primjenljiva na "
"većini štampača, većini zadataka i većinskim tipovima datoteka.</p> <p>za "
"više pomoći, omogućiti \"What's This\" kursor i kliknuti na bilo koju "
"tekstualnu labelu ili GUI element ovog dijaloga</p> </qt>"

#: kpgeneralpage.cpp:129
msgid ""
" <qt> <p><b>Page size:</b> Select paper size to be printed on from the drop-"
"down menu.</p> <p>The exact list of choices depends on the printer driver "
"(\"PPD\") you have installed.</p> <br /> <hr /> <p><em><b>Additional hint "
"for power users:</b> This KDEPrint GUI element correponds to the CUPS "
"command line job option parameter:</em> <pre>    -o PageSize=...         # "
"examples: \"A4\" or \"Letter\" </pre> </p>  </qt>"
msgstr ""
" <qt> <p><b>Veličina stranice:</b> Koristeći drop-down meni odabrati "
"veličinu stranice koja će se štampati. </p> <p>Tačna lista izbora zavisi od "
"uređaja štampača(\"PPD\") koji ste instalirali.</p> <br /> <hr /> "
"<p><em><b>Dodatni savjet za korisnike:</b> Ovaj KDEPrint GUI element "
"odgovara na CUPS komandnu liniju zadanog parametra:</em> <pre> -o "
"PageSize=... # Primjer: \"A4\" or \"Letter\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:142
msgid ""
" <qt> <p><b>Paper type:</b> Select paper type to be printed on from the drop-"
"down menu. </p> <p>The exact list of choices depends on the printer driver "
"(\"PPD\") you have installed.</p> <br /> <hr /> <p><em><b>Additional hint "
"for power users:</b> This KDEPrint GUI element corresponds to the CUPS "
"command line job option parameter:</em> <pre>    -o MediaType=...        # "
"example: \"Transparency\" </pre> </p> </qt>"
msgstr ""
" <qt> <p><b>Veličina stranice:</b> Koristeći drop-down meni odabrati "
"veličinu stranice koja će se štampati. </p> <p>Tačna lista izbora zavisi od "
"uređaja štampača(\"PPD\") koji ste instalirali.</p> <br /> <hr /> "
"<p><em><b>Dodatni savjet za korisnike:</b> Ovaj KDEPrint GUI element "
"odgovara na CUPS komandnu liniju zadanog parametra:</em> <pre> -o "
"MediaType=... # primjer: \"Transparency\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:155
msgid ""
" <qt> <p><b>Paper source:</b> Select paper source tray for the paper to be "
"printed on from the drop-down menu.</p> <p>The exact list of choices depends "
"on the printer driver (\"PPD\") you have installed.</p> <br /> <hr /> "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"corresponds to the CUPS command line job option parameter:</em> <pre>    -o "
"InputSlot=...        # examples: \"Lower\" or \"LargeCapacity\" </pre> </p> "
"</qt>"
msgstr ""
" <qt> <p><b>Izvor papira:</b>Odaberite ladicu kao izvor papira za printanje "
"iz padajućeg menija.</p> <p>Tačna lista opcija zavisi od drajvera printera "
"(\"PPD\") koji ste instalirali..</p> <br /> <hr /> <p><em><b>Dodatni savjet "
"za iskusne korisnike:</b> Ovaj KDEPrint GUI elemenat odgovara opciji "
"parametra CUPS komande u komandnoj liniji:</em> <pre> -o InputSlot=... # "
"primjeri: \"Lower\" ili \"LargeCapacity\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:168
msgid ""
" <qt> <p><b>Image Orientation:</b> Orientation of the printed page image on "
"your paper is controlled by the radio buttons. By default, the orientation "
"is <em>Portrait</em>.</p> <p>You can select from 4 alternatives: <ul>  <li> "
"<b>Portrait</b>. Portrait is the default setting.</li> <li> <b>Landscape</b>."
"</li>  <li> <b>Reverse Landscape</b>. Reverse Landscape prints the images "
"upside down.</li> <li> <b>Reverse Portrait</b>. Reverse Portrait prints the "
"image upside down.</li> </ul> The icon changes according to your selection.</"
"p> <br /> <hr /> <p><em><b>Additional hint for power users:</b> This "
"KDEPrint GUI element corresponds to the CUPS command line job option "
"parameter:</em> <pre>    -o orientation-requested=...       # examples: "
"\"landscape\" or \"reverse-portrait\" </pre> </p>  </qt>"
msgstr ""
" <qt> <p><b>Orijentacija slike:</b> Orijentacija štampane slike na papiru je "
"kontrolisana sa radio button-om. Početna orijentacija je<em>Portret</em>.</"
"p> <p>Možete odabrati 4 mogućnosti: <ul> <li> <b>Portret</b>. Portret je "
"odmah podešen</li> <li> <b>Pejzaž</b>.</li> <li> <b>Inverzni pejzaž</b>. "
"Inverzni pejzaž štampa slike naopako</li> <li> <b>Inverzni portret</b>. "
"Reverse Portrait prints the image upside down.</li> </ul> The icon changes "
"according to your selection.</p> <br /> <hr /> <p><em><b>Additional hint for "
"power users:</b> This KDEPrint GUI element corresponds to the CUPS command "
"line job option parameter:</em> <pre> -o orientation-requested=... # "
"examples: \"landscape\" or \"reverse-portrait\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:189
msgid ""
"<qt> <p><b>Duplex Printing:</b> These controls may be grayed out if your "
"printer does not support <em>duplex printing</em> (i.e. printing on both "
"sides of the sheet.) These controls are active if your printer supports "
"duplex printing.</p> <p>You can choose from 3 alternatives:</p> <ul> "
"<li><b>None.</b> This prints each page of the job on one side of the sheets "
"only.</li> <li><b>Long Side.</b> This prints the job on both sides of the "
"paper sheets. It prints the job in a way so that the backside has the same "
"orientation as the front side if you fold the paper over the long edge. "
"(Some printer drivers call this mode <em>duplex-non-tumbled</em>.)</li> "
"<li><b>Short Side.</b> This prints the job on both sides of the paper "
"sheets. It prints the job so that the backside has the reverse orientation "
"from the front side if you turn the paper over the long edge, but the same "
"orientation, if you turn it over the short edge. (Some printer drivers name "
"this mode <em>duplex-tumbled</em>.)</li> </ul> <hr /> <p><em><b>Additional "
"hint for power users:</b> This KDEPrint GUI element corresponds to the CUPS "
"command line job option parameter:</em> <pre>    -o duplex=...       # "
"examples: \"tumble\" or \"two-sided-short-edge\" </pre> </p> </qt>"
msgstr ""
"<qt> <p><b>Dvostrano Štampanje:</b> Ove opcije mogu biti nedostupne ukoliko "
"vaš printer ne podržava <em>dvostrano štampanje</em> (tj. štampanje na obje "
"strane papira.) Ove opcije su aktivne ukoliko ih vaš printer podržava.</p> "
"<p>Možete izabrati od 3 alternative:</p> <ul> <li><b>Bez.</b> Ova opcija "
"štampa svaku stranicu samo na jednu stranu papira.</li> <li><b>Duga Strana.</"
"b> Ova opcija štampa na obje strane papira. Ona štampa tako što poleđina ima "
"istu orijentaciju kao prednja strana ako okrenete papir preko duže stranice. "
"(Neki printeri ovo nazivaju <em>dvostrano-neprevaljeno</em>.)</li> "
"<li><b>Kratka Stranica.</b> Ova opcija štampa na obje strane papira. Štampa "
"tako što poleđina ima obrnutu orijentaciju od prednje stranice ako okrenete "
"papir preko duže stranice, ali iste orijentacije ako okrenete papir preko "
"kraće stranice. (Neki printeri ovo nazivaju <em>dvostrano-prevaljeno</em>.)</"
"li> </ul> <hr /> <p><em><b>Dodatni savjet za iskusne korisnike:</b> Ovaj "
"KDEPrint GUI elemenat odgovara parametru opcije CUPS komande u komandnoj "
"liniji:</em> <pre> -o duplex=... # primjeri: \"tumble\" ili \"two-sided-"
"short-edge\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:214
msgid ""
" <qt> <p><b>Banner Page(s):</b> Select banner(s) to print one or two special "
"sheets of paper just before or after your main job.</p> <p>Banners may "
"contain some pieces of job information such as user name, time of printing "
"or job title.</p> <p>Banner pages are useful to separate different jobs more "
"easily, especially in a multi-user environment.</p> <p><em><b>Hint:</b></em> "
"You can design your own banner pages. To make use of them, just put the "
"banner file into the standard CUPS <em>banners</em> directory (this is "
"usually <em>\"/usr/share/cups/banner/\"</em>. Your custom banner(s) must "
"have one of the supported printable formats. Supported formats are ASCII "
"text, PostScript, PDF and nearly any image format such as PNG, JPEG or GIF. "
"Your added banner pages will appear in the drop down menu CUPS is restarted."
"</p> <p>CUPS comes with a selection of banner pages.</p> <br /> <hr /> "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"corresponds to the CUPS command line job option parameter:</em> <pre>    -o "
"job-sheets=...       # examples: \"standard\" or \"topsecret\"  </pre> </p> "
"</qt>"
msgstr ""
" <qt> <p><b>Banner Stranice:</b>Odaberite banner da štampate jednu ili dvije "
"posebne stranice papira prije ili poslije glavnog zadatka.</p> <p>Banneri "
"mogu sadržavati neke dijelove informacija o zadatku kao korisničko ime, "
"vrijeme štampanja ili naziv zadatka.</p> <p>Banner stranice su korisne da "
"razdvoje različite zadatke lakše, posebno u višekorisničkom okruženju.</p> "
"<p><em><b>Savjet:</b></em> Možete dizajnirati vaše vlastite banner stranice. "
"Da ih koristite, postavite banner datoteku u uobičajeni CUPS <em>banners</"
"em> direktorij (ovo je uglavnom <em>\"/usr/share/cups/banner/\"</em>. Vaš "
"prilagođeni baner mora imati jedan od podržanih formata štampanja. Podržani "
"formati su ASCII tekst, PostScript, PDF i gotovo svi formati slika poput "
"PNG, JPEG ili GIF. Vaša dodana baner stranica će biti prikazana u padajućem "
"izborniku kada se CUPS ponovo pokrene.</p> <p>CUPS dolazi s izborom baner "
"stranica.</p> <br /> <hr /> <p><em><b>Dodatni savjet za iskusne korisnike:</"
"b> Ovaj KDEPrint GUI elemenat odgovara parametru opcije CUPS komande u "
"komandnoj liniji:</em> <pre> -o job-sheets=... # primjeri: \"standard\" ili "
"\"topsecret\" </pre> </p> </qt>"

#: kpgeneralpage.cpp:236
msgid ""
"<qt> <p><b>Pages per Sheet:</b>  You can choose to print more than one page "
"onto each sheet of paper. This is sometimes useful to save paper.</p> "
"<p><b>Note 1:</b> the page images get scaled down accordingly to print 2 or "
"4 pages per sheet. The page image does not get scaled if you print 1 page "
"per sheet (the default setting).</p> <p><b>Note 2:</b> If you select "
"multiple pages per sheet here, the scaling and re-arranging is done by your "
"printing system. However, some printers are independently capable of "
"printing multiple pages per sheet. In which case you find the option in the "
"printer driver settings. Be careful: if you enable multiple pages per sheet "
"in both places, your printout will not look as you intended.</p> <br /> <hr /"
"> <p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"corresponds to the CUPS command line job option parameter:</em> <pre>    -o "
"number-up=...        # examples: \"2\" or \"4\"  </pre> </p> </qt>"
msgstr ""
"<qt> <p><b>Broj Stranica na Papiru:</b> Možete odabrati da štampate više od "
"jedne stranice na svaki list papira. Ovo je nekada korisno da sačuvate papir."
"</p> <p><b>Napomena 1:</b> Slike na stranicama se smanje za štampanje 2 ili "
"4 stranice po listu. Slika stranice se ne smanjuje ako se štampa 1 strana po "
"papiru (podarzumijevana postavka).</p> <p><b>Napomena 2:</b> Ako odaberete "
"više stranica po lisu ovdje, smanjivanje i raspored je obavljen u vašem "
"sistemu štampe. Neki štampači mogu neovisno štampati više stranica po listu "
"papira.</p> <br /> <hr /> <p><em><b>Dodatni savjet za iskusne korisnike:</"
"b>  Ovaj KDEPrint GUI elemenat odgovara parametru opcije CUPS komande u "
"komandnoj liniji:</em> <pre> -o number-up=... # primjeri: \"2\" ili \"4\" </"
"pre> </p> </qt>"

