#: outputservice.cpp:69
#, kde-format
msgid "The 'size' command requires a valid combination of width and height"
msgstr "'size'  komanda zahtijeva odgovarajucu kombinaciju sirine i visine"

#: outputservice.cpp:73
#, kde-format
msgid "The 'size' command requires a 'width' and a 'height' argument"
msgstr ""
"'size'  komanda zahtijeva odgovarajucu kombinaciju 'sirine' i 'visine' kao "
"argumenti"

#: outputservice.cpp:91
#, kde-format
msgid "The 'position' command requires a valid combination of x and y"
msgstr "'position' komanda zahtijeva odgovarajucu kombinaciju x i y"

#: outputservice.cpp:95
#, kde-format
msgid "The 'position' command requires a 'x' and a 'y' argument"
msgstr ""
"'psitiona' komanda zahtijeva odgovarajucu kombinaciju 'x' i 'y' kao "
"argumenata"

#: outputservice.cpp:116
#, kde-format
msgid ""
"The 'rotation' command requires a valid value for 'rotate' (0, 90, 180 or "
"270)"
msgstr ""
"'rotation' komanda zahtijeva odgovarajucu vrijednost za 'rotaciju'(0, 90, "
"180 or 270)"

#: outputservice.cpp:120
#, kde-format
msgid "The 'rotation' command requires a 'rotate' argument"
msgstr "'rottion; komanda zahtijeva  'rotaciju' kao argument"

