msgstr "Nema ključa za OpenCalais API konfigurisanog"

#. i18n: ectx: label, entry, group (Connection)
#: opencalaisconfig.kcfg:9
#, kde-format
msgid "Open Calais registration key"
msgstr "Open Calais registracijski ključ"

#. i18n: ectx: label, entry, group (General)
#: opencalaisconfig.kcfg:14
#, kde-format
msgid "Show a warning if Key is missing"
msgstr "Prikaži upozorenje ako ključ nedostaje"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: opencalaisconfig.ui:21
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Verdana'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Using the OpenCalais web "
"service requires a free registration. <a href=\"http://www.opencalais.com/"
"APIkey\"><span style=\" text-decoration: underline; color:#0000ff;\">Request "
"a license key</span></a> from OpenCalais and copy it into the configuration "
"below.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Verdana'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Upotreba OpenCalais web "
"servisa zahtijeva besplatnu registraciju. <a href=\"http://www.opencalais."
"com/APIkey\"><span style=\" text-decoration: underline; color:#0000ff;"
"\">Zahtijevaj licencni ključ</span></a> od OpenCalais i kopiraj ga u donju "
"konfiguraciju.</p></body></html>"

