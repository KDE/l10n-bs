#. i18n: ectx: property (windowTitle), widget (QWidget, gridConfig)
#. i18n: ectx: property (accessibleName), widget (QWidget, gridConfig)
#: gridConfig.ui:19 gridConfig.ui:22
msgid "Configure Grid"
msgstr ""

#. i18n: ectx: property (whatsThis), widget (QLabel, rowLabel)
#: gridConfig.ui:62
msgid ""
"Here you can set the number of columns to be used. Note that in vertical "
"panels, this means the maximum number of rows, so your grid will never be "
"higher than that. It will expand horizontally instead, i.e. add more columns."
msgstr ""

#. i18n: ectx: property (text), widget (QLabel, rowLabel)
#: gridConfig.ui:65
msgid "Number of rows"
msgstr "Broj redova"

#. i18n: ectx: property (whatsThis), widget (QLabel, colLabel)
#: gridConfig.ui:78
msgid ""
"Here you can set the number of columns to be used. Note that in vertical "
"panels, this means the maximum number of columns, so your grid will never be "
"wider than that. It will expand vertically instead, i.e. add more rows."
msgstr ""

#. i18n: ectx: property (text), widget (QLabel, colLabel)
#: gridConfig.ui:81
msgid "Number of columns"
msgstr "Broj kolona"

#. i18n: ectx: property (text), widget (QLabel, note)
