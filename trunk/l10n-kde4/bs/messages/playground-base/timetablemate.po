#: project.cpp:1701
#, kde-format
msgctxt "@info"
msgid ""
"<title>You need to implement a '%1' script function</title> <para>Service "
"provider plugins that only support journeys are currently not accepted by "
"the data engine, but that may change.</para>"
msgstr ""
"<title>Morate implementirati '%1' funkcije komandne datoteke</title> "
"<para>Dodaci pružitelja usluga koji podržavaju jedino putovanja trenutno "
"nisu prihvaćeni od strane podatkovne mašine, ali to se može promijeniti.</"
"para>"

#: project.cpp:1716
msgctxt "@info/plain"
msgid "No results in departure test"
msgstr "Nema rezultata u testiranju polaska."

#: project.cpp:1723
#, kde-format
msgctxt "@info/plain"
msgid "'%1' script function not implemented"
msgstr "'%1' funkcija komandne datoteke nije implementirano"

#: project.cpp:1724
#, kde-format
msgctxt "@info"
msgid ""
"<title>You can implement a '%1' script function</title> <para>This can be "
"used to load additional data for single departures or arrivals.</para>"
msgstr ""
"<title>Možete implementirati '%1' funkciju komandne datoteke</title> "
"<para>Ovo može biti korišteno za učitavanje dodatnih informacija za pojedine "
"polaske ili dolaske.</para>"

#: project.cpp:1744
#, kde-format
msgctxt "@info"
msgid ""
"<title>You need to implement a '%1' script function</title> <para>Without "
"stop suggestions it can be very hard for users to find a valid stop name. "
"Therefore this function is needed.</para>"
msgstr ""
"<title>Morate implementirati'%1' funkciju komandne datoteke</title> "
"<para>Bez prijedloga za stajanje korisniku može biti veoma teško da pronađe "
"odgovarajuće ime stajališta. Stoga je ova funkcija potrebna .</para>"

#: project.cpp:1751
#, kde-format
msgctxt "@info/plain"
msgid "For journeys, you need to implement a '%1' script function"
msgstr "Za putovanja morate implementirati '%1' funkcija komandne datoteke"

#: project.cpp:1752
#, kde-format
msgctxt "@info"
msgid ""
"<title>For journeys, you need to implement a '%1' script function</title> "
"<para>If you do not implement the function, journeys will not work with the "
"plugin.</para>"
msgstr ""
"<title>Za putovanja morate implementirati'%1' funkciju komandne datoteke</"
"title> <para>Ako ne implementirate funkciju putovanja neće raditi sa "
"dodacima</para>"

#: project.cpp:1758
#, kde-format
msgctxt "@info/plain"
msgid "You should implement a '%1' script function"
msgstr "Trebate implementirati '%1' funkciju komandne datoteke"

#: project.cpp:1759
#, kde-format
msgctxt "@info"
msgid ""
"<title>You should implement a '%1' script function</title> <para>This "
"function is used to know what information the plugin parses from documents. "
"Without adding the appropriate TimetableInformation names to the return "
"value of this function, the associated data will be unused or associated "
"features will be disabled.</para><para>If, for example, the script can parse "
"Arrivals, 'Arrivals' should be added to the return value. If the script "
"parses route stops or stop IDs, add 'RouteStops' or 'StopID' to the return "
"value, etc.</para>"
msgstr ""
"<title>Trebate implementirati '%1' funkciju komandne datoteke</title> "
"<para>Ova funkcija se koristi sa saznanje koje informacije iz dokumenata "
"dodaci analiziraju. Bez dodavanja odgovarajućih PlanerInformacije imena koje "
"će vraćati vrijednosti tih funkcija, povezani podaci neće biti korišteni ili "
"će povezani sadržaji biti onemogućeni.</para><para>Ukoliko naprimjer "
"komandna datoteka može analizirati dolaske,  'Dolasci' bi trebali biti "
"dodani u vrijednost koju vraća.Ukoliko komandna datoteka  analizira rute "
"stajanja ili informacije o stajanjima, dodajte \"RuteStajanja\" ili "
"\"InformacijeOStajanjima\" u vrijednost koju vraća.</para>"

