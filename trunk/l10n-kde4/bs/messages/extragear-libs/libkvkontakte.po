msgstr "Broj napomena koje su se promijenile između zahtijeva"

#: authenticationdialog.cpp:55
msgctxt "@title:window"
msgid "Authenticate with VKontakte"
msgstr "Prijava s VKontakte"

#: authenticationdialog.cpp:69
msgid "Loading Page:"
msgstr "Učitavam stranicu:"

#: authenticationdialog.cpp:126
#, kde-format
msgid ""
"<b>VKontakte Error Description:</b> %1<br><b>VKontakte Error:</b> %2<br>"
msgstr "<b>Opis VKontakte greške:</b> %1<br><b>VKontakte greška:</b> %2<br>"

#: authenticationdialog.cpp:128
msgid "Authentication with VKontakte was not successful."
msgstr "Prijava s VKontakte nije uspješna."

#: authenticationdialog.cpp:129
msgctxt "@title:window"
msgid "Authentication Problem"
msgstr "Problem s prijavom"

#: authenticationdialog.cpp:167
msgid ""
"There was a network error when trying to authenticate with VKontakte web "
"service."
msgstr "Desila se mrežna greška pri prijavi na VKontakte web uslugu."

#: authenticationdialog.cpp:168
msgctxt "@title:window"
msgid "Network Error"
msgstr "Mrežna greška"

#: deletealbumjob.cpp:41
msgid "Failed to delete album"
msgstr "Neuspjelo brisanje albuma"

#: editalbumjob.cpp:50
msgid "Failed to edit album"
msgstr "Neuspjelo ažuriranje albuma"

#: photopostjob.cpp:51
#, kde-format
msgid ""
"The VKontakte server returned an error of type <i>%1</i> in reply to "
"uploading to URL %2: <i>%3</i>"
msgstr ""
"VKontakte server je vratio grešku tipa <i>%1</i> u odgovoru na slanje na  "
"URL %2: <i>%3</i>"

#: photopostjob.cpp:135 vkontaktejobs.cpp:136
#, kde-format
msgid "Unable to parse data returned by the VKontakte server: %1"
msgstr "Ne mogu analizirati podatke koje je vratio VKontakte server: %1"

#: vkontaktejobs.cpp:79
#, kde-format
msgid ""
"The VKontakte server returned an error of type <i>%1</i> in reply to method "
"%2: <i>%3</i>"
msgstr ""
"VKontakte server je vratio grešku tipa <i>%1</i> u odgovoru na metod %2: <i>"
"%3</i>"
