#: tools/resizeoptionsdialog.cpp:235
msgid ""
"<p><b>Proportional (1 dim.)</b>: standard auto-resizing using one dimension. "
"The width or the height of the images will be automatically selected, "
"depending on the images' orientations. The images' aspect ratios are "
"preserved.</p>"
msgstr ""
"<p><b>Proporcionalno (1 dim.)</b>: standardna automatska promjena veličine "
"koristeći jednu dimenziju. Širina ili visina slike će biti automatski "
"odabrana, ovisno od orijentacija slike. Omjeri slike su sačuvani.</p>"

#: tools/resizeoptionsdialog.cpp:300 tools/resizeoptionsdialog.cpp:400
msgid "Width (pixels):"
msgstr "Širina (u pikselima):"

#: tools/resizeoptionsdialog.cpp:301 tools/resizeoptionsdialog.cpp:401
msgid "The new images' width in pixels."
msgstr "Širina nove slike u pikselima."

#: tools/resizeoptionsdialog.cpp:306 tools/resizeoptionsdialog.cpp:406
msgid "Height (pixels):"
msgstr "Visina (u pikselima):"

#: tools/resizeoptionsdialog.cpp:307 tools/resizeoptionsdialog.cpp:407
msgid "The new images' height in pixels."
msgstr "Visina nove slike u pikselima."

#: tools/resizeoptionsdialog.cpp:309
msgid "Fill image to specified size"
msgstr "Popuni sliku u određenu veličini"

#: tools/resizeoptionsdialog.cpp:310
msgid ""
"If this box is set, the resulting image is filled up with the specified "
"background color to the desired dimension, otherwise it is only as big as "
"needed to fit the original image into the specified dimensions."
msgstr ""
"Ako je ovaj okvir postavljen, rezultujuća slika je popunjena sa određenom "
"bojom pozadine do željene dimenzije, inače je velika onoliko koliko je "
"potrebno da se uklopi u originalnu sliku određenih dimenzija."

#: tools/resizeoptionsdialog.cpp:315
msgid "Background color:"
msgstr "Boja pozadine:"

#: tools/resizeoptionsdialog.cpp:317
msgid ""
"You can select here the background color to be used when adapting the "
"images' sizes."
msgstr ""
"Možete ovdje odabrati boju pozadine koja će biti korištena kad prilagođavate "
"veličinu slike."

#: tools/resizeoptionsdialog.cpp:345
msgid ""
"<p><b>Proportional (2 dim.)</b>: auto-resizing using two dimensions. The "
"images' aspect ratio are preserved. You can use this, for example, to adapt "
"your images' sizes to your screen size.</p>"
msgstr ""
"<p><b>Proporcionalno (2 dim.)</b>: automatska promjena veličine slike "
"koristeći dvije dimenzije. Omjer slike je očuvan. Možete ovo koristiti da "
"bi, na primjer, prilagodili veličinu slike Vašoj veličini ekrana.</p>"

#: tools/resizeoptionsdialog.cpp:428
msgid ""
"<p><b>Non proportional</b>: non-proportional resizing using two dimensions. "
"The images' aspect ratios are not preserved.</p>"
msgstr ""
"<p><b>Neproporcionalno</b>: neproporcionalna promjena veličine slike "
"koristeći dvije dimenzije. Omjeri slike nisu sačuvani.</p>"

#: tools/resizeoptionsdialog.cpp:490
msgid "Use custom settings"
msgstr "Koristi posebne postavke"

#: tools/resizeoptionsdialog.cpp:491
msgid "If this option is enabled, all printing settings can be customized."
msgstr ""
"Ako je ova opcija omogućena, sve postavke štampanja mogu biti prilagođene."

#: tools/resizeoptionsdialog.cpp:498
msgid "Printing Standard Settings"
msgstr "Standardne postavke štampanja"

#: tools/resizeoptionsdialog.cpp:501
msgid "Paper size (cm):"
msgstr "Veličina papira (cm):"

#: tools/resizeoptionsdialog.cpp:514
msgid "The standard photographic paper sizes in centimeters."
msgstr "Standardna veličina fotografskog papira u centimetrima."

#: tools/resizeoptionsdialog.cpp:517 tools/resizeoptionsdialog.cpp:565
msgid "Print resolution (dpi):"
msgstr "Rezolucija štampanja (tpi):"

#: tools/resizeoptionsdialog.cpp:526
msgid "The standard print resolutions in dots per inch."
msgstr "Standardna rezolucija štampanja u tačkama po inču."

#: tools/resizeoptionsdialog.cpp:529
msgid "Stretch Image"
msgstr "Razvuci Sliku"

#: tools/resizeoptionsdialog.cpp:530
msgid ""
"If this is selected, the image will be stretched to fit the paper "
"dimensions. Otherwise it will be centered on the canvas and the borders will "
"get cropped to achieve the desired paper size."
msgstr ""
"Ako je ovo odabrano, slika će biti razvučena da se prilagodi dimenzijama "
"papira. Inače će biti postavljena na centar platna i ivice će biti odrezane "
"da bi se postigla željena veličina papira."

#: tools/resizeoptionsdialog.cpp:546
msgid "Printing Custom Settings"
msgstr "Posebne postavke štampanja"

#: tools/resizeoptionsdialog.cpp:549
msgid "Paper width (cm):"
msgstr "Širina papira (cm):"

#: tools/resizeoptionsdialog.cpp:553
msgid "The customized width of the photographic paper size in centimeters."
msgstr "Prilagođena širina fotografskog papira u centimetrima."

#: tools/resizeoptionsdialog.cpp:557
msgid "Paper height (cm):"
msgstr "Visina papira (cm):"

#: tools/resizeoptionsdialog.cpp:561
msgid "The customized height of the photographic paper size in centimeters."
msgstr "Prilagođena visina fotografskog papira u centimetrima."

#: tools/resizeoptionsdialog.cpp:569
msgid "The customized print resolution in dots per inch."
msgstr "Prilagođena rezolucija za štampanje u tačkama po inčima."

#: tools/resizeoptionsdialog.cpp:629
msgid ""
"<p><b>Prepare to print</b>: prepare the image for photographic printing. The "
"user can set the print resolution and the photographic paper size. The "
"target images will be adapted to the specified dimensions (included the "
"background size, margin size, and background color).</p>"
msgstr ""
"<p><b>Spremno za štampanje</b>: pripremi sliku za fotografsko štampanje. "
"Korisnik može podesiti rezoluciju za štampanje i veličinu fotografskog "
"papira. Odredišne slike će biti prilagođene određenim dimenzijama (uključiti "
"veličinu pozadine, veličinu margine, i boju pozadine).</p>"

