#: exif/exifdevice.cpp:225
msgctxt "metering mode"
msgid "Average"
msgstr "Prosječni"

#: exif/exifdevice.cpp:226
msgctxt "metering mode"
msgid "Center weighted average"
msgstr "Centar prosječnog opterećenja"

#: exif/exifdevice.cpp:227
msgctxt "metering mode"
msgid "Spot"
