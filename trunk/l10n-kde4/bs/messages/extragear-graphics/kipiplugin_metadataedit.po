msgstr "Sekvencijalna oblast boje"

#: exif/exifdevice.cpp:287
msgid "Trilinear sensor"
msgstr "Trilinearni senzor"

#: exif/exifdevice.cpp:288
msgid "Color sequential linear"
msgstr "Linearna sekvencijalna boja"

#: exif/exifdevice.cpp:289
msgid ""
"Select here the image sensor type used by the camera to take the picture."
msgstr ""
"Odaberite ovdje tip senzora slike korišten na kameri za snimanje slike."

#: exif/exifdevice.cpp:294
msgid "Scene capture type:"
msgstr "Tip snimanja scene:"

#: exif/exifdevice.cpp:296
msgid "Standard"
msgstr "Standardno"

#: exif/exifdevice.cpp:297
msgid "Landscape"
msgstr "Pejzaž"

#: exif/exifdevice.cpp:298
msgid "Portrait"
msgstr "Portret"

#: exif/exifdevice.cpp:299 xmp/xmpproperties.cpp:98
msgid "Night scene"
msgstr "Noćna scena"

#: exif/exifdevice.cpp:300
msgid "Select here the type of scene used by the camera to take the picture."
msgstr "Odaberite ovdje tip scene korišten na kameri za snimanje slike."

#: exif/exifdevice.cpp:305
msgid "Subject distance type:"
msgstr "Vrsta udaljenosti objekta:"

#: exif/exifdevice.cpp:307
msgid "Unknown"
msgstr "Nepoznat"

#: exif/exifdevice.cpp:308
msgid "Macro"
msgstr "Makro"

#: exif/exifdevice.cpp:309
msgid "Close view"
msgstr "Blizak pogled"

#: exif/exifdevice.cpp:310
msgid "Distant view"
msgstr "Udaljeni pogled"

#: exif/exifdevice.cpp:311
msgid ""
"Select here the type of distance between the subject and the image input "
"equipment."
msgstr "Odaberite ovdje tip udaljenosti između teme i ulazne opreme slike."

#: exif/exiflens.cpp:156
msgid "Focal length (mm):"
msgstr "Fokusna dužina (mm):"

#: exif/exiflens.cpp:162
msgid ""
"Set here the lens focal length in millimeters used by camera to take the "
"picture."
msgstr "Postavite ovdje fokusnu dužinu u milimetrima na kameri za slikanje."

#: exif/exiflens.cpp:167
msgid "Focal length in 35mm film (mm):"
msgstr "Fokusna dužina u 35mm film (mm):"

#: exif/exiflens.cpp:169
msgid ""
"Set here equivalent focal length assuming a 35mm film camera, in mm. A value "
"of 0 means the focal length is unknown."
msgstr ""
"Postavite ovdje ekvivalentu fokusnu dužinu uz pretpostavku da je 35mm film "
"kamera, u mm. Vrijednost 0 znači da je fokusna dužina nepoznata."

#: exif/exiflens.cpp:175
msgid "Digital zoom ratio:"
msgstr "Odnos digitalnog zuma:"

#: exif/exiflens.cpp:181
msgid "Set here the digital zoom ratio used by camera to take the picture."
msgstr ""
"Postavite ovdje omjer digitalnog zumiranja korišten na kameri za snimanje "
"slike."

#: exif/exiflens.cpp:186
msgid "Lens aperture (f-number):"
msgstr "Otvor objektiva (f-broj):"

#: exif/exiflens.cpp:189
msgid "Select here the lens aperture used by camera to take the picture."
msgstr "Odaberite ovdje otvor objektiva korišten na kameri za snimanje slike."

#: exif/exiflens.cpp:194
msgid "Max. lens aperture (f-number):"
msgstr "Max. otvor objektiva (f-broj):"

#: exif/exiflens.cpp:197
msgid ""
"Select here the smallest aperture of the lens used by camera to take the "
"picture."
msgstr ""
"Odaberite ovdje najmanji otvor objektiv korišten na kameri prilikom snimanja "
"slike."

