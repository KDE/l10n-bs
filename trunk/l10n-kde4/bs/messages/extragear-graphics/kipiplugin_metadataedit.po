msgstr "Djelimično"

#: exif/exifdevice.cpp:231
msgctxt "metering mode"
msgid "Other"
msgstr "Ostalo"

#: exif/exifdevice.cpp:232
msgid ""
"Select here the metering mode used by the camera to set exposure when the "
"picture was taken."
msgstr ""
"Odaberite ovdje način mjerenja korišten na kameri za postavljanje "
"ekspozicije kada je slika snimljena."

#: exif/exifdevice.cpp:237
msgid "Sensitivity (ISO):"
msgstr "Osjetljivost (ISO):"

#: exif/exifdevice.cpp:275
msgid "Select here the ISO Speed of the camera which took the picture."
msgstr "Postavite ovdje ISO Brzinu kamere kojom je snimljena slika."

#: exif/exifdevice.cpp:280
msgid "Sensing method:"
msgstr "Metod osjetljivosti:"

#: exif/exifdevice.cpp:282
msgid "Not defined"
msgstr "Neodređeno"

#: exif/exifdevice.cpp:283
msgid "One-chip color area"
msgstr "Jednočipna oblast boje"

#: exif/exifdevice.cpp:284
