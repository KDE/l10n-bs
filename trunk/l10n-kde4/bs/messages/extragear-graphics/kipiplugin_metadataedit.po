#: exif/exifadjust.cpp:98
msgid "Brightness (APEX):"
msgstr "Osvetljaj (APEX):"

#: exif/exifadjust.cpp:103
msgid ""
"Set here the brightness adjustment value in APEX unit used by camera to take "
"the picture."
msgstr ""
"Postavite ovdje vrijednost svjetline u APEX jedinicama na kameri za slikanje."

#: exif/exifadjust.cpp:108
msgid "Gain Control:"
msgstr "Kontrola pojačanja:"

#: exif/exifadjust.cpp:110
msgctxt "gain control"
msgid "None"
msgstr "Nikakvo"

#: exif/exifadjust.cpp:111
msgctxt "gain control"
msgid "Low gain up"
msgstr "Malo povećanje"

#: exif/exifadjust.cpp:112
msgctxt "gain control"
msgid "High gain up"
msgstr "Visoko povećanje"

#: exif/exifadjust.cpp:113
msgctxt "gain control"
msgid "Low gain down"
msgstr "Malo povećanje"

#: exif/exifadjust.cpp:114
msgctxt "gain control"
msgid "High gain down"
msgstr "Veliko povećanje"

#: exif/exifadjust.cpp:115
msgid ""
"Set here the degree of overall image gain adjustment used by camera to take "
"the picture."
msgstr ""
"Postavite ovdje stepen napredovanja cjelokupne slike na kameri za slikanje."

#: exif/exifadjust.cpp:120
msgid "Contrast:"
msgstr "Kontrast:"

#: exif/exifadjust.cpp:122
msgctxt "contrast mode"
msgid "Normal"
msgstr "Normalan"

#: exif/exifadjust.cpp:123
msgctxt "contrast mode"
msgid "Soft"
msgstr "Blag"

#: exif/exifadjust.cpp:124
msgctxt "contrast mode"
msgid "Hard"
msgstr "Jak"

#: exif/exifadjust.cpp:125
msgid ""
"Set here the direction of contrast processing applied by the camera to take "
"the picture."
msgstr "Postavite ovdje smjer obrađivanja kontrasta na kameri za slikanje."

#: exif/exifadjust.cpp:130
msgid "Saturation:"
msgstr "Zasićenje:"

#: exif/exifadjust.cpp:132
msgctxt "saturation mode"
msgid "Normal"
msgstr "Normalan"

#: exif/exifadjust.cpp:133
msgctxt "saturation mode"
msgid "Low"
msgstr "Nizak"

#: exif/exifadjust.cpp:134
msgctxt "saturation mode"
msgid "High"
msgstr "Visok"

#: exif/exifadjust.cpp:135
msgid ""
"Set here the direction of saturation processing applied by the camera to "
"take the picture."
msgstr "Postavite ovdje smjer obrade saturacije na kameri za slikanje."

#: exif/exifadjust.cpp:140
msgid "Sharpness:"
msgstr "Oštrina:"

#: exif/exifadjust.cpp:142
msgctxt "sharpness mode"
msgid "Normal"
msgstr "Normalan"

#: exif/exifadjust.cpp:143
msgctxt "sharpness mode"
msgid "Soft"
msgstr "Blago"

#: exif/exifadjust.cpp:144
msgctxt "sharpness mode"
msgid "Hard"
msgstr "Jaki"

#: exif/exifadjust.cpp:145
msgid ""
"Set here the direction of sharpness processing applied by the camera to take "
"the picture."
msgstr "Odaberite ovdje smjer obrade oštrine na kameri za slikanje."

#: exif/exifadjust.cpp:150
msgid "Custom rendered:"
msgstr "Posebno iscrtavanje:"

#: exif/exifadjust.cpp:152
msgid "Normal process"
msgstr "Normalni proces"

#: exif/exifadjust.cpp:153
msgid "Custom process"
msgstr "Prilagođeni proces"

#: exif/exifadjust.cpp:154
msgid ""
"Set here the use of special processing on image data, such as rendering "
"geared to output."
msgstr ""
"Navedite ovdje specijalnu oradu slike, kao što je iscrtavanje prema izlazu"

#: exif/exifcaption.cpp:107
msgctxt "name of the document this image has been scanned from"
msgid "Name (*):"
msgstr "Ime (*):"

#: exif/exifcaption.cpp:111
msgid ""
"Enter the name of the document from which this image was been scanned. This "
"field is limited to ASCII characters."
msgstr ""
"Unesite ovdje ime dokumenta iz kojeg je ova slika skenirana. Ovo polje je "
"ograničeno sa ASCII znakovima."

#: exif/exifcaption.cpp:117
msgctxt "image title"
msgid "Title (*):"
msgstr "Naslov (*):"

#: exif/exifcaption.cpp:121
msgid "Enter the image title. This field is limited to ASCII characters."
msgstr "Unesite naslov slike. Ovo polje je ograničeno sa ASCII znakovima."

#: exif/exifcaption.cpp:126
msgid "Artist (*):"
msgstr "Umjetnik (*):"

#: exif/exifcaption.cpp:130
msgid ""
"Enter the image author's name. This field is limited to ASCII characters."
msgstr "Unesite ime autora slike. Ovo polje je ograničeno sa ASCII znakovima."

#: exif/exifcaption.cpp:135
msgid "Copyright (*):"
msgstr "Autorska prava (*):"

#: exif/exifcaption.cpp:139
msgid ""
"Enter the copyright owner of the image. This field is limited to ASCII "
"characters."
msgstr ""
"Unesite vlasnika autorskih prava slike. Ovo polje je ograničeno sa ASCII "
"znakovima."

#: exif/exifcaption.cpp:144
msgctxt "image cpation"
msgid "Caption:"
msgstr "Naslov:"

#: exif/exifcaption.cpp:146
msgid ""
"Enter the image's caption. This field is not limited. UTF8 encoding will be "
"used to save the text."
msgstr ""
"Unesite naslov slike. Ovo polje nije ograničeno. UTF8 enkodiranje će biti "
"korišteno da sačuva tekst."

#: exif/exifcaption.cpp:150
#, kde-format
msgid "Sync captions entered through %1"
msgstr "Sinhronizuj naslove unesene kroz %1"

#: exif/exifcaption.cpp:153 iptc/iptccontent.cpp:109 xmp/xmpcontent.cpp:105
msgid "Sync JFIF Comment section"
msgstr "Sinhronizuj odjeljak JFIF komentara"

#: exif/exifcaption.cpp:154
msgid "Sync XMP caption"
msgstr "Sinhronizuj XMP naslov"

#: exif/exifcaption.cpp:155
msgid "Sync IPTC caption (warning: limited to 2000 printable Ascii characters)"
msgstr ""
"Sinhronizuj IPTC naslov (upozorenje: ograničeno do 2000 ispisivih Ascii "
"zakova)"

#: exif/exifcaption.cpp:163 exif/exifdevice.cpp:316
msgid ""
"<b>Note: <b><a href='http://en.wikipedia.org/wiki/EXIF'>EXIF</a></b> text "
"tags marked by (*) only support printable <b><a href='http://en.wikipedia."
"org/wiki/Ascii'>ASCII</a></b> characters.</b>"
msgstr ""
"<b>Bilješka: <b><href='http://en.wikipedia.org/wiki/EXIF'>EXIF</a></b>oznake "
"teksta označene sa (*) samo podržava printanje <b><href='http://en.wikipedia."
"org/wiki/Ascii'>ASCII</a></b> znakovi.</b>"

#: exif/exifdatetime.cpp:111
msgid "Creation date and time"
msgstr "Datum i vrijeme stvaranja"

#: exif/exifdatetime.cpp:112
#, fuzzy
msgid "Creation second"
msgstr "Kreiranje sub-drugog"

#: exif/exifdatetime.cpp:115 iptc/iptcorigin.cpp:425 xmp/xmporigin.cpp:399
#, kde-format
msgid "Sync creation date hosted by %1"
msgstr "Sinhronizuj datum kreiranja od %1"

#: exif/exifdatetime.cpp:118
msgid "Sync XMP creation date"
msgstr "Sinhronizuj XMP datum kreiranja"

#: exif/exifdatetime.cpp:119
msgid "Sync IPTC creation date"
msgstr "Sinhronizuj IPTC datum stvaranja"

#: exif/exifdatetime.cpp:123 iptc/iptcorigin.cpp:432 xmp/xmporigin.cpp:406
msgid "Set creation date to today"
msgstr "Postavi datum kreiranja na danas"

#: exif/exifdatetime.cpp:128
msgid ""
"Set here the date and time of image creation. In this standard it is the "
"date and time the file was changed."
msgstr ""
"Postavite ovdje datum i vrijeme kreiranja slike. U ovom standardu to je "
"datum i vrijeme kada je datoteka izmjenjena."

#: exif/exifdatetime.cpp:130
msgid ""
"Set here the fractions of seconds for the date and time of image creation."
msgstr ""
"Postavite ovdje frakcije u sekundama za datum i vrijeme kreiranja slike."

#: exif/exifdatetime.cpp:137
msgid "Original date and time"
msgstr "Originalni datum i vrijeme"

#: exif/exifdatetime.cpp:138
#, fuzzy
msgid "Original second"
msgstr "Originalni sub-drugi"

#: exif/exifdatetime.cpp:144
msgid "Set original date to today"
msgstr "Postavi originalni datum na danas"

#: exif/exifdatetime.cpp:146
msgid ""
"Set here the date and time when the original image data was generated. For a "
"digital still camera the date and time the picture was taken are recorded."
msgstr ""
"Postavite ovdje datum i vrijeme kad su podaci originalne slike generirani. "
"Kod digitalne kamere datum i vrijeme slikanja su snimljeni."

#: exif/exifdatetime.cpp:149
msgid ""
"Set here the fractions of seconds for the date and time when the original "
"image data was generated."
msgstr ""
"Postavite ovdje frakcije sekundi za datum i vrijeme kada su originalni "
"podaci slike generirani."

#: exif/exifdatetime.cpp:156
msgid "Digitization date and time"
msgstr "Datum i vrijeme digitalizacije"

#: exif/exifdatetime.cpp:157
#, fuzzy
msgid "Digitization second"
msgstr "Digitalizacija sub-drugi"

#: exif/exifdatetime.cpp:163 iptc/iptcorigin.cpp:410 xmp/xmporigin.cpp:388
msgid "Set digitization date to today"
msgstr "Postavi datum digitalizacije na danas"

#: exif/exifdatetime.cpp:165
msgid ""
"Set here the date and time when the image was stored as digital data. If, "
"for example, an image was captured by a digital still camera and at the same "
"time the file was recorded, then Original and Digitization date and time "
"will have the same contents."
msgstr ""
"Postavite ovdje datum i vrijeme kada je slika spašena kao digitalni podatak. "
"Ako je na primjer, slika uslikana sa digitalnom kamerom i ako je u isto "
"vrijeme i datoteka snimljena, Originalni i Digitalizacioni datum i vrijeme "
"će imati isti sadržaj."

#: exif/exifdatetime.cpp:170
msgid ""
"Set here the fractions of seconds for the date and time when the image was "
"stored as digital data."
msgstr ""
"Postavite ovdje frakcije sekunde za datum i vrijeme kada je slika spašena "
"kao digitalni podatak."

#: exif/exifdevice.cpp:133
msgid "Device manufacturer (*):"
msgstr "Proizvođač uređaja (*):"

#: exif/exifdevice.cpp:137
msgid ""
"Set here the manufacturer of image input equipment used to take the picture. "
"This field is limited to ASCII characters."
msgstr ""
"Postavite ovdje proizvođača ulazne opreme korištene za slikanje. Ovo polje "
"je ograničeno sa ASCII znakovima."

#: exif/exifdevice.cpp:142
msgid "Device model (*):"
msgstr "Model uređaja (*):"

#: exif/exifdevice.cpp:146
msgid ""
"Set here the model of image input equipment used to take the picture. This "
"field is limited to ASCII characters."
msgstr ""
"Postavite ovdje modelPostavite ovdje proizvođača ulazne opreme korištene za "
"slikanje. Ovo polje je ograničeno sa ASCII znakovima. ulazne opreme "
"korištene za slikanje. Ovo polje je ograničeno sa ASCII znakovima."

#: exif/exifdevice.cpp:151
msgid "Device type:"
msgstr "Vrsta uređaja:"

#: exif/exifdevice.cpp:153
msgid "Film scanner"
msgstr "Skener filma"

#: exif/exifdevice.cpp:154
msgid "Reflection print scanner"
msgstr "Klasičan skener"

#: exif/exifdevice.cpp:155
msgid "Digital still camera"
msgstr "Digitalni fotoaparat"

#: exif/exifdevice.cpp:156
msgid "Select here the image input equipment type used to take the picture."
msgstr "Postavite ovdje tip ulazne opreme korištene za slikanje."

#: exif/exifdevice.cpp:159
msgid ""
"<b>Warning: EXIF <b><a href='http://en.wikipedia.org/wiki/"
"Exchangeable_image_file_format#MakerNote_data'>Makernotes</a></b> can be "
"unreadable if you set wrong device manufacturer/model description.</b>"
msgstr ""
"<b>Upozorenje: EXIF <b><a href='http://en.wikipedia.org/wiki/"
"Exchangeable_image_file_format#MakerNote_data'>Makernotes</a></b> može biti "
"nemoguće za pročitati ako postavite pogrešnog proizvođača/opis modela.</b>"

#: exif/exifdevice.cpp:171
msgid "Exposure time (seconds):"
msgstr "Vrijeme ekspozicije (sek.):"

#: exif/exifdevice.cpp:176
msgid ""
"Set on this option to set the exposure time of picture, given in seconds."
msgstr ""
"Postavite ovu opciju da postavite vrijeme ekspozicije slike, dato u "
"sekundama."

#: exif/exifdevice.cpp:181
msgid "Exposure program:"
msgstr "Program ekspozicije:"

#: exif/exifdevice.cpp:183
msgctxt "exposure program"
msgid "Not defined"
msgstr "Nije definisano"

#: exif/exifdevice.cpp:184
msgctxt "exposure program"
msgid "Manual"
msgstr "Ručni"

#: exif/exifdevice.cpp:185
msgctxt "exposure program"
msgid "Auto"
msgstr "Automatski"

#: exif/exifdevice.cpp:186
msgctxt "exposure program"
msgid "Aperture priority"
msgstr "Prednost otvora"

#: exif/exifdevice.cpp:187
msgctxt "exposure program"
msgid "Shutter priority"
msgstr "Prednost zatvarača"

#: exif/exifdevice.cpp:188
msgctxt "exposure program"
msgid "Creative program"
msgstr "Kreativni program"

#: exif/exifdevice.cpp:189
msgctxt "exposure program"
msgid "Action program"
msgstr "Akcijski program"

#: exif/exifdevice.cpp:190
msgctxt "exposure program"
msgid "Portrait mode"
msgstr "Portretski način"

#: exif/exifdevice.cpp:191
msgctxt "exposure program"
msgid "Landscape mode"
msgstr "Pejzažni način"

#: exif/exifdevice.cpp:192
msgid ""
"Select here the program used by the camera to set exposure when the picture "
"was taken."
msgstr ""
"Odaberite ovdje program korišten na kameri da postavi ekspoziciju kada je "
"slika snimljena."

#: exif/exifdevice.cpp:197
msgid "Exposure mode:"
msgstr "Režim ekspozicije:"

#: exif/exifdevice.cpp:199
msgctxt "exposure mode"
msgid "Auto"
msgstr "Automatski"

#: exif/exifdevice.cpp:200
msgctxt "exposure mode"
msgid "Manual"
msgstr "Ručno"

#: exif/exifdevice.cpp:201
msgctxt "exposure mode"
msgid "Auto bracket"
msgstr "Automatska potpora"

#: exif/exifdevice.cpp:202
msgid ""
"Select here the mode used by the camera to set exposure when the picture was "
"taken. In auto-bracketing mode, the camera shoots a series of frames of the "
"same scene at different exposure settings."
msgstr ""
"Odaberite ovdje način korišten na kameri da postavi ekspozicicju kada je "
"slika snimljena. U auto-potpornom načinu, kamera snima serije okvira iste "
"scene na različite ekspozicije."

#: exif/exifdevice.cpp:210
msgid "Exposure bias (APEX):"
msgstr "Ekspozicija (APEX):"

#: exif/exifdevice.cpp:215
msgid ""
"Set here the exposure bias value (in APEX units) used by camera to take the "
"picture."
msgstr ""
"Postavite ovdje vrijednost ekspozicije (u APEX jedinicama) korištene na "
"kameri za snimanje slike."

#: exif/exifdevice.cpp:222
