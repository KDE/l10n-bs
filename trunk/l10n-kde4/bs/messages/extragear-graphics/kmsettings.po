"<p><b>Mismatch Handling</b> settings lets you manage different handling "
"situations for differing profiles.</p>\n"
msgstr ""

#. i18n: ectx: property (title), widget (QGroupBox, box_GROUP_BEHAVIOUR_MISSMATCH)
#: kmsettings.ui:342
msgid "Mismatch Handling"
msgstr "Neusklađeno rukovanje"

#. i18n: ectx: property (text), widget (QLabel, label_ACTION_UNTAGGED_ASSIGN)
#: kmsettings.ui:371
msgid "For Non-existent Profile"
msgstr "Za nepostojeće profile"

#. i18n: ectx: property (text), widget (QLabel, label_ACTION_OPEN_MISMATCH_RGB)
#: kmsettings.ui:378
msgid "For RGB Mismatch"
msgstr "Za RGB neusklađenost"

#. i18n: ectx: property (text), widget (QLabel, label_ACTION_OPEN_MISMATCH_CMYK)
#: kmsettings.ui:385
msgid "For CMYK Mismatch"
msgstr "Za CMYK neusklađenost"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_ACTION_UNTAGGED_ASSIGN)
#: kmsettings.ui:396
msgid ""
"<ul>\n"
"<li><b>Do Not Assign Profile:</b> Do nothing to the mismatched profile "
"(leave as is).</li>\n"
"<li><b>Assign Assumed Profile:</b> Assign a profile.</li>\n"
"<li><b>Prompt User:</b> Let the user decide on whether to assign a profile "
"or not.</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li><b>Ne dodijeli profile:</b> Nemoj učiniti ništa za neusklađene profile "
"(ostavi kako jeste).</li>\n"
"<li><b>Dodijeli pretpostavljene profile:</b> Dodijeli profil.</li>\n"
"<li><b>Pitaj korisnika:</b> Neka korisnik odluči da li će dodijeliti profil "
"ili ne.</li>\n"
"</ul>"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_UNTAGGED_ASSIGN)
#: kmsettings.ui:400
msgid "Do Not Assign Profile"
msgstr "Ne dodijeli profil"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_UNTAGGED_ASSIGN)
#: kmsettings.ui:405
msgid "Assign Assumed Profile"
msgstr "Dodijeli pretpostavljeni profil"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_UNTAGGED_ASSIGN)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_RGB)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_CMYK)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:410 kmsettings.ui:436 kmsettings.ui:462 kmsettings.ui:557
#: kmsettings.ui:599
msgid "Prompt User"
msgstr "Pitaj korisnika"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_ACTION_OPEN_MISMATCH_RGB)
#: kmsettings.ui:422
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Allow the source RGB profile to be kept and "
"unchanged from the destination.</li>\n"
"<li><b>Automatically Convert:</b> Convert the source RGB profile to its "
"destination.</li>\n"
"<li><b>Prompt User:</b> Allow the user to choose which method to use.</li>\n"
"</ul>"
msgstr ""

#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_RGB)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_CMYK)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:426 kmsettings.ui:452 kmsettings.ui:542 kmsettings.ui:584
msgid "Preserve Numbers"
msgstr "Sačuvaj brojeve"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_RGB)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_ACTION_OPEN_MISMATCH_CMYK)
#: kmsettings.ui:431 kmsettings.ui:457
msgid "Automatically Convert"
msgstr "Automatski pretvori"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_ACTION_OPEN_MISMATCH_CMYK)
#: kmsettings.ui:448
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Allow the source CMYK profile to be kept and "
"unchanged from the destination.</li>\n"
"<li><b>Automatically Convert:</b> Convert the source CMYK profile to its "
"destination.</li>\n"
"<li><b>Prompt User:</b> Allow the user to choose which method to use.</li>\n"
"</ul>"
msgstr ""

#. i18n: ectx: property (toolTip), widget (QGroupBox, box_GROUP_BEHAVIOUR_MIXED_MODE_DOCUMENTS)
#: kmsettings.ui:488
msgid ""
"<p><b>Mixed Color Space Settings</b> lets you handle color space mismatch "
"options for your monitor and printer.</p>"
msgstr ""

#. i18n: ectx: property (title), widget (QGroupBox, box_GROUP_BEHAVIOUR_MIXED_MODE_DOCUMENTS)
#: kmsettings.ui:491
msgid "Mixed Color Space Settings"
msgstr ""

#. i18n: ectx: property (text), widget (QLabel, label_MIXED_MOD_DOCUMENTS_SCREEN)
#: kmsettings.ui:523
msgid "For Screen"
msgstr "Za ekran"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#: kmsettings.ui:538
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Leave the non-RGB color space as is (no "
"conversion).</li>\n"
"<li><b>Convert to Editing RGB Space:</b> Convert the non-RGB color space "
"into the assigned editing color space.</li>\n"
"<li><b>Convert to Web:</b> Convert the non-RGB color space into the web-"
"appropriate sRGB color space.</li>\n"
"<li><b>Prompt User:</b> Allow the user to select the appropriate color space "
"conversion method.</li>\n"
"</ul>"
msgstr ""

#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#: kmsettings.ui:547
msgid "Convert to Editing RGB Space"
msgstr "Pretvori u uređeni RGB prostor"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_SCREEN)
#: kmsettings.ui:552
msgid "Convert to Web"
msgstr "Pretvori u Web"

#. i18n: ectx: property (text), widget (QLabel, label_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:565
msgid "Printer"
msgstr "Štampač"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:580
msgid ""
"<ul>\n"
"<li><b>Preserve Numbers:</b> Leave the non-CMYK color space as is (no "
"conversion).</li>\n"
"<li><b>Convert to Editing CMYK:</b> Convert the non-CMYK color space into an "
"assigned editing CMYK color space.</li>\n"
"<li><b>Convert to Untagged CMYK:</b> Convert the color space into a non-CMYK "
"color space.</li>\n"
"<li><b>Prompt User:</b> Allow the user to select the appropriate color space "
"conversion method.</li>\n"
"</ul>"
msgstr ""

#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:589
msgid "Convert to Editing CMYK"
msgstr "Pretvori u uređeni CMYK"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_MIXED_MOD_DOCUMENTS_PRINT)
#: kmsettings.ui:594
msgid "Convert to Untagged CMYK"
msgstr "Pretvori u neoznačeni CMYK"

#. i18n: ectx: property (toolTip), widget (QGroupBox, box_GROUP_BEHAVIOUR_PROOF)
#: kmsettings.ui:612
msgid ""
"<p><b>Proofing</b> will allow you to modify color proofing options, "
"including color space, rendering intent, and hard/soft proofing.</b>"
msgstr ""
"<p><b>Korekcije</b> će omogućiti modifikovanje boje opcija korekcije, "
"uključuju prostor boje, cilj iscrtavanja i teške/meke korekcije. </b>"

#. i18n: ectx: property (title), widget (QGroupBox, box_GROUP_BEHAVIOUR_PROOF)
#: kmsettings.ui:615
msgid "Proofing"
msgstr "Korekcije"

#. i18n: ectx: property (text), widget (QLabel, label_PROFILE_PROOF)
#: kmsettings.ui:644
msgid "Color Space:"
msgstr "Oboji prostor:"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_PROFILE_PROOF)
#: kmsettings.ui:651
msgid "Select from a list of profiles applicable for proofing."
msgstr "Izaberi sa liste primjenljive profile za korekciju."

#. i18n: ectx: property (text), widget (QLabel, label_RENDERING_INTENT_PROOF)
#: kmsettings.ui:658
msgid "Rendering Intent:"
msgstr "Cilj iscrtavanja:"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_RENDERING_INTENT_PROOF)
#: kmsettings.ui:668
msgid ""
"<ul>\n"
"<li><b>Relative Colorimetric:</b> Scales the white point of the source gamut "
"into the white point of the target.</li>\n"
"<li><b>Absolute Colorimetric:</b> Preserves in-gamut colors, and clips out-"
"of-gamut colors to the nearest hue.</li>\n"
"</ul>"
msgstr ""

#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT_PROOF)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT)
#: kmsettings.ui:672 kmsettings.ui:755
msgid "Relative Colorimetric"
msgstr "Relativna kolorimetrija"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT_PROOF)
#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT)
#: kmsettings.ui:677 kmsettings.ui:765
msgid "Absolute Colorimetric"
msgstr "Apsolutna kolorimetrija"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, check_PROOF_SOFT)
#: kmsettings.ui:687
msgid ""
"<p>Select <b>Soft Proof</b> as a means to preview the printer's color output "
"on your monitor. (Mostly to match transmissive media.)</p>"
msgstr ""

#. i18n: ectx: property (text), widget (QCheckBox, check_PROOF_SOFT)
#: kmsettings.ui:690
msgid "Soft Proof"
msgstr "Mekan dokaz"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, check_PROOF_HARD)
#: kmsettings.ui:697
msgid ""
"<p>Check <b>Hard Proof</b> (or match print) to fully simulate colors that "
"the printer will be using through a reflective surface.</p>"
msgstr ""

#. i18n: ectx: property (text), widget (QCheckBox, check_PROOF_HARD)
#: kmsettings.ui:700
msgid "Hard Proof"
msgstr "Težak dokaz"

#. i18n: ectx: property (toolTip), widget (QGroupBox, box_GROUP_BEHAVIOUR_RENDERING)
#: kmsettings.ui:714
msgid ""
"<p><b>Rendering Settings</b> allows you to change the global rendering "
"intent.</p>"
msgstr ""

#. i18n: ectx: property (title), widget (QGroupBox, box_GROUP_BEHAVIOUR_RENDERING)
#: kmsettings.ui:717
msgid "Rendering Intent"
msgstr "Namjera sjenčenja"

#. i18n: ectx: property (whatsThis), widget (QComboBox, combo_RENDERING_INTENT)
#: kmsettings.ui:746
msgid ""
"<ul>\n"
"<li><b>Perceptual:</b> Preserves relationship between out-of-gamut colors.</"
"li>\n"
"<li><b>Relative Colorimetric:</b> The white point of the colorspace source "
"is changed to the destination.</li>\n"
"<li><b>Saturation:</b> Preserves accurate saturation, while modifying color "
"hues.</li>\n"
"<li><b>Absolute Colorimetric:</b> The white point of the destination "
"colorspace will become the white point of the source.</li>\n"
"</ul>\n"
msgstr ""

#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT)
#: kmsettings.ui:750
msgid "Perceptual"
msgstr "Perceptualno"

#. i18n: ectx: property (text), item, widget (QComboBox, combo_RENDERING_INTENT)
#: kmsettings.ui:760
msgid "Saturation"
msgstr "Zasićenje"

#. i18n: ectx: property (text), widget (QCheckBox, check_RENDERING_BPC)
#: kmsettings.ui:773
msgid "BlackPointCompensation"
msgstr ""

#. i18n: ectx: property (text), widget (QCheckBox, check_RENDERING_GAMUT_WARNING)
#: kmsettings.ui:780
msgid "Gamut Warning"
msgstr "Skala upozorenja"
