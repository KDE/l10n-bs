#: smugalbum.cpp:108
msgctxt "smug album privacy"
msgid "Public"
msgstr "Javno"

#: smugalbum.cpp:111
msgid "Public album is listed on your public SmugMug page."
msgstr "Javni album je uvršten na javnoj SmugMug stranicu."

#: smugalbum.cpp:112
msgctxt "smug album privacy"
msgid "Unlisted"
msgstr "Nije na listi"

