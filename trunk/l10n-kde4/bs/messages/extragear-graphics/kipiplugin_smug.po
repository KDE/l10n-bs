msgid "Unlisted album is only accessible via URL."
msgstr "Nenavedeni album je dostupan samo preko URL-a."

#: smugalbum.cpp:122
msgid "Require password to access the album (optional)."
msgstr "Zahtijevaj lozinku za pristup albumu (neobavezno)"

