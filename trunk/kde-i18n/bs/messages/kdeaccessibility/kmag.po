#: kmagzoomview.cpp:116
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified if zoom level is set."
msgstr ""
"Ovo je glavni prozor, koji pokazuje "
"sadržaj izabrane oblasti. Sadržaj će biti "
"uvećan ako je zadat nivo uvećanja."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Adnan Sadzak"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "sadzak@inet.ba"

#: main.cpp:37
msgid "File to open"
msgstr "Datoteka koja treba da se otvori"

#: main.cpp:45
msgid "KMagnifier"
msgstr "KMagnifier"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "Povećavanje ekrana za KDE"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "Ponovno pisanje i trenutni održavalac"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "Prvobitna ideja i autor (KDE1)"

#: main.cpp:58
msgid "Various patches"
msgstr "Razne zakrpe"

#: main.cpp:59
msgid "Some tips"
msgstr "Neki savjeti"

#: rc.cpp:5
msgid "Other &Settings"
msgstr "Ostale &postavke"

#: kmag.cpp:87
msgid "&Very Low"
msgstr "&Vrlo nisko"

#: kmag.cpp:87
msgid "&Low"
msgstr "&Nisko"

#: kmag.cpp:87
msgid "&Medium"
msgstr "&Srednje"

#: kmag.cpp:87
msgid "&High"
msgstr "V&isoko"

#: kmag.cpp:87
msgid "V&ery High"
msgstr "V&rlo visoko"

#: kmag.cpp:122
msgid "New &Window"
msgstr "Novi &prozor"

#: kmag.cpp:124
msgid "Open a new KMagnifier window"
msgstr "Otvara se novi prozor KMagnifier-a"

#: kmag.cpp:126
msgid "&Stop"
msgstr "&Zaustavi"

#: kmag.cpp:128
msgid "Click to stop window refresh"
msgstr ""
"Kliknite ovdje da biste zaustavili "
"osvežavanje prozora"

#: kmag.cpp:129
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Klikom na ovu ikonu, osvežavanje prikaza "
"biće <b>pokrenuto</b>/<b>zaustavljeno</b>. "
"Zaustavljanjem osvežavanje anuliraće se "
"potrebno procesorsko vrijeme."

#: kmag.cpp:133
msgid "&Save Snapshot As..."
msgstr "&Sačuvaj snimak kao..."

#: kmag.cpp:135
msgid "Saves the zoomed view to an image file."
msgstr "Snima se uveličan prikaz u datoteku."

#: kmag.cpp:136
msgid "Save image to a file"
msgstr "Snimi sliku u datoteku"

#: kmag.cpp:139
msgid "Click on this button to print the current zoomed view."
msgstr ""
"Klikom na ovo dugme odštampaće se tekući "
"uveličani prikaz."

#: kmag.cpp:142 kmag.cpp:143
msgid "Quits the application"
msgstr "Izlazi se iz programa"

#: kmag.cpp:146
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Klikom na ovo dugme kopiraće se tekući "
"uveličani prikaz u clipboard, odakle ga "
"možete prenijeti u druge programe."

#: kmag.cpp:147
msgid "Copy zoomed image to clipboard"
msgstr "Kopiraj uveličanu sliku u clipboard"

#: kmag.cpp:149
msgid "Show &Menu"
msgstr "Prikaži &meni"

#: kmag.cpp:151
msgid "Show Main &Toolbar"
msgstr "Prikaži glavnu &traku sa alatima"

#: kmag.cpp:153
msgid "Show &View Toolbar"
msgstr "Prikaži traku za &prikaz"

#: kmag.cpp:155
msgid "Show &Settings Toolbar"
msgstr "Prikažu traku sa p&ostavkama"

#: kmag.cpp:159
msgid "&Always Fit Window"
msgstr "&Uvijek uklopi prozor"

#: kmag.cpp:162
msgid "&Fit Window"
msgstr "&Uklopi prozor"

#: kmag.cpp:164
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr ""
"Kliknite na ovo dugme da biste uklopili "
"uveličani prikaz u prozor za uveličavanje."

#: kmag.cpp:165
msgid "Maximize the use of the window"
msgstr "Maksimizuj iskorištenost prozora"

#: kmag.cpp:167
msgid "&Follow Mouse"
msgstr "&Prati miša"

#: kmag.cpp:169
msgid "Magnify around the mouse cursor"
msgstr "Uveličaj oko strelice miša"

#: kmag.cpp:170
msgid "If selected, the area around the mouse cursor is magnified"
msgstr ""
"Ako je ovo izabrano, oblast oko strelice "
"miša će biti uveličavana"

#: kmag.cpp:172
msgid "Hide Mouse &Cursor"
msgstr "Sakrij &strelicu miša"

#: kmag.cpp:174
msgid "Hide the mouse cursor"
msgstr "Sakriva se strelica miša"

#: kmag.cpp:176
msgid "Selection &Window"
msgstr "Prozor za &izbor"

#: kmag.cpp:178
msgid "Show the selection window on the screen"
msgstr "Prikazuje se na ekranu prozor za izbor"

#: kmag.cpp:181
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr ""
"Kliknite na ovo dugme da biste "
"<b>uveličali</b> izabranu oblast."

#: kmag.cpp:185
msgid "Select the zoom factor."
msgstr "Izaberite faktor uveličanja."

#: kmag.cpp:186
msgid "Zoom factor"
msgstr "Faktor uveličanja"

#: kmag.cpp:189
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr ""
"Kliknite na ovo dugme da biste "
"<b>umanjili</b> izabranu oblast."

#: kmag.cpp:197
msgid "&Refresh"
msgstr "&Osvježavanje"

#: kmag.cpp:199
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Ovdje birate učestanost osvežavanja. Što je "
"učestanost veća, potrebno je više "
"procesorske snage."

#: kmag.cpp:200
msgid "Refresh rate"
msgstr "Učestanost osvježavanja"

#: kmag.cpp:468
msgid "Save Zoomed Region"
msgstr "Snimi uveličanu oblast"

#: kmag.cpp:475
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Ne može da se snimi privremena datoteka (prije "
"spajanja u mrežnu datoteku koji ste naveli)."

#: kmag.cpp:476 kmag.cpp:480 kmag.cpp:492
msgid "Error Writing File"
msgstr "Greška pri pisanju datoteke"

#: kmag.cpp:479
msgid "Unable to upload file over the network."
msgstr "Datoteka ne može da se snimi na mrežu."

#: kmag.cpp:482 kmag.cpp:494
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Tekuća uveličana slika je snimljena u\n"
"%1"

#: kmag.cpp:491
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Datoteka ne može da se snimi. Provjerite da li "
"imate dozvolu za upisivanje u "
"direktorij."

#: kmag.cpp:511
msgid "Click to stop window update"
msgstr ""
"Kliknite ovdje da biste zaustavili "
"osvježavanje prozora"

#: kmag.cpp:514
msgid "Start"
msgstr "Pokreni"

#: kmag.cpp:515
msgid "Click to start window update"
msgstr ""
"Kliknite ovdje da biste pokrenuli "
"osvježavanje prozora"

