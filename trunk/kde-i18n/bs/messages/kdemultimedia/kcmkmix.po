#: mixconfig.cpp:55
msgid "Default Volumes"
msgstr "Podrazumjevana glasnoća"

#: mixconfig.cpp:63
msgid "Save Current Volumes"
msgstr "Spasi trenutne glasnoće"

#: mixconfig.cpp:68
msgid "Load Volumes"
msgstr "Učitaj glasnoće"

#: mixconfig.cpp:73
msgid "Load volumes on login"
msgstr "Učitaj glasnoće po prijavi"

#: mixconfig.cpp:78
msgid "Hardware Settings"
msgstr "Hardverske postavke"

#: mixconfig.cpp:85
msgid "Maximum number of probed mixers"
msgstr "Maksimalan broj ispitanih miksera"

#: mixconfig.cpp:89
msgid ""
"Change this value to optimize the startup time of kmix.\n"
"High values mean that kmix probes for many soundcards. If you have more "
"mixers installed than kmix detects, increase this value."
msgstr ""
"Promjenite ovu vrijednost kako biste optimizirali vrijeme pokretanja kmix-a.\n"
"Visoke vrijednosti znače da kmix traži mnoge zvučne kartice. Ako ste instalirali "
"više miksera nego ih kmix prepoznaje, povećajte ovu vrijednost."

#: mixconfig.cpp:97
msgid "Maximum number of probed devices per mixer"
msgstr "Maksimalan broj ispitanih uređaja po mikseru"

#: mixconfig.cpp:102
msgid ""
"Change this value to optimize the startup time of kmix. High values mean "
"that kmix probes for many devices per soundcard driver.\n"
"If there are more mixer sub devices in a driver than kmix detects, increase "
"this value"
msgstr ""
"Promjenite ovu vrijednost kako biste optimizirali vrijeme pokretanja kmix-a. "
"Visoke vrijednosti znače da kmix traži mnoge uređaje za svaki drajver "
"zvučne kartice.\n"
"Ako ste instalirali više mikserskih poduređaja za drajver nego ih kmix "
"prepoznaje, povećajte ovu vrijednost"

#: mixconfig.cpp:122
msgid "Restoring default volumes"
msgstr "Vraćam podrazumjevane vrijednosti"

#: mixconfig.cpp:129 mixconfig.cpp:156
msgid "The kmixctrl executable can't be found."
msgstr "Ne mogu pronaći kmixctrl izvršnu datoteku."

#: mixconfig.cpp:149
msgid "Saving default volumes"
msgstr "Spašavam podrazumjevane glasnoće"

