#: plugin_webarchiver.cpp:59
msgid "&Archive Web Page"
msgstr "&Arhiviraj web stranicu"

#: plugin_webarchiver.cpp:78
msgid "Save Page as Web-Archive"
msgstr "Sačuvaj stranicu kao Web arhivu"

#: plugin_webarchiver.cpp:83
msgid "Invalid URL"
msgstr "Pogrešan URL"

#: plugin_webarchiver.cpp:84
msgid ""
"This URL \n"
" %1 \n"
" is not valid."
msgstr ""
"Ovaj URL \n"
" %1 \n"
" nije ispravan."

#: plugin_webarchiver.cpp:91
msgid "File exists"
msgstr "Datoteka već postoji"

#: plugin_webarchiver.cpp:92
msgid ""
"Do you really want to overwrite: \n"
"%1?"
msgstr ""
"Da li zaista želite pisati preko ove datoteke: \n"
"%1?"

#: plugin_webarchiver.cpp:115
msgid "Archiving webpage completed."
msgstr "Arhiviranje web stranice završeno."

#: plugin_webarchiver.cpp:122
msgid "Couldn't open Web-Archive"
msgstr "Ne mogu otvoriti Web arhivu"

#: plugin_webarchiver.cpp:123
msgid ""
"Sorry, couldn't open \n"
" %1 \n"
" for writing."
msgstr ""
"Izvinite, ne mogu otvoriti \n"
" %1 \n"
" za pisanje."

#: plugin_webarchiver.cpp:152 plugin_webarchiver.cpp:153
msgid "Couldn't open a temporary file"
msgstr "Ne mogu otvoriti privremenu datoteku"
