#: kcmmediacontrol.cpp:197
msgid ""
"<h1>MediaControl</h1> This module allows you to configure the MediaControl "
"applet for KDE's panel."
msgstr ""
"<h1>MediaControl</h1> Ovaj modul vam dozvoljava da podesite MediaControl "
"applet za KDE-ov panel."

#: rc.cpp:1
msgid "KCMMediaControlWidget"
msgstr "KCMMediaControlWidget"

#: rc.cpp:4
msgid "General"
msgstr "Općenito"

#: rc.cpp:5
msgid "Media-Player"
msgstr "Media-Player"

#: rc.cpp:6
msgid "Select the multimedia-player you are using in this box"
msgstr "Izaberite multimedia-player koji koristite u ovom boksu"

#: rc.cpp:8
msgid "Mousewheel scrolling amount"
msgstr "Veličina koju će točak od miša pomjeriti"

#: rc.cpp:9
msgid "Sets the amount a mousewheel will scroll in the current file"
msgstr "Podešava veličinu koju se točkić na mišu pomjeriti u trenutnoj datoteci"

#: rc.cpp:10
msgid "Themes"
msgstr "Teme"

#: rc.cpp:11
msgid "Use Themes"
msgstr "Koristi teme"

#: rc.cpp:12
msgid "default"
msgstr "uobičajeno"

#: rc.cpp:13
msgid "Preview"
msgstr "Pregled"

#: rc.cpp:14
msgid "Shows you how the selected theme will look"
msgstr "Prikazuje kako će izabrana tema izgledati"

