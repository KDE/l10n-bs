#: plugin_katexmltools.cpp:143
msgid "&Insert Element..."
msgstr "&Umetni element..."

#: plugin_katexmltools.cpp:145
msgid "&Close Element"
msgstr "&Zatvori element"

#: plugin_katexmltools.cpp:147
msgid "Assign Meta &DTD..."
msgstr "Dodijeli meta &DTD..."

#: plugin_katexmltools.cpp:417
msgid "Assign Meta DTD in XML Format"
msgstr "Dodijeli meta DTD u XML formatu"

#: plugin_katexmltools.cpp:420
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr ""
"Trenutna datoteka je identifikovana kao dokument tipa \"%1\". Meta DTD za "
"ovaj tip dokumenta će sada biti učitan."

#: plugin_katexmltools.cpp:423
msgid "Loading XML Meta DTD"
msgstr "Učitavam XML meta DTD"

#: plugin_katexmltools.cpp:447
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "Ne mogu otvoriti datoteku '%1'. Server je vratio grešku."

#: plugin_katexmltools.cpp:449 pseudo_dtd.cpp:51 pseudo_dtd.cpp:60
msgid "XML Plugin Error"
msgstr "Greška XML dodatka"

#: plugin_katexmltools.cpp:927
msgid "Insert XML Element"
msgstr "Umetni XML element"

#: plugin_katexmltools.cpp:950
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr ""
"Unesite ime i atribute XML taga (\"<\", \">\" i zatvoreni tag će biti "
"automatski uneseni):"

#: pseudo_dtd.cpp:49
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr ""
"Ne mogu obraditi datoteku '%1'. Molim provjerite da li je datoteka ispravno "
"formiran XML."

#: pseudo_dtd.cpp:55
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr ""
"Datoteka '%1' nije u očekivanom formatu. Molim provjerite da li je datoteka "
"tipa:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"Ovakve datoteke možete napraviti koristeći dtdparse. Pogledajte "
"dokumentaciju Kate dodatka za više informacija."

#: pseudo_dtd.cpp:70
msgid "Analyzing meta DTD..."
msgstr "Analiziram meta DTD..."

#: rc.cpp:2
#, no-c-format
msgid "&XML"
msgstr "&XML"
