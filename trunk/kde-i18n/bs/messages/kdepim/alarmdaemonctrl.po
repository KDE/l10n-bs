#: alarmdaemonctrl.cpp:58
msgid "&Start alarm client automatically at login"
msgstr "&Pokreni alarm klijent automatski prilikom prijave"

#: alarmdaemonctrl.cpp:61
msgid "Check to start the alarm client whenever you start a KDE session."
msgstr ""
"Uključite ako želite da se alarm klijent pokrene svaki put prilikom pokretanja "
"KDE sesije."

#: alarmdaemonctrl.cpp:66
msgid "Chec&k interval: "
msgstr "Interval &provjere: "

#: alarmdaemonctrl.cpp:71
msgid " minutes"
msgstr " minuta"

#: alarmdaemonctrl.cpp:72
msgid "1 minute"
msgstr "1 minuta"

#: alarmdaemonctrl.cpp:77
msgid "How often (in minutes) the alarm daemon should check for alarms becoming due."
msgstr "Koliko često (u minutama) će alarm demon provjeriti da li je vrijeme za alarme."

#: alarmdaemonctrl.cpp:99
msgid ""
"<h1>Alarm Daemon</h1> This module allows you to configure the KDE alarm "
"daemon."
msgstr ""
"<h1>Alarm demon</h1> Ovaj modul vam omogućuje da podesite KDEov "
"alarm demon."

