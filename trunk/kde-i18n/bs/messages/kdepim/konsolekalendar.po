#: main.cpp:193
msgid ""
"\n"
"KonsoleKalendar supports these export formats:\n"
"  Text [Default]\n"
"  HTML\n"
"  CSV (Comma-Separated Values)"
msgstr ""
"\n"
"KonsoleKalendar podržava ove izvozne formate:\n"
"  Tekst (uobičajeno)\n"
"  HTML\n"
"  CSV (vrijednosti razdvojene zarezom)"

