msgid "Emails cannot be canceled or superseded!"
msgstr "Email ne može biti otkazan ili prepisan!"

#: knarticlefactory.cpp:920
msgid "Cancel messages cannot be canceled or superseded!"
msgstr "Otkaži poruke ne može biti otkazan ili prepisan!"

#: knarticlefactory.cpp:925
msgid "Only sent articles can be canceled or superseded!"
msgstr "Samo poslani članci mogu biti otkazani ili prepisani!"

#: knarticlefactory.cpp:930
msgid "This article has already been canceled or superseded!"
msgstr "Ovaj članak je več otkazan ili prepisan!"

#: knarticlefactory.cpp:937
msgid ""
"This article cannot be canceled or superseded,\n"
"because its message-id has not been created by KNode!\n"
"But you can look for your article in the newsgroup\n"
"and cancel (or supersede) it there."
msgstr ""
"Ovaj članak ne može biti otkazan ili prepisan,\n"
"jer njegov message-id nije napravio Knode!\n"
"Pokušajte potražiti vaš članak u news grupi\n"
"i otkazati (ili prepisati) ga tamo."

#: knarticlefactory.cpp:974
msgid ""
"This article does not appear to be from you.\n"
"You can only cancel or supersede your own articles."
msgstr ""
"Izgleda da ovaj članak niste poslali vi.\n"
"Možete otkazati ili prepisati samo svoje članke."

#: knarticlefactory.cpp:979
msgid ""
"You have to download the article body\n"
"before you can cancel or supersede the article."
msgstr ""
"Morate skinuti tijelo članka\n"
"prije nogo što ga otkažete ili prepišete."

