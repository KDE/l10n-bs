msgid ""
"You have aborted the posting of articles. The unsent articles are stored in "
"the \"Outbox\" folder."
msgstr ""
"Prekinuli ste slanje članaka. Neposlani članci su smješteni u "
"direktorij \"Izlazna Pošta\"."

#: knarticlefactory.cpp:784
msgid ""
"Please set a hostname for the generation\n"
"of the message-id or disable it."
msgstr ""
"Molim podesite hostname za generiranje\n"
"message-id ili isključite ovu opciju."

#: knarticlefactory.cpp:830
msgid "Please enter a valid email address."
msgstr "Molim unesite validnu email adresu."

