#: rc.cpp:2
#, no-c-format
msgid "Config Dialog"
msgstr "Dijalog za podešavanje"

#: rc.cpp:4
#, no-c-format
msgid "Title &Alignment"
msgstr "&Poravnanje naslova"

#: rc.cpp:12
#, no-c-format
msgid "Use shadowed &text"
msgstr "Koristi &tekst sa sijenkom"

#: rc.cpp:14
#, no-c-format
msgid ""
"Check this option if you want the titlebar text to have a 3D look with a "
"shadow behind it."
msgstr ""
"Uključite ovu opciju ako želite da tekst u naslovnoj traci ima 3D izgled "
"sa sijenkom u pozadini."

#: rc.cpp:16
#, no-c-format
msgid "Animate buttons"
msgstr "Animiraj dugmad"

#: rc.cpp:18
#, no-c-format
msgid ""
"Check this option if you want the buttons to fade in when the mouse pointer "
"hovers over them and fade out again when it moves away."
msgstr ""
"Uključite ovu opciju ako želite da se dugme pojavi kada se pokazivač "
"miša nalazi iznad njega a nestane kada se pokazivač skloni."

#: rc.cpp:20
#, no-c-format
msgid "Close windows by double clicking the menu button"
msgstr "Zatvaraj prozore dvostrukim klikom na menu dugme"

#: rc.cpp:22
#, no-c-format
msgid ""
"Check this option if you want windows to be closed when you double click the "
"menu button, similar to Microsoft Windows."
msgstr ""
"Uključite ovu opciju ako želite da možete zatvoriti prozor dvostrukim "
"klikom na dugme \"Menu\" (ikona aplikacije), kao što je slučaj u Microsoft "
"Windowsu."

#~ msgid "Alt+T"
#~ msgstr "Alt+T"
