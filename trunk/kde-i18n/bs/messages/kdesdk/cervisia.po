msgid "CVS Checkout"
msgstr "CVS checkout"

#: checkoutdlg.cpp:48
msgid "CVS Import"
msgstr "CVS uvoz"

#: checkoutdlg.cpp:74 checkoutdlg.cpp:90
msgid "&Module:"
msgstr "&Modul:"

#: checkoutdlg.cpp:81 mergedlg.cpp:50 tagdlg.cpp:53 updatedlg.cpp:50
msgid "Fetch &List"
msgstr "Dobavi &listu"

#: checkoutdlg.cpp:96
msgid "&Branch tag:"
msgstr "Tag &grane:"

#: checkoutdlg.cpp:115
msgid "Working &folder:"
msgstr "Radni &direktorij:"

#: checkoutdlg.cpp:124
msgid "&Vendor tag:"
msgstr "Oznaka &proizvođača:"

#: checkoutdlg.cpp:131
msgid "&Release tag:"
msgstr "Oznaka &izdanja:"

#: checkoutdlg.cpp:138
msgid "&Ignore files:"
msgstr "Ig&noriši datoteke:"

#: checkoutdlg.cpp:145
msgid "&Comment:"
msgstr "&Komentar:"

#: checkoutdlg.cpp:148
msgid "Import as &binaries"
msgstr "Uvezi kao &binarne"

#: checkoutdlg.cpp:244
msgid "Please choose an existing working folder."
msgstr "Izaberite postojeći radni direktorij."

#: checkoutdlg.cpp:249
msgid "Please specify a module name."
msgstr "Navedite ime modula."

#: checkoutdlg.cpp:258
msgid "Please specify a vendor tag and a release tag."
msgstr "Navedite oznaku proizvođača i oznaku izdanja."

#: checkoutdlg.cpp:264
