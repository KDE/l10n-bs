#: kbabel/prefwidgets.cpp:858
msgid "&Show surrounding quotes"
msgstr "Prikaži poruke između &navodnika"

#: kbabel/prefwidgets.cpp:860
msgid ""
"<qt>"
"<p><b>Appearance</b></p>"
"<p>These options let you configure the appearance for the message "
"editor.</p>"
"<p>Check <b>Highlight syntax</b> to let KBabel display special characters, "
"like \\\" and \\n, in different colors.</p>"
"<p>The three other options will help you to \"see\" whitespace characters. "
"<b>Mark whitespace with points</b> draws a small point instead of a "
"whitespace, <b>Highlight background</b> colors the background of the "
"characters and <b>Show surrounding quotes</b> displays quotes at the "
"beginning and end of each line.</p></qt>"
msgstr ""

