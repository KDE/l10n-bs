#: rip/k3bcddbpatternwidget.cpp:119
msgid ""
"<p><b>Pattern special strings:</b><ul>\n"
"<li>%a - artist of the track\n"
"<li>%t - title of the track\n"
"<li>%n - track number\n"
"<li>%y - year of the CD\n"
"<li>%e - extended information about the track\n"
"<li>%g - genre of the CD\n"
"<li>%r - album artist (differs from %a only on soundtracks or compilations)\n"
"<li>%m - album title\n"
"<li>%x - extended information about the CD\n"
"<li>%d - current date\n"
"</ul>"
msgstr ""
"<p><b>Specijalni stringovi:</b><ul>\n"
"<li>%a - izvođač\n"
"<li>%t - naslov\n"
"<li>%n - broj\n"
"<li>%y - godina\n"
"<li>%e - dodatne informacije o stazi\n"
"<li>%g - žanr CD-a\n"
"<li>%r - izvođač albuma \n"
"<li>%m - naslov albuma\n"
"<li>%x - dodatne informacije o CD\n"
"<li>%d - trenutni datum\n"
"</ul>"

