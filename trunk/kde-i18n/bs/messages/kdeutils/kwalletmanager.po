msgid "Name-Value Map: %1"
msgstr "Naziv-vrijednost mape: %1"

#: kwalleteditor.cpp:347 kwalleteditor.cpp:593
#, c-format
msgid "Binary Data: %1"
msgstr "Binarni podaci: %1"

#: kwalleteditor.cpp:394
msgid ""
"<qt><br />"
"<center><table width=\"90%\">"
"<tr><td bgcolor=\"#99ccff\"><font "
"size=\"+2\">&nbsp;%1</font>&nbsp;&nbsp;<font "
