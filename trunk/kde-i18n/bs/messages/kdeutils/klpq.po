#: main.cpp:38
msgid "KDE Print Queue utility."
msgstr "KDE Alat za Ispisni red."

#: main.cpp:43
msgid "Print to 'printer'"
msgstr "Ispiši na 'štampaču'"

#: main.cpp:44
msgid "Files to print"
msgstr "Datoteke koje treba ispisati"

#: main.cpp:50
msgid "Print Queue"
msgstr "Red Ispisa"

#: main.cpp:140
msgid "Sorry, can't open your printcap file."
msgstr "Žalim, ne mogu otvoriti printcap datoteku."

#: main.cpp:145
msgid ""
"Unable to parse your printcap - probably you haven't configured any printers "
"yet."
msgstr ""
"Ne mogu parsirati vaš printcap - vjerojatno još niste podesili nijedan "
"štampač."

#: klpq.cpp:69
msgid "Printer Configuration"
msgstr "Postavke štampača"

#: klpq.cpp:79
msgid "Printer name:"
msgstr "Ime štampača:"

#: klpq.cpp:86
msgid "Queuing"
msgstr "Stavljam u red"

#: klpq.cpp:90
msgid "Printing"
msgstr "Ispisujem"

#: klpq.cpp:96
msgid "Rank"
msgstr "Rang"

#: klpq.cpp:98
msgid "Owner"
msgstr "Vlasnik"

#: klpq.cpp:99
msgid "Job"
msgstr "Posao"

#: klpq.cpp:102
msgid "Size"
msgstr "Veličina"

#: klpq.cpp:123 klpq.cpp:166
msgid "Make Top"
msgstr "Stavi na vrh"

#: klpq.cpp:134
msgid "Auto"
msgstr "Auto"

#: klpq.cpp:139
msgid "Update"
msgstr "Osvježi"

#: klpq.cpp:146
msgid "&Update Frequency..."
msgstr "Promijeni &frekvenciju..."

#: klpq.cpp:148
msgid "&Spooler..."
msgstr "&Spooler..."

#: klpq.cpp:319
msgid "Do you really want to remove job No %1?"
msgstr "Želite li zaista ukloniti posao br. %1?"

#: klpq.cpp:322
msgid "Do you really want to remove the marked jobs?"
msgstr "Želite li zaista ukloniti označene poslove?"

#: klpq.cpp:357
msgid ""
"Do you really want to move job No %1\n"
"to top of queue?"
msgstr ""
"Želite li zaista pomaknuti posao br. %1\n"
"na vrh reda?"

#: klpq.cpp:360
msgid ""
"Do you really want to move the marked\n"
"jobs to top of queue?"
msgstr ""
"Želite li zaista pomaknuti označene poslove\n"
"na vrh reda?"

#: klpq.cpp:506 klpq.cpp:512 klpq.cpp:529
msgid "This is a privileged command and you do not have permission to execute it."
msgstr "Ovo je privilegovana komanda a vi nemate privilegije da je izvršite."

#: klpq.cpp:508 klpq.cpp:514 klpq.cpp:531
msgid "Permission denied"
msgstr "Pristup odbijen"

#: klpq.cpp:581
msgid ""
"<qt>Could not print some of the files. Please make sure you have access to "
"all files and that they are not directories.</qt>"
msgstr ""
"<qt>Nisam uspio ispisate neke datoteke. Provjerite da li imate pristup svim "
"datotekama i da te datoteke nisu direktoriji.</qt>"

#: ConfAutoUpdate.cpp:16
msgid "Update Frequency"
msgstr "Promijeni frekvenciju"

#: ConfAutoUpdate.cpp:30
msgid "Update frequency in seconds:"
msgstr "Frekvencija osvježavanja (sek):"

#: klpqspooler.cpp:115 klpqspooler.cpp:353
msgid "(standard input)"
msgstr "(standardni upis)"

#: klpqspooler.cpp:223
msgid ""
"Sorry, I can't find your lpc program.\n"
"Please check the configuration under Options->Spooler."
msgstr ""
"Žalim, ne mogu naći lpc program.\n"
"Provjerite postavke pod Opcije->Spooler."

#: klpqspooler.cpp:225 klpqspooler.cpp:302
msgid "Can't find your lpc program!"
msgstr "Ne mogu naći lpc program!"

#: klpqspooler.cpp:300
msgid ""
"Sorry, I can't find your lpc program.\n"
"Please check the configuration under Config->Spooler."
msgstr ""
"Žalim, ne mogu naći lpc program.\n"
"Provjerite postavke pod Opcije->Spooler."

#: FirstStart.cpp:12 SpoolerConfig.cpp:42
msgid "Select your spooling system"
msgstr "Izaberite spooling sistem"

#: FirstStart.cpp:16
msgid ""
"<qt>Please select the spooling system you use. Most systems use the "
"<b>BSD</b> spooler. So if you don't know which spooler is installed on your "
"system, BSD is probably a good choice.</qt>"
msgstr ""
"<qt>Izaberite spooling sistem koji koristite. Većina sistema koristi "
"<b>BSD</b> spooler. Ako ne znate koji spooler imate, instaliran BSD je "
"vjerojatno dobar izbor.</qt>"

