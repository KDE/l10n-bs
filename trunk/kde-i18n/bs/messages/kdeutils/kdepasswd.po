#: kdepasswd.cpp:25
msgid "Change password of this user."
msgstr "Promijeni šifru ovog korisnika."

#: kdepasswd.cpp:32
msgid "KDE passwd"
msgstr "KDE passwd"

#: kdepasswd.cpp:33
msgid "Changes a UNIX password."
msgstr "Mijenja UNIX šifru."

#: kdepasswd.cpp:35
msgid "Maintainer"
msgstr "Održavatelj"

#: kdepasswd.cpp:51
msgid "You need to be root to change the password of other users."
msgstr "Trebate biti root da biste mijenjali šifre drugih korisnika."

#: passwddlg.cpp:19 passwddlg.cpp:87
msgid "Change Password"
msgstr "Promjena šifre"

#: passwddlg.cpp:20
msgid "Please enter your current password."
msgstr "Molim unesite vašu trenutnu šifru."

#: passwddlg.cpp:41 passwddlg.cpp:159
msgid "Conversation with `passwd' failed."
msgstr "\"Konverzacija\" sa komandom 'passwd' nije uspjela."

#: passwddlg.cpp:51
msgid "Could not find the program `passwd'."
msgstr "Ne mogu pronaći program 'passwd'."

#: passwddlg.cpp:56
msgid "Incorrect password! Please try again."
msgstr "Netačna šifra! Molim pokušajte kasnije."

#: passwddlg.cpp:60
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr ""
"Unutrašnja greška: ilegalna vrijednost vraćena od "
"PasswdProcessa::checkCurrent."

#: passwddlg.cpp:89
msgid "Please enter your new password."
msgstr "Molim unesite vašu novu šifru."

#: passwddlg.cpp:91
msgid "Please enter the new password for user <b>%1</b>."
msgstr "Molim unesite novu šifru za korisnika <b>%1</b>."

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Vaša šifra je duža od 8 znakova. Na nekim sistemima ovo može dovesti do "
"problema. Možete skratiti šifru na 8 znakova, ili je ostaviti kako jeste."

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Šifra je duža od 8 znakova. Na nekim sistemima ovo može dovesti do "
"problema. Možete skratiti šifru na 8 znakova, ili je ostaviti kako jeste."

#: passwddlg.cpp:115
msgid "Password too long"
msgstr "Šifra je predugačka"

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "Skrati"

#: passwddlg.cpp:117
msgid "Use as is"
msgstr "Ostavi"

#: passwddlg.cpp:138
msgid "Your password has been changed."
msgstr "Vaša šifra je promijenjena."

#: passwddlg.cpp:148
#, fuzzy
msgid "Your password has not been changed."
msgstr "Vaša šifra je promijenjena."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Amila Akagić"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "bono@linux.org.ba"

#~ msgid "Conversation with `passwd' failed:\n"
#~ msgstr "\"Konverzacija\" sa komandom 'passwd' nije uspjela:\n"

#~ msgid "Your password will be truncated to 8 characters."
#~ msgstr "Vaša šifra će biti smanjena na 8 karaktera."
