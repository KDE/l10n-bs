#: Editor.cpp:86
msgid "Edit Board Layout"
msgstr "Izmijeni raspored ploče"

#: Editor.cpp:115
msgid "New board"
msgstr "Nova ploča"

#: Editor.cpp:118
msgid "Open board"
msgstr "Otvori ploču"

#: Editor.cpp:121
msgid "Save board"
msgstr "Spasi ploču"

#: Editor.cpp:127
msgid "Select"
msgstr "Izaberite"

#: Editor.cpp:137
msgid "Move tiles"
msgstr "Pomakni pločice"

#: Editor.cpp:140
msgid "Add tiles"
msgstr "Dodaj pločice"

#: Editor.cpp:142
msgid "Remove tiles"
msgstr "Ukloni pločice"

#: Editor.cpp:158
msgid "Shift left"
msgstr "Pomakni lijevo"

#: Editor.cpp:160
msgid "Shift up"
msgstr "Pomakni gore"

#: Editor.cpp:162
msgid "Shift down"
msgstr "Pomakni dole"

#: Editor.cpp:164
msgid "Shift right"
msgstr "Pomakni desno"

#: Editor.cpp:168
msgid "Exit"
msgstr "Izlaz"

#: Editor.cpp:263
msgid "Tiles: %1 Pos: %2,%3,%4"
msgstr "Pločice: %1 Poz: %2,%3,%4"

#: Editor.cpp:275 Editor.cpp:312
msgid ""
"*.layout|Board Layout (*.layout)\n"
"*|All Files"
msgstr ""
"*.layout|Datoteka s rasporedom ploče\n"
"*|Sve datoteke"

#: Editor.cpp:278 Preview.cpp:282
msgid "Open Board Layout"
msgstr "Otvori raspored ploče"

#: Editor.cpp:315 Editor.cpp:332
msgid "Save Board Layout"
msgstr "Spasi raspored ploče"

#: Editor.cpp:318 Preview.cpp:534 kmahjongg.cpp:538
msgid "Only saving to local files currently supported."
msgstr "Trenutno omogućeno snimanje u lokalne datoteke"

#: Editor.cpp:329 Preview.cpp:545
msgid "A file with that name already exists. Do you wish to overwrite it?"
msgstr "Datoteka sa tim imenom već postoji. Da li želite pisati preko nje?"

#: Editor.cpp:357
msgid "The board has been modified. Would you like to save the changes?"
msgstr "Ploča je mijenjana. Da li želite spasiti promjene?"

#: Editor.cpp:365
msgid "Save failed. Aborting operation."
msgstr "Spašavanje nije uspjelo. Odustajem."

#: HighScore.cpp:64
msgid "Pos"
msgstr "Poz"

#: HighScore.cpp:77
msgid "Name"
msgstr "Ime"

#: HighScore.cpp:86
msgid "Board"
msgstr "Ploča"

#: HighScore.cpp:94
msgid "Score"
msgstr "Rezultat"

#: HighScore.cpp:102
msgid "Time"
msgstr "Vrijeme"

#: HighScore.cpp:165
msgid "Scores"
msgstr "Rezultati"

#: HighScore.cpp:465
msgid "Anonymous"
msgstr "Anonimac"

#: HighScore.cpp:498
msgid ""
"Resetting the high scores will remove all high score entries both in memory "
"and on disk. Do you wish to proceed?"
msgstr ""
"Poništavanje najboljih rezultata će izbrisati sve rezultate\n"
"iz memorije i diska. Da li želite nastaviti?"

#: HighScore.cpp:502
msgid "Reset high scores"
msgstr "Poništi najbolje rezultate"

#: Preview.cpp:67
msgid "Load"
msgstr "Učitaj"

#: Preview.cpp:168
msgid "Change Background Image"
msgstr "Promijeni pozadinsku sliku"

#: Preview.cpp:170
msgid ""
"*.bgnd|Background Image\n"
"*.bmp|Windows bitmap file (*.bmp)\n"
msgstr ""
"*.bgnd|Pozadinska slika\n"
"*.bmp|Windows bitmapa (*.bmp)\n"

#: Preview.cpp:174
msgid "Change Tile Set"
msgstr "Promijeni skup pločica"

#: Preview.cpp:175
msgid ""
"*.tileset|Tile set file\n"
msgstr ""
"*.tileset|Datoteka sa skupom pločica\n"

#: Preview.cpp:179
msgid ""
"*.layout|Board layout file\n"
msgstr ""
"*.layout|Datoteka s rasporedom ploče\n"

#: Preview.cpp:180
msgid "Change Board Layout"
msgstr "Promijeni raspored ploče"

#: Preview.cpp:185
msgid ""
"*.theme|KMahjongg theme\n"
msgstr ""
"*.theme|KMahjongg tema\n"

#: Preview.cpp:186
msgid "Choose Theme"
msgstr "Izaberite temu"

#: Preview.cpp:196
msgid ""
"*|All Files\n"
msgstr ""
"*.*|Sve datoteke\n"

#: Preview.cpp:338
msgid "That is not a valid theme file."
msgstr "Ovo nije ispravna datoteka s temom."

#: Preview.cpp:528
msgid "Save Theme"
msgstr "Snimi temu."

#: Preview.cpp:554 kmahjongg.cpp:545
msgid "Could not write to file. Aborting."
msgstr "Ne mogu pisati u datoteku. Odustajem."

