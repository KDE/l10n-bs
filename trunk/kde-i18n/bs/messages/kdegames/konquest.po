#: Konquest.cc:10
msgid "Galactic Strategy KDE Game"
msgstr "KDE Igra galaktičke strategije"

#: Konquest.cc:15
msgid "Konquest"
msgstr "Konquest"

#: fleetdlg.cc:16
msgid "Fleet Overview"
msgstr "Pregled flote"

#: fleetdlg.cc:19
msgid "Fleet No."
msgstr "Flota br."

#: fleetdlg.cc:20
msgid "Destination"
msgstr "Odredište"

#: fleetdlg.cc:21
msgid "Ships"
msgstr "Brodovi"

#: fleetdlg.cc:22
msgid "Kill Percentage"
msgstr "Postotak ubijenih"

#: fleetdlg.cc:23
msgid "Arrival Turn"
msgstr "Početak poteza"

#: gameboard.cc:56
msgid "End Turn"
msgstr "Kraj poteza"

#: gameboard.cc:217
msgid ": Select source planet..."
msgstr ": Izaberite izvorni planet..."

#: gameboard.cc:235
msgid ": Select destination planet..."
msgstr ": Izaberite odredišni planet..."

#: gameboard.cc:257
msgid ": How many ships?"
msgstr ": Koliko brodova?"

#: gameboard.cc:281
msgid "Ruler: Select starting planet."
msgstr "Linijar: Izaberite početni planet."

#: gameboard.cc:296
msgid ""
"The distance from Planet %1 to Planet %2 is %3 light years.\n"
"A ship leaving this turn will arrive on turn %4"
msgstr ""
"Udaljenost između planeta %1 i planet %2 je %3 svjetlosne godine(a).\n"
"Brod koji krene u ovom potezu će stići tokom poteza %4"

#: gameboard.cc:302
msgid "Distance"
msgstr "Udaljenost"

#: gameboard.cc:307
msgid "Ruler: Select ending planet."
msgstr "Linijar: Izaberite odredišni planet."

#: gameboard.cc:319
msgid "Computer Player thinking..."
msgstr "Računarski igrač razmišlja..."

#: gameboard.cc:414
msgid "Turn #: %1 of %2"
msgstr "Potez #: %1 od %2"

#: gameboard.cc:534
msgid "The once mighty empire of %1 has fallen in ruins."
msgstr "Nekada veliki imperij %1 je propao."

#: gameboard.cc:537
msgid "An Empire Has Fallen"
msgstr "Imperij je pao"

#: gameboard.cc:546
msgid "The fallen empire of %1 has staggered back to life."
msgstr "Pali imperij %1 se uspio vratiti u život."

#: gameboard.cc:549
msgid "Up From the Ashes"
msgstr "Iz pepela..."

#: gameboard.cc:569
msgid "Reinforcements (%1 ships) have arrived for planet %2."
msgstr "Pojačanje (%1 brodova) je stiglo na planet %2."

#: gameboard.cc:572
msgid "Fleet Arrival"
msgstr "Flota dolazi"

#: gameboard.cc:614
msgid "Planet %1 has held against an attack from %2."
msgstr "Planet %1 je uspio održati nalete sa %2."

#: gameboard.cc:617
msgid "Planet Holds"
msgstr "Planet se drži"

#: gameboard.cc:624
msgid "Planet %1 has fallen to %2."
msgstr "Planet %1 je pao pod napadima %2."

#: gameboard.cc:627
msgid "Planet Conquered"
msgstr "Planet je osvojen"

#: gameboard.cc:686
msgid "Do you wish to retire this game?"
msgstr "Da li se želite povući iz ove igre?"

#: gameboard.cc:687
msgid "End Game"
msgstr "Kraj igre"

#: gameboard.cc:693
msgid "Final Standings"
msgstr "Konačni rezultati"

#: gameboard.cc:872
msgid "Not enough ships to send."
msgstr "Nemate dovoljno brodova za poslati."

#: gameboard.cc:894
msgid "Current Standings"
msgstr "Trenutni rezultati"

#: gameenddlg.cc:16
msgid ""
"This is the last turn.\n"
"Do you wish to add more turns?"
msgstr ""
"Ovo je vaš zadnji potez.\n"
"Da li želite dodati još poteza?"

#: gameenddlg.cc:66
msgid "Add %1 turns"
msgstr "Dodaj %1 poteza"

#: mainwin.cc:26
msgid "Galactic Conquest"
msgstr "Galaktičko osvajanje"

#: mainwin.cc:48
msgid "&Measure Distance"
msgstr "&Izmjeri udaljenost"

#: mainwin.cc:50
msgid "&Show Standings"
msgstr "&Prikaži stanje"

#: mainwin.cc:52
