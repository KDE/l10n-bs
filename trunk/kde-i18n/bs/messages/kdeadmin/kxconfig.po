#: toplevel.cpp:56
msgid "XFree86 Configuration"
msgstr "Konfiguracija XFree86-a"

#: toplevel.cpp:94
msgid "Advanced XFree86 Configuration"
msgstr "Napredna konfiguracija XFree86-a"

#: toplevel.cpp:106
msgid "Video Card"
msgstr "Video karta"

#: toplevel.cpp:107
