#: AddDlFree.cpp:11 rc.cpp:6
#, fuzzy
msgid "Directory:"
msgstr "&Direktorij"

#: AddDlFree.cpp:11 AddNoRet.cpp:11
#, fuzzy
msgid "Filename:"
msgstr "&Ime datoteke:"

#: AddDlFree.cpp:16
msgid "Add Freely Downloadable Directory"
msgstr "Dodaj direktorij otvoren za skidanje (download)"

#: AddDlFree.cpp:18
msgid "Add Freely Downloadable File"
msgstr "Dodaj datoteku otvorenu za skidanje (download)"

#: AddMessage.cpp:25
msgid "Add Readme"
msgstr "Dodaj Readme"

#: AddMessage.cpp:27
msgid "Add Message"
msgstr "Dodaj poruku"

#: AddMessage.cpp:29
msgid ""
"Message will be displayed after a user logs in.\n"
"The file has to be relative to the chrooted directory for anonymous/guest "
"users."
msgstr ""
"Poruka će biti prikazana kada se korisnik prijavi.\n"
"Ova datoteka mora biti u vezi s \"chrooted\" directorijem za anonimne/gost "
"korisnike."

#: AddMessage.cpp:30
msgid ""
"Message will be displayed when a user enters the specified directory.\n"
"Path has to be relative to chroot for anonymous/guest users."
msgstr ""
"Poruka će biti prikazana kada korisnik unese navedeni direktorij.\n"
"Putanja mora biti u vezi s \"chroot-om\" za anonimne/gost korisnike."

#: AddMessage.cpp:31
msgid "Filename of the message file - remember to make this relative to chroot!"
msgstr "Ime datoteke s porukom - ne zaboravite da ga navedete s početkom u chroot!"

#: AddMessage.cpp:32
msgid ""
"Directory in which the message will be displayed.\n"
"May be globbed: For example * means show in every directory.\n"
"This is especially useful if you're using ratios."
msgstr ""
"Directorij za koji će poruka biti prikazana.\n"
"Može biti \"globbed\": Na primjer * znači pokaži u svakom direktoriju.\n"
"Ovo je posebno korisno ako koristite \"odnose\"."

#: AddMessage.cpp:33
msgid "The message will be displayed only to members of the classes below."
msgstr "Poruka će biti prikazana samo članovima dole navedenih klasa."

#: AddMessage.cpp:44
msgid "The message will be displayed to members of the classes selected here."
msgstr "Poruka će biti prikazana samo članovima ovdje izabrane klase."

#: AddNoRet.cpp:13
msgid "Add Non-Retrievable File/Directory"
msgstr "Dodaj datoteku/direktorij koji se ne moze skidati"

#: AddNoRet.cpp:14
msgid ""
"End the filename with a / to indicate it is\n"
"an entire directory; no file in this directory\n"
"will be retrievable."
msgstr ""
"Završite ime datoteke s / da biste označili\n"
"čitav directorij; nijedna datoteka iz ovog\n"
"direktorija se neće moći skinuti (download)."

#: AddRCPT.cpp:11
#, fuzzy
msgid "Address:"
msgstr "&Adresa:"

#: AddRCPT.cpp:13
msgid "Add Recipient for Upload-Notification"
msgstr "Dodajte primaoca obavještenja o upload-u"

#: AddVHost.cpp:12
#, fuzzy
msgid "IP address:"
msgstr "&Adresa:"

#: AddVHost.cpp:14
msgid "Add Virtual Host"
msgstr "Dodaj virtualni server"

#: AddVHost.cpp:15
msgid "Enter the IP address of the new virtual host here."
msgstr "Ovdje unesite IP adresu virtualnog servera."

#: Directories.cpp:19
msgid ""
"Anonymous users (username <i>ftp</i> or <i>anonymous</i>) will see the "
"directory entered here as their / directory."
msgstr ""
"Anonimni korisnici (s imenom <i>ftp</i> ili <i>anonymous</i>) će vidjeti "
"ovdje navedeni direktorij kao svoj / direktorij."

#: Directories.cpp:20
msgid ""
"Guest users (real users with restricted access) will see the directory "
"entered here as their / directory."
msgstr ""
"Korisnici \"gosti\" (stvarni korisnici s ograničenim pristupom) će vidjeti "
"ovdje navedeni direktorij kao svoj /."

#: Directories.cpp:21
msgid ""
"Use the alternate passwd file specified here for authenticating users."
"<br>If this is left blank, the system passwd file will be used."
"<br>This setting can be overridden for virtual hosts."
msgstr ""
"Ovdje možete navesti neku drugu passwd datoteku za verifikaciju "
"korisnika."
"<br>Ako ovo polje ostavite prazno sistemska passwd datoteka će biti "
"korištena.<br>Ovo podešavanje ne mora važiti za virtualne servere."

#: Directories.cpp:22
msgid ""
"Use the alternate shadow password file specified here for authenticating "
"users."
"<br>If this is left blank, the system shadow file will be used."
"<br>This setting can be overridden for virtual hosts."
msgstr ""
"Navedena shadow password datoteka će se koristiti za verifikaciju "
"korisnika."
"<br>Ako ništa ne unesete, sistemska shadow datoteka će biti "
"korištena.<br>Ovo podešavanje ne mora važiti i za virtualne servere."

#: EditLimit.cpp:31
msgid "Edit Limit for Class"
msgstr "Izmijeni limit za klasu"

#: EditLimit.cpp:33
#, fuzzy
msgid "Edit Limit"
msgstr "Promi&jeni ograničenje"

#: EditLimit.cpp:36
#, fuzzy
msgid "Add Limit for Class"
msgstr "Dodaj limit za klasu"

#: EditLimit.cpp:38
#, fuzzy
msgid "Add Limit"
msgstr "Dodaj &Ograničenje"

#: EditLimit.cpp:42 EditLimit.cpp:43
msgid ""
"Use this to specify at which hours this limit is in effect.\n"
"Example:\n"
"0630-1310 -> 06:30 AM - 01:10 PM\n"
"Defaults to 0000-2400."
msgstr ""
"Ovdje možete navesti u koje vrijeme je limit na snazi.\n"
"Primjer:\n"
"0630-1310 -> 06:30 prije podne - 01:10 poslije podne\n"
"Default je 0000-2400."

#: EditUpload.cpp:19
msgid "Edit Upload"
msgstr "Izmjena upload-a"

#: Logging.cpp:20
msgid ""
"Use these check boxes to control for which types of users all commands will "
"be logged."
msgstr ""
"Ovdje možete označiti za koje će korisnike sve komande biti zabilježene "
"u posebnu datoteku."

#: Logging.cpp:21
msgid "Log inbound transfers (uploads to this server)"
msgstr "Bilježi ulazne prenose (upload-a na ovaj server)"

#: Logging.cpp:22
msgid "Log outbound transfers (downloads from this server)"
msgstr "Bilježi izlazne prenose (download-e s ovog servera)"

#: Logging.cpp:23
msgid "Log security-related messages (failed logins etc.)"
msgstr "Bilježi poruke u vezi sigurnosti (neuspjele prijave itd)"

#: Logging.cpp:24
msgid ""
"Log commands given by anonymous (username <i>ftp</i> or <i>anonymous</i>) "
"users."
msgstr ""
"Bilježi komande date od anonimnih (ime korisnika <i>ftp</i> ili "
"<i>anonymous</i>) korisnika."

#: Logging.cpp:25
msgid ""
"Log commands given by guest users (users with a real account, but restricted "
"access)."
msgstr ""
"Bilježi komande date od korisnika \"gostiju\" (korisnici sa stvarnim "
"kontom, ali ograničenim pristupom)"

#: Logging.cpp:26
msgid ""
"Log commands given by real users (users with an unrestricted account on the "
"server"
msgstr ""
"Bilježi komande date od \"stvarnih\" korisnika (korisnici sa kontom bez "
"ograničenja na ovom serveru)"

#: Logging.cpp:27
msgid ""
"Log inbound transfers (uploads to the server) by anonymous users (username "
"<i>ftp</i> or <i>anonymous</i>)"
msgstr ""
"Bilježi \"ulazne\" transfere (upload-e na server) od strane anonimnih "
"korisnika (ime korisnika <i>ftp</i> ili <i>anonymous</i>)"

#: Logging.cpp:28
msgid ""
"Log inbound transfers (uploads to the server) by guest users (users with a "
"real account, but restricted access)"
msgstr ""
"Bilježi \"ulazne\" transfere (upload-e na server) od strane \"gostiju\" "
"(korisnici sa stvarnim kontom, ali sa ograničenim pristupom)"

#: Logging.cpp:29
msgid ""
"Log inbound transfers (uploads to the server) by real users (users with a "
"real account and without restrictions)"
msgstr ""
"Bilježi \"ulazne\" transfere (upload-e na server) od strane pravih "
"korisnika (korisnici sa stvarnim kontom i bez ograničenja u pristupu)"

#: Logging.cpp:30
msgid ""
"Log outbound transfers (downloads from the server) by anonymous users "
"(username <i>ftp</i> or <i>anonymous</i>)"
msgstr ""
"Bilježi \"izlazne\" transfere (download-e sa servera) od strane anonimnih "
"korisnika (ime korisnika <i>ftp</i> ili <i>anonymous</i>)"

#: Logging.cpp:31
msgid ""
"Log outbound transfers (downloads from the server) by guest users (users "
"with a real account, but restricted access)"
msgstr ""
"Bilježi \"izlazne\" transfere (download-e sa servera) od strane \"gostiju\" "
"(korisnici sa stvarnim kontom, ali sa ograničenim pristupom)"

#: Logging.cpp:32
msgid ""
"Log outbound transfers (downloads from the server) by real users (users with "
"a real account and without restrictions)"
msgstr ""
"Bilježi \"izlazne\" transfere (download-e sa servera) od strane pravih "
"korisnika (korisnici sa stvarnim kontom i bez ograničenja u pristupu)"

#: Logging.cpp:33
msgid ""
"Keep a security log (failed login attempts etc.) for anonymous users "
"(username <i>anonymous</i> or <i>ftp</i>)"
msgstr ""
"Sačuvaj sigurnosne zabilješke (neuspjele prijave itd) za anonimne "
"korisnike (ime korisnika <i>anonymous</i> ili <i>ftp</i>)"

#: Logging.cpp:34
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with restricted access)"
msgstr ""
"Sačuvaj sigurnosne zabilješke (neuspjele prijave itd) za korisnike "
"\"goste\" (korisnici sa stvarnim kontom, ali sa ograničenim pristupom)"

#: Logging.cpp:35
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with unrestricted access)"
msgstr ""
"Sačuvaj sigurnosne zabilješke (neuspjele prijave itd) za \"stvarne\" "
"korisnike (korisnici sa stvarnim kontom i bez ograničenja u pristupu)"

#: Logging.cpp:36
msgid "Log to syslog instead of logfiles"
msgstr "Bilježenje u syslog umjesto datoteka sa zabilješkama"

#: Logging.cpp:37
msgid "Automatically notify the administrator of uploads from anonymous users"
msgstr "Automatski obavijesti administratora o upload-ima od strane anonimusa :)"

#: Logging.cpp:38
msgid ""
"The address entered here will appear in the <i>From:</i> header of upload "
"notification email messages sent by wu-ftpd."
msgstr ""
"Adresa koju ovdje unesete će biti u <i>Od:</i> zaglavlju obavještenja o "
"upload-u poslanom preko e-maila od strane wu-ftpd-a."

#: Logging.cpp:39
msgid ""
"The mail server entered here will be used to transmit upload notification "
"email messages sent by wu-ftpd. If left blank, localhost will be used."
msgstr ""
"Mail server kojeg ovdje navedete će biti korišten za slanje e-maila sa "
"obavještenjem o upload-u. Ako ništa ne navedete, localhost će biti "
"korišten."

#: Logging.cpp:41 Logging.cpp:42
msgid ""
"This list box shows the recipient(s) of upload notification emails. Use the "
"<b>Add</b> and <b>Remove</b> buttons below to modify the recipients."
msgstr ""
"Ova lista prikazuje primaoca(e) obavještenja o upload-ima. Koristite dugmad "
"<b>Dodaj</b> i <b>Ukloni</b> da biste promijenili primaoce."

#: Logging.cpp:44
msgid "Add a new recipient for upload notification emails"
msgstr "Dodaj novog primaoca obavještenja o upload-ima"

#: Logging.cpp:45
msgid "Remove the currently selected recipient for upload notification emails"
msgstr "Ukloni trenutno izabranog primaoca obavještenja o upload-ima"

#: Messages.cpp:16
#, fuzzy
msgid ""
"The file selected here will be displayed to\n"
"FTP users before login.\n"
"May break compatibility with truly ancient clients."
msgstr ""
"Ovdje izabrana datoteka će biti prikazana\n"
"korisnicima ftp-a prije prijave.\n"
"Ovo možda nije kompatibilno sa pravo starim\n"
"klijentima."

#: Messages.cpp:17
msgid ""
"The hostname given here will be shown at login and for\n"
"the %L cookie in message files.\n"
"If this is blank, the canonical hostname of your system will be used."
msgstr ""
"Ovdje navedeno ime hosta će biti prikazano kod prijave\n"
"i korišteno za %L cookie u datotekama s porukom.\n"
"Oko ovo ostavite prazno, sistemsko ime hosta će biti korišteno."

#: Messages.cpp:18
#, c-format
msgid "Email address returned with the %E cookie in message files."
msgstr "Email adresa dobijena pomoću %E cookie-ja u datotekama s porukom."

#: Messages.cpp:19
msgid "If this is not checked, message files at CWD will be displayed only once."
msgstr ""
"Ako ovo nije označeno, poruka pri komandi CWD će biti prikazana samo "
"jednom."

#: Messages.cpp:20
msgid "If this is not checked, hints on README files will be displayed only once."
msgstr ""
"Ako je ovo neoznačeno, datoteka pročitaj_me (README) će biti prikazana "
"samo jednom."

#: Messages.cpp:22 Messages.cpp:23 Messages.cpp:24
msgid ""
"Messages are files that are automatically displayed to the user after "
"logging in or after entering a directory. Use the <b>Add Message</b> and "
"<b>Remove Message</b> buttons to modify the messages."
msgstr ""
"Poruke su datoteke koje su automatski prikazane korisnicima poslije prijave, "
"ili prilikom ulaska u direktorij. Koristite dugmad <b>Dodaj poruku</b> i "
"<b>Ukloni poruku</b> za izmjenu poruka."

#: Messages.cpp:26 Messages.cpp:27 Messages.cpp:28
msgid ""
"When you've defined README files, users changing to a directory containing "
"files matching the glob listed here will be pointed to these files with a "
"<i>Please read the file README, last modified x days ago</i> message."
"<br>Use the <b>Add Readme</b> and <b>Remove Readme</b>"
" buttons to modify the list of README files."
msgstr ""
"Kada ste odredili README datoteke, korisnici koji uđu u direktorij što "
"sadrži datoteke koje se poklapaju sa ovdje prikazanim glob-om će dobiti "
"uputu <i>Molimo vas da pročitate README, promijenjen prije x dana</i>. "
"<br>Koristite dugmad <b>Dodaj Readme</b> i <b>Ukloni Readme</b> da biste "
"izmijenili listu README datoteka."

#: NewClass.cpp:11
msgid "Add New User Class"
msgstr "Dodaj novu korisničku klasu"

#: NewClass.cpp:17 NewClass.cpp:18
msgid ""
"The name of your new user class -\n"
"may be anything, but may not contain whitespaces."
msgstr ""
"Ime vaše nove klase -\n"
"Može biti bilo šta, ali ne smije sadržavati prazna polja."

#: NewClass.cpp:19
msgid ""
"Anonymous users\n"
"(login=ftp or anonymous)"
msgstr ""
"Anonimni korisnici\n"
"(login=ftp ili anonymous)"

#: NewClass.cpp:20
msgid ""
"Guest users\n"
"(chrooted real users)"
msgstr ""
"Korisnici gosti\n"
"(chroot-ovani stvarni korisnici)"

#: NewClass.cpp:21
msgid "Real users"
msgstr "Stvarni korisnici"

#: NewClass.cpp:22 NewClass.cpp:23 UserClasses.cpp:28 UserClasses.cpp:29
msgid ""
"Specify the addresses for this user class here;\n"
"may be globbed:\n"
"* = any address\n"
"*.localdomain.com = any address in localdomain.com\n"
"127.0.0.* = IPs 127.0.0.1-127.0.0.255\n"
"..."
msgstr ""
"Ovdje navedite adrese za ovu korisničku klasu;\n"
"može biti globb-ovana (skraćena):\n"
"* = bilo koja adresa\n"
"*.lokalna_domena.com = sve adrese u lokalna_domena.com\n"
"127.0.0.* = IP adrese 127.0.0.1-127.0.0.255\n"
"..."

#: NewClass.cpp:37
msgid "Class name may not be empty."
msgstr "Morate navesti ime klase."

#: NewClass.cpp:42
msgid "Class name may not contain whitespaces"
msgstr "Ime klase ne smije sadržavati prazna polja"

#: NewClass.cpp:49
msgid "You must check at least one of Anonymous, Guest or Real!"
msgstr "Morate izabrati barem jedno između anoniman, gost, ili stvarni!"

#: NewClass.cpp:55
msgid "Addresses can not be empty. Assume '*'?"
msgstr "Morate navesti adresu. Da li da koristim '*'?"

