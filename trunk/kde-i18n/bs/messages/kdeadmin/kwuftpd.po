msgid "Add limit"
msgstr "Dodaj limit"

#: EditLimit.cpp:41
msgid "Limit &always in effect"
msgstr "Limit uvijek n&a snazi"

#: EditLimit.cpp:45
msgid "Limit in effect at the following &days/hours:"
msgstr "Limit na snazi sljedećim &danima/satima:"

#: EditLimit.cpp:51
msgid "&Monday"
msgstr "&Ponedeljak"

#: EditLimit.cpp:53
msgid "&Tuesday"
msgstr "&Utorak"

#: EditLimit.cpp:55
msgid "&Wednesday"
msgstr "&Srijeda"

#: EditLimit.cpp:57
msgid "Thu&rsday"
msgstr "Četv&rtak"

#: EditLimit.cpp:59
msgid "&Friday"
msgstr "Peta&k"

#: EditLimit.cpp:61
msgid "&Saturday"
msgstr "Su&bota"

#: EditLimit.cpp:63
msgid "S&unday"
msgstr "&Nedelja"

#: EditLimit.cpp:66
msgid "&Hours:"
msgstr "Sa&t:"

#: EditLimit.cpp:71 EditLimit.cpp:72
msgid ""
"Use this to specify at which hours this limit is in effect.\n"
"Example:\n"
"0630-1310 -> 06:30 AM - 01:10 PM\n"
"Defaults to 0000-2400."
msgstr ""
"Ovdje možete navesti u koje vrijeme je limit na snazi.\n"
"Primjer:\n"
"0630-1310 -> 06:30 prije podne - 01:10 poslije podne\n"
"Default je 0000-2400."

#: EditLimit.cpp:77
msgid "&Limit to"
msgstr "&Ograniči na"

#: EditLimit.cpp:84
msgid "users"
msgstr "korisnika"

#: EditLimit.cpp:87
msgid "&No limit"
msgstr "&Bez ograničenja"

