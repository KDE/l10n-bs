#: AddDlFree.cpp:13
msgid "Add Freely Downloadable Directory"
msgstr "Dodaj direktorij otvoren za skidanje (download)"

#: AddDlFree.cpp:15
msgid "Add Freely Downloadable File"
msgstr "Dodaj datoteku otvorenu za skidanje (download)"

#: AddDlFree.cpp:19 AddDlFree.cpp:21 AddNoRet.cpp:14
msgid "&Filename:"
msgstr "&Ime datoteke:"

#: AddMessage.cpp:17
msgid "Add Readme"
msgstr "Dodaj Readme"

#: AddMessage.cpp:19
msgid "Add Message"
msgstr "Dodaj poruku"

#: AddMessage.cpp:25
msgid "Display at &login"
msgstr "Pokaži pri pri&javi"

#: AddMessage.cpp:29
msgid ""
"Message will be displayed after a user logs in.\n"
"The file has to be relative to the chrooted directory for anonymous/guest "
"users."
msgstr ""
"Poruka će biti prikazana kada se korisnik prijavi.\n"
"Ova datoteka mora biti u vezi s \"chrooted\" directorijem za "
"anonimne/gost korisnike."

#: AddMessage.cpp:30
msgid "Display at &CWD"
msgstr "Prikaži pri &CWD"

#: AddMessage.cpp:34
msgid ""
"Message will be displayed when a user enters the specified directory.\n"
"Path has to be relative to chroot for anonymous/guest users."
msgstr ""
"Poruka će biti prikazana kada korisnik unese navedeni direktorij.\n"
"Putanja mora biti u vezi s \"chroot-om\" za anonimne/gost korisnike."

#: AddMessage.cpp:37
msgid "&Message file"
msgstr "Datoteka &poruke"

#: AddMessage.cpp:39
msgid "Filename of the message file - remember to make this relative to chroot!"
msgstr "Ime datoteke s porukom - ne zaboravite da ga navedete s početkom u chroot!"

#: AddMessage.cpp:41
msgid "&Directory"
msgstr "&Direktorij"

#: AddMessage.cpp:41 Directories.cpp:24
msgid "Sele&ct"
msgstr "I&zaberite"

#: AddMessage.cpp:43
msgid ""
"Directory in which the message will be displayed.\n"
"May be globbed: For example * means show in every directory.\n"
"This is especially useful if you're using ratios."
msgstr ""
"Directorij za koji će poruka biti prikazana.\n"
"Može biti \"globbed\": Na primjer * znači pokaži u svakom direktoriju.\n"
"Ovo je posebno korisno ako koristite \"odnose\"."

#: AddMessage.cpp:47
msgid "Display for &any class"
msgstr "Prik&aži za sve klase"

#: AddMessage.cpp:48
msgid "The message will be displayed to everyone"
msgstr "Poruka će biti prikazana svakome"

#: AddMessage.cpp:52
msgid "Displa&y for selected classes:"
msgstr "Prika&ži izabranim klasama:"

#: AddMessage.cpp:53
msgid "The message will be displayed only to members of the classes below."
msgstr "Poruka će biti prikazana samo članovima dole navedenih klasa."

#: AddMessage.cpp:68
msgid "The message will be displayed to members of the classes selected here."
msgstr "Poruka će biti prikazana samo članovima ovdje izabrane klase."

#: AddNoRet.cpp:11
msgid "Add Non-Retrievable File/Directory"
msgstr "Dodaj datoteku/direktorij koji se ne moze skidati"

#: AddNoRet.cpp:17
msgid ""
"End the filename with a / to indicate it is\n"
"an entire directory; no file in this directory\n"
"will be retrievable."
msgstr ""
"Završite ime datoteke s / da biste označili\n"
"čitav directorij; nijedna datoteka iz ovog\n"
"direktorija se neće moći skinuti (download)."

#: AddRCPT.cpp:12
msgid "Add Recipient for Upload-Notification"
msgstr "Dodajte primaoca obavještenja o upload-u"

#: AddRCPT.cpp:15
msgid "&Address:"
msgstr "&Adresa:"

#: AddVHost.cpp:11
msgid "Add Virtual Host"
msgstr "Dodaj virtualni server"

#: AddVHost.cpp:14
msgid "&IP:"
msgstr "&IP:"

#: AddVHost.cpp:17
msgid "Enter the IP address of the new virtual host here."
msgstr "Ovdje unesite IP adresu virtualnog servera."

#: Directories.cpp:12
msgid "Root directory for &anonymous users:"
msgstr "Root direktorij za &anonimne korisnike:"

#: Directories.cpp:14
msgid ""
"Anonymous users (username <i>ftp</i> or <i>anonymous</i>) will see the "
"directory entered here as their / directory."
msgstr ""
"Anonimni korisnici (s imenom <i>ftp</i> ili <i>anonymous</i>) će vidjeti "
"ovdje navedeni direktorij kao svoj / direktorij."

#: Directories.cpp:16
msgid "Root directory for &guest users:"
msgstr "Root direktorij za korisnike &goste:"

#: Directories.cpp:16
msgid "S&elect"
msgstr "Izab&eri"

#: Directories.cpp:18
msgid ""
"Guest users (real users with restricted access) will see the directory "
"entered here as their / directory."
msgstr ""
"Korisnici \"gosti\" (stvarni korisnici s ograničenim pristupom) će "
"vidjeti ovdje navedeni direktorij kao svoj /."

#: Directories.cpp:20
msgid "&Passwd file:"
msgstr "&Passwd datoteka:"

#: Directories.cpp:20 EditUpload.cpp:23
msgid "Se&lect"
msgstr "Iza&beri"

#: Directories.cpp:22
msgid ""
"Use the alternate passwd file specified here for authenticating users.<br>If "
"this is left blank, the system passwd file will be used.<br>This setting can "
"be overridden for virtual hosts."
msgstr ""
"Ovdje možete navesti neku drugu passwd datoteku za verifikaciju korisnika.<br>Ako "
"ovo polje ostavite prazno sistemska passwd datoteka će biti korištena.<br>Ovo "
"podešavanje ne mora važiti za virtualne servere."

#: Directories.cpp:24
msgid "&Shadow passwd file:"
msgstr "&Shadow passwd datoteka:"

#: Directories.cpp:26
msgid ""
"Use the alternate shadow password file specified here for authenticating "
"users.<br>If this is left blank, the system shadow file will be used."
"<br>This setting can be overridden for virtual hosts."
msgstr ""
"Navedena shadow password datoteka će se koristiti za verifikaciju "
"korisnika.<br>Ako ništa ne unesete, sistemska shadow datoteka će biti "
"korištena.<br>Ovo podešavanje ne mora važiti i za virtualne servere."

#: EditLimit.cpp:28
msgid "Edit limit for class"
msgstr "Izmjeni limit za klasu"

#: EditLimit.cpp:30
msgid "Edit limit"
msgstr "Izmjeni limit"

#: EditLimit.cpp:33
msgid "Add limit for class"
msgstr "Dodaj limit za klasu"

