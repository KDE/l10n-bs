"<li>malo opterećenje procesora</li>\n"
"<li>sporiji odgovor</li>\n"
"<li>manje prekidanja</li>\n"
"</ul>"

#: rc.cpp:24
msgid ""
"<ul>\n"
"<li>high CPU usage</li>\n"
"<li>fast response</li>\n"
"<li>more dropouts</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li>veliko opterećenje procesora</li>\n"
"<li>brzi odgovor</li>\n"
"<li>više prekidanja</li>\n"
"</ul>"

