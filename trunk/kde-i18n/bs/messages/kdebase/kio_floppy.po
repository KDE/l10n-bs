#: kio_floppy.cpp:200
#, fuzzy
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"uređaj %1.\n"
"Uređaj je još uvijek zauzet.\n"
"Sačekajte dok ne završi sa radom i pokušajte ponovo."

#: kio_floppy.cpp:204 kio_floppy.cpp:1146
#, fuzzy
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"\n"
"Disketa u uređaju %1 je vjerovatno puna."

#: kio_floppy.cpp:214
#, fuzzy
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"\n"
"Vjerovatno nema diskete u uređaju %1"

#: kio_floppy.cpp:218
#, fuzzy
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"\n"
"Najvjerovatnije nema diska u jedinici %1 ili nemate dovoljno privilegija da "
"pristupite jedinici."

#: kio_floppy.cpp:222
#, fuzzy
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"\n"
"Uređaj %1 nije podržan."

#: kio_floppy.cpp:227
#, fuzzy
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"\n"
"Pobrinite se da je disketa u uređaju %1 formatirana za DOS\n"
"i da je dozvola za datoteku uređaja (npr. /dev/fd0) podešena kako treba "
"(rwxrwxrwx)."

#: kio_floppy.cpp:231
#, fuzzy
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"\n"
"Disketa u uređaju %1 vjerovatno nije formatirana za DOS."

#: kio_floppy.cpp:235
#, fuzzy
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"\n"
"Disketa u uređaju %1 je vjerovatno zaštićena od pisanja."

#: kio_floppy.cpp:244
#, fuzzy
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"\n"
"Vjerovatno nema diskete u uređaju %1"

#: kio_floppy.cpp:368
#, fuzzy
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\n"
"Provjerite da li je paket mtools ispravno instaliran na vaš sistem."

#~ msgid "Reason unknown."
#~ msgstr "Razlog nije poznat."

#~ msgid "Don't know why, sorry."
#~ msgstr "Žalim, ne znam zbog čega."
