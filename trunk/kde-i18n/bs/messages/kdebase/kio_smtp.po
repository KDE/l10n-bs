#: smtp.cc:262 smtp.cc:331
msgid "The sender address is missing."
msgstr "Nedostaje adresa pošiljaoca."

#: smtp.cc:273
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTPProtocol::smtp_open nije uspio (%1)"

#: smtp.cc:282
msgid ""
"The server did not accept the sender address.\n"
"The server responded: \"%1\""
msgstr ""
"Server nije prihvatio adresu pošiljaoca.\n"
"Server kaže: \"%1\""

#: smtp.cc:305
msgid ""
"The attempt to start sending the message content failed.\n"
"The server responded: \"%1\""
msgstr ""
"Pokušaj slanja sadržaja poruke nije uspio.\n"
"Server kaže: \"%1\""

#: smtp.cc:379
msgid ""
"The message content was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Sadržaj poruke nije prihvaćen.\n"
"Server kaže: \"%1\""

#: smtp.cc:396
msgid ""
"One of the recipients was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Jedan od primalaca poruke nije prihvaćen.\n"
"Server kaže: \"%1\""

#: smtp.cc:464 smtp.cc:487
msgid "Invalid SMTP response received."
msgstr "Primljen je neispravan SMTP odgovor."

#: smtp.cc:520
msgid "Invalid SMTP response received: \"%1\""
msgstr "Primljen je neispravan SMTP odgovor: \"%1\""

#: smtp.cc:571
msgid "The server did not accept the connection: \"%1\""
msgstr "Server nije prihvatio vezu: \"%1\""

#: smtp.cc:609 smtp.cc:657
msgid "The server responded: \"%1\""
msgstr "Server je rekao: \"%1\""

#: smtp.cc:633
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Vaš SMTP server tvrdi da podržava TLS, ali dogovaranje nije uspjelo.\n"
"Možete isključiti TLS u KDE-u koristeći kripto konfiguracijski modul."

#: smtp.cc:638
msgid "Connection Failed"
msgstr "Veza nije uspjela"

#: smtp.cc:678
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Vaš SMTP server ne podržava TLS. Isključite TLS ako se želite povezati "
"bez kriptovanja."

#: smtp.cc:690
msgid "Username and password for your SMTP account:"
msgstr "Korisničko ime i šifra za vaš SMTP račun:"

#: smtp.cc:692
msgid "When prompted, you ran away."
msgstr "Kad ste upitani, zbrisali ste."

#: smtp.cc:739
msgid "No compatible authentication methods found."
msgstr "Nije pronađen nijedan kompatibilan metod za potvrdu autentičnosti."

#: smtp.cc:760
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""
"Vaš SMTP server ne podržava %1.\n"
"Izaberite neku drugu metodu potvrde autentičnosti."

#: smtp.cc:790
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded: \"%1\""
msgstr ""
"Potvrda autentičnosti nije uspjela.\n"
"Najvjerovatnije je šifra pogrešna.\n"
"Server je rekao: \"%1\""

#~ msgid ""
#~ "The server didn't accept the message content:\n"
#~ "%1"
#~ msgstr ""
#~ "Server nije prihvatio sadržaj poruke:\n"
#~ "%1"

#~ msgid ""
#~ "The server didn't accept one of the recipients.\n"
#~ "It said: %1"
#~ msgstr ""
#~ "Server nije prihvatio jednog od primalaca.\n"
#~ "Rekao je: %1"
