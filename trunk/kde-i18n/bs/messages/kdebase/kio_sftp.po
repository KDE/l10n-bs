#: kio_sftp.cpp:238
msgid "Opening connection to host <b>%1:%2</b>"
msgstr "Otvaram konekciju do računara <b>%1:%2</b>"

#: kio_sftp.cpp:299
msgid "Sftp Login"
msgstr "Sftp prijava"

#: kio_sftp.cpp:301
msgid "site:"
msgstr "site:"

#: kio_sftp.cpp:313
msgid "Login failed. Retrying..."
msgstr "Prijava nije uspjela. Pokušavam ponovo..."

#: kio_sftp.cpp:330
msgid "Please enter your username and password."
msgstr "Molim unesite vaše korisničko ime i šifru."

#: kio_sftp.cpp:333
msgid ""
"Login failed.\n"
"Please confirm your username and password, and enter them again."
msgstr ""
"Prijava nije uspjela.\n"
"Provjerite vaše korisničko ime i šifru i pokušajte ponovo."

#: kio_sftp.cpp:338
msgid "Please enter a username and password"
msgstr "Molim unesite vaše korisničko ime i šifru"

#: kio_sftp.cpp:358
msgid "Connection failed."
msgstr "Konekcija nije uspjela."

#: kio_sftp.cpp:364
msgid "Warning: Host key not found!"
msgstr "Upozorenje: Host ključ nije nađen!"

#: kio_sftp.cpp:368
msgid "Warning: Host key has changed!"
msgstr "Upozorenje: Host ključ je promijenjen!"

#: kio_sftp.cpp:379
msgid "Shall we contine connecting to %1?"
msgstr "Hoćemo li ponovo pokušati da se spojimo na %1?"

#: kio_sftp.cpp:396
msgid "Connected to "
msgstr "Spojen na "

#: kio_sftp.cpp:427
msgid "Timed out waiting for a response from the server."
msgstr ""

#: kio_sftp.cpp:440
msgid "Login failed."
msgstr "Prijava nije uspjela."

#: kio_sftp.cpp:442
msgid ""
"Could not login to %1.\n"
"Maximum number of retries exceeded."
msgstr ""
"Nisam se mogao prijaviti na %1.\n"
"Maximum number of retries exceeded."

#: kio_sftp.cpp:470
msgid "Login OK"
msgstr "Prijava je OK"

