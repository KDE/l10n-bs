#: main.cpp:44
msgid "KDE Crash Handler gives the user feedback if a program crashed."
msgstr "KDE rukovatelj rušenja daje korisniku informaciju kada se program sruši."

#: main.cpp:48
msgid "The signal number that was caught"
msgstr "Broj signala koji smo uhvatili"

#: main.cpp:49
msgid "Name of the program"
msgstr "Ime programa"

#: main.cpp:50
msgid "Path to the executable"
msgstr "Putanja do programa"

#: main.cpp:51
msgid "The version of the program"
msgstr "Verzija programa"

#: main.cpp:52
msgid "The bug address to use"
msgstr "Adresa za prijavljivanje bugova"

#: main.cpp:53
msgid "Translated name of the program"
msgstr "Prevedeno ime programa"

#: main.cpp:54
msgid "The PID of the program"
msgstr "PID programa"

#: main.cpp:55
msgid "Startup ID of the program"
msgstr "ID pokretanja programa"

#: main.cpp:56
msgid "The program was started by kdeinit"
msgstr "Program je pokrenut od strane kdeinit-a"

#: main.cpp:70
msgid "The KDE Crash Handler"
msgstr "KDE Rukovatelj rušenja"

#: debugger.cpp:66
msgid "C&opy"
msgstr "K&opiraj"

#: debugger.cpp:83
msgid "Done."
msgstr "Gotov."

#: debugger.cpp:96
msgid "Select Filename"
msgstr "Odaberite datoteku"

#: debugger.cpp:105
msgid "Can't open file %1 for writing"
msgstr "Nemogu otvoriti %1 za pisanje"

#: debugger.cpp:112
msgid "Unable to create backtrace."
msgstr "Ne mogu napraviti povratni trag (backtrace)."

#: debugger.cpp:117
msgid "Loading backtrace..."
msgstr "Učitavam povratni trag..."

#: debugger.cpp:134
msgid "Loading symbols..."
msgstr "Učitavam simbole..."

#: krashconf.cpp:61
msgid "unknown"
msgstr "nepoznat"

#: drbugreport.cpp:55
msgid "You have to edit the description before the report can be sent."
msgstr "Trebate izmijeniti opis prije slanja izvještaja."

#: backtrace.cpp:84
msgid ""
"%1 not found. Check if it is installed -- you need it to generate the "
"backtrace.\n"
"If you have another debugger, contact kde-devel@kde.org for help on how to "
"set it up."
msgstr ""
"%1 nije pronađen. Provjerite da li je instaliran -- potreban je za "
"generisanje povratnog traga (backtrace).\n"
"Ako imate neki drugi debugger, pitajte na kde-devel@kde.org za pomoć oko "
"podešavanja istog."

#: toplevel.cpp:60
msgid "&Bug report"
msgstr "Izvještaj o &bugu (grešci)"

#: toplevel.cpp:61
msgid "&Debugger"
msgstr "&Debugger (Ispravljač grešaka)"

#: toplevel.cpp:65
msgid "&General"
msgstr "&Općenito"

#: toplevel.cpp:80
msgid "&Backtrace"
msgstr "&Povratni trag"

#: toplevel.cpp:99
msgid "<p><b>Short description</b></p><p>%1</p>"
msgstr "<p><b>Kratak opis</b></p><p>%1</p>"

#: toplevel.cpp:103
msgid "<p><b>What is this?</b></p><p>%1</p>"
msgstr "<p><b>Šta je ovo?</b></p><p>%1</p>"

#: toplevel.cpp:107
msgid "<p><b>What can I do?</b></p><p>%1</p>"
msgstr "<p><b>Šta mogu uraditi?</b></p><p>%1</p>"

#: toplevel.cpp:112
msgid "<p><b>Application crashed</b></p><p>The program %appname crashed.</p>"
msgstr "<p><b>Aplikacija se srušila.</b></p><p>Program %appname je krahirao.</p>"

#: toplevel.cpp:130
msgid ""
"<p>Do you want to generate a backtrace? This will help the developers to "
"figure out what went wrong.</p>\n"
"<p>Unfortunately this will take some time on slow machines.</p>"
"<p><b>Note: A backtrace is not a substitute for a proper description of the "
"bug and information on how to reproduce it. It is not possible to fix the "
"bug without a proper description.</b></p>"
msgstr ""
"<p<Želite li napraviti povratni trag (backtrace)? To će pomoći "
"programerima da pronađu grešku.</p>\n"
"<p>Nažalost to može potrajati neko vrijeme na sporijim "
"računarima.</p>"
"<p><b>"
" Napomena: Povratni trag nije zamjena za pravilan opis greške (bug-a) i "
"podatke kako je izazvati. Nije moguće popraviti grešku bez odgovarajućeg "
"opisa. </b></p>"

#: toplevel.cpp:142
msgid "Include Backtrace"
msgstr "Uključi povratni trag (backtrace)"

#: toplevel.cpp:199
msgid "It was not possible to generate a backtrace."
msgstr "Ne mogu napraviti povratni trag."

#: toplevel.cpp:200
msgid "Backtrace not Possible"
msgstr "Povratni trag nije moguć"

