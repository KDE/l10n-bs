#: main.cpp:30
msgid "Printer/destination to print on"
msgstr "Štampač/odredište štampe"

#: main.cpp:32
msgid "Title/Name for the print job"
msgstr "Naslov/Ime zadatka štampe"

#: main.cpp:34
msgid "Number of copies"
msgstr "Broj kopija"

#: main.cpp:35
msgid "Printer option"
msgstr "Opcije štampača"

#: main.cpp:36
msgid "Job output mode (gui, console, none)"
msgstr "Način izlaza zadatka (gui, konzola, ništa)"

#: main.cpp:37
msgid "Print system to use (lpd, cups)"
msgstr "Sistem štampe za koristiti (lpd, cups)"

#: main.cpp:38
msgid "Allow printing from STDIN"
msgstr "Dozvoli štampanje sa STDIN"

#: main.cpp:39
msgid "Do not show the print dialog (print directly)."
msgstr "Nemoj prikazivati dijalog štampe (štampaj odmah)."

#: main.cpp:40
msgid "Files to load"
msgstr "Datoteke za učitati"

#: main.cpp:46
msgid "A printer tool for KDE"
msgstr "Alat za štampu za KDE"

#: printwrapper.cpp:55
msgid "Print information"
msgstr "Štampaj informacije"

#: printwrapper.cpp:56 printwrapper.cpp:63
msgid "Print warning"
msgstr "Štampaj upozorenje"

#: printwrapper.cpp:57 printwrapper.cpp:63
msgid "Print error"
msgstr "Štampaj grešku"

#: printwrapper.cpp:63
msgid "Print info"
msgstr "Štampaj info"

#: printwrapper.cpp:138
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""
"Datoteka je zadata na komandnoj liniji. Štampanje sa STDINa će biti "
"isključeno."

#: printwrapper.cpp:143
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Prilikom korištenja '--nodialog' morate navesti barem jednu datoteku za "
"štampu ili koristiti flag '--stdin'."

#: printwrapper.cpp:164
msgid "The specified printer or the default printer could not be found."
msgstr "Nisam pronašao navedeni štampač ili podrazumjevani štampač."

#: printwrapper.cpp:166
msgid "Operation aborted."
msgstr "Operacija prekinuta."

#: printwrapper.cpp:188
msgid "Unable to construct the print dialog."
msgstr "Ne mogu napraviti dijalog za štampu."

#: printwrapper.cpp:217
msgid ""
"Can't print from STDIN: use '--stdin' option, or specify a file to print in "
"the file selection area."
msgstr ""
"Ne mogu štampati sa STDINa: koristite '--stdin' opciju ili navedite "
"datoteku za štampu u području za odabir datoteke."

#: printwrapper.cpp:242
msgid "Unable to open temporary file."
msgstr "Ne mogu otvoriti privremenu datoteku."

#: printwrapper.cpp:254
msgid "Stdin is empty, no job sent."
msgstr "Stdin je prazan, zadatak nije poslan."

#: printwrapper.cpp:269
msgid "Error while printing files"
msgstr "Greška prilikom štampanja datoteka"

#: printwrapper.cpp:272
msgid "<nobr>File(s) sent to printer <b>%1</b>.</nobr>"
msgstr "<nobr>Datoteke poslane na štampač <b>%1</b>.</nobr>"
