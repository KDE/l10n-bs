#: crypto.cpp:107
msgid "%1 (%2 of %3 bits)"
msgstr "%1 (%2 od %3 bita)"

#: crypto.cpp:235
msgid "kcmcrypto"
msgstr "kcmcrypto"

#: crypto.cpp:235
msgid "KDE Crypto Control Module"
msgstr "KDE modul za kontrolu enkripcije"

#: crypto.cpp:237
msgid "(c) 2000 - 2001 George Staikos"
msgstr "(c) 2000 - 2001 George Staikos"

#: crypto.cpp:263
msgid "Enable &TLS support if supported by the server"
msgstr "Koristi &TLS podršku ako je podržana na serveru"

#: crypto.cpp:266
msgid ""
"TLS is the newest revision of the SSL protocol. It integrates better with "
"other protocols and has replaced SSL in protocols such as POP3 and SMTP."
msgstr ""
"TLS je najnovija verzija SSL protokola. Ona se bolje integriše sa ostalim "
"protokolima i zamijenila je SSL u protokolima kao POP3 i SMTP."

#: crypto.cpp:271
msgid "Enable SSLv&2"
msgstr "Aktiviraj SSLv&2"

#: crypto.cpp:274
msgid ""
"SSL v2 is the second revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v2 je druga revizija SSL protokola. Najčešći je slučaj da se "
"aktiviraju i v2 i v3."

#: crypto.cpp:278
msgid "Enable SSLv&3"
msgstr "Aktiviraj SSLv&3"

#: crypto.cpp:281
msgid ""
"SSL v3 is the third revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v3 je treća revizija SSL protokola. Najčešći je slučaj da se "
"aktiviraju i v2 i v3."

#: crypto.cpp:287
msgid "SSLv2 Ciphers to Use"
msgstr "SSLv2 šifre koji želite koristiti"

#: crypto.cpp:288
msgid ""
"Select the ciphers you wish to enable when using the SSL v2 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"Izaberite šifre koje želite da aktivirate kada koristite SSL v2 protokol. "
"Protokol koji će stvarno biti korišten će biti dogovoren sa serverom "
"prilikom povezivanja."

#: crypto.cpp:298
msgid ""
"SSL ciphers cannot be configured because this module was not linked with "
"OpenSSL."
msgstr ""
"SSL šifra ne može da bude podešena jer ovaj modul nije linkovan sa "
"OpenSSL."

#: crypto.cpp:313
msgid "SSLv3 Ciphers to Use"
msgstr "SSLv3 šifre koji želite koristiti"

#: crypto.cpp:314
msgid ""
"Select the ciphers you wish to enable when using the SSL v3 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"Izaberite šifre koje želite da aktivirate kada koristite SSL v3 protokol. "
"Protokol koji će stvarno biti korišten će biti dogovoren sa serverom "
"prilikom povezivanja."

#: crypto.cpp:328
msgid "Cipher Wizard"
msgstr "Čarobnjak za šifre"

#: crypto.cpp:331
msgid ""
"<qt>Use these preconfigurations to more easily configure the SSL encryption "
"settings. You can choose among the following modes: <ul>"
msgstr ""
"<qt>Koristite ovu dugmad kako biste lakše podesili SSL enkripciju. Možete "
"izabrati jedan od sljedećih režima: <ul>"

#: crypto.cpp:334
msgid "Most Compatible"
msgstr "Najkompatibilnije"

#: crypto.cpp:335
msgid ""
"<li><b>Most Compatible:</b> Select the settings found to be most "
"compatible.</li>"
msgstr ""
"<li><b>Najkompatibilnije:</b> Odabira postavke koje su se pokazale kao "
"najkompatibilnije.</li>"

#: crypto.cpp:336
msgid "US Ciphers Only"
msgstr "Samo SAD šifre"

#: crypto.cpp:337
msgid ""
"<li><b>US Ciphers Only:</b> Select only the US strong (&gt;= 128 bit) "
"encryption ciphers.</li>"
msgstr ""
"<li><b>Samo SAD šifre:</b> Odabira samo SAD \"jake\" (&gt;= 128 bita) "
"enkripcione šifre.</li>"

#: crypto.cpp:338
msgid "Export Ciphers Only"
msgstr "Samo izvozne šifre"

#: crypto.cpp:339
msgid ""
"<li><b>Export Ciphers Only:</b> Select only the weak ciphers (&lt;= 56 "
"bit).</li>"
msgstr ""
"<li><b>Samo izvozne šifre:</b> Odabira samo \"slabe\" šifre (&lt;=56 "
"bita).</li>"

#: crypto.cpp:340
msgid "Enable All"
msgstr "Koristi sve"

#: crypto.cpp:341
msgid "<li><b>Enable All:</b> Select all SSL ciphers and methods.</li></ul>"
msgstr "<li><b>Koristi sve:</b> Odabira sve SSL šifre i metode enkripcije.</li></ul>"

#: crypto.cpp:352
msgid "Warn on &entering SSL mode"
msgstr "Upozor&enje pri uspostavljanju SSL veze"

#: crypto.cpp:355
msgid "If selected, you will be notified when entering an SSL enabled site"
msgstr "Ako ovo izaberete, bićete obavješteni pri ulasku na sajt koji koristi SSL"

#: crypto.cpp:359
msgid "Warn on &leaving SSL mode"
msgstr "Upozorenje pri ras&kidu SSL veze"

#: crypto.cpp:362
msgid "If selected, you will be notified when leaving an SSL based site."
msgstr ""
"Ako ovo izaberete bićete obavješteni prilikom napuštanja sajta koji "
"koristi SSL."

#: crypto.cpp:366
msgid "Warn on sending &unencrypted data"
msgstr "&Upozorenje pri slanju ne-šifrovanih podataka"

#: crypto.cpp:369
msgid ""
"If selected, you will be notified before sending unencrypted data via a web "
"browser."
msgstr ""
"Ako ovo izaberete bićete obavješteni prije nego što pošaljete "
"ne-šifrovane podatke preko web preglednika."

#: crypto.cpp:374
msgid "Warn on &mixed SSL/non-SSL pages"
msgstr "Upozorenje o &miješanim SSL/ne-SSL stranama"

#: crypto.cpp:377
msgid ""
"If selected, you will be notified if you view a page that has both encrypted "
"and non-encrypted parts."
msgstr ""
"Ako ovo izaberete bićete obavješteni da ste na web stranici koja ima "
"šifrovani i ne-šifrovani sadržaj."

#: crypto.cpp:390
msgid "Path to OpenSSL Shared Libraries"
msgstr "Putanja do OpenSSL biblioteka"

#: crypto.cpp:394
msgid "&Test"
msgstr "&Test"

#: crypto.cpp:404
msgid "Use EGD"
msgstr "Koristi EGD"

#: crypto.cpp:406
msgid "Use entropy file"
msgstr "Koristi entropijsku datoteku"

#: crypto.cpp:414 crypto.cpp:2310
msgid "Path to EGD:"
msgstr "Putanja do EGD-a:"

#: crypto.cpp:420
msgid ""
"If selected, OpenSSL will be asked to use the entropy gathering daemon (EGD) "
"for initializing the pseudo-random number generator."
msgstr ""
"Ako je izabran, od OpenSSL-a će biti zatraženo da koristi daemon za "
"sakupljanje entropije (EGD) za inicijalizaciju generatora pseudo-slučajnih "
"brojeva."

#: crypto.cpp:423
msgid ""
"If selected, OpenSSL will be asked to use the given file as entropy for "
"initializing the pseudo-random number generator."
msgstr ""
"Ako je izabran, od OpenSSL-a će biti zatraženo da koristi navedenu "
"datoteku kao entropiju za inicijalizaciju generatora pseudo-slučajnih "
"brojeva."

#: crypto.cpp:426
msgid ""
"Enter the path to the socket created by the entropy gathering daemon (or the "
"entropy file) here."
msgstr ""
"Ovdje unesite putanju do socketa napravljenog od strane EGD-a (ili "
"entropijske datoteke)."

#: crypto.cpp:429
msgid "Click here to browse for the EGD socket file."
msgstr "Kliknite ovdje da potražite EGD socket datoteku."

#: crypto.cpp:446
