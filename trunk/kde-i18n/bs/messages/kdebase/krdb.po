#: krdb.cpp:304
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Look & Feel -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# napravljeno od strane KDE-a, %1\n"
"#\n"
"# Ako zelite da KDE pise preko vaših GTK postavki, izaberite\n"
"# Izgled i Osjexaj/Boje u kontrolnom centru i iskljuxite opciju\n"
"# \"Primijeni ove boje na ne-KDE aplikacije\"\n"
"#\n"
"#\n"
