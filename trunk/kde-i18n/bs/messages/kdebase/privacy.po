#: privacy.cpp:64 rc.cpp:6
msgid "Privacy Settings"
msgstr "Postavke privatnosti"

#: privacy.cpp:65
msgid "Description"
msgstr "Opis"

#: privacy.cpp:73
msgid "General"
msgstr "Opšte"

#: privacy.cpp:74
msgid "Web Browsing"
msgstr "Pretraživanje weba"

#: privacy.cpp:80
msgid "Run command history"
msgstr "Historija izvršenih naredbi"

#: privacy.cpp:82
msgid "Cookies"
msgstr "Kolačići"

#: privacy.cpp:84
msgid "Saved clipboard contents"
msgstr "Snimljen sadržaj clipboarda"

#: privacy.cpp:86
msgid "Web history"
msgstr "Web historija"

#: privacy.cpp:88
msgid "Web cache"
msgstr "Keširane web strane"

#: privacy.cpp:90
msgid "Form completion entries"
msgstr "Automatsko popunjavanje formulara"

#: privacy.cpp:92
msgid "Recent documents"
msgstr "Skorašnji dokumenti"

#: privacy.cpp:94
msgid "Quick start menu"
msgstr "Meni 'Brzi start'"

#: privacy.cpp:96
msgid "Favorite icons"
msgstr "Omiljene ikone"

#: privacy.cpp:98
msgid ""
"Check all cleanup actions you would like to perform. These will be executed "
"by pressing the button below"
msgstr ""
"Izaberite sve vrste čišćenja koje želite napraviti. Pritiskom na dugme ispod ćete "
"započeti čišćenje."

#: privacy.cpp:99
msgid "Immediately performs the cleanup actions selected above"
msgstr "Odmah izvršava čišćenje, kako je odabrano gore"

#: privacy.cpp:101
msgid ""
"Clears the history of commands run through the Run Command tool on the "
"desktop"
msgstr "Briše historiju naredbi izvršenih kroz desktop alat Izvrši naredbu"

#: privacy.cpp:102
msgid "Clears all stored cookies set by websites"
msgstr "Briše sve snimljene kolačiće"

#: privacy.cpp:103
msgid "Clears the history of visited websites"
msgstr "Briše historiju posjećenih web strana"

#: privacy.cpp:104
msgid "Clears the clipboard contents stored by Klipper"
msgstr "Briše sadržaj clipboarda koji je sačuvao Klipper"

#: privacy.cpp:105
msgid "Clears the temporary cache of websites visited"
msgstr "Briše privremeni keš posjećenih web strana"

#: privacy.cpp:106
msgid "Clears values which were entered into forms on websites"
msgstr "Briše vrijednosti koje su unošene u formulare na web stranama"

#: privacy.cpp:107
msgid "Clears the list of recently used documents from the KDE applications menu"
msgstr "Briše listu skoro korištenih dokumenata iz KDE menija"

#: privacy.cpp:108
msgid "Clears the entries from the list of recently started applications"
msgstr "Briše stavke iz liste skoro pokrenutih programa"

#: privacy.cpp:109
msgid "Clears the FavIcons cached from visited websites"
msgstr "Briše keširane FavIcons posjećenih web stranica"

#: privacy.cpp:241
msgid "You are deleting data that is potentially valuable to you. Are you sure?"
msgstr "Brišete podatke koji bi mogli biti od neke vrijednosti. Da li ste sigurni?"

#: privacy.cpp:244
msgid "Starting cleanup..."
msgstr "Počinjem brisanje..."

#: privacy.cpp:253
msgid "Clearing %1..."
msgstr "Brišem %1..."

#: privacy.cpp:285
msgid "Clearing of %1 failed"
msgstr "Brisanje %1 nije uspjelo"

#: privacy.cpp:292
msgid "Clean up finished."
msgstr "Brisanje je završeno."

#: privacy.cpp:299
msgid ""
"The privacy module allows a user to erase traces which KDE leaves on the "
"system, such as command histories or browser caches."
msgstr ""
"Modul Privatnost pruža mogućnost korisnicima da izbrišu tragove koje KDE "
"ostavlja na sistemu, kao što su historija naredbi ili keš web pretraživača."

#: privacy.cpp:307
msgid "kcm_privacy"
msgstr "kcm_privacy"

#: privacy.cpp:307
msgid "KDE Privacy Control Module"
msgstr "KDE kontrolni modul za privatnost"

#: privacy.cpp:309
msgid "(c) 2003 Ralf Hoelzer"
msgstr "(c) 2003 Ralf Hoelzer"

#: rc.cpp:1
msgid "Privacy"
msgstr "Privatnost"

#: rc.cpp:4
msgid "Select None"
msgstr "Izaberi ništa"

#: rc.cpp:5
msgid "Clean Up"
msgstr "Očisti"

#: rc.cpp:7
msgid "Network privacy level:"
msgstr "Nivo mrežne privatnosti:"

#: rc.cpp:8
msgid "Low"
msgstr "Nizak"

#: rc.cpp:9
msgid "Medium"
msgstr "Srednji"

#: rc.cpp:10
msgid "High"
msgstr "Visok"

#: rc.cpp:11
msgid "Custom"
msgstr "Prilagođen"

#: rc.cpp:12
msgid "Financial Information"
msgstr "Informacije o finansijama"

#: rc.cpp:13
msgid "Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Upozori me kada posjetim sajt koji koristi podatke o mojim novčanim "
"transakcijama:"

#: rc.cpp:14 rc.cpp:18
msgid "For marketing or advertising purposes"
msgstr "U svrhu marketinga ili reklame"

#: rc.cpp:15 rc.cpp:19 rc.cpp:23
msgid "To share with other companies"
msgstr "Za dijeljenje sa drugim preduzećima"

#: rc.cpp:16
msgid "Health Information"
msgstr "Informacije o zdravstvenom stanju"

#: rc.cpp:17
msgid "Warn me when I visit a site that uses my health or medical information: "
msgstr "Upozori me kada posjetim sajt koji koristi podatke o mom zdravstvenom stanju:"

#: rc.cpp:20
msgid "Demographics"
msgstr "Demografija"

#: rc.cpp:21
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr "Upozori me kada posjetim sajt koji koristi javno dostupne podatke o meni:"

#: rc.cpp:22
msgid "To determine my interests, habits or general behavior"
msgstr "Da odredi moje navike, oblast interesovanja ili opšti način ponašanja"

#: rc.cpp:24
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Upozori me kada posjetim sajt koji razmjenjuje podatke o meni sa drugim "
"kompanijama"

#: rc.cpp:25
msgid ""
"Warn me when I visit a site that doesn't let me know what information they "
"have about me"
msgstr ""
"Upozori me kada posjetim sajt koji ne dopušta da znam koje informacije imaju o "
"meni"

#: rc.cpp:26
msgid "Personal Information"
msgstr "Lične informacije"

#: rc.cpp:27
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Upozori me kada posjetim sajt koji me može kontaktirati radi ponude svojih ostalih "
"proizvoda i usluga:"

#: rc.cpp:28
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr "Upozori me kada posjetim sajt koji može iskoristiti moje lične informacije za:"

#: rc.cpp:29
msgid "Determine my habits, interests or general behavior"
msgstr "Određivanje mojih navika, oblasti interesovanja ili opšteg načina ponašanja."

#: rc.cpp:30
msgid "Via telephone"
msgstr "telefonom"

#: rc.cpp:31
msgid "Via mail"
msgstr "pismom"

#: rc.cpp:32
msgid "Via email"
msgstr "elektronskom poštom"

#: rc.cpp:33
msgid "And do not allow me to remove my contact information"
msgstr "Spriječi me da uništim svoje informacije o kontaktima"

