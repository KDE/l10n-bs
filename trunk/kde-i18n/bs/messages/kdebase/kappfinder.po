#: main.cpp:27
msgid "KDE's application finder"
msgstr "KDEov pronalazač programa"

#: main.cpp:30
msgid "Install .desktop files into directory <dir>"
msgstr "Instaliraj .desktop datoteke u direktorij <dir>"

#: main.cpp:36 toplevel.cpp:49
msgid "KAppfinder"
msgstr "KNađiPrograme"

#: toplevel.cpp:52
msgid ""
"The application finder looks for legacy applications on your system and adds "
"them to the KDE menu system. Click 'Scan' to begin, select the desired "
"applications and then click 'Apply'."
msgstr ""
"Pronalazač programa je alat koji pronalazi programe koji su instalirani na "
"vašem sistemu i dodaje ih u vaš K meni. Da započnete pretragu, kliknite "
"na dugme 'Traži', izaberite željene aplikacije, zatim kliknite na "
"'Primijeni'."

#: toplevel.cpp:62
msgid "Application"
msgstr "Aplikacija"

#: toplevel.cpp:63
msgid "Description"
msgstr "Opis"

#: toplevel.cpp:64
msgid "Command"
msgstr "Naredba"

#: toplevel.cpp:75
msgid "Summary:"
msgstr "Sažetak:"

#: toplevel.cpp:84
msgid "Unselect All"
msgstr "Isključi sve"

#: toplevel.cpp:90
msgid "Scan"
msgstr "Traži"

#: toplevel.cpp:244
#, c-format
msgid ""
"_n: Summary: found %n application\n"
"Summary: found %n applications"
msgstr ""
"Status: pronađena %n aplikacija\n"
"Status: pronađene %n aplikacije\n"
"Status: pronađeno %n aplikacija"

#: toplevel.cpp:287
#, c-format
msgid ""
"_n: %n application was added to the KDE menu system.\n"
"%n applications were added to the KDE menu system."
msgstr ""
"%n aplikacija je dodana u vaš meni.\n"
"%n aplikacije su dodane u vaš meni.\n"
"%n aplikacija je dodano u vaš meni."

