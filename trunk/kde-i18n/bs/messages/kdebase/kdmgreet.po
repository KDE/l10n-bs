msgstr "&Očisti"

#: kgreeter.cpp:294
msgid "Co&nsole Login"
msgstr "&Konzola"

#: kgreeter.cpp:301
msgid "R&estart X Server"
msgstr "&Ponovo pokreni X Server"

#: kgreeter.cpp:302
msgid "Clos&e Connection"
msgstr "Za&tvori konekciju"

#: kgreeter.cpp:305
msgid "&Menu"
msgstr "&Meni"

#: kgreeter.cpp:313
msgid "&Shutdown..."
msgstr "&Ugasi..."

#: kgreeter.cpp:405
msgid "Login failed"
msgstr "Prijava nije uspjela."

#: kgreeter.cpp:408
msgid "Warning: Caps locked"
msgstr "Upozorenje: Uključen Caps Lock"

#: kgreeter.cpp:549
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile for more information\n"
"or contact your system administrator."
msgstr ""
"Pojavila se kritična greška.\n"
"Za više informacija pregledajte KDM log datoteku\n"
"ili kontaktirajte sistem administratora."

#: kgreeter.cpp:554
msgid "Home directory not available."
msgstr "Korisnički direktorij nije na raspolaganju."

#: kgreeter.cpp:557
msgid "Root logins are not allowed."
msgstr "Root korisniku nije dozvoljena prijava."

#: kgreeter.cpp:561
msgid "Your login shell is not listed in /etc/shells."
msgstr "Vaš shell se ne nalazi u /etc/shells datoteci."

#: kgreeter.cpp:564
msgid "Your account has expired."
msgstr "Vaš račun je istekao."

#: kgreeter.cpp:567
msgid "Your password has expired."
msgstr "Vaša šifra je istekla."

#: kgreeter.cpp:570
msgid ""
"You are not allowed to login\n"
"at the moment."
msgstr ""
"Nije vam dozvoljen pristup u\n"
"ovom trenutku."

#: kgreeter.cpp:587
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Prijave nisu dozvoljene u ovom trenutku.\n"
"Pokušajte nešto kasnije."

#: kgreeter.cpp:622
msgid "Your account expires today."
msgstr "Vaš account ističe danas."

#: kgreeter.cpp:624
msgid "Your account expires tomorrow."
msgstr "Vaš account ističe sutra."

#: kgreeter.cpp:627
msgid "Your account expires in %1 days."
msgstr "Vaš account ističe za %1 dana."

#: kgreeter.cpp:632
msgid "Your password expires today."
msgstr "Vaša šifra ističe danas."

#: kgreeter.cpp:634
msgid "Your password expires tomorrow."
msgstr "Vaša šifra ističe sutra."

#: kgreeter.cpp:637
msgid "Your password expires in %1 days."
msgstr "Vaša šifra ističe za %1 dana."
