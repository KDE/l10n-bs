msgstr "&Tip sesije:"

#: kgreeter.cpp:248
msgid ""
"_: session type\n"
"(previous)"
msgstr "(prethodna)"

#: kgreeter.cpp:249
msgid ""
"_: session type\n"
"(selected)"
msgstr "(izabrano)"

