msgid "Module %1 not found!"
msgstr "Modul %1 nije pronađen!"

#: kcmshell.cpp:53
msgid "List all possible modules"
msgstr "Izlistaj sve moguće module"

#: kcmshell.cpp:55
msgid "Specify a particular language."
msgstr "Izaberite određeni jezik."

#: kcmshell.cpp:56
msgid "Window ID to embed into."
msgstr "Identifikacija prozora je ugrađena."

#: kcmshell.cpp:57
msgid "Do not display main window."
msgstr "Ne prikazuj glavni prozor."

#: kcmshell.cpp:135
msgid "KDE Control Module"
msgstr "KDE kontrolni modul"

#: kcmshell.cpp:137
msgid "A tool to start single KDE control modules"
msgstr "Alat za pokretanje individualnih KDE kontrolnih modula"

#: kcmshell.cpp:141 main.cpp:115 main.cpp:117
msgid "Current Maintainer"
msgstr "Trenutno održava"

#: kcmshell.cpp:271
msgid "There was an error loading the module."
msgstr "Greška prilikom učitavanja modula."

#: kcmshell.cpp:271
msgid ""
"<qt>"
"<p>The diagnostics is:"
"<br>%1"
"<p>Possible reasons:</p>"
"<ul>"
"<li>An error occurred during your last KDE upgrade leaving an orphaned "
"control module"
"<li>You have old third party modules lying around.</ul>"
"<p>Check these points carefully and try to remove the module mentioned in "
"the error message. If this fails, consider contacting your distributor or "
"packager.</p></qt>"
msgstr ""
"<qt>"
"<p>Dijagnostika:"
"<br>%1"
"<p>Mogući razlozi:</p>"
"<ul>"
"<li>Greška se dogodila prilikom zadnje nadogradnje KDE-a, te je ostavljen "
"kontrolni modul kao \"siroče\" (orphan)."
"<li>Imate stare module koji su neiskorišteni.</ul>"
"<p>"
"Pažljivo provjerite navedeno i pokušajte ukloniti spomenute module. Ako ne "
"uspije, probajte pitati vašeg distributera ili tvorca paketa.</p></qt>"

#: kcrootonly.cpp:31
msgid ""
"<big>You need super user privileges to run this control "
"module.</big><br>Click on the \"Administrator Mode\" button below."
msgstr ""
"<big>Trebate administratorske privilegije za pokretanje ovog kontrolnog "
"modula.</big><br>Kliknite na dugme \"Administrativni način\" ispod."

#: kecdialog.cpp:43
msgid "Settings"
msgstr "Postavke"

