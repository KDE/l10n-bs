msgstr "Konf. modul koji želite otvoriti."

#: kcminit.cpp:65
msgid "KCMInit"
msgstr "KCMInit"

#: kcminit.cpp:67
msgid "KCMInit - runs startups initialization for Control Modules."
msgstr "KCMinit - pokreće početnu inicijalizaciju za Kontrolne module."

