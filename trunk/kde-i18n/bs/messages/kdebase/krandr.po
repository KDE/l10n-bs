#: randr.cpp:259
msgid "Mirrored horizontally"
msgstr "Preslikano vodoravno"

#: randr.cpp:261
msgid "mirrored horizontally"
msgstr "preslikano vodoravno"

#: randr.cpp:264
msgid "Mirrored vertically"
msgstr "Preslikano uspravno"

#: randr.cpp:266
msgid "mirrored vertically"
msgstr "preslikano uspravno"

#: randr.cpp:271
msgid "unknown orientation"
msgstr "nepoznata orijentacija"

