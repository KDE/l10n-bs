#: imap4.cc:813
msgid "What do you want to store in this folder?"
msgstr "Šta želite imati u ovom direktoriju?"

#: imap4.cc:813
msgid "Create Folder"
msgstr "Napravi direktorij"

#: imap4.cc:814
msgid "&Messages"
msgstr "&Poruke"

#: imap4.cc:814
msgid "&Subfolders"
msgstr "&Poddirektoriji"

#: imap4.cc:1092
msgid "Unsubscribe of folder %1 failed."
msgstr ""

#: imap4.cc:1109
msgid "Subscribe of folder %1 failed."
msgstr ""

#: imap4.cc:1131 imap4.cc:1142
msgid "Changing the flags of message %1 failed."
msgstr "Promjena zastavica poruke %1 nije uspjela."

#: imap4.cc:1231
msgid "Unable to close mailbox."
msgstr "Nisam u mogućnosti zatvoriti mailbox."

#: imap4.cc:1254
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Ne mogu se autentificirati preko %1. Odgovor servera: %2"

#: imap4.cc:1417
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Server %1 ne podržava niti IMAP4 niti IMAP4rev1.\n"
"Server korisiti %2."

#: imap4.cc:1428
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Server ne podržava TLS.\n"
"Isključite ovu sigurnosnu opciju kako bi se konektovali ne-kriptovano."

#: imap4.cc:1453
msgid "Starting TLS failed."
msgstr "Pokretanje TLS-a nije uspjelo."

#: imap4.cc:1463
msgid "The authentication method %1 is not supported by the server."
msgstr "Server ne podržava autentifikacijski metod %1."

#: imap4.cc:1474
msgid "Username and password for your IMAP account:"
msgstr "Korisničko ime i šifra za vaš IMAP account:"

#: imap4.cc:1488
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""
"Kod IMAP-ove čisto tekstualne prijave, jedino US-ASCII karakteri su "
"dozvoljeni. Molim koristite drugi autentifikacijski metod koji vaš server "
"podržava ili pokušajte dobiti drugo korisničko ime."

#: imap4.cc:1493
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"Kod IMAP-ove čisto tekstualne prijave, jedino US-ASCII karakteri su "
"dozvoljeni. Molim koristite drugi autentifikacijski metod koji vaš server "
"podržava ili promijenite šifru."

#: imap4.cc:1498
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Ne mogu se prijaviti. Vjerovatno šifra nije dobro upisana.\n"
"Odgovor servera:\n"
"%1"

#: imap4.cc:1504
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Ne mogu se autentificirati preko %1.\n"
"Odgovor servera:\n"
"%2"

#: imap4.cc:1904
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Ne mogu se autentificirati preko %1. Odgovor servera: %2"
