#: imap4.cc:754
msgid "What do you want to store in this folder?"
msgstr "Šta želite imati u ovom direktoriju?"

#: imap4.cc:754
msgid "Create folder"
msgstr "Kreiraj direktorij"

#: imap4.cc:755
msgid "&Messages"
msgstr "&Poruke"

#: imap4.cc:755
msgid "&Subfolders"
msgstr "&Poddirektoriji"

#: imap4.cc:1032 imap4.cc:1044
msgid "Changing the flags of message %1 failed."
msgstr "Promjena zastavica poruke %1 nije uspjela."

#: imap4.cc:1133
msgid "Unable to close mailbox."
msgstr "Nisam u mogućnosti zatvoriti mailbox."

#: imap4.cc:1299
msgid ""
"Sorry, the server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Žalim, server %1 ne podržava niti IMAP4 ni IMAP4rev1.\n"
"Server korisiti %2."

#: imap4.cc:1310
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Server ne podržava TLS.\n"
"Isključite ovu sigurnosnu opciju kako bi se konektovali ne-kriptovano."

#: imap4.cc:1335
msgid "Starting TLS failed."
msgstr "Pokretanje TLS-a nije uspjelo."

#: imap4.cc:1345
msgid "The authentication method %1 is not supported by the server."
msgstr "Server ne podržava autentifikacijski metod %1."

#: imap4.cc:1354
msgid "Username and password for your IMAP account:"
msgstr "Korisničko ime i šifra za vaš IMAP account:"

#: imap4.cc:1363
msgid ""
"Sorry, in IMAP clear text login, only US-ASCII characters are possible. "
"Please use a different authentication method that your server supports or "
"try to get a different username."
msgstr ""
"Žalim, kod IMAP-ove čisto tekstualne prijave, jedino US-ASCII karakteri su "
"dozvoljeni. Molim koristite drugi autentifikacijski metod koji vaš server "
"podržava ili pokušajte dobiti drugo korisničko ime."

#: imap4.cc:1368
msgid ""
"Sorry, in IMAP clear text login, only US-ASCII characters are possible. "
"Please use a different authentication method that your server supports or "
"change your password."
msgstr ""
"Žalim, kod IMAP-ove čisto tekstualne prijave, jedino US-ASCII karakteri su "
"dozvoljeni. Molim koristite drugi autentifikacijski metod koji vaš server "
"podržava ili promjenite šifru."

#: imap4.cc:1373
#, c-format
msgid ""
"Could not login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Ne mogu se logovati. Vjerovatno šifra nije dobro upisana.\n"
"Server je odgovorio:\n"
"%1"

#: imap4.cc:1379
msgid ""
"Could not authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Ne mogu se autentificirati preko %1.\n"
"Server je odgovorio:\n"
"%2"
