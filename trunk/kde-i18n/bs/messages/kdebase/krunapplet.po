#: runapplet.cpp:58
msgid "Run Command:"
msgstr "Pokreni komandu:"

#: runapplet.cpp:165
msgid "< Run"
msgstr "< Pokreni"

#: runapplet.cpp:172
msgid "Run >"
msgstr "Pokreni >"

#: runapplet.cpp:227
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Morate unijeti komandu za izvršenje ili URL koji treba otvoriti."

#: runapplet.cpp:236
msgid ""
"Could not logout properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing the CTRL, ALT and BACKSPACE keys at the same time. Note however "
"that your current session will not be saved with a forced shutdown."
msgstr ""
"Ne mogu se ispravno odjaviti.\n"
"Menadžer sesija nije dostupan. Možete pokušati ugasiti mašinu koristeći "
"CRTL, ALT i BACKSPACE tipke u isto vrijeme. Imajte na umu da trenutna sesija "
"neće biti sačuvana ukoliko korisite ovaj način gašenja računara."

#: runapplet.cpp:275
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>Program ili komanda <b>%1</b>\n"
"nije nađen/a. Molim unesite ispravan naziv komande\n"
"ili URL-a i pokušajte ponovo</qt>"

#: runapplet.cpp:286
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>Ne mogu pokrenuti <b>%1</b>.\n"
"Molim ispravite komandu ili URL i pokušajte ponovo.</qt>"
