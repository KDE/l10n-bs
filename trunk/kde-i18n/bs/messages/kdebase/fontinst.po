#: DirSettingsWidgetData.cpp:86 rc.cpp:9
msgid ""
"This is the top level X11 fonts folder. Located within this will be the "
"folders containing your fonts, and encodings files. Usually this will be "
"(for Linux) either:\n"
"\n"
"    ~/.kde/share/fonts/    (Normal users)\n"
"    /usr/X11R6/lib/X11/fonts/    (Root)"
