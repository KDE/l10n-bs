#: KfiCmModule.cpp:141
msgid ""
"<h1>Font Installer</h1>"
"<p> This module allows you to install TrueType, Type1, Speedo, and Bitmap "
"fonts. If you have StarOffice installed on your system, this can also be "
"configured.</p>"
