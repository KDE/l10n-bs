#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b>"
"<P>KDE now supports utilizing older themes from other platforms in your new "
"KDE desktop. The most common type of legacy theme is for the GTK toolkit, "
"which is imported to KDE's Control Center with this utility."
"<P>In order to do this you must specify at least one item: the folder where "
"the pixmaps for the theme is located. You may also have to specify the "
"theme's gtkrc file if it's not in the same folder as the pixmaps. Both are "
"usually in the folder \"gtk\" inside the theme's directory.</QT>"
msgstr ""
"<QT><b>Uvoznik starih tema</b>"
"<P>KDE sada podržava korištenje starih tema sa starih platformi na vašem "
"novom KDE desktopu. Najčešći tip starih tema su teme za GTK toolkit, koji "
"se mogu uvesti u KDE Kontrolni centar pomoću ovog alata."
"<P>Da biste ovo napravili, morate navesti makar jedno: direktorij gdje se "
"nalaze pixmape za temu. Možda ćete morati također navesti gtkrc datoteku "
"teme ako se ona ne nalazi u istom direktoriju kao i pixmape. Oboje se "
"uglavnom nalazi u direktoriju \"gtk\" unutar direktorija tema.</QT>"

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Korak 1: Navedite direktorij sa pixmapama teme:"

#: legacyimport.cpp:51
msgid "Specify pixmap directory"
msgstr "Navedite pixmap direktorij"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b>"
"<P>A gtkrc file was not found in the specified directory. If it exists "
"somewhere other than where the pixmaps are located enter it here.</QT>"
msgstr ""
"<QT><b>Uvoznik starih tema</b>"
"<P>"
"gtkrc datoteka nije pronađena u navedenom direktoriju. Ako se ona nalazi "
"negdje drugo, a ne tamo gdje i pixmape, molimo unesite taj direktorij "
"ovdje.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Korak 2: Odredite gtkrc teme:"

#: legacyimport.cpp:76
msgid "Specify gtkrc directory"
msgstr "Navedite gtkrc direktorij"

#: legacyimport.cpp:85
msgid "Legacy Import"
msgstr "Uvoz starih tema"

#: legacyimport.cpp:92
msgid "GTK Themes Folder"
msgstr "GTP direktorij sa temama"

#: legacyimport.cpp:116 legacyimport.cpp:137
msgid "You did not enter a valid file!"
msgstr "Niste unijeli ispravnu datoteku!"

#: legacyimport.cpp:124
msgid "Gtkrc Theme File"
msgstr "Gtkrc datoteka teme"

#: legacyimport.cpp:144
msgid "Theme Title"
msgstr "Naslov teme"

#: legacyimport.cpp:145
msgid "Please enter a short title for this theme:"
msgstr "Molim unesite kratak naslov za ovu temu:"

#: legacyimport.cpp:152
msgid "Legacy widget theme"
msgstr "Stara tema ukrasa"

#: legacyimport.cpp:158
msgid "The theme is now installed and will be shown in KDE's Control Center."
msgstr "Ova tema je sada instalirana i biće prikazana u KDE Kontrolnom centru."

#: legacyimport.cpp:165
msgid "KLegacyImport"
msgstr "KLegacyImport"

