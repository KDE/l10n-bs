#: fileshare.cpp:42
msgid "File Sharing"
msgstr "Dijeljenje datoteka"

#: fileshare.cpp:46
msgid "Do &not allow users to share files"
msgstr "&Ne dozvoli korisnicima da dijele datoteke"

#: fileshare.cpp:47
msgid "&Allow users to share files from their HOME directory"
msgstr "&Dozvoli korisnicima da dijele datoteke u njihovom HOME direktoriju"

#: fileshare.cpp:58
msgid ""
"SMB and NFS servers are not installed on this machine, to enable this module "
"the servers must be installed."
msgstr ""
"SMB i NFS serveri nisu instalirani na ovoj mašini, a da bi se uključili "
"ovaj modul ovi serveri moraju biti instalirani."

#: fileshare.cpp:143
msgid ""
"<h1>File Sharing</h1>"
"<p>"
"This module can be used to enable file sharing over the network using the "
"\"Network File System\" (NFS) or SMB in Konqueror. The latter enables you to "
"share your files with Windows(TM) computers on your network.</p>"
msgstr ""
"<h1>Dijeljenje datoteka</h1>"
"<p>Ovaj modulse može koristiti za uključivanje dijeljenja datoteka preko "
"mreže u Konqueroru, koristeći \"Network File System\" (NFS) ili SMB. "
"Potonji vam omogućava da dijelite datoteke sa Windows(TM) računarima na "
"vašoj mreži.</p>"

#~ msgid "SMB and NFS servers not installed!"
#~ msgstr "SMB i NFS serveri nisu instalirani!"
