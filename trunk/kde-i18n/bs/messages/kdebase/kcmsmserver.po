#: kcmsmserver.cpp:89
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout), should be "
"confirmed and if the previous session should be restored when logging in."
msgstr ""
"<h1>Menadžer sesije</h1> Ovdje možete podesiti menadžera sesije. To uključuje "
"opcije kao da li ćete trebati da potvrdite izlaz iz sesije (logout) kao i "
"da li će vaša prethodna sesija biti rekonstruisana kada otvorite novu sesiju."

#: rc.cpp:1 rc.cpp:2
msgid "Session Manager"
msgstr "Menadžer sesija"

#: rc.cpp:3
msgid "Confirm &logout"
msgstr "Potvrdi &logout"

#: rc.cpp:4
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""
"Markirajte ovu opciju ako želite da menadžer sesije zatraži potvrdu "
"zatvaranja sesije."

#: rc.cpp:5
msgid "&Restore previous session when logging in"
msgstr "&Rekonstruiši prethodnu sesiju u sljedećoj sesiji"

#: rc.cpp:6
msgid ""
"Check this option if you want the session manager to save the running "
"session when logging out and restore it on the next login."
msgstr ""
"Markirajte ovu opciju ako želite da menadžer sesije sačuva stanje sesije "
"pri izlasku i da je rekonstruiše u narednoj sesiji."

