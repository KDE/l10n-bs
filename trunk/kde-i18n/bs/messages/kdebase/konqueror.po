msgstr "Premješta označeni tekst/stavke u spremnik"

#: konq_mainwindow.cc:2878
msgid ""
"Click this button to copy the currently selected text or items to the system "
"clipboard<br><br>\n"
"\n"
"You can also select the <b>Copy</b> command from the Edit menu."
msgstr ""
