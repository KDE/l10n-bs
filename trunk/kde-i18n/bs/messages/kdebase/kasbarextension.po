#: kasprefsdlg.cpp:24
msgid "Kasbar Preferences"
msgstr "Kasbar postavke"

#: kasprefsdlg.cpp:38
msgid "Specifies the size of the task items."
msgstr "Specifies the size of the task items."

#: kasprefsdlg.cpp:40
msgid "Si&ze:"
msgstr "&Veličina"

#: kasprefsdlg.cpp:43
msgid "Large"
msgstr "Veliki"

#: kasprefsdlg.cpp:44
msgid "Medium"
msgstr "Srednji"

#: kasprefsdlg.cpp:45
msgid "Small"
msgstr "Mali"

#: kasprefsdlg.cpp:52
msgid "Trans&parent"
msgstr "Trans&parentno"

#: kasprefsdlg.cpp:53
msgid "Enables pseudo-transparent mode."
msgstr "Uključi pseudo-transparentni mod."

#: kasprefsdlg.cpp:57
msgid "Enable T&int"
msgstr "Uključi t&intu"

#: kasprefsdlg.cpp:59
msgid "Enables tinting the background that shows through in transparent mode."
msgstr "Enables tinting the background that shows through in transparent mode."

#: kasprefsdlg.cpp:65
msgid "Specifies the color used for the background tint."
msgstr "Specifies the color used for the background tint."

#: kasprefsdlg.cpp:67
msgid "Tint &Color:"
msgstr "&Boja tinte:"

#: kasprefsdlg.cpp:76
msgid "Specifies the strength of the background tint."
msgstr "Specifies the strength of the background tint."

#: kasprefsdlg.cpp:78
msgid "Tint &Strength: "
msgstr "Jačina ti&nte: "

#: kasprefsdlg.cpp:92
msgid "Thumbnails"
msgstr "Thumbnails"

#: kasprefsdlg.cpp:94
msgid "Enable Thu&mbnails"
msgstr "Uključi Thu&mbnails"

#: kasprefsdlg.cpp:96
msgid ""
"Enables the display of a thumbnailed image of the window when you move your "
"mouse pointer over an item. The thumbnails are approximate, and may not "
"reflect the current window contents.\n"
"\n"
"Using this option on a slow machine may cause performance problems."
msgstr ""
"Enables the display of a thumbnailed image of the window when you move your "
"mouse pointer over an item. The thumbnails are approximate, and may not "
"reflect the current window contents.\n"
"\n"
"Using this option on a slow machine may cause performance problems."

#: kasprefsdlg.cpp:105
msgid ""
"Controls the size of the window thumbnails. Using large sizes may cause "
"performance problems."
msgstr ""
"Controls the size of the window thumbnails. Using large sizes may cause "
"performance problems."

#: kasprefsdlg.cpp:107
msgid "Thumbnail &Size: "
msgstr "Ve&ličina thumbnail-a: "

#: kasprefsdlg.cpp:117
msgid ""
"Controls the frequency with which the thumbnail of the active window is "
"updated. If the value is 0 then no updates will be performed.\n"
"\n"
"Using small values may cause performance problems on slow machines."
msgstr ""
"Controls the frequency with which the thumbnail of the active window is "
"updated. If the value is 0 then no updates will be performed.\n"
"\n"
"Using small values may cause performance problems on slow machines."

#: kasprefsdlg.cpp:120
msgid "&Update thumbnail every: "
msgstr "Uradi update t&humbnail-a svakih: "

#: kasprefsdlg.cpp:125
msgid "seconds"
msgstr "sekunde/i"

#: kasprefsdlg.cpp:133
msgid "Behavior"
msgstr "Ponašanje"

#: kasprefsdlg.cpp:135
msgid "Enable &Startup Notifier"
msgstr "Omogući &Startup Notifier"

#: kasprefsdlg.cpp:137
msgid ""
"Enables the display of tasks that are starting but have not yet created a "
"window."
msgstr ""
"Enables the display of tasks that are starting but have not yet created a "
"window."

#: kasprefsdlg.cpp:142
msgid "Enable &Modified Indicator"
msgstr "Omogući &modifikovani indikator"

#: kasprefsdlg.cpp:144
msgid ""
"Enables the display of a floppy disk state icon for windows containing a "
"modified document."
msgstr ""
"Enables the display of a floppy disk state icon for windows containing a "
"modified document."

#: kasprefsdlg.cpp:149
msgid "Show All &Windows"
msgstr "Prikaži sve p&rozore"

#: kasprefsdlg.cpp:151
msgid "Enables the display of all windows, not just those on the current desktop."
msgstr "Enables the display of all windows, not just those on the current desktop."

#: kasprefsdlg.cpp:155
msgid "&Group Windows"
msgstr "&Grupiraj prozore"

#: kasprefsdlg.cpp:157
msgid "Enables the grouping together of related windows."
msgstr "Enables the grouping together of related windows."

#: kasprefsdlg.cpp:164
msgid ""
"Specifies the maximum number of items that should be placed in a line before "
"starting a new row or column. If the value is 0 then all the available space "
"will be used."
msgstr ""
"Specifies the maximum number of items that should be placed in a line before "
"starting a new row or column. If the value is 0 then all the available space "
"will be used."

#: kasprefsdlg.cpp:167
msgid "Ma&x Boxes: "
msgstr "Ma&x pločica: "

#: kastaskitem.cpp:120
msgid "All"
msgstr "Sve"

