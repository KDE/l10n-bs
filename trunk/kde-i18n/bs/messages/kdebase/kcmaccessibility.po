#~ msgid ""
#~ "This option will turn on the \"visible bell\", i.e. a visible "
#~ "notification shown every time that normally just a bell would occur. This "
#~ "is especially useful for deaf people."
#~ msgstr ""
#~ "Ovdje se omogućava \"vidljivo zvono\", tj. svaki put kada bi se samo "
#~ "zvonce trebalo čuti, pojaviće se i vidljivi znak, što je posebno korisno "
#~ "osobama koje rade u buci ili imaju oštećen sluh."

#~ msgid ""
#~ "All screen colors will be inverted for the amount of time specified below."
#~ msgstr ""
#~ "Tokom dole navedenog vremena, umjesto boja na ekranu biće korištene njima "
#~ "suprotne."

#~ msgid ""
#~ "The screen will turn to a custom color for the amount of time specified "
#~ "below."
#~ msgstr ""
#~ "Ekran će poprimiti boju kou ste odabrali tokom dole navedenog vremena."

#~ msgid ""
