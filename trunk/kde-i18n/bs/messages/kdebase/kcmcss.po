#: kcmcss.cpp:229
msgid ""
"This module allows you to apply your own color and font settings to "
"konqueror by using stylesheets (CSS). You can either specify options or "
"apply your own self-written stylesheet by pointing to its location."
"<br> Note that these settings will always have precedence before all other "
"settings made by the site author. This can be useful to visually impaired "
"people or for web pages that are unreadable due to bad design."
msgstr ""
"Ovaj modul vam omogućuje da primjenite boje i fontove po vašoj želji u "
"konqueror-u koristeći stylesheets (CSS). Imate izbor da navedete opcije, "
"ili da primjenite vlastiti stylesheet tako što ćete navesti njegovu "
"lokaciju."
"<br> Obratite pažnju da će ova podešavanja biti korištena umjesto onih "
"koje je napravio autor web stranice. Ovo može biti korisno za osobe sa "
"slabijim vidom, ili za web starnice koje su nečitke zbog lošeg dizajna."

#: rc.cpp:1 rc.cpp:5
msgid "Stylesheets"
msgstr "Stylesheets"

#: rc.cpp:2 rc.cpp:3
msgid ""
"<b>Stylesheets</b>"
"<p>See http://www.w3.org/Style/CSS for further information on cascading "
"style sheets.</p>"
msgstr ""
"<b>Stylesheets</b>"
"<p>Pogledajte http://www.w3.org/Style/CSS ako vam treba više informacija o "
"CSS.</p>"

#: rc.cpp:4
msgid "&General"
msgstr "O&pšte"

#: rc.cpp:6
msgid ""
"<b>Stylesheets</b>"
"<p>Use this groupbox to determine how Konqueror will render style sheets.</p>"
msgstr ""
"<b>Stylesheets</b>"
"<p>Koristite ovu groupbox da biste odredili kako će Konqueror prikazivati "
"style sheets.</p>"

#: rc.cpp:7
msgid "Use &user-defined stylesheet"
msgstr "&Upotrijebi korisnikov stylesheet"

#: rc.cpp:8
msgid ""
"<b>Use user-defined stylesheet</b>"
"<p>If this box is checked, konqueror will try to load a user-defined style "
"sheet as specified in the location below. The style sheet allows you to "
"completely override the way web pages are rendered in your browser. The file "
"specified should contain a valid style sheet (see "
"http://www.w3.org/Style/CSS for further information on cascading style "
"sheets).</p>"
msgstr ""
"<b>Upotrijebi korisnikov stylesheet</b>"
"<p>"
"Ako je ova kutija markirana konqueror će pokušati da koristi stylesheet "
"koji se nalazi na dole navedenom mjestu. Stylesheet vam omogućuje da u "
"potpunosti definišete kako će se web stranice prikazivati u vašem "
"pregledniku. Navedena datoteka mora sadržavati ispravan stylesheet "
"(pogledajte http://www.w3.org/Style/CSS ako želite saznati više o CSS).</p>"

#: rc.cpp:9
msgid "Use &accessiblity stylesheet defined in \"Customize\"-tab"
msgstr ""
"Koristi stylesheet prilagođen za pristup&ačnost naveden u "
"\"Prilagodi\"-tabu"

#: rc.cpp:10
msgid ""
"<b>Use accessiblity stylesheet defined in "
"&quot;Customize&quot;-tab</b>"
"<p>"
"Selecting this option will allow you to define a default font, font size, "
"and font color with a few simple clicks of the mouse. Simply wander over to "
"the Customize tab and pick out your desired options.</p>"
msgstr ""
"<b>Koristi stylesheet prilagođen za pristupačnost naveden u "
"&quot;Prilagodi&quot;-tabu</b>"
"<p>"
"Izabiranjem ove opcije možete promijeniti default font, veličinu i boju "
"fontova na jednostavan način sa nekoliko pritisaka na miša. Izaberite tab "
"sa imenom Prilagodi i odlučite se za željene opcije.</p>"

#: rc.cpp:11
msgid "Use &default stylesheet"
msgstr "Upotrijebi &default stylesheet"

#: rc.cpp:12
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""
"<b>Upotrijebi default stylesheet</b>"
"<p>Izaberite ovu opciju da bi ste koristili default stylesheet.</p>"

#: rc.cpp:13
msgid "&Customize"
msgstr "Prila&godi"

#: rc.cpp:14
msgid "Colors"
msgstr "Boje"

#: rc.cpp:15
msgid "&Black on White"
msgstr "Crna na &bijeloj"

#: rc.cpp:16
msgid "<b>Black on White</b><p>This is what you normally see.</p>"
msgstr "<b>Crna na bijeloj</b><p>Ovo je uobičajena kombinacija.</p>"

#: rc.cpp:17
msgid "&White on Black"
msgstr "Bije&la na crnoj"

#: rc.cpp:18
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr "<b>Bijela na crnoj</b><p>Ovo je klasična invertirana šema.</p>"

#: rc.cpp:19
msgid "Cus&tom"
msgstr "Vlas&tito"

#: rc.cpp:20
msgid ""
"<b>Custom</b>"
"<p>Select this option to define a custom color for the default font.</p>"
msgstr ""
"<b>Vlastito</b>"
"<p>Izaberite ovu opciju da bi ste definisali svoje boje za default font.</p>"

#: rc.cpp:21 rc.cpp:23
msgid ""
"<b>Foreground color</b>"
"<p>The foreground color is the color that the text is drawn in.</p>"
msgstr "<b>Boja teksta</b><p>Ovo je boja kojom će tekst biti ispisivan:).</p>"

#: rc.cpp:22
msgid "&Foreground:"
msgstr "Boja te&ksta:"

#: rc.cpp:24
msgid ""
"<b>Background</b>"
"<p>Behind this door lays the ability to choose a custom default "
"background.</p>"
msgstr ""
"<b>Pozadina</b>"
"<p>Ovdje vam se otvara mogućnost da izaberete vlastitu boju pozadine.</p>"

#: rc.cpp:25
msgid "B&ackground:"
msgstr "Po&zadina:"

#: rc.cpp:26
msgid ""
"<b>Background</b>"
"<p>This background color is the one displayed behind the text by default. A "
"background image will override this.</p>"
msgstr ""
"<b>Pozadina</b>"
"<p>Boja pozadine će biti korištena kao podloga za tekst. Ovo ne važi u "
"slučaju da se slika koristi kao pozadina.</p>"

#: rc.cpp:27
msgid "Use same color for all text"
msgstr "Koristi istu boju za sav tekst"

#: rc.cpp:28 rc.cpp:29
msgid ""
"<b>Use same color for all text</b>"
"<p>"
"Select this option to apply your chosen color to the default font as well as "
"any custom fonts as specified in a stylesheet.</p>"
msgstr ""
"<b>Koristi istu boju za sav tekst</b>"
"<p>Koristite ovu opciju da bi ste primjenili izabranu boju za default font "
"kao i za vaše fontove koje ste naveli u stylesheet.</p>"

#: rc.cpp:30
msgid "Images"
msgstr "Slike"

#: rc.cpp:31
msgid "<b>Images</b><p></b>"
msgstr "<b>Slike</b><p></b>"

#: rc.cpp:32
msgid "&Suppress images"
msgstr "&Spriječi slike"

#: rc.cpp:33
msgid ""
"<b>Suppress images</b>"
"<p>Selecting this will prevent Konqueror from loading images.</p>"
msgstr ""
"<b>Spriječi slike</b>"
"<p>Ako ovo izaberete Konqueror neće prikazivati slike.</p>"

#: rc.cpp:34
msgid "Suppress background images"
msgstr "Spriječi slike u pozadini"

#: rc.cpp:35
msgid ""
"<b>Suppress background images</b>"
"<p>Selecting this option will prevent Konqueror from loading background "
"images.</p>"
msgstr ""
"<b>Spriječi slike u pozadini</b>"
"<p>Ovom opcijom možete spriječiti da Konqueror koristi slike kao "
"pozadinu.</p>"

#: rc.cpp:36
msgid "&Preview..."
msgstr "&Pregled..."

#: rc.cpp:37
msgid ""
"<b>Preview</b>"
"<p>Click on this button to see what your selections look like in action.</p>"
msgstr ""
"<b>Pregled</b>"
"<p>Pritisnite ovo dugme da bi ste vidjeli kako vaš izbor izgleda u "
"živo.</p>"

#: rc.cpp:38
msgid "Font family"
msgstr "Porodica fontova"

#: rc.cpp:39 rc.cpp:40
msgid ""
"<b>Font family</b>"
"<p>A font family is a group of fonts that resemble one another, with family "
"members that are e.g. bold, italic, or any number of the above.</p>"
msgstr ""
"<b>Porodica fontova</b>"
"<p>Porodica fontova je grupa fontova koji su slični jedni drugim, članovi "
"porodice su npr. bold, italic, ili bilo koji broj iznad.</p>"

#: rc.cpp:41
msgid "Base fa&mily:"
msgstr "Bazna poro&dica:"

#: rc.cpp:43
msgid "<p>This is the currently selected font family</p>"
msgstr "<p>Ovo je porodica fontova koja je trenutno u upotrebi</p>"

#: rc.cpp:44
msgid "Use same family for all text"
msgstr "Koristi istu porodicu za sav tekst"

#: rc.cpp:45
msgid ""
"<b>Use same family for all text</b>"
"<p>Select this option to override custom fonts everywhere in favor of the "
"base font.</p>"
msgstr ""
"<b>Koristi istu porodicu za sav tekst</b>"
"<p>Koristite ovu opciju da bi bazni font bio uvijek korišten bez obzira na "
"specificirani font na web stranici.</p>"

#: rc.cpp:46
msgid "Font size"
msgstr "Veličina fonta"

#: rc.cpp:47
msgid "<b>Font size</b>"
msgstr "<b>Veličina fonta</b>"

#: rc.cpp:48
msgid "7"
msgstr "7"

#: rc.cpp:49
msgid "8"
msgstr "8"

#: rc.cpp:50
msgid "9"
msgstr "9"

#: rc.cpp:51
msgid "10"
msgstr "10"

#: rc.cpp:52
msgid "11"
msgstr "11"

#: rc.cpp:53
msgid "12"
msgstr "12"

#: rc.cpp:54
msgid "14"
msgstr "14"

#: rc.cpp:55
msgid "16"
msgstr "16"

#: rc.cpp:56
msgid "20"
msgstr "20"

#: rc.cpp:57
msgid "24"
msgstr "24"

#: rc.cpp:58
msgid "32"
msgstr "32"

#: rc.cpp:59
msgid "48"
msgstr "48"

#: rc.cpp:60
msgid "64"
msgstr "64"

#: rc.cpp:61
msgid "Base Font Si&ze:"
msgstr "Veličina ba&znog fonta:"

#: rc.cpp:62
msgid "&Use same size for all elements"
msgstr "Koristi ist&u veličinu za sve elemente"

#: rc.cpp:63
msgid ""
"<b>Use same size for all elements</b>"
"<p>Select this option to override custom font sizes in favor of the base "
"font size. All fonts will be displayed in the same size.</p>"
msgstr ""
"<b>Koristi istu veličinu za sve elemente</b>"
"<p>Koristite ovu opciju kako veličina baznog fonta bila korištena za sve "
"fontove. Svi fontovi će imati istu veličinu.</p>"

#: rc.cpp:64
msgid "Preview"
msgstr "Pregled"

#: rc.cpp:65
msgid ""
"<qt>\n"
"\n"
"<h1>Heading 1</h1><br/>\n"
"<h2>Heading 2</h2><br/>\n"
"<h3>Heading 3</h3><br/>\n"
"\n"
"<p>User defined stylesheets allow increased\n"
"accessibility for visually handicapped\n"
"people.</p>\n"
"\n"
"</qt>"
msgstr ""
"<qt>\n"
"\n"
"<h1>Heading 1</h1><br/>\n"
"<h2>Heading 2</h2><br/>\n"
"<h3>Heading 3</h3><br/>\n"
"\n"
"<p>Korisnički stylesheet-ovi olakšavaju\n"
"čitanje osobama sa slabijim\n"
"vidom.</p>\n"
"\n"
"</qt>"

