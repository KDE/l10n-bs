#: kdesu.cpp:51 kdesu.cpp:52
msgid "Specifies the command to run."
msgstr "Navodi naredbu koju treba pokrenuti."

#: kdesu.cpp:53
msgid "Run command under target uid if <file> is not writeable."
msgstr "Pokreni naredbu pod slijedećim uid-om ako se ne može pisati u <file>."

#: kdesu.cpp:54
msgid "Specifies the target uid"
msgstr "Navodi ciljni uid"

#: kdesu.cpp:55
msgid "Do not keep password."
msgstr "Nemoj sačuvati šifru."

#: kdesu.cpp:56
msgid "Stop the daemon (forgets all passwords)."
msgstr "Zaustavi demona (zaboravlja sve šifre)."

#: kdesu.cpp:57
msgid "Enable terminal output (no password keeping)."
msgstr "Omogući ispis na treminal (bez čuvanja šifri)."

#: kdesu.cpp:58
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Unesite prioritet: 0 <= prio <= 100, 0 je najniži."

#: kdesu.cpp:59
msgid "Use realtime scheduling."
msgstr "Koristi realtime raspored."

#: kdesu.cpp:60
msgid "Let command use existing dcopserver."
msgstr "Dopusti da komanda koristi postojeći dcopserver."

#: kdesu.cpp:81
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:82
msgid "Runs a program with elevated privileges."
msgstr "Pokreće program sa povišenim privilegijama."

#: kdesu.cpp:85
msgid "Maintainer"
msgstr "Održavatelj"

#: kdesu.cpp:87
msgid "Original author"
msgstr "Orginalni autor"

#: kdesu.cpp:156
#, c-format
msgid "Illegal priority: %1"
msgstr "Nepostojeći prioritet: %1"

#: kdesu.cpp:181
msgid "No command specified!"
msgstr "Nijedna komanda nije navedena!"

#: kdesu.cpp:261
msgid ""
"Su returned with an error!\n"
msgstr ""
"Su se vratio sa greškom!\n"

#: kdesu.cpp:276
msgid "Command:"
msgstr "Komanda:"

#: kdesu.cpp:281
msgid "realtime: "
msgstr "realtime: "

#: kdesu.cpp:283
msgid "Priority:"
msgstr "Prioritet:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Pokreni kao %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"Akcija koju ste zatražili zahtjeva root privilegije. Molim, unesite root "
"šifru ili kliknite Odbaci kako bi nastavili s postojećim privilegijama."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Akcija koju ste zatražili zahtjeva dodatne privilegije. Molim unesite "
"šifru za \"%1\" ili kliknite na Odbaci kako bi nastavili sa postojećim "
"privilegijama."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&Odbaci"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "Razgovor sa 'su' nije uspio."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"Ne mogu naći program `su'!\n"
"Provjerite da je putanja (PATH) ispravno podešena."

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Nemate privilegije za korištenje `su'!\n"
"Na nekim sistemima morate biti član posebne grupe (obično: wheel) ako "
"želite koristiti ovaj program."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr "Kriva šifra! Molim, pokušajte ponovo."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Interna greška: Ilegalni povratni kod SuProcess::checkInstall()"

