#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pouzdani upravljač KDE seanse koji razgovara sa X11R6 \n"
"protokolom za vođenje "

#: main.cpp:35
msgid "Restores the previous session if available"
msgstr "Vraća stanje prethodne seanse (ako je dostupna)"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Pokreće 'wm' kada dan drugi upravljač prozora \n"
"(window manager) nije aktivan. Obično je to 'kwin'."

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Dozvoli i spajanje sa drugih mjesta."

