#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Samir Maric"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "samir_maric@yahoo.se"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pouzdani upravljač KDE seanse koji razgovara sa standardnim X11R6 \n"
"protokolom za upravljanje seansom (XSMP). "

#: main.cpp:35
msgid "Restores the previous session if available"
msgstr "Vraća stanje prethodne seanse, ako je dostupno"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Pokreće 'wm' kada nijedan drugi upravljač prozora \n"
"(window manager) nije aktivan. Default je 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Dozvoli i spajanje sa drugih kompjutera."

#: main.cpp:166
msgid "The KDE Session Manager"
msgstr "KDE menadžer seanse"

#: shutdown.cpp:81
#, c-format
msgid "End session for %1"
msgstr "Zatvori seansu za %1"

#: shutdown.cpp:105
msgid "What do you want to do next?"
msgstr "Šta želite da uradite poslije?"

#: shutdown.cpp:106
msgid "&Login as different user"
msgstr "Prijava &drugog korisnika"

#: shutdown.cpp:107
msgid "&Turn off computer"
msgstr "Isključi kompju&ter"

#: shutdown.cpp:108
msgid "&Restart computer"
msgstr "Ponovo pok&reni kompjuter (restart)"

#: shutdown.cpp:121
msgid "Shutdown mode"
msgstr "Način isključivanja"

#: shutdown.cpp:122
msgid "Sch&edule"
msgstr "Plan&iraj"

#: shutdown.cpp:124
msgid "&Force Now"
msgstr "Primoraj &sada"

#: shutdown.cpp:125
msgid "&Try Now"
msgstr "Pokuš&aj sada"

#: shutdown.cpp:130
msgid "&Save session for future logins"
msgstr "&Sačuvaj seansu za buduće prijave"

#: shutdown.cpp:138
msgid "&Logout"
msgstr "&Odjava"
