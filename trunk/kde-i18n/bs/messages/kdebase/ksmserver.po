#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Samir Marić, Vedran Ljubović"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "samir_maric@yahoo.se, vljubovic@smartnet.ba"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pouzdani upravitelj KDE sesijama koji \"govori\" standardni X11R6 \n"
"protokol za upravljanje sesijama (XSMP). "

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Vraća snimljeno stanje sesije, ako je dostupno"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Pokreće 'wm' kada nijedan drugi upravljač prozora \n"
"(window manager) nije aktivan. Default je 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Dozvoli i spajanje sa drugih kompjutera."

#: main.cpp:166
msgid "The KDE Session Manager"
msgstr "KDE upravitelj sesijama"

#: shutdown.cpp:79
msgid "End Session for \"%1\""
msgstr "Zatvori sesiju za \"%1\""

#: shutdown.cpp:103
msgid "What do you want to do next?"
msgstr "Šta želite da uradite poslije?"

#: shutdown.cpp:104
msgid "&Login as different user"
msgstr "Prijavi se kao &drugi korisnik"

#: shutdown.cpp:105
msgid "&Turn off computer"
msgstr "Isključi raču&nar"

#: shutdown.cpp:106
msgid "&Restart computer"
msgstr "&Restartuj računar"

#: shutdown.cpp:127
msgid "Shutdown Mode"
msgstr "Način isključivanja"

#: shutdown.cpp:128
msgid "Sch&edule"
msgstr "Plan&iraj"

#: shutdown.cpp:130
msgid "&Force now"
msgstr "Prisili &sada"

#: shutdown.cpp:131
msgid "&Try now"
msgstr "Pokuš&aj sada"

#: shutdown.cpp:142
msgid "&Logout"
msgstr "&Odjava"

#~ msgid "&Save session for future logins"
#~ msgstr "&Sačuvaj seansu za buduće prijave"

