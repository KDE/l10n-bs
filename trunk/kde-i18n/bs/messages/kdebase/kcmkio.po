msgstr ""
"Unesite računar ili domenu na koje se pravila odnose, npr. "
"<i>www.kde.org</i> ili <i>.kde.org</i>"

#: policydlg.cpp:78
msgid "Policy:"
msgstr "Pravila:"

#: policydlg.cpp:81
msgid ""
"Select the desired policy:"
"<ul>"
"<li><b>Accept</b> - Allows this site to set cookie</li>"
"<li><b>Reject</b> - Refuse all cookies sent from this "
"site</li>"
"<li><b>Ask</b> - Prompt when cookies are received from this site</li></ul>"
msgstr ""
"Odaberite željena pravila: "
"<ul>"
"<li><b>Prihvati</b> - Dozvoli ovom sajtu da postavlja "
"kolačiće</li>"
"<li><b>Odbaci</b> - Odbaci sve kolačiće s ovog sajta</li> "
"<li><b>Pitaj</b> - Pitaj kada sajt pošalje kolačić</li></ul>"

