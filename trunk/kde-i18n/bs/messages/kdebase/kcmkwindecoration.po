#: kwindecoration.cpp:458
msgid ""
"<h1>Window Manager Decoration</h1>This module allows you to choose the "
"window border decorations, as well as titlebar button positions and custom "
"decoration options."
msgstr ""
"<h1>Dekoracija Window menadžera</h1> Ovaj modul vam omogućava izbor "
"dekoracije prozora, kao i podešavanje pozicije dugmića naslovne trake i "
"druge opcije za dekoraciju."

#: kwindecoration.cpp:467
msgid "kcmkwindecoration"
msgstr "kcmkwindecoration"

