#: kdebase/drkonqi/presets/enduserrc:1
msgid "Name=End user"
msgstr "Name=Krajnji korisnik"

#: kdebase/drkonqi/presets/enduserrc:1
msgid ""
"Name=The application %progname (%appname) crashed and caused the signal "
"%signum (%signame)."
msgstr ""
"Name=Aplikacija %progname (%appname) se srušila sa signalom %signum "
"(%signame)."

#: kdebase/drkonqi/presets/enduserrc:1
msgid ""
"Name=You might want to send a bug report for this application. Check if it's "
"listed on http://bugs.kde.org, otherwise mail the author. Please include as "
"much information as possible, maybe the original documents. If you have a "
"way to reproduce the error, include this also."
msgstr ""
"Name=Možda biste trebali prijaviti bug za ovu aplikaciju. Provjerite da li je "
"aplikacija izlistana na http://bugs.kde.org, pa ako nije pošaljite e-mail autoru. "
"Molim uključite što je više moguće podataka, po mogućnosti originalne "
"datoteke. Ako znate kako pouzdano ponoviti ovu grešku, navedite i to."

#: kdebase/drkonqi/presets/enduserrc:2
msgid "Comment=Settings preferred for end users"
msgstr "Comment=Postavke preporučene krajnjim korisnicima"

#: kdebase/drkonqi/presets/enduserrc:2
msgid ""
"Comment=An application mostly receives the SIGILL signal due to a bug in the "
"application. The application was asked to save its documents."
msgstr ""
"Comment=Aplikacija najčešće dobija SIGILL signal zbog buga u aplikaciji. "
"Od aplikacije je zatraženo da spasi svoje dokumente."

#: kdebase/drkonqi/presets/enduserrc:2
msgid ""
"Comment=An application terminates with a SIGABRT signal when it detects an "
"internal inconsistency caused by a bug in the program."
msgstr ""
"Comment=Aplikacija se prekida signalom SIGABRT kada se ustanovi interna "
"nekonzistentnost koju izaziva bug u programu."

#: kdebase/drkonqi/presets/enduserrc:2
msgid ""
"Comment=An application mostly receives the SIGFPE signal due to a bug in the "
"application. The application was asked to save its documents."
msgstr ""
"Comment=Aplikacija najčešće dobija SIGFPE signal zbog buga u aplikaciji. "
"Od aplikacije je zatraženo da spasi svoje dokumente."

#: kdebase/drkonqi/presets/enduserrc:2
msgid ""
"Comment=An application mostly receives the SIGSEGV signal due to a bug in "
"the application. The application was asked to save its documents."
msgstr ""
"Comment=Aplikacija najčešće dobija SIGSEGV signal zbog buga u aplikaciji. "
"Od aplikacije je zatraženo da spasi svoje dokumente."

#: kdebase/drkonqi/presets/enduserrc:2
msgid "Comment=Sorry, I don't know this signal."
msgstr "Comment=Žalim, ovaj signal mi nije poznat."

