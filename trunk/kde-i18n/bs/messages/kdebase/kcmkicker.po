#, no-c-format
msgid "Top Left Corner"
msgstr "Gornji lijevi ugao"

#: rc.cpp:116
#, no-c-format
msgid "Top Edge"
msgstr "Gornji rub"

#: rc.cpp:118
#, no-c-format
msgid "Top Right Corner"
msgstr "Gornji desni ugao"

#: rc.cpp:120
#, no-c-format
msgid "Right Edge"
