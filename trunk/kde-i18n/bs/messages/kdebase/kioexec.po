#: main.cpp:46
msgid "KFM Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KFM Exec - Otvara datoteke na udaljenim računarima, nadgleda promjene, pita "
"za upload."

#: main.cpp:52
msgid "Command to execute."
msgstr "Naredba koju treba izvršiti."

#: main.cpp:53
msgid "URL(s) or local file used for 'command'."
msgstr "URL(-ovi) ili lokalne datoteke korištene za 'naredbu'."

#: main.cpp:69
msgid ""
"'command' expected.\n"
msgstr ""
"'naredba' očekivana.\n"

#: main.cpp:92
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"nije ispravan"

#: main.cpp:201
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Datoteka\n"
"%1\n"
"je promijenjena.\n"
"Da li želite poslati promjene?"

#: main.cpp:202
msgid "File Changed"
msgstr "Datoteka promijenjena"

#: main.cpp:224
msgid "KFMExec"
msgstr "KFMExec"

#: main.cpp:239
msgid ""
"Syntax Error:\n"
"kfmexec command [URLs ...]"
msgstr ""
"Greška u sintaksi:\n"
"kfmexec naredba [URL-ovi ....]"

