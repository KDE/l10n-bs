#: main.cpp:45
msgid "KFM Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KFM Exec - Otvara remote datoteke, nadgleda promjene, pita za upload."

#: main.cpp:51
msgid "Command to execute."
msgstr "Komanda koju treba izvršiti."

#: main.cpp:52
msgid "URL(s) or local file used for 'command'."
msgstr "URL(-ovi) ili lokalne datoteke korištene za 'komandu'."

#: main.cpp:68
msgid "'command' expected.\n"
msgstr "'komanda' očekivana.\n"

#: main.cpp:89
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"nije ispravan"

#: main.cpp:196
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Datoteka\n"
"%1\n"
"je promijenjena.\n"
"Da li želite poslati promjene?"

#: main.cpp:197
msgid "File changed"
msgstr "Datoteka promijenjena"

#: main.cpp:256
msgid "KFMExec"
msgstr "KFMExec"

#: main.cpp:271
msgid ""
"Syntax Error:\n"
"kfmexec command [URLs ....]"
msgstr ""
"Greška u sintaksi:\n"
"kfmexec komanda [URL-ovi ....]"

