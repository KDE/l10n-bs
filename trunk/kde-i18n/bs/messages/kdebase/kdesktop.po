#: lock/lockprocess.cc:856
msgid ""
"<h1>Screen Locking Failed!</h1>Your screen was not locked because the "
"<i>kcheckpass</i> program was not able to check your password. This is "
"usually the result of kcheckpass not being installed correctly. If you "
"installed KDE yourself, reinstall kcheckpass as root. If you are using a "
"pre-compiled package, contact the packager."
msgstr ""
"<h1>Zaključavanje ekrana nije uspjelo!</h1>Vaš ekran nije zaključan zato "
"što program <i>kcheckpass</i> nije mogao provjeriti vašu šifru. Ovo se "
"obično dešava kada kcheckpass nije ispravno instaliran. Ako ste sami "
"instalirali KDE, ponovo instalirajte kcheckpass kao root. Ako koristite "
"ranije kompajliran paket, kontaktirajte onoga ko ga je pakirao."

#: lock/lockprocess.cc:863
msgid "Screen Locking Failed"
msgstr "Zaključavanje ekrana nije uspjelo"

