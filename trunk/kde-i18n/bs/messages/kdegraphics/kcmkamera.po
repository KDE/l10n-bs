msgid "Serial"
msgstr "Serijski"

#: kameradevice.cpp:204 kameradevice.cpp:313 kameradevice.cpp:441
msgid "Parallel"
msgstr "Paralelni"

#: kameradevice.cpp:205 kameradevice.cpp:316 kameradevice.cpp:443
