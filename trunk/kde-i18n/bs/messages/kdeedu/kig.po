#: rc.cpp:39
msgid "Define New Macro"
msgstr "Definiši novi makro"

#: rc.cpp:40
msgid "Given Objects"
msgstr "Zadati objekti"

#: rc.cpp:41
msgid "Select the \"given\" objects for your new macro and press \"Next\"."
msgstr "Izaberite \"zadate\" objekte za vaš novi makro i kliknite na \"Dalje\"."

#: rc.cpp:42
msgid "Final Object"
msgstr "Konačni objekat"

#: rc.cpp:43
msgid "Select the final object for your new macro."
msgstr "Izaberite konačni objekat za vaš novi makro."

#: rc.cpp:44
msgid "Name"
msgstr "Ime"

