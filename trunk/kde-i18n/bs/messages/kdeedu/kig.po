msgid "_: NAME OF TRANSLATORS\\nYour names"
msgstr "Vedran Ljubović"

#: kig/aboutdata.h:95
msgid "_: EMAIL OF TRANSLATORS\\nYour emails"
msgstr "vljubovic@smartnet.ba"

