#: rc.cpp:5 rc.cpp:11 rc.cpp:20
msgid "Paint keybord with colors"
msgstr "Oboji tastaturu bojama"

#: rc.cpp:6 rc.cpp:12 rc.cpp:21
msgid ""
"Check this if you want your keyboard to show colors which indicate finger "
"regions"
msgstr ""
"Izaberite ovo ako želite da vaša tastatura prikazuje boje koje označavaju "
"oblasti prstiju"

#: rc.cpp:7
msgid "Sound on automatic level change"
msgstr "Zvuk na automatskoj promjeni nivoa"

#: rc.cpp:8
msgid "Visual"
msgstr "Vizualno"

#: rc.cpp:9
msgid "Set color"
msgstr "Podesite boju"

#: rc.cpp:10
msgid "Color on error"
msgstr "Boja pri grešci"

#: rc.cpp:14 rc.cpp:28 rc.cpp:47
msgid "Close dialog and discarge all changes."
