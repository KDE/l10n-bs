#: rc.cpp:15 rc.cpp:25 rc.cpp:44
msgid "Done"
msgstr "Završeno"

#: rc.cpp:16 rc.cpp:26 rc.cpp:45
msgid "Close dialog and apply all changes."
msgstr "Zatvori dijalog i primijeni sve izmjene."

#: ktouch.cpp:127 rc.cpp:17
msgid "Keyboard"
msgstr "Tastatura"

#: rc.cpp:18
msgid "Color && animation"
msgstr "Boja i animacija"

#: rc.cpp:19
msgid "Use color on keyboard"
msgstr "Koristi boje na tastaturi"

#: rc.cpp:22
msgid "Show next key to press on keyboard"
msgstr "Prikaži na tastaturi sljedeću tipku za pritisnuti"

#: rc.cpp:23
msgid "Animated keyboard"
msgstr "Animirana tastatura"

#: rc.cpp:24
msgid ""
"If you want KTouch to indicate which finger to move and where to press, you "
"should check this option"
msgstr ""
"Ako želite da KTouch prikaže koji prst trebate pomjeriti i gdje pritisnuti, "
"uključite ovu opciju"

