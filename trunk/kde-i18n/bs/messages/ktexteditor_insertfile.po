#: insertfileplugin.cpp:79
msgid "Insert File"
msgstr "Umetni datoteku"

#: insertfileplugin.cpp:87
msgid "Choose a File to Insert"
msgstr "Izaberite datoteku"

#: insertfileplugin.cpp:111
msgid ""
"Failed to load file:\n"
"\n"
msgstr ""
"Neuspjelo učitavanje datoteke:\n"
"\n"

#: insertfileplugin.cpp:111
msgid "Insert File error"
msgstr "Greška prilikom umetanja datoteke"

#: insertfileplugin.cpp:120
msgid "<p>The file <strong>%1</strong> is empty, aborting."
msgstr "<p>Datoteka <strong>%1</strong> je prazna, prekidam."

#: insertfileplugin.cpp:125
msgid "<p>The file <strong>%1</strong> does not exist or is not readable, aborting."
msgstr "<p>Datoteka <strong>%1</strong> ne postoji ili nije čitljiva, prekidam."

#: insertfileplugin.cpp:129
msgid "<p>Unable to open file <strong>%1</strong>, aborting."
msgstr "<p>Nisam u mogućnosti otvoriti datoteku <strong>%1</strong>, prekidam."

#: insertfileplugin.cpp:132 insertfileplugin.cpp:154
msgid "Insert file error"
msgstr "Greška prilikom umetanja datoteke"

#: insertfileplugin.cpp:152
msgid "<p>File <strong>%1</strong> had no contents."
msgstr "<p>Datoteka <strong>%1</strong> je prazna."

