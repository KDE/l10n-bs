msgstr "Boja teksta..."

#: kwview.cc:774
msgid "Number"
msgstr "Broj"

#: kwview.cc:777
msgid "Bullet"
msgstr "Tačka"

#: kwview.cc:802
msgid "Fra&mestyle"
msgstr "&Stil okvira"

#: kwview.cc:804
msgid "Framest&yle"
msgstr "Stil &okvira"

#: kwview.cc:809
msgid "Border Outline"
msgstr "Linija ruba"

#: kwview.cc:811
msgid "Border Left"
msgstr "Lijevi rub"

#: kwview.cc:813
msgid "Border Right"
msgstr "Desni rub"

#: kwview.cc:815
msgid "Border Top"
msgstr "Gornji rub"

#: kwview.cc:817
msgid "Border Bottom"
msgstr "Donji rub"

#: kwview.cc:819
msgid "Border Style"
msgstr "Stil ruba"

#: kwview.cc:832
msgid "Border Width"
msgstr "Širina ruba"

#: kwview.cc:841
msgid "Border Color"
msgstr "Boja ruba"

#: kwview.cc:846 kwview.cc:1688
msgid "Text Background Color..."
msgstr "Boja pozadine teksta..."

#: kwview.cc:847 kwview.cc:848
msgid "Change background color for currently selected text."
msgstr "Promjeni boju u pozadini trenutno izabranog teksta."

#: kwview.cc:857 kwview.cc:858
msgid "Adjust properties of the current table."
msgstr "Izmjeni postavke trenutne tabele."

#: kwview.cc:869
msgid "&Insert Row..."
msgstr "&Umetni red..."

#: kwview.cc:872
msgid "Insert one or more rows at cursor location."
msgstr "Umetni jedan ili više redova na lokaciji kursora."

#: kwview.cc:873
msgid "Insert one or more rows at current cursor location."
msgstr "Umetni jedan ili više redova na trenutnoj lokaciji kursora."

#: kwview.cc:875
msgid "I&nsert Column..."
msgstr "U&metni kolonu..."

#: kwview.cc:878 kwview.cc:879
msgid "Insert one or more columns into the current table."
msgstr "Umetni jednu ili više kolona u trenutnu tabelu."

#: kwview.cc:881
msgid "&Delete Selected Rows..."
msgstr "O&briši izabrane redove..."

#: kwview.cc:884 kwview.cc:885
msgid "Delete selected rows from the current table."
msgstr "Obriši izabrane redove iz tabele."

#: kwview.cc:887
msgid "D&elete Selected Columns..."
msgstr "&Obriši izabrane kolone..."

#: kwview.cc:890
msgid "Delete selected columns from the current table."
msgstr "Obriši izabrane kolone iz tabele."

#: kwview.cc:891
msgid "Delete selected column from the current table."
msgstr "Obriši izabranu kolonu iz tabele."

#: kwview.cc:893
msgid "Resize Column..."
msgstr "Širina kolone..."

#: kwview.cc:896 kwview.cc:897
msgid "Change the width of the currently selected column."
msgstr "Promjeni širinu trenutno izabrane kolone."

#: kwview.cc:900
msgid "&Join Cells"
msgstr "S&poji polja"

#: kwview.cc:903
msgid "Join two or more cells into one large cell."
msgstr "Spoji dva ili više polja tabele u jedno veće polje."

#: kwview.cc:904
msgid ""
"Join two or more cells into one large cell."
"<p>This is a good way to create titles and labels within a table."
msgstr ""
"Spoji dva ili više polja tabele u jedno veće polje."
"<p>Ovo je dobar način za pravljenje naslova ili oznaka u tabeli."

#: kwview.cc:906
msgid "&Split Cells..."
msgstr "&Razdvoji polja..."

#: kwview.cc:909
msgid "Split one cell into two or more cells."
msgstr "Razdvoji jedno polje na dva ili više polja."

#: kwview.cc:910
msgid ""
"Split one cell into two or more cells."
"<p>Cells can be split horizontally, vertically or both directions at once."
msgstr ""
"Razdvoji jedno polje na dva ili više polja."
"<p>Polja mogu biti razdvojena vodoravno, uspravno ili u oba pravca "
"istovremeno."

#: kwview.cc:912
msgid "Protect Cells"
msgstr "Zaštiti polja"

#: kwview.cc:915
msgid "Prevent changes to content of selected cells."
msgstr "Onemogući izmjene u sadržaju izabranih polja."

#: kwview.cc:916
msgid ""
"Toggles cell protection on and off."
"<br>"
"<br>When cell protection is on, the user can not alter the content or "
"formatting of the text within the cell."
msgstr ""
"Prekidač za zaštitu polja."
"<br>"
"<br>Kada je zaštita polja uključena, korisnik ne može mijenjati sadržaj "
"ili formatiranje teksta unutar polja."

#: kwview.cc:918
msgid "&Ungroup Table"
msgstr "R&azgrupiraj tabelu"

#: kwview.cc:921
msgid "Break a table into individual frames."
msgstr "Razbij tabelu u više zasebnih okvira."

#: kwview.cc:922
msgid ""
"Break a table into individual frames"
"<p>Each frame can be moved independently around the page."
msgstr ""
"Razbij tabelu u više zasebnih okvira."
"<p>Svaki okvir možete zasebno pomjerati po stranici."

#: kwview.cc:924
msgid "Delete &Table"
msgstr "Obriši &tabelu"

#: kwview.cc:927
msgid "Delete the entire table."
msgstr "Obriši cijelu tabelu."

#: kwview.cc:928
msgid ""
"Deletes all cells and the content within the cells of the currently selected "
"table."
msgstr "Briše sva polja kao i njihov sadržaj u trenutno izabranoj tabeli."

#: kwview.cc:931
msgid "T&able Style Manager..."
msgstr "Upravitelj stilova t&abela..."

#: kwview.cc:934
msgid "Change attributes of tablestyles."
msgstr "Izmjeni atribute stilova tabela."

#: kwview.cc:935
msgid ""
"Change textstyle and framestyle of the tablestyles."
"<p>Multiple tablestyles can be changed using the dialog box."
msgstr ""
"Izmjeni stil teksta i stil okvira unutar stila tabele."
"<p>Ovim dijalogom možete izmjeniti više stilova tabele."

#: kwview.cc:937 kwview.cc:939
msgid "Table&style"
msgstr "&Stil tabele"

#: kwview.cc:948
msgid "Enable Autocorrection"
msgstr "Uključi ispravljanje"

#: kwview.cc:951 kwview.cc:952
msgid "Toggle autocorrection on and off."
msgstr "Prekidač za automatsko ispravljanje."

#: kwview.cc:954
msgid "Configure &Autocorrection..."
msgstr "Podesi &ispravljanje..."

#: kwview.cc:957
msgid "Change autocorrection options."
msgstr "Izmjeni opcije automatskog ispravljanja."

#: kwview.cc:958
msgid ""
"Change autocorrection options including:"
"<p> "
"<UL>"
"<LI>"
"<P>exceptions to autocorrection</P> "
"<LI>"
"<P>add/remove autocorrection replacement text</P> "
"<LI><P>and basic autocorrection options</P>."
msgstr ""
"Izmjeni opcije automatskog ispravljanja, uključujući:"
"<p> "
"<UL>"
"<LI>"
"<p>izuzeci od automatskog ispravljanja</P> "
"<LI>"
"<P>dodavanje/brisanje pravila za zamjenu kod ispravljanja</p> "
"<LI><P>osnovne opcije ispravljanja</P>."

#: kwview.cc:960
msgid "Custom &Variables..."
msgstr "&Vlastite varijable..."

#: kwview.cc:964
msgid "&Personal Expressions..."
msgstr "&Lični izrazi..."

#: kwview.cc:967
msgid "Add or change one or more personal expressions."
msgstr "Dodaj ili izmjeni jedan ili više ličnih izraza."

#: kwview.cc:968
msgid ""
"Add or change one or more personal expressions."
"<p>"
"Personal expressions are a way to quickly insert commonly used phrases or "
"text into your document."
msgstr ""
"Dodaj ili izmjeni jedan ili više ličnih izraza."
"<p>Lični izrazi su brz način za umetanje često korištenih fraza ili "
"teksta u vaš dokument."

#: kwview.cc:970
msgid "Change Case..."
msgstr "Izmjeni velika/mala slova..."

#: kwview.cc:973
msgid "Alter the capitalization of selected text."
msgstr "Promjeni kapitalizaciju izabranog teksta."

#: kwview.cc:974
msgid ""
"Alter the capitalization of selected text to one of five pre-defined "
"patterns."
"<p>You can also switch all letters from uppercase to lower case and from "
"lower case to upper case in one move."
msgstr ""
"Promjeni kapitalizaciju izabranog teksta u jedan od pet predefinisanih "
"uzoraka."
"<p>"
"Također možete prebaciti sva slova iz velikih u mala i obratno u jednom "
"potezu."

#: kwview.cc:980
msgid "Change Picture..."
msgstr "Promjeni sliku..."

#: kwview.cc:983
msgid "Change the picture in the currently selected frame."
msgstr "Promjeni sliku u trenutno izabranom okviru."

#: kwview.cc:984
msgid ""
"You can specify a different picture in the current frame."
"<br>"
"<br>KWord automatically resizes the new picture to fit within the old frame."
msgstr ""
"Možete navesti neku drugu sliku u trenutnom okviru."
"<br>"
"<br>KWord će automatski promjeniti veličinu slike kako bi ona stala u "
"stari okvir."

#: kwview.cc:986
msgid "Configure Header/Footer..."
msgstr "Podesi zaglavlje/podnožje..."

#: kwview.cc:989 kwview.cc:990
msgid "Configure the currently selected header or footer."
msgstr "Podesi trenutno izabrano zaglavlje ili podnožje."

#: kwview.cc:992
msgid "Inline Frame"
msgstr "Okvir u liniji"

#: kwview.cc:995
msgid "Convert current frame to an inline frame."
msgstr "Prebaci trenutni okvir u okvir u liniji."

#: kwview.cc:996
msgid ""
"Convert the current frame to an inline frame."
"<br>"
"<br>Place the inline frame within the text at the point nearest to the "
"frames current position."
msgstr ""
"Prebaci trenutni okvir u okvir u liniji."
"<br>"
"<br>Umeće okvir u liniji u tekst na tačku koja je najbliža trenutnom "
"položaju okvira."

#: kwview.cc:998
msgid "Open Link"
msgstr "Otvori link"

#: kwview.cc:1001
msgid "Open the link with the appropriate application."
msgstr "Otvori link odgovarajućom aplikacijom."

#: kwview.cc:1002
msgid ""
"Open the link with the appropriate application."
"<br>"
"<br>Web addresses are opened in a browser."
"<br>Email addresses begin a new message addressed to the link."
"<br>File links are opened by the appropriate viewer or editor."
msgstr ""
"Otvori link odgovarajućom aplikacijom."
"<br>"
"<br>Web adrese će biti otvorene u web pregledniku."
"<br>Email adrese će započeti novu poruku na tu adresu."
"<br>Linkovi na datoteke će biti otvoreni u odgovarajućem pregledniku ili "
"editoru."

#: kwview.cc:1004
msgid "Change Link..."
msgstr "Izmjeni link..."

#: kwview.cc:1007
msgid "Change the content of the currently selected link."
msgstr "Izmjeni sadržaj trenutno izabranog linka."

#: kwview.cc:1008
msgid "Change the details of the currently selected link."
msgstr "Izmjeni detalje trenutno izabranog linka."

#: kwview.cc:1011
msgid "Show Doc Structure"
msgstr "Pokaži strukturu dokumenta"

#: kwview.cc:1014
msgid "Open document structure sidebar."
msgstr "Otvori traku sa strane sa strukturom dokumenta."

#: kwview.cc:1015
msgid ""
"Open document structure sidebar."
"<p>This sidebar helps you organize your document and quickly find pictures, "
"tables, etc."
msgstr ""
"Otvori traku sa strane sa strukturom dokumenta."
"<p>Ova traka vam pomaže da organizujete vaš dokument i brzo pronađete "
"slike, tabele itd."

#: kwview.cc:1017
msgid "Show Rulers"
msgstr "Pokaži linijare"

#: kwview.cc:1020
msgid "Shows or hides rulers."
msgstr "Pokaži ili skloni linijare."

#: kwview.cc:1021
msgid ""
"The rulers are the white measuring spaces top and left of the document. The "
"rulers show the position and width of pages and of frames and can be used to "
"position tabulators among others."
"<p>Uncheck this to disable the rulers from being displayed."
msgstr ""
"Linijari su bijeli pristori za mjerenje pri vrhu i lijevo od dokumenta. Oni "
"pokazuju položaj i širinu stranica i okvirova, a mogu se između ostalog "
"koristiti i za razmještanje tabulatora."
"<p>Isključite ovu opciju da biste uklonili linijare sa ekrana."

#: kwview.cc:1026
msgid "&Configure Completion..."
msgstr "&Podesi dovršavanje..."

#: kwview.cc:1029
msgid "Change the words and options for autocompletion."
msgstr "Podesi riječi i opcije za automatsko dovršavanje."

#: kwview.cc:1030
msgid "Add words or change the options for autocompletion."
msgstr "Dodajte riječi ili promjenite opcije za automatsko dovršavanje."

#: kwview.cc:1034
msgid "Insert non-breaking Space"
msgstr "Ubaci \"tvrdi\" razmak"

#: kwview.cc:1036
msgid "Insert Soft Hyphen"
msgstr "Umetni \"mekani\" apostrof"

#: kwview.cc:1038
msgid "Line Break"
msgstr "Prelom linije"

#: kwview.cc:1041
msgid "Completion"
msgstr "Dovršavanje"

#: kwview.cc:1060
msgid "Edit Variable..."
msgstr "Izmjeni varijablu..."

#: kwview.cc:1063
msgid "Apply Autocorrection"
msgstr "Primjeni ispravljanje"

#: kwview.cc:1066 kwview.cc:1067
msgid "Manually force KWord to scan the entire document and apply autocorrection."
msgstr "Ručno pokrenite pregled čitavog dokumenta i primjenu automatskih ispravki."

#: kwview.cc:1069
msgid "Create Style From Selection"
msgstr "Napravi stil od izabranog"

