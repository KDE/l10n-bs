#: kwview.cc:500
msgid ""
"This inserts a non-printing character at the current cursor position. All "
"text after this point will be moved into the next frame in the frameset."
msgstr ""
"Ovo ubacuje poseban znak koji se ne štampa na lokaciju kursora. On "
"označava da se sav tekst nakon njega prebacuje u idući okvir u frameset-u."

#: kwview.cc:502
msgid "Link..."
msgstr "Link..."

#: kwview.cc:505 kwview.cc:506
msgid "Insert a web address, email address or hyperlink to a file."
msgstr "Ubacuje web adresu, email adresu ili hiperlink u datoteku."

#: kwview.cc:508
msgid "Comment..."
msgstr "Komentar..."

#: kwview.cc:511
msgid "Insert a comment about the selected text."
msgstr "Ubacuje komentar o izabranom tekstu."

#: kwview.cc:512
msgid ""
"Insert a comment about the selected text. These comments are not designed to "
"appear on the final page."
msgstr ""
"Ubacuje komentar o izabranom tekstu. Ovi komentari se neće vidjeti na "
"stranici kada ona bude odštampana."

#: kwview.cc:514
msgid "Edit Comment..."
msgstr "Izmjeni komentar..."

#: kwview.cc:517 kwview.cc:518
msgid "Change the content of a comment."
msgstr "Mijenja sadržaj komentara."

#: kwview.cc:520
msgid "Remove Comment"
msgstr "Ukloni komentar"

#: kwview.cc:523 kwview.cc:524
msgid "Remove the selected document comment."
msgstr "Briše izabrani komentar iz dokumenta."

#: kwview.cc:526 kwview.cc:1039
msgid "&Footnote..."
msgstr "&Fusnota..."

#: kwview.cc:529 kwview.cc:530
msgid "Insert a footnote referencing the selected text."
msgstr "Dodaje fusnotu vezanu za izabrani tekst."

#: kwview.cc:532 kwview.cc:2970
msgid "Table of &Contents"
msgstr "Tablica &sadržaja"

#: kwview.cc:535 kwview.cc:536
msgid "Insert table of contents at the current cursor position."
msgstr "Ubacuje sadržaj na trenutni položaj kursora."

#: kwview.cc:539
msgid "&Variable"
msgstr "&Varijabla"

#: kwview.cc:543
msgid "Document &Information"
msgstr "&Informacije o dokumentu"

#: kwview.cc:544
