msgid "Text Background Color..."
msgstr "Boja pozadine teksta..."

#: kwview.cc:811 kwview.cc:812
msgid "Change background color for currently selected text."
msgstr "Promjeni boju u pozadini trenutno izabranog teksta."

#: kwview.cc:821 kwview.cc:822
msgid "Adjust properties of the current table."
msgstr "Izmjeni postavke trenutne tabele."

#: kwview.cc:833
msgid "&Insert Row..."
msgstr "&Umetni red..."

#: kwview.cc:836
msgid "Insert one or more rows at cursor location."
msgstr "Umetni jedan ili više redova na lokaciji kursora."

#: kwview.cc:837
msgid "Insert one or more rows at current cursor location."
msgstr "Umetni jedan ili više redova na trenutnoj lokaciji kursora."

#: kwview.cc:839
msgid "I&nsert Column..."
msgstr "U&metni kolonu..."

#: kwview.cc:842 kwview.cc:843
msgid "Insert one or more columns into the current table."
msgstr "Umetni jednu ili više kolona u trenutnu tabelu."

#: kwview.cc:845
msgid "&Delete Selected Rows..."
msgstr "O&briši izabrane redove..."

#: kwview.cc:848 kwview.cc:849
msgid "Delete selected rows from the current table."
msgstr "Obriši izabrane redove iz tabele."

#: kwview.cc:851
msgid "D&elete Selected Columns..."
msgstr "&Obriši izabrane kolone..."

#: kwview.cc:854
msgid "Delete selected columns from the current table."
msgstr "Obriši izabrane kolone iz tabele."

#: kwview.cc:855
msgid "Delete selected column from the current table."
msgstr "Obriši izabranu kolonu iz tabele."

#: kwview.cc:857
msgid "Resize Column..."
msgstr "Širina kolone..."

#: kwview.cc:860 kwview.cc:861
msgid "Change the width of the currently selected column."
msgstr "Promjeni širinu trenutno izabrane kolone."

#: kwview.cc:864
msgid "&Join Cells"
msgstr "S&poji polja"

#: kwview.cc:867
msgid "Join two or more cells into one large cell."
msgstr "Spoji dva ili više polja tabele u jedno veće polje."

#: kwview.cc:868
msgid ""
"Join two or more cells into one large cell.<p>This is a good way to create "
"titles and labels within a table."
msgstr ""
"Spoji dva ili više polja tabele u jedno veće polje.<p>Ovo je dobar način "
"za pravljenje naslova ili oznaka u tabeli."

#: kwview.cc:870
msgid "&Split Cells..."
msgstr "&Razdvoji polja..."

#: kwview.cc:873
msgid "Split one cell into two or more cells."
msgstr "Razdvoji jedno polje na dva ili više polja."

#: kwview.cc:874
msgid ""
"Split one cell into two or more cells.<p>Cells can be split horizontally, "
"vertically or both directions at once."
msgstr ""
"Razdvoji jedno polje na dva ili više polja.<p>Polja mogu biti razdvojena "
"vodoravno, uspravno ili u oba pravca istovremeno."

#: kwview.cc:876
msgid "Protect Cells"
msgstr "Zaštiti polja"

#: kwview.cc:879
msgid "Prevent changes to content of selected cells."
msgstr "Onemogući izmjene u sadržaju izabranih polja."

#: kwview.cc:880
msgid ""
"Toggles cell protection on and off.<br><br>When cell protection is on, the "
"user can not alter the content or formatting of the text within the cell."
msgstr ""
"Prekidač za zaštitu polja.<br><br>Kada je zaštita polja uključena, korisnik "
"ne može mijenjati sadržaj ili formatiranje teksta unutar polja."

#: kwview.cc:882
msgid "&Ungroup Table"
msgstr "R&azgrupiraj tabelu"

#: kwview.cc:885
msgid "Break a table into individual frames."
msgstr "Razbij tabelu u više zasebnih okvira."

#: kwview.cc:886
msgid ""
"Break a table into individual frames<p>Each frame can be moved independently "
"around the page."
msgstr ""
"Razbij tabelu u više zasebnih okvira.<p>Svaki okvir možete zasebno pomjerati "
"po stranici."

#: kwview.cc:888
msgid "Delete &Table"
msgstr "Obriši &tabelu"

#: kwview.cc:891
msgid "Delete the entire table."
msgstr "Obriši cijelu tabelu."

#: kwview.cc:892
msgid ""
"Deletes all cells and the content within the cells of the currently selected "
"table."
msgstr "Briše sva polja kao i njihov sadržaj u trenutno izabranoj tabeli."

#: kwview.cc:895
msgid "T&able Style Manager..."
msgstr "Upravitelj stilova t&abela..."

#: kwview.cc:898
msgid "Change attributes of tablestyles."
msgstr "Izmjeni atribute stilova tabela."

#: kwview.cc:899
msgid ""
"Change textstyle and framestyle of the tablestyles.<p>Multiple tablestyles "
"can be changed using the dialog box."
msgstr ""
"Izmjeni stil teksta i stil okvira unutar stila tabele.<p>Ovim dijalogom "
"možete izmjeniti više stilova tabele."

#: kwview.cc:901 kwview.cc:903
msgid "Table&style"
msgstr "&Stil tabele"

#: kwview.cc:912
msgid "Enable Autocorrection"
msgstr "Uključi ispravljanje"

#: kwview.cc:915 kwview.cc:916
msgid "Toggle autocorrection on and off."
msgstr "Prekidač za automatsko ispravljanje."

#: kwview.cc:918
msgid "Configure &Autocorrection..."
msgstr "Podesi &ispravljanje..."

#: kwview.cc:921
msgid "Change autocorrection options."
msgstr "Izmjeni opcije automatskog ispravljanja."

#: kwview.cc:922
msgid ""
"Change autocorrection options including:<p> <UL><LI><P>exceptions to "
"autocorrection</P> <LI><P>add/remove autocorrection replacement text</P> "
"<LI><P>and basic autocorrection options</P>."
msgstr ""
"Izmjeni opcije automatskog ispravljanja, uključujući:<p> <UL><LI><p>izuzeci od "
"automatskog ispravljanja</P> <LI><P>dodavanje/brisanje pravila za zamjenu kod "
"ispravljanja</p> <LI><P>osnovne opcije ispravljanja</P>."

#: kwview.cc:924
msgid "Custom &Variables..."
msgstr "&Vlastite varijable..."

#: kwview.cc:928
msgid "&Personal Expressions..."
msgstr "&Lični izrazi..."

#: kwview.cc:931
msgid "Add or change one or more personal expressions."
msgstr "Dodaj ili izmjeni jedan ili više ličnih izraza."

#: kwview.cc:932
msgid ""
"Add or change one or more personal expressions.<p>Personal expressions are a "
"way to quickly insert commonly used phrases or text into your document."
msgstr ""
"Dodaj ili izmjeni jedan ili više ličnih izraza.<p>Lični izrazi su brz "
"način za umetanje često korištenih fraza ili teksta u vaš dokument."

#: kwview.cc:934
msgid "Change Case..."
msgstr "Izmjeni velika/mala slova..."

#: kwview.cc:937
msgid "Alter the capitalization of selected text."
msgstr "Promjeni kapitalizaciju izabranog teksta."

#: kwview.cc:938
msgid ""
"Alter the capitalization of selected text to one of five pre-defined "
"patterns.<p>You can also switch all letters from uppercase to lower case and "
"from lower case to upper case in one move."
msgstr ""
"Promjeni kapitalizaciju izabranog teksta u jedan od pet predefinisanih "
"uzoraka.<p>Također možete prebaciti sva slova iz velikih u mala i obratno "
"u jednom potezu."

#: kwview.cc:944
msgid "Change Picture..."
msgstr "Promjeni sliku..."

#: kwview.cc:947
msgid "Change the picture in the currently selected frame."
msgstr "Promjeni sliku u trenutno izabranom okviru."

#: kwview.cc:948
msgid ""
"You can specify a different picture in the current frame.<br><br>KWord "
"automatically resizes the new picture to fit within the old frame."
msgstr ""
"Možete navesti neku drugu sliku u trenutnom okviru.<br><br>KWord će "
"automatski promjeniti veličinu slike kako bi ona stala u stari okvir."

#: kwview.cc:950
msgid "Configure Header/Footer..."
msgstr "Podesi zaglavlje/podnožje..."

#: kwview.cc:953 kwview.cc:954
msgid "Configure the currently selected header or footer."
msgstr "Podesi trenutno izabrano zaglavlje ili podnožje."

#: kwview.cc:956
msgid "Inline Frame"
msgstr "Okvir u liniji"

#: kwview.cc:959
msgid "Convert current frame to an inline frame."
msgstr "Prebaci trenutni okvir u okvir u liniji."

#: kwview.cc:960
msgid ""
"Convert the current frame to an inline frame.<br><br>Place the inline frame "
"within the text at the point nearest to the frames current position."
msgstr ""
"Prebaci trenutni okvir u okvir u liniji.<br><br>Umeće okvir u liniji "
"u tekst na tačku koja je najbliža trenutnom položaju okvira."

#: kwview.cc:962
msgid "Open Link"
msgstr "Otvori link"

#: kwview.cc:965
msgid "Open the link with the appropriate application."
msgstr "Otvori link odgovarajućom aplikacijom."

#: kwview.cc:966
msgid ""
"Open the link with the appropriate application.<br><br>Web addresses are "
"opened in a browser.<br>Email addresses begin a new message addressed to the "
"link.<br>File links are opened by the appropriate viewer or editor."
msgstr ""
"Otvori link odgovarajućom aplikacijom.<br><br>Web adrese će biti otvorene "
"u web pregledniku.<br>Email adrese će započeti novu poruku na tu "
"adresu.<br>Linkovi na datoteke će biti otvoreni u odgovarajućem pregledniku ili "
"editoru."

#: kwview.cc:968
msgid "Change Link..."
msgstr "Izmjeni link..."

#: kwview.cc:971
msgid "Change the content of the currently selected link."
msgstr "Izmjeni sadržaj trenutno izabranog linka."

#: kwview.cc:972
msgid "Change the details of the currently selected link."
msgstr "Izmjeni detalje trenutno izabranog linka."

#: kwview.cc:975
msgid "Show Doc Structure"
msgstr "Pokaži strukturu dokumenta"

#: kwview.cc:978
msgid "Open document structure sidebar."
msgstr "Otvori traku sa strane sa strukturom dokumenta."

#: kwview.cc:979
msgid ""
"Open document structure sidebar.<p>This sidebar helps you organize your "
"document and quickly find pictures, tables, etc."
msgstr ""
"Otvori traku sa strane sa strukturom dokumenta.<p>Ova traka vam pomaže "
"da organizujete vaš dokument i brzo pronađete slike, tabele itd."

#: kwview.cc:981
msgid "Show Rulers"
msgstr "Pokaži linijare"

#: kwview.cc:984
msgid "Shows or hides rulers."
msgstr "Pokaži ili skloni linijare."

#: kwview.cc:985
msgid ""
"The rulers are the white measuring spaces top and left of the document. The "
"rulers show the position and width of pages and of frames and can be used to "
"position tabulators among others.<p>Uncheck this to disable the rulers from "
"being displayed."
msgstr ""
"Linijari su bijeli pristori za mjerenje pri vrhu i lijevo od dokumenta. "
"Oni pokazuju položaj i širinu stranica i okvirova, a mogu se između ostalog "
"koristiti i za razmještanje tabulatora.<p>Isključite ovu opciju "
"da biste uklonili linijare sa ekrana."

#: kwview.cc:990
msgid "&Configure Completion..."
msgstr "&Podesi dovršavanje..."

#: kwview.cc:993
msgid "Change the words and options for autocompletion."
msgstr "Podesi riječi i opcije za automatsko dovršavanje."

#: kwview.cc:994
msgid "Add words or change the options for autocompletion."
msgstr "Dodajte riječi ili promjenite opcije za automatsko dovršavanje."

#: kwview.cc:998
msgid "Insert non-breaking Space"
msgstr "Ubaci \"tvrdi\" razmak"

#: kwview.cc:1000
msgid "Insert Soft Hyphen"
msgstr "Umetni \"mekani\" apostrof"

#: kwview.cc:1002
msgid "Line Break"
msgstr "Prelom linije"

#: kwview.cc:1005
msgid "Completion"
msgstr "Dovršavanje"

#: kwview.cc:1024
msgid "Edit Variable..."
msgstr "Izmjeni varijablu..."

#: kwview.cc:1027
msgid "Apply Autocorrection"
msgstr "Primjeni ispravljanje"

#: kwview.cc:1030 kwview.cc:1031
msgid "Manually force KWord to scan the entire document and apply autocorrection."
msgstr "Ručno pokrenite pregled čitavog dokumenta i primjenu automatskih ispravki."

#: kwview.cc:1033
msgid "Create Style From Selection"
msgstr "Napravi stil od izabranog"

#: kwview.cc:1036 kwview.cc:1037
msgid "Create a new style based on the currently selected text."
msgstr "Napravi novi stil baziran na trenutno izabranom tekstu."

#: kwview.cc:1042 kwview.cc:1043
msgid "Change the look of footnotes."
msgstr "Izmjeni izgled fusnota."

#: kwview.cc:1045 kwview.cc:5039
msgid "Edit Footnote"
msgstr "Izmjeni fusnotu"

#: kwview.cc:1048 kwview.cc:1049
msgid "Change the content of the currently selected footnote."
msgstr "Izmjeni sadržaj trenutno izabrane fusnote."

#: kwview.cc:1052
msgid "Change Footnote/Endnote Parameter"
msgstr "Izmjeni parametre fusnote/endnote"

#: kwview.cc:1056
msgid "Save Picture..."
msgstr "Snimi sliku..."

#: kwview.cc:1059
msgid "Save the picture in a separate file."
msgstr "Snimi sliku u zasebnu datoteku."

#: kwview.cc:1060
msgid ""
"Save the picture in the currently selected frame in a separate file, outside "
"the KWord document."
msgstr ""
"Snimi sliku iz trenutno izabranog okvira u zasebnu datoteku, koja se može otvoriti "
"izvan KWord dokumenta."

#: kwview.cc:1062
msgid "Autospellcheck"
msgstr "Automatska provjera pravopisa"

