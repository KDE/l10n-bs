msgstr "Podrazumjevani format"

#: kwview.cc:674 kwview.cc:675
msgid "Change font and paragraph attributes to their default values."
msgstr "Vrati atribute fonta i odlomka na njihove podrazumjevane vrijednosti."

#: kwview.cc:679
