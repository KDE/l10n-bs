msgid "&Page Mode"
msgstr "&Stranični mod"

#: kwview.cc:443
msgid ""
"Switch to page mode.<br><br> Page mode is designed to make editing your text "
"easy.<br><br>This function is most frequently used to return to text editing "
"after switching to Preview mode."
msgstr ""
"Prebaci na stranični mod.<br><br> Stranični mod je napravljen kako bi vam "
"olakšao editovanje teksta.<br><br>Ova funkcija se najčešće koristi za povratak "
"na editovanje teksta nakon što ste vidjeli Pregled."

#: kwview.cc:444
msgid "Switch to page editing mode."
msgstr "Prebacuje na mod za editovanje stranice."

#: kwview.cc:448
msgid "Pre&view Mode"
msgstr "&Pregled"

