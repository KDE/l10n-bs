msgstr "Naredba za editovanje:"

#: part/kateviewdialog.cpp:81
msgid "Replace Text"
msgstr "Zamijeni tekst"

#: part/kateviewdialog.cpp:83
msgid "&All"
msgstr "&Sve"

#: part/kateviewdialog.cpp:83
msgid "&No"
msgstr "&Ne"

#: part/kateviewdialog.cpp:83
msgid "&Yes"
msgstr "&Da"

#: part/kateviewdialog.cpp:89
msgid "Replace this occurence?"
msgstr "Želite li zamijeniti ovo?"

