msgstr "&Isključeno"

#: part/kateview.cpp:338
msgid "Follow &Line Numbers"
msgstr "Prati &brojeve linija"

#: part/kateview.cpp:339
msgid "&Always On"
msgstr "&Uvijek uključen"

#: part/kateview.cpp:343
