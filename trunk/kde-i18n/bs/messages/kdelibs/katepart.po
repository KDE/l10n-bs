msgid "Save File"
msgstr "Spremi datoteku"

#: part/kateview.cpp:715
msgid "A file named \"%1\" already exists. Are you sure you want to overwrite it?"
msgstr ""
"Dokument pod imenom \"%1\" već postoji. Da li ga želite da prepišem preko "
