msgid "User"
msgstr "Korisnik"

#: kfile/kpropertiesdialog.cpp:1772
msgid "Others"
msgstr "Ostali"

#: kfile/kpropertiesdialog.cpp:1775
msgid "Set UID"
msgstr "Podesi UID"

#: kfile/kpropertiesdialog.cpp:1779
msgid ""
"If this flag is set, the owner of this folder will be the owner of all new "
"files."
msgstr ""
"Ako je ova privilegija aktivna, vlasnik ovog direktorija će biti vlasnik "
"svih novo napravljenih datoteka."

