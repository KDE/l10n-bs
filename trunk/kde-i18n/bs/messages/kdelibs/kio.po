"_: Enter folder\n"
"Enter"
msgstr "Ulaz"

#: kfile/kpropertiesdialog.cpp:1742
msgid "Enable this flag to allow entering the folder."
msgstr "Uključite ovu privilegiju da dozvolite ulaženje u direktorij."

#: kfile/kpropertiesdialog.cpp:1745
msgid "Exec"
msgstr "Izvršenje"

#: kfile/kpropertiesdialog.cpp:1746
msgid "Enable this flag to allow executing the file as a program."
msgstr "Uključite ovu privilegiju da dozvolite izvršenje datoteke kao programa."

