#: kpgpbase2.cpp:307 kpgpbase5.cpp:236 kpgpbaseG.cpp:266
msgid "You don't have the secret key needed to decrypt this message."
msgstr "Nemate tajni ključ koji je potreban za dešifrovanje ove poruke."

#: kpgpbase2.cpp:447
msgid ""
"The keyring file %1 does not exist.\n"
"Please check your PGP setup."
msgstr ""
"Keyring datoteka %1 ne postoji.\n"
"Molim provjerite vaše PGP postavke."

