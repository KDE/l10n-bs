#: ksieve_error.cpp:34
msgid "Parse error: Carriage Return (CR) without Line Feed (LF)"
msgstr "Greška u obradi: Carriage Return (CR) bez Line Feed (LF)"

#: ksieve_error.cpp:37
msgid "Parse error: Illegal Character"
msgstr "Greška u obradi: Nedozvoljen znak"

#: ksieve_error.cpp:40
msgid "Parse error: Number out of Range (must be smaller than %1)"
msgstr "Greška u obradi: Broj izvan raspona (mora biti manji od %1)"

#: ksieve_error.cpp:43
msgid "Parse error: Premature end of Multiline String (did you forget the '.'?)"
msgstr ""
"Greška u obradi: Preran završetak višelinijskog stringa (jeste li "
"zaboravili '.'?)"

#: ksieve_error.cpp:46
msgid "Parse error: Premature end of Quoted String (missing closing '\"')"
msgstr ""
"Greška u obradi: Preran završetak stringa u navodnicima (nedostaje "
"završni '\"')"

#: ksieve_error.cpp:49
msgid "Parse error: Premature end of String List (missing closing ']')"
msgstr "Greška u obradi: Preran završetak liste stringova(nedostaje završni ']')"

#: ksieve_error.cpp:52
msgid "Parse error: Premature end of Test List (missing closing ')')"
msgstr "Greška u obradi: Preran završetak liste testova (nedostaje završni ')')"

#: ksieve_error.cpp:55
msgid "Parse error: Premature end of Block (missing closing '}')"
msgstr "Greška u obradi: Preran završetak bloka (nedostaje završni '}')"

#: ksieve_error.cpp:58
msgid "Parse error: Missing ';' or Block"
msgstr "Greška u obradi: Nedostaje ';' ili blok"

#: ksieve_error.cpp:61
msgid "Parse error: Only Strings allowed in String Lists"
msgstr "Greška u obradi: U listama stringova su dozvoljeni samo stringovi"

#: ksieve_error.cpp:64
msgid "Parse error: Only Tests allowed in Test Lists"
msgstr "Greška u obradi: U listama testova su dozvoljeni samo testovi"

#: ksieve_error.cpp:69
msgid "\"require\" must be first command"
msgstr "\"require\" mora biti prva naredba"

