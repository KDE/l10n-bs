#: protocols/aim/aimcontact.cpp:112 protocols/aim/aimcontact.cpp:269
msgid ""
"<qt>Sorry, this user is not online at the moment for you to message him/her. "
"AIM users must be online for you to be able to message them.</qt>"
msgstr ""
"<qt>Žalim, ovaj korisnik nije trenutno online kako bi ste mu/joj poslali poruku. "
"AIM korisnici moraju biti online kako bi ste im mogli slati poruke.</qt>"

#: protocols/aim/aimcontact.cpp:112 protocols/aim/aimcontact.cpp:187
#: protocols/aim/aimcontact.cpp:271
msgid "User not Online"
msgstr "Korisnik nije Online"

#: protocols/aim/aimcontact.cpp:183
msgid ""
"<qt>Sorry, you must be connected to the AIM server to retrieve user "
"information, but you will be allowed to continue if you would like to change "
"the user's nickname.</qt>"
msgstr ""
"<qt>Žalim, vi morate biti spojeni na AIM server da bi ste pribavili informacije "
"o korisniku, ali biti će vam dopušteno da nastavite ako želite promjeniti "
"korisnikov nadimak.</qt>"

#: protocols/aim/aimcontact.cpp:183
msgid "You Must be Connected"
msgstr "Vi morate biti spojeni"

#: protocols/aim/aimcontact.cpp:187
msgid ""
"<qt>Sorry, this user isn't online for you to view his/her information, but "
"you will be allowed to only change his/her nickname. Please wait until this "
"user becomes available and try again</qt>"
msgstr ""
"<qt>Žalim, ovaj korisnik nije online kako bi ste vidjeli njegove/njene informacije, ali "
"će vam biti omogućeno samo da promijenite njegov/njen nadimak. Molim pričekajte "
"dok ovaj korisnik postane dostupan i pokušajte ponovo.<qt>"

