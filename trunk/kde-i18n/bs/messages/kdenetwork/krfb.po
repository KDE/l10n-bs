msgstr "Upravitelj &pozivima"

#: trayicon.cpp:70
msgid "Enable Remote Control"
msgstr "Dozvoli udaljeno upravljanje"

#: trayicon.cpp:100
msgid "The remote user has been authenticated and is now connected."
msgstr "Udaljeni korisnik se prijavio i sada je konektovan."

#: trayicon.cpp:103
#, c-format
msgid "Desktop Sharing - connected with %1"
msgstr "Dijeljenje radne površine - konektovan sa %1"

#: trayicon.cpp:110
msgid "Desktop Sharing - disconnected"
msgstr "Dijeljenje radne površine - diskonektovan"

#: trayicon.cpp:113
