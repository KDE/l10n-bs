msgid "You have no valid news accounts configured!"
msgstr "Nemate konfigurisanih validnih news accounta !"

#: knarticlefactory.cpp:441
msgid "Do you really want to supersede this article?"
msgstr "Da li želite prepisati ovaj članak?"

#: knarticlefactory.cpp:572
msgid "This article cannot be edited."
msgstr "Ovaj članak ne može biti izmjenjen."

#: knarticlefactory.cpp:619
msgid "Article has already been sent."
msgstr "Članak je već poslan."

#: knarticlefactory.cpp:636
msgid "Unable to load article!"
msgstr "Ne mogu učitati članak!"

#: knarticlefactory.cpp:661
msgid "Unable to load the outbox-folder!"
msgstr "Ne mogu učitati direktorij izlazih članaka!"

#: knarticlefactory.cpp:777
msgid ""
"Please set a hostname for the generation\n"
"of the message-id or disable it."
msgstr ""
"Molim podesite hostname za generiranje\n"
"message-id ili isključite ovu opciju."

#: knarticlefactory.cpp:823
msgid "Please enter a valid email address."
msgstr "Molim unesite validnu email adresu."

#: knarticlefactory.cpp:907
msgid "Emails cannot be canceled or superseded!"
msgstr "Email ne može biti otkazan ili prepisan!"

#: knarticlefactory.cpp:913
msgid "Cancel messages cannot be canceled or superseded!"
msgstr "Otkaži poruke ne može biti otkazan ili prepisan!"

#: knarticlefactory.cpp:918
msgid "Only sent articles can be canceled or superseded!"
msgstr "Samo poslani članci mogu biti otkazani ili prepisani!"

#: knarticlefactory.cpp:923
msgid "This article has already been canceled or superseded!"
msgstr "Ovaj članak je več otkazan ili prepisan!"

#: knarticlefactory.cpp:930
msgid ""
"This article cannot be canceled or superseded,\n"
"because its message-id has not been created by KNode!\n"
"But you can look for your article in the newsgroup\n"
"and cancel (or supersede) it there."
msgstr ""
"Ovaj članak ne može biti otkazan ili prepisan,\n"
"jer njegov message-id nije kreirao Knode!\n"
"Pokušajte potražiti vaš članak u news grupi\n"
"i otkazati (ili prepisati) ga tamo."

#: knarticlefactory.cpp:967
msgid ""
"This article does not appear to be from you.\n"
"You can only cancel or supersede you own articles."
msgstr ""
"Ovaj članak niste poslali vi.\n"
"Možete otkazati ili prepisati samo svoje članke."

#: knarticlefactory.cpp:972
msgid ""
"You have to download the article body\n"
"before you can cancel or supersede the article."
msgstr ""
"Morate skinuti tijelo članka\n"
"prije nogo što ga otkažete ili prepišete."

