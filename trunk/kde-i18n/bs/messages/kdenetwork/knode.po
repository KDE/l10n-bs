msgstr "Potpis je validan, ali ispravnost ključa je nepoznata."

#: knarticlewidget.cpp:1059
msgid "The signature is valid and the key is marginally trusted."
msgstr "Potpis je validan i ključ je marginalno ispravan."

#: knarticlewidget.cpp:1063
msgid "The signature is valid and the key is fully trusted."
msgstr "Potpis je validan i ključ je u ispravan."

#: knarticlewidget.cpp:1067
msgid "The signature is valid and the key is ultimately trusted."
msgstr "Potpis je validan i ključ je u potpunosti ispravan."

#: knarticlewidget.cpp:1071
msgid "The signature is valid, but the key is untrusted."
msgstr "Potpis je validan, ali je ključ neispravan."

#: knarticlewidget.cpp:1077
msgid "Warning: The signature is bad."
msgstr "Upozorenje: Potpis je pogrešan."

#: knarticlewidget.cpp:1104
msgid ""
"<br><bodyblock><b>This article has the Mime-Type &quot;message/"
"partial&quot;, which KNode cannot handle yet.<br>Meanwhile you can save the "
"article as a text-file and reassemble it by hand.</b></bodyblock></qt>"
msgstr ""
"<br><bodyblock><b>Ovaj članak ima Mime-Type &quot;message/"
"partial&quot;, koje KNode još ne može obraditi.<br>U međuvremenu možete snimiti "
"članak kao tekst fajl i ručno ga sastaviti.</b></bodyblock></qt>"

