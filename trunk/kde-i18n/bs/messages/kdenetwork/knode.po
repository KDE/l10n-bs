#: knaccountmanager.cpp:148
msgid "Cannot create a directory for this account!"
msgstr "Ne mogu kreirati direktorij za ovaj account!"

#: knaccountmanager.cpp:162
msgid "This account cannot be deleted since there are some unsent messages for it."
msgstr "Ovaj account ne može biti izbrisan jer sadrži neposlane poruke."

#: knaccountmanager.cpp:164
msgid "Do you really want to delete this account?"
msgstr "Želite li izbrisati ovaj account?"

#: knaccountmanager.cpp:170
msgid ""
"At least one group of this account is currently in use.\n"
"The account cannot be deleted at the moment."
msgstr ""
"Barem jedna grupa iz ovog accounta se trenutno koristi.\n"
"Account trenutno ne može biti izbrisan."

#: knarticlecollection.cpp:55
msgid ""
"Memory allocation failed!\n"
"You should close this application now\n"
"to avoid data loss."
msgstr ""
"Alokacija memorije nije uspjela!\n"
"Trebali bi zatvoriti ovaj program\n"
"da izbjegnete gubitak podataka."

#: knarticlefactory.cpp:143
msgid ""
"The author has requested a reply by email instead\n"
"of a followup to the newsgroup. (Followup-To: poster)"
msgstr ""
"Autor traži odgovor na email umjesto\n"
"odgovora na newsgrupu. (Followup-To: poster)"

#: knarticlefactory.cpp:193
msgid "The author requested a mail copy of your reply. (Mail-Copies-To header)"
msgstr "Autor zahtijeva email kopiju vašeg odgovora. (Mail-Copies-To header)"

#: knarticlefactory.cpp:281
msgid "This article contains attachments. Do you want them to be forwarded too?"
msgstr "Ovaj članak sadrži i dodane fajlove. Želite li i njih proslijediti?"

