msgid "Do you really want to cancel this article?"
msgstr "Da li želite otkazati slanje ove poruke?"

#: knarticlefactory.cpp:365
msgid ""
"Do you want to send the cancel\n"
"message now or later?"
msgstr ""
"Želite li poslati poruku\n"
"sada ili kasnije?"

