#: main.cpp:16
msgid "International Keyboard Selector"
msgstr "Izbornik međunarodne tastature"

#: main.cpp:17
msgid "Run time selector for keyboard layout on the desktop or on individual windows"
msgstr ""
"Izbornik izgleda tastature u realnom vremenu za desktop ili pojedinačne "
"prozore."

#: main.cpp:21
msgid "Current maintainer"
msgstr "Trenutni održavatelj"

#: main.cpp:23
msgid "Original author"
msgstr "Orginalni autor"

#: main.cpp:24
msgid "Bug fixing"
msgstr "Ispravljanje bugova"

#: options.cpp:169
msgid "X default codes"
msgstr "X default kodovi"

#: options.cpp:243
msgid ""
"%1\n"
"Do you want to configure now?"
msgstr ""
"%1\n"
"Da li želite početi sa podešavanjem?"

#: options.cpp:252
msgid ""
"You're using \"International Keyboard\" for the first time.\n"
"I installed a number of default settings."
msgstr ""
"Koristite \"Međunarodnu tastaturu\" po prvi put.\n"
"Instalirao sam uobičajene postavke."

#: kikbd.cpp:173
msgid ""
"Only one instance of the international keyboard configuration\n"
"can run at a given moment."
msgstr ""
"Samo jedna instanca podešavanja međunarodne tastature\n"
"može biti pokrenuta u jednom trenutku."

#: kikbd.cpp:175
msgid "Already running"
msgstr "Već je pokrenut"

#: kikbd.cpp:240
msgid ""
"X codes \"%1\" file does not exist.\n"
"Using previously default X codes."
msgstr ""
"Datoteka \"%1\" sa X kodovima ne postoji.\n"
"Koristim ranije default X kodove."

#: kikbd.cpp:267
msgid ""
"Keyboard map \"%1\" does not exists.\n"
"Skipping this map."
msgstr ""
"Mapa tastature \"%1\" ne postoji.\n"
"Preskačem ovu mapu."

#: kikbd.cpp:283
msgid "Setup"
msgstr "Postavke"

#: kikbd.cpp:305 kikbd.cpp:318
msgid ""
"Can not remove %1 from Modifiers.\n"
msgstr ""
"Ne mogu ukloniti %1 iz liste modificirajućih tipki.\n"

#: kikbd.cpp:308
msgid ""
"Can not add %1 to Modifier number 3.\n"
msgstr ""
"Ne mogu dodati %1 za modificirajuću tipku broj 3.\n"

#: kikbd.cpp:330
msgid ""
"Can not set Mode Switch as %1 for keyboard %2.\n"
"Alt symbols disabled"
msgstr ""
"Ne mogu postaviti prekidač moda %1 za tastaturu %2\n"
"Alt znakovi isključeni"

#: kikbd.cpp:352
msgid ""
"Can't remove Caps Lock from Modifiers.\n"
"Caps Lock Emulation disabled"
msgstr ""
"Ne mogu ukloniti Caps Lock iz liste modificirajućih tipki.\n"
"Caps Lock oponašanje isključeno"

#: kikbd.cpp:1009
msgid ""
"You're about to quit the \"International Keyboard\" tool.\n"
" Do you want to have it autostarted at your next login?"
msgstr ""
"Upravo zatvarate \"Međunarodnu tastaturu\".\n"
"Da li želite da se ona automatski pokrene prilikom slijedećeg logina?"

#: kikbd.cpp:1012
msgid "Exiting International Keyboard"
msgstr "Izlazim iz Međunarodne tastature"

#: keysyms.cpp:18
msgid "KeyMap: can't allocate memory"
msgstr "KeyMap: ne mogu alocirati memoriju"

#: keysyms.cpp:73
msgid ""
"Can't find symbol \"%1\".\n"
"Maybe your default X codes do not match.\n"
"You can preset X codes from section \"Advanced\"\n"
"in the configuration program."
msgstr ""
"Ne mogu naći znak \"%1\".\n"
"Možda se vaši default X kodovi ne podudaraju.\n"
"Možete podesiti X kodove u sekciji \"Napredno\"\n"
"u programu za podešavanje."

#: keysyms.cpp:78
msgid "KeyMap: can't find symbol \"%1\"."
msgstr "KeyMap: ne mogu naći znak \"%1\"."

#: keysyms.cpp:88
msgid "KeyMap: can't read keycode \"%1\"."
msgstr "KeyMap: ne učitati keycode \"%1\"."

#: keysyms.cpp:94
msgid "KeyMap: keycode \"%1\" is out of range."
msgstr "KeyMap: keycode \"%1\" je izvan raspona."

