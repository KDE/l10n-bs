#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror with "
"%1, but it cannot handle this file type."
msgstr ""
"Izgleda da postoji greška u konfiguraciji. Pridružili ste Konqueroru tip %1, "
"ali on ne može raditi s tom vrstom datoteka."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Da li zaista želite izvršiti '%1'?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Otvori '%1' koristeći '%2'?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Otvori '%1'?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Snimi na disk"
