#: filter_thebat.cxx:35
msgid ""
"<p><b>The Bat! import filter</b></p>"
"<p>Select the base directory of the 'The Bat!' local mailfolder you want to "
"import.</p>"
"<p><b>Note:</b> This filter imports the *.tbb-files from 'The Bat!' local "
