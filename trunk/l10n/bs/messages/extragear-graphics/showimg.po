#: showimg/rename.cpp:935
msgid ""
"<u>Description:</u>"
"<br>\n"
"\n"
"Add an expression describing the final filename. Valid tokens are:"
"<br>\n"
"<br>\n"
"<b>$</b> old filename"
"<br><b>%</b> old filename converted to lower case"
"<br><b>Both old filenames are without the old file extension.</b>"
"<br>\n"
"<br>\n"
"<b>#</b> Adds a number to the filename starting with StartIndex."
"<br><b>Example:</b>pic_$_#.jpg ."
msgstr ""
"<u>Opis:</u>"
"<br>\n"
"\n"
"Dodaj izraz za opis konačnog imena. Dozvoljeno je:"
"<br>\n"
"<br>\n"
"<b>$</b> stari naziv datoteke"
"<br><b>%</b> stari naziv datoteke reimenovan u mala slova"
"<br><b>Oba stara naziva datoteka su bez ekstenzije.</b>"
"<br>\n"
"<br>\n"
"<b>#</b> Dodaj broj nazivu datoteke počevši od PočetnogIndeksa."
"<br><b>Primjer:</b>slika_$_#.jpg ."

#: showimg/rename.cpp:944
msgid "Insert EXIF tags"
msgstr "Ubaci EXIF oznake"

#: showimg/rename.cpp:946
msgid "&Use original file extension"
msgstr "Koristi &originalnu ekstenziju datoteke"

#: showimg/rename.cpp:947
