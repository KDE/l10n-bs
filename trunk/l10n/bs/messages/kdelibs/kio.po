msgstr "Ne mogu promijeniti ime datoteke %1."

#: kio/global.cpp:330
#, c-format
msgid "Could not change permissions for %1."
msgstr "Ne mogu promijeniti ovlasti za %1."

#: kio/global.cpp:333
#, c-format
msgid "Could not delete file %1."
msgstr "Ne mogu obrisati datoteku %1."

#: kio/global.cpp:336
