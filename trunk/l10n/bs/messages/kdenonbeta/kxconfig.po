#: main.cpp:47
msgid "KDE utility for X-server configuration."
msgstr "KDE alat za podešavanje X-servera."

#: main.cpp:52
msgid "Enable batch mode."
msgstr "Uključi automatski režim."

#: main.cpp:53
msgid ""
"Batch-mode only: Specify the pointer model to use.\n"
"The format is:\n"
"<Protocol>,<Wheels>,<Device>\n"
" Protocol is the mouse protocol to be used (as\n"
" written to XF86Config)\n"
" Wheels is the number of mouse wheels\n"
" Device is the mouse device"
msgstr ""
"Samo batch-mode: Navedite model vašeg pokazivača.\n"
"Format je:\n"
"<Protokol>,<Točkića>,<Uređaj>\n"
" 'Protokol' je vrsta miša koji će se koristiti\n"
" (što će biti zapisano u datoteci XF86Config)\n"
" 'Točkića' je broj točkića miša\n"
" 'Uređaj' je sistemska oznaka uređaja (porta) miša"

#: main.cpp:60
msgid ""
"Batch-mode only: Specify the keyboard model and\n"
"layout to use. The format is:\n"
"<Model>,<Layout>\n"
" Model is the keyboard model\n"
" Layout is the keyboard layout, both as specified\n"
" in XF86Config"
msgstr ""
"Samo batch-mode: Navedite model tastature i raspored\n"
"koji će se koristiti. Format je:\n"
"<Model>,<Raspored>\n"
" 'Model' je model tastature\n"
" 'Raspored' je raspored tipaka na tastaturi, oboje u obliku\n"
" koji će biti zapisan u XF86Config"

#: main.cpp:66
msgid ""
"Batch-mode only: Specify X server flags.\n"
"The format is:\n"
"<AllowZap>\n"
" AllowZap specifies whether the Ctrl+Alt+BackSpace\n"
"shortcut is enabled (1) or not (0)"
msgstr ""

#: main.cpp:71
msgid ""
"Batch-mode only: Specify the basic screen\n"
"layout. The format is:\n"
"<DefaultDepth>,<DisplayInfo1>,<DisplayInfo2>,...\n"
" DefaultDepth specifies the default color depth\n"
" DisplayInfo is in the following format:\n"
"  Depth,XResolution,YResolution,VertRefresh"
msgstr ""

#: main.cpp:77
msgid ""
"Batch-mode only: Specify monitor details\n"
"The format is:\n"
"HSyncMin,HSyncMax,VSyncMin,VSyncMax"
msgstr ""

#: main.cpp:80
msgid ""
"Batch-mode only: Specify video card details\n"
"The format is:\n"
"<Driver>,<VendorName>,<Model>\n"
" Driver is the xfree video card driver to use\n"
" VendorName is the vendor name to specify in the\n"
" config file\n"
" Model is the model of the videocard, as specified\n"
" in the BoardName option in the config file"
msgstr ""

#: main.cpp:88
msgid ""
"Use the specified file to read and write the configuration\n"
"settings from/to\n"
msgstr ""
"Koristi navedenu datoteku kako bi čitao i pisao postavke\n"
"iz/u\n"

#: main.cpp:90
msgid "Force probing of hardware."
msgstr "Prisili ispitivanje hardvera."

#: main.cpp:91
msgid "Prevent probing of hardware."
msgstr "Spriječi ispitivanje hardvera."

#: main.cpp:98
msgid "KDE X-Configurator"
msgstr "KDE X-Configurator"

#: main.cpp:130
msgid "The KDE X Configurator must be run as root!"
msgstr "KDE X Configurator morate pokrenuti kao root!"

#: main.cpp:251
msgid ""
"XFree 3.x configuration file found.\n"
"It appears that you are already running X Window. In order to\n"
"create a new XFree 4.x configuration you need to start kxconfig\n"
"from the system console. Aborting."
msgstr ""
"Pronašao sam XFree 3.x konfiguracijsku datoteku.\n"
"Izgleda da ste već pokrenuli X Window. Kako biste\n"
"napravili novu XFree 4.x konfiguraciju morate pokrenuti kxconfig\n"
"sa sistemske konzole. Prekidam."

#: main.cpp:257
msgid ""
"XFree 3.x configuration file found.\n"
"Do you want to use KXConfig to create a new XFree 4.x\n"
"configuration?"
msgstr ""
"Pronašao sam XFree 3.x konfiguracijsku datoteku.\n"
"Želite li koristiti KXConfig kako biste napravili novu XFree\n"
"4.x konfiguraciju?"

#: monitorpageimpl.cpp:268
msgid ""
"<h1>Monitor Setup</h1><p>Please choose a monitor model from the list of vendors "
"and models on the right or specify a user defined model in the input fields "
"below.</p>"
msgstr ""
"<h1>Podešavanje monitora</h1> <p>Molim izaberite model monitora sa liste "
"proizvođača i modela desno ili navedite vlastiti model pomoću polja sa "
"vrijednostima ispod.</p>"

#: monitorpageimpl.cpp:281
msgid "Illegal range for horizontal sync frequency."
msgstr "Nedozvoljen raspon za frekvenciju vodoravnog osvježavanja."

#: monitorpageimpl.cpp:298
msgid "Illegal range for vertical refresh rate."
msgstr "Nedozvoljen raspon za frekvenciju okomitog osvježavanja."

#: mousepageimpl.cpp:176
msgid ""
"<h1>Mouse Setup</h1><p>Please select the type, model and port of your pointer "
"device from the dropdown fields in the upper left. If your mouse does not have "
"a third mouse button you might want to enable the third button emulation in the "
"lower left. A 3rd button click is emulated by pressing both the first and "
"second mouse button.</p>"
msgstr ""
"<h1>Podešavanje miša</h1> <p>Molim izaverite vrstu, model i port vašeg "
"pokazivačkog uređaja (miša) sa padajućih listi u gornjem lijevom dijelu "
"prozora. Ako vaš miš nema treće dugme, možda želite omogućiti simulaciju "
"trećeg dugmeta u donjem lijevom dijelu. Pritisak na treće dugme simulira se "
"tako što pritisnete oba dugmeta istovremeno.</p>"

