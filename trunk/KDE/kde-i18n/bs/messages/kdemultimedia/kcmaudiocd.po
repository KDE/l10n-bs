msgid "Error Correction Settings"
msgstr "Podešavanje ispravki greški"

#. i18n: file audiocdconfig.ui line 152
#: rc.cpp:27
#, no-c-format
msgid "Enable &error correction"
msgstr "Uključi i&spravku greški"

#. i18n: file audiocdconfig.ui line 158
#: rc.cpp:30
#, no-c-format
msgid ""
"If you check this option, the slave will not try to use error correction "
"which can be useful for reading damaged CDs. However, this feature can be "
"problematic in some cases, so you can switch it off here."
msgstr ""
"Ako uključite ovu opciju, slave neće pokušavati koristiti ispravku "
"grešaka. Ova mogućnost može biti korisna kada čitate oštećene CDove, "
"ali zna doći do problema u nekim slučajevima, tako da je ovdje možete "
"isključiti."

